[Unit]
Description=Binaural headphone sound (CamillaDSP on Kodi's 7.1 through snd-aloop)
# Inert until the listener sets it up: copy /usr/share/binaural/camilladsp-7.1.yml here
ConditionPathExists=/storage/.config/binaural/camilladsp.yml
Before=kodi.service
# a daemon that cannot start yet keeps trying, as Kodi does
StartLimitIntervalSec=0

[Service]
ExecStartPre=/sbin/modprobe snd-aloop
# Kodi sets these when it opens the HDMI output itself; playing to the loopback, it does not.
ExecStartPre=-/usr/bin/amixer -q -c AMLAUGESOUND sset 'HDMITX Audio Source Select' 'Spdif_b'
ExecStartPre=-/usr/bin/amixer -q -c AMLAUGESOUND sset 'Audio spdif_b format' 'Multi-channel LPCM'
ExecStartPre=-/usr/bin/amixer -q -c AMLAUGESOUND sset 'Audio I2S to HDMITX Format' 'Multi-channel LPCM'
ExecStart=/usr/bin/camilladsp -l warn /storage/.config/binaural/camilladsp.yml
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=kodi.service
