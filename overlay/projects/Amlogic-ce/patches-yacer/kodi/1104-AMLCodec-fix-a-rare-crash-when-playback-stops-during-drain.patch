From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: allolive <160342668+allolive@users.noreply.github.com>
Date: Wed, 16 Sep 2026 13:16:48 -0400
Subject: [PATCH] AMLCodec: fix a rare crash when playback stops during drain

GetPicture reads the queued frame count straight from m_amlVideoFile while
CloseDecoder can be releasing it: m_opened is cleared before the file is
dropped, so a video thread already past that check dereferences a null
pointer. Take the same copy under m_amlVideoFileMutex the other callers take;
no file means nothing is queued, which ends the drain.

Signed-off-by: allolive <160342668+allolive@users.noreply.github.com>

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
index ac6cc5695536beef3bb6a72bd01926a3916c73ff..3c1935422e172e2ff856bbda81a4a6b39ec543b4 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
@@ -3106,7 +3106,17 @@ CDVDVideoCodec::VCReturn CAMLCodec::GetPicture(VideoPicture *pVideoPicture)
     return CDVDVideoCodec::VC_ERROR;
 
   if (m_drain)
-    queued_frames = m_amlVideoFile->IOControl(AMLVIDEO_IOC_GET_VFQ, &queued_frames) == 0 ? queued_frames : 0;
+  {
+    PosixFilePtr amlVideoFile;
+    {
+      std::lock_guard<std::mutex> lock(m_amlVideoFileMutex);
+      amlVideoFile = m_amlVideoFile;
+    }
+
+    if (amlVideoFile)
+      queued_frames =
+          amlVideoFile->IOControl(AMLVIDEO_IOC_GET_VFQ, &queued_frames) == 0 ? queued_frames : 0;
+  }
 
   if (m_buffer_level_ready && (buffer_level > m_minimum_buffer_level || (queued_frames > 0)) && (ret = DequeueBuffer()) == 0)
   {
