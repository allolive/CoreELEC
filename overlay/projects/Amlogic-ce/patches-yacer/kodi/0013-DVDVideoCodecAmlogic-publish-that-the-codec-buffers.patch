From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: allolive <160342668+allolive@users.noreply.github.com>
Date: Wed, 16 Sep 2026 10:06:26 -0400
Subject: [PATCH] DVDVideoCodecAmlogic: turn on the network buffering fix

libamcodec keeps its own stream buffer, so the demux queue empties into it and
the queue's level says nothing about how much is left to play.

Signed-off-by: allolive <160342668+allolive@users.noreply.github.com>

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAmlogic.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAmlogic.cpp
index 1a79460681241c15e81b77105c0871c0c35b180f..b5437241cf825e786fc6140bf6c64a8a2ac35fea 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAmlogic.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAmlogic.cpp
@@ -407,6 +407,8 @@ bool CDVDVideoCodecAmlogic::Open(CDVDStreamInfo &hints, CDVDCodecOptions &option
   m_videobuffer.color_transfer = m_hints.colorTransferCharacteristic;
 
   m_processInfo.SetVideoDecoderName(m_pFormatName, true);
+  // libamcodec keeps its own stream buffer.
+  m_processInfo.SetVideoCodecBuffersData(true);
   m_processInfo.SetVideoDimensions(m_hints.width, m_hints.height);
   m_processInfo.SetVideoDeintMethod("hardware");
   m_processInfo.SetVideoDAR(m_hints.aspect);
