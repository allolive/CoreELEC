From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: allolive <160342668+allolive@users.noreply.github.com>
Date: Wed, 16 Sep 2026 10:06:26 -0400
Subject: [PATCH] FileCache: don't stop playback when a network share stalls

A stalled share ended playback: the file cache reported the stall as end
of file. Retry a failed read, return EAGAIN while the input has not ended
and pass it through, and wait 1 s instead of 10 so the player can buffer.
A stall mid-Matroska-element can still end demuxing until the next seek.
On every platform a failing read now retries until the user stops. Shared
code: FileCache, the input stream and the demuxer are not AML-reachable.

Signed-off-by: allolive <160342668+allolive@users.noreply.github.com>

diff --git a/xbmc/addons/interfaces/Filesystem.cpp b/xbmc/addons/interfaces/Filesystem.cpp
index 4bf0cf040019f6267cac8dbd61273fe4f0dcadda..612158976e34f3c08d323536f805f28bb690018f 100644
--- a/xbmc/addons/interfaces/Filesystem.cpp
+++ b/xbmc/addons/interfaces/Filesystem.cpp
@@ -833,7 +833,10 @@ ssize_t Interface_Filesystem::read_file(void* kodiBase, void* file, void* ptr, s
     return -1;
   }
 
-  return static_cast<CFile*>(file)->Read(ptr, size);
+  // The ABI documents -1 for any error, so do not let an internal error value
+  // through - the file cache reports a stalled source as one.
+  const ssize_t ret = static_cast<CFile*>(file)->Read(ptr, size);
+  return ret < 0 ? -1 : ret;
 }
 
 bool Interface_Filesystem::read_file_string(void* kodiBase,
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index 5a3e21b394b13e35356458e1776733db184a73a1..559b3bfb097c9e84a9a9cd26a5f1985ec2c0fefb 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -1088,7 +1088,13 @@ DemuxPacket* CDVDDemuxFFmpeg::ReadInternal(bool keep)
     {
       // assume we are not eof
       if (m_pFormatContext->pb)
+      {
         m_pFormatContext->pb->eof_reached = 0;
+        // ffmpeg latches a stalled read next to the eof flag and hands it back on
+        // every later read. Only that one is cleared; a real error still stands.
+        if (m_pFormatContext->pb->error == AVERROR(EAGAIN))
+          m_pFormatContext->pb->error = 0;
+      }
 
       // check for saved packet after a program change
       if (m_pkt.result < 0)
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.cpp
index a129064892b5eb255675f2e22b86e16bcd7d3afd..67d6ecf956835e930fd267a478a08d0560862830 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.cpp
@@ -14,6 +14,8 @@
 #include "utils/log.h"
 #include "video/VideoFileItemClassify.h"
 
+#include <cerrno>
+
 using namespace KODI;
 using namespace XFILE;
 
@@ -95,6 +97,9 @@ int CDVDInputStreamFile::Read(uint8_t* buf, int buf_size)
 
   ssize_t ret = m_pFile->Read(buf, buf_size);
 
+  if (ret == -EAGAIN)
+    return -EAGAIN; // the source stalled, ffmpeg reads this as "try again"
+
   if (ret < 0)
     return -1; // player will retry read in case of error until playback is stopped
 
diff --git a/xbmc/filesystem/FileCache.cpp b/xbmc/filesystem/FileCache.cpp
index f9f8b521d70062a33677965d7718aab38f3cc1ce..a0f3131cd90412a9a330991632a7af353b5e539c 100644
--- a/xbmc/filesystem/FileCache.cpp
+++ b/xbmc/filesystem/FileCache.cpp
@@ -25,6 +25,7 @@
 
 #include <algorithm>
 #include <cassert>
+#include <cerrno>
 #include <inttypes.h>
 #include <memory>
 #include <stdexcept>
@@ -410,8 +411,9 @@ void CFileCache::Process()
       iRead = m_source->Read(buffer.get(), maxSourceRead);
     if (iRead <= 0)
     {
-      // Check for actual EOF and retry as long as we still have data in our cache
-      if (m_writePos < m_fileSize && m_pCache->WaitForData(0, 0ms) > 0)
+      // A failed read before the end of the file is a stall, so retry it even once the
+      // player has caught up.
+      if (m_writePos < m_fileSize && (iRead < 0 || m_pCache->WaitForData(0, 0ms) > 0))
       {
         CLog::Log(LOGWARNING, "CFileCache::{} - <{}> source read returned {}! Will retry",
                   __FUNCTION__, m_sourcePath, iRead);
@@ -566,15 +568,26 @@ retry:
       return -1;
     }
 
-    // just wait for some data to show up
-    iRc = m_pCache->WaitForData(1, 10s);
+    // The player decides whether to buffer between reads, so a read that parks
+    // for ten seconds on a stalled source takes those decisions with it.
+    iRc = m_pCache->WaitForData(1, 1s);
     if (iRc > 0)
       goto retry;
+
     if (!m_sourcePositionValid)
     {
       SetLastError(m_seekError != 0 ? m_seekError : EIO);
       return -1;
     }
+
+    // Nothing arrived and the source has not reported the end of the file, so it
+    // has stalled. Say that, instead of the zero bytes every caller reads as EOF.
+    if (!m_pCache->IsEndOfInput())
+    {
+      CLog::Log(LOGWARNING, "CFileCache::{} - <{}> source stalled, no data to read", __FUNCTION__,
+                m_sourcePath);
+      return -EAGAIN;
+    }
   }
 
   if (iRc == CACHE_RC_TIMEOUT)
