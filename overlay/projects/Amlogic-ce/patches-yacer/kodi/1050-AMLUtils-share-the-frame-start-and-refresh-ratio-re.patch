   void aml_init_drmDevice();
   void aml_drmDevice_vsync();
   std::string aml_get_drmDevice_mode();
@@ -153,6 +154,7 @@ public:
 
   void aml_refresh_display_caps();
   int aml_get_Device_handle() const { return m_amlDRMUtils->aml_get_drmDevice_handle(); }
