From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: allolive <160342668+allolive@users.noreply.github.com>
Date: Fri, 19 Sep 2026 16:00:00 -0400
Subject: [PATCH] AMLCodec: bound the writes into the decoder

codec_write is retried until it takes the data, but a write of zero bytes was
counted as progress: len advanced by nothing, the retry budget was never spent
and the loop ran forever. Treat it as no progress and spend the budget, and
keep the error path for a real failure rather than a decoder that is only
busy.

The dump file was written from the head of the buffer on every retry instead
of the offset the decoder had reached, so a partial write recorded the wrong
bytes. Write from the offset.

The MJPEG and DivX pre-feeding and header writes returned success whatever the
write did; propagate the failure so the caller sees it.

Signed-off-by: allolive <160342668+allolive@users.noreply.github.com>

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
index 5764ae4611..5881d11e7a 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
@@ -263,7 +263,7 @@ static const uint64_t UINT64_0 = 0x8000000000000000ULL;
 #define CODEC_TAG_RV30  (0x30335652)
 #define CODEC_TAG_RV40  (0x30345652)
 
-#define RW_WAIT_TIME    (5 * 1000) // 20ms
+#define RW_WAIT_TIME    (5 * 1000) // 5ms
 
 #define P_PRE           (0x02000000)
 #define F_PRE           (0x03000000)
@@ -651,23 +651,24 @@ static int write_header(am_private_t *para, am_packet_t *pkt)
                 return PLAYER_SUCCESS;
             }
         }
-        int eagain_retries = 0;
+        int no_progress_attempts = 0;
         while (1) {
             write_bytes = para->m_dll->codec_write(pkt->codec, pkt->hdr->data + len, pkt->hdr->size - len);
-            if (write_bytes < 0 || write_bytes > (pkt->hdr->size - len)) {
-                if (-errno != AVERROR(EAGAIN)) {
+            if (write_bytes <= 0 || write_bytes > (pkt->hdr->size - len)) {
+                if (write_bytes < 0 && -errno != AVERROR(EAGAIN)) {
                     CLog::Log(LOGDEBUG, "ERROR:write header failed!");
                     return PLAYER_WR_FAILED;
                 } else {
-                    if (++eagain_retries > 100) {
-                        CLog::Log(LOGDEBUG, "ERROR:write header timed out (EAGAIN)!");
+                    if (++no_progress_attempts > 100) {
+                        CLog::Log(LOGDEBUG, "ERROR:write header made no progress!");
                         return PLAYER_WR_FAILED;
                     }
                     usleep(RW_WAIT_TIME);
                     continue;
                 }
             } else {
-                dumpfile_write(para, pkt->hdr->data, write_bytes);
+                no_progress_attempts = 0;
+                dumpfile_write(para, pkt->hdr->data + len, write_bytes);
                 len += write_bytes;
                 if (len == pkt->hdr->size) {
                     break;
@@ -695,11 +702,11 @@ int write_av_packet(am_private_t *para, am_packet_t *pkt)
                 return PLAYER_WR_FAILED;
             }
         }
-        if (write_header(para, pkt) == PLAYER_WR_FAILED) {
+        if (write_header(para, pkt) != PLAYER_SUCCESS) {
             CLog::Log(LOGDEBUG, "[{}]write header failed!", __FUNCTION__);
             return PLAYER_WR_FAILED;
         }
         //pkt->newflag = 0;
     }
 
     buf = pkt->data;
@@ -711,9 +718,9 @@ int write_av_packet(am_private_t *para, am_packet_t *pkt)
 
     while (size > 0 && pkt->isvalid) {
         write_bytes = para->m_dll->codec_write(pkt->codec, buf, size);
-        if (write_bytes < 0 || write_bytes > size) {
+        if (write_bytes <= 0 || write_bytes > size) {
             CLog::Log(LOGDEBUG, "write codec data failed, write_bytes({:d}), errno({:d}), size({:d})", write_bytes, errno, size);
-            if (-errno != AVERROR(EAGAIN)) {
+            if (write_bytes < 0 && -errno != AVERROR(EAGAIN)) {
                 CLog::Log(LOGDEBUG, "write codec data failed!");
                 return PLAYER_WR_FAILED;
             } else {
@@ -826,7 +833,9 @@ static int mjpeg_data_prefeeding(am_packet_t *pkt)
 
 static int mjpeg_write_header(am_private_t *para, am_packet_t *pkt)
 {
-    mjpeg_data_prefeeding(pkt);
+    int ret = mjpeg_data_prefeeding(pkt);
+    if (ret != PLAYER_SUCCESS)
+        return ret;
     if (1) {
         pkt->codec = &para->vcodec;
     } else {
@@ -834,8 +843,7 @@ static int mjpeg_write_header(am_private_t *para, am_packet_t *pkt)
         return PLAYER_EMPTY_P;
     }
     pkt->newflag = 1;
-    write_av_packet(para, pkt);
-    return PLAYER_SUCCESS;
+    return write_av_packet(para, pkt);
 }
 
 static int divx3_data_prefeeding(am_packet_t *pkt, unsigned w, unsigned h)
@@ -863,7 +871,9 @@ static int divx3_data_prefeeding(am_packet_t *pkt, unsigned w, unsigned h)
 static int divx3_write_header(am_private_t *para, am_packet_t *pkt)
 {
     CLog::Log(LOGDEBUG, "divx3_write_header");
-    divx3_data_prefeeding(pkt, para->video_width, para->video_height);
+    int ret = divx3_data_prefeeding(pkt, para->video_width, para->video_height);
+    if (ret != PLAYER_SUCCESS)
+        return ret;
     if (1) {
         pkt->codec = &para->vcodec;
     } else {
@@ -871,8 +881,7 @@ static int divx3_write_header(am_private_t *para, am_packet_t *pkt)
         return PLAYER_EMPTY_P;
     }
     pkt->newflag = 1;
-    write_av_packet(para, pkt);
-    return PLAYER_SUCCESS;
+    return write_av_packet(para, pkt);
 }
 
 static int h264_add_header(unsigned char *buf, int size, am_packet_t *pkt)
@@ -926,20 +935,11 @@ static int hevc_add_header(unsigned char *buf, int size,  am_packet_t *pkt)
 
 static int hevc_write_header(am_private_t *para, am_packet_t *pkt)
 {
-    int ret = -1;
+    // Annex-B streams can carry VPS/SPS/PPS in their first packet.
+    if (!para->extradata)
+        return PLAYER_SUCCESS;
 
-    if (para->extradata) {
-      ret = hevc_add_header(para->extradata.GetData(), para->extradata.GetSize(), pkt);
-    } else {
-      if (pkt->hdr) {
-          if (pkt->hdr->data) {
-              free(pkt->hdr->data);
-              pkt->hdr->data = NULL;
-          }
-          free(pkt->hdr);
-          pkt->hdr = NULL;
-      }
-    }
+    int ret = hevc_add_header(para->extradata.GetData(), para->extradata.GetSize(), pkt);
 
     if (ret == PLAYER_SUCCESS) {
       pkt->codec = &para->vcodec;
@@ -1536,11 +1536,9 @@ static int wvc1_write_header(am_private_t *para, am_packet_t *pkt)
     size_t wvc1_extra = para->extradata.GetSize();
     if (wvc1_extra < 1) {
         CLog::Log(LOGDEBUG, "[wvc1_write_header] empty extradata!");
-        // Left describing nothing rather than whatever malloc returned: the header
-        // is only freed on the success path, so an error return leaves it live and
-        // write_header decides on this field.
+        // VC-1 elementary streams may carry the sequence header in-band.
         pkt->hdr->size = 0;
-        return PLAYER_EMPTY_P;
+        return PLAYER_SUCCESS;
     }
     wvc1_extra -= 1;
     if (wvc1_extra > HDR_BUF_SIZE)
