--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
@@ -39,6 +39,7 @@ public:
   {
     m_buffer = 0.0;
     m_lastError = 0.0;
+    m_lastValid = false;
     m_count  = 0;
     m_timer.Set(interval);
   }
@@ -54,9 +55,11 @@ public:
   {
     if(m_timer.IsTimePast())
     {
+      const bool sampled = m_count != 0;
       error = Get();
       Flush(interval);
       m_lastError = error;
+      m_lastValid = sampled;
