From: allolive <160342668+allolive@users.noreply.github.com>
Subject: [PATCH] video_sink: reject negative layer/vpp indices in sysfs stores

parse_para() uses kstrtoint(), so twelve /sys/class/video stores in
video.c accept a negative layer index: "parsed[0] < MAX_VD_LAYER" passes
for -1. Writing "-1 5" to force_skip_count writes
force_skip_cnt[0xffffffff]; the pre_[hv]scaler_*, force_pre_scaler,
vd_attch_vpp and vdx test_pattern stores write pre_scaler[-1] or
vd_layer[-1]. vd_attch_vpp also stored parsed[1] into vd_layer[].vpp_index
unbounded, and the vsync path indexes 4-entry tables (rdma_func[],
vsync_cnt[], vpp_hold_line[]) with it, so "0 9" reads out of bounds in
interrupt context.

Add a ">= 0" bound to the twelve checks, matching how these stores already
treat a too-large index, and return -EINVAL for a vpp index outside
[0, VPP_MAX). In-range values, including PRE_VSYNC (3), behave as before.
These are root-only debug nodes; not exercised on hardware.

--- a/drivers/media/video_sink/video.c
+++ b/drivers/media/video_sink/video.c
@@ -10719,7 +10719,7 @@
 	u32 index;
 
 	if (likely(parse_para(buf, 2, parsed) == 2)) {
-		if (parsed[0] < MAX_VD_LAYER) {
+		if (parsed[0] >= 0 && parsed[0] < MAX_VD_LAYER) {
 			index = parsed[0];
 			force_skip_cnt[index] = parsed[1];
 			vd_layer[index].property_changed = true;
@@ -11265,7 +11265,7 @@
 	int layer_id = 0, pre_hscaler_ntap_en = 0;
 
 	if (likely(parse_para(buf, 2, parsed) == 2)) {
-		if (parsed[0] < MAX_VD_LAYER)
+		if (parsed[0] >= 0 && parsed[0] < MAX_VD_LAYER)
 			layer_id = parsed[0];
 		pre_hscaler_ntap_en = parsed[1];
 		if (pre_hscaler_ntap_en !=
@@ -11405,7 +11405,7 @@
 	int layer_id = 0;
 
 	if (likely(parse_para(buf, 2, parsed) == 2)) {
-		if (parsed[0] < MAX_VD_LAYER)
+		if (parsed[0] >= 0 && parsed[0] < MAX_VD_LAYER)
 			layer_id = parsed[0];
 		/* check valid */
 		if (has_pre_hscaler_8tap(layer_id)) {
@@ -11461,7 +11461,7 @@
 	int layer_id = 0, pre_vscaler_ntap_en = 0;
 
 	if (likely(parse_para(buf, 2, parsed) == 2)) {
-		if (parsed[0] < MAX_VD_LAYER)
+		if (parsed[0] >= 0 && parsed[0] < MAX_VD_LAYER)
 			layer_id = parsed[0];
 		pre_vscaler_ntap_en = parsed[1];
 		if (pre_vscaler_ntap_en !=
@@ -11498,7 +11498,7 @@
 	int layer_id = 0;
 
 	if (likely(parse_para(buf, 2, parsed) == 2)) {
-		if (parsed[0] < MAX_VD_LAYER)
+		if (parsed[0] >= 0 && parsed[0] < MAX_VD_LAYER)
 			layer_id = parsed[0];
 		if (has_pre_vscaler_ntap(layer_id)) {
 			/* only support 2,4 tap */
@@ -11539,7 +11539,7 @@
 	/* 0: no scaler;     1: 2 scaler down */
 	/* 2: 4 scaler down; 3: 8 scaler down */
 	if (likely(parse_para(buf, 2, parsed) == 2)) {
-		if (parsed[0] < MAX_VD_LAYER)
+		if (parsed[0] >= 0 && parsed[0] < MAX_VD_LAYER)
 			layer_id = parsed[0];
 		if (parsed[1] > 3) {
 			pr_info("err, max support max is 3(8 scaler down)\n");
@@ -11575,7 +11575,7 @@
 	int layer_id = 0;
 
 	if (likely(parse_para(buf, 2, parsed) == 2)) {
-		if (parsed[0] < MAX_VD_LAYER)
+		if (parsed[0] >= 0 && parsed[0] < MAX_VD_LAYER)
 			layer_id = parsed[0];
 		if (parsed[1] > 3) {
 			pr_info("err, max support max is 3(8 scaler down)\n");
@@ -11622,7 +11622,7 @@
 	int i;
 
 	if (likely(parse_para(buf, 5, parsed) == 5)) {
-		if (parsed[0] < MAX_VD_LAYER)
+		if (parsed[0] >= 0 && parsed[0] < MAX_VD_LAYER)
 			layer_id = parsed[0];
 		for (i = 0; i < 4; i++)
 			pre_scaler[layer_id].pre_hscaler_coef[i] = parsed[i + 1];
@@ -11667,7 +11667,7 @@
 	int i;
 
 	if (likely(parse_para(buf, 5, parsed) == 5)) {
-		if (parsed[0] < MAX_VD_LAYER)
+		if (parsed[0] >= 0 && parsed[0] < MAX_VD_LAYER)
 			layer_id = parsed[0];
 		for (i = 0; i < 4; i++)
 			pre_scaler[layer_id].pre_vscaler_coef[i] = parsed[i + 1];
@@ -11701,7 +11701,7 @@
 	int layer_id = 0;
 
 	if (likely(parse_para(buf, 2, parsed) == 2)) {
-		if (parsed[0] < MAX_VD_LAYER)
+		if (parsed[0] >= 0 && parsed[0] < MAX_VD_LAYER)
 			layer_id = parsed[0];
 		pre_scaler[layer_id].force_pre_scaler = parsed[1];
 		vd_layer[layer_id].property_changed = true;
@@ -11887,7 +11887,9 @@
 	/* parsed[0]: layer_id */
 	/* parsed[1]: vpp index */
 	if (likely(parse_para(buf, 2, parsed) == 2)) {
-		if (parsed[0] < MAX_VD_LAYER)
+		if (parsed[1] < 0 || parsed[1] >= VPP_MAX)
+			return -EINVAL;
+		if (parsed[0] >= 0 && parsed[0] < MAX_VD_LAYER)
 			layer_id = parsed[0];
 		vd_layer[layer_id].vpp_index = parsed[1];
 		if (layer_id >= 1) {
@@ -12564,7 +12566,7 @@
 	u32 index;
 
 	if (likely(parse_para(buf, 3, parsed) == 3)) {
-		if (parsed[0] < MAX_VD_LAYER) {
+		if (parsed[0] >= 0 && parsed[0] < MAX_VD_LAYER) {
 			index = parsed[0];
 			set_vdx_test_pattern(index, parsed[1], parsed[2]);
 		}
