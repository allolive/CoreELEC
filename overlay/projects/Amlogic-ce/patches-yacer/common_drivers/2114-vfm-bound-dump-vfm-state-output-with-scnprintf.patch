From: allolive <160342668+allolive@users.noreply.github.com>
Subject: [PATCH] vfm: bound dump_vfm_state output with scnprintf

dump_vfm_state() built its output with plain sprintf() into a caller
supplied buffer without checking the room left; provider_list() and
receiver_list() did the same. Its live caller is map_show(), which
hands it the one-page sysfs buffer of /sys/class/vfm/map.

vfm_map_add() accepts up to VFM_MAP_COUNT (40) maps of VFM_MAP_SIZE
(10) 31-char names, so about eleven root writes of a maximum-length
map push the listing past 4096 bytes and a later read writes past the
sysfs page.

Pass the size down and use scnprintf(buf + len, size - len, ...):
PAGE_SIZE for a caller-supplied buffer, DUMP_BUFFER_SIZE for the
local_dump_buf path. Output is unchanged for any state that fitted
before. Compile-tested only; not exercised on hardware.

Not fixed here: vfm_map_num_store() still sets vfm_map_num from sysfs
with no bound against VFM_MAP_COUNT.
--- a/drivers/media/common/vfm/vfm.c
+++ b/drivers/media/common/vfm/vfm.c
@@ -477,10 +477,12 @@
 {
 	int i, j;
 	int len = 0;
+	size_t size = PAGE_SIZE;
 	bool print_flag = false;
 
 	if (!buf && local_dump_buf) {
 		buf = local_dump_buf;
+		size = DUMP_BUFFER_SIZE;
 		memset(local_dump_buf, 0, DUMP_BUFFER_SIZE * sizeof(char));
 		print_flag = true;
 	}
@@ -488,24 +490,25 @@
 		return 0;
 	for (i = 0; i < vfm_map_num; i++) {
 		if (vfm_map[i] && vfm_map[i]->valid) {
-			len += sprintf(buf + len, "[%02d]  %s { ",
+			len += scnprintf(buf + len, size - len, "[%02d]  %s { ",
 				i,/*in slot num.*/
 				vfm_map[i]->id);
 			for (j = 0; j < vfm_map[i]->vfm_map_size; j++) {
 				if (j < (vfm_map[i]->vfm_map_size - 1)) {
-					len += sprintf(buf + len, "%s(%d) ",
+					len += scnprintf(buf + len, size - len,
+					   "%s(%d) ",
 					   vfm_map[i]->name[j],
 					   (vfm_map[i]->active >> j) & 0x1);
 				} else {
-					len += sprintf(buf + len, "%s",
-						vfm_map[i]->name[j]);
+					len += scnprintf(buf + len, size - len,
+						"%s", vfm_map[i]->name[j]);
 				}
 			}
-			len += sprintf(buf + len, "}\n");
+			len += scnprintf(buf + len, size - len, "}\n");
 		}
 	}
-	len += provider_list(buf + len);
-	len += receiver_list(buf + len);
+	len += provider_list(buf + len, size - len);
+	len += receiver_list(buf + len, size - len);
 	if (print_flag)
 		pr_info("%s\n", local_dump_buf);
 	return len;
--- a/drivers/media/common/vfm/vfm.h
+++ b/drivers/media/common/vfm/vfm.h
@@ -16,9 +16,9 @@
 
 void vf_update_active_map(void);
 
-int provider_list(char *buf);
+int provider_list(char *buf, size_t size);
 
-int receiver_list(char *buf);
+int receiver_list(char *buf, size_t size);
 
 struct vframe_provider_s *vf_get_provider_by_name(const char *provider_name);
 
--- a/drivers/media/common/vfm/vframe_provider.c
+++ b/drivers/media/common/vfm/vframe_provider.c
@@ -85,18 +85,19 @@
 
 #endif
 
-int provider_list(char *buf)
+int provider_list(char *buf, size_t size)
 {
 	struct vframe_provider_s *p = NULL;
 	int len = 0;
 	int i;
 
-	len += sprintf(buf + len, "\nprovider list:\n");
+	len += scnprintf(buf + len, size - len, "\nprovider list:\n");
 	TABLE_LOCK();
 	for (i = 0; i < MAX_PROVIDER_NUM; i++) {
 		p = provider_table[i].vframe_provider;
 		if (p)
-			len += sprintf(buf + len, "   %s\n", p->name);
+			len += scnprintf(buf + len, size - len, "   %s\n",
+					 p->name);
 	}
 	TABLE_UNLOCK();
 	return len;
--- a/drivers/media/common/vfm/vframe_receiver.c
+++ b/drivers/media/common/vfm/vframe_receiver.c
@@ -20,17 +20,18 @@
 struct vframe_receiver_s *receiver_table[MAX_RECEIVER_NUM];
 static DEFINE_MUTEX(mutex);
 
-int receiver_list(char *buf)
+int receiver_list(char *buf, size_t size)
 {
 	struct vframe_receiver_s *r = NULL;
 	int len = 0;
 	int i = 0;
 
-	len += sprintf(buf + len, "\nreceiver list:\n");
+	len += scnprintf(buf + len, size - len, "\nreceiver list:\n");
 	for (i = 0; i < MAX_RECEIVER_NUM; i++) {
 		r = receiver_table[i];
 		if (r)
-			len += sprintf(buf + len, "   %s\n", r->name);
+			len += scnprintf(buf + len, size - len, "   %s\n",
+					 r->name);
 	}
 
 	return len;
