From: allolive <160342668+allolive@users.noreply.github.com>
Subject: [PATCH] drm/meson: bound the VPU debug parser and overwrite_reg table

The VPU "debug" node exists twice, as the sysfs attribute
/sys/class/drm/card0/vpu/debug (meson_sysfs.c) and as the debugfs file
of the same name (meson_debugfs.c). Both call a local parse_param()
that stores every whitespace-separated token with "parm[n++] = token"
and no upper bound, into a "char *parm[8]": a write of more than eight
tokens stores past the end of a stack array. Both writers then
dereference parm[1]..parm[4] without checking they are present, so an
empty or short write NULL-derefs. The "wv"/"wvb" commands also append
to overwrite_reg[256]/overwrite_val[256] with a bare reg_num++, so the
257th distinct register writes past both arrays, which the commit path
in meson_vpu_pipeline.c then reads back into VPU registers.

Pass the destination size into parse_param(), stop at that many tokens
and return the count; reject a write with no token with -EINVAL;
NULL-check each parm[n] before kstrtoul()/kstrtouint(); refuse a new
table entry with -ENOSPC at ARRAY_SIZE(overwrite_reg). Both nodes are
root-only, so this is a memory-safety fix, not a privilege boundary.
The missing synchronisation between these writers and the commit-path
readers of reg_num/overwrite_reg[] is left alone.

Not exercised on hardware.
--- a/drivers/drm/meson_debugfs.c
+++ b/drivers/drm/meson_debugfs.c
@@ -439,7 +439,7 @@
 	return single_open(file, meson_reg_debug_show, crtc);
 }
 
-static void parse_param(char *buf_orig, char **parm)
+static int parse_param(char *buf_orig, char **parm, unsigned int max)
 {
 	char *ps, *token;
 	unsigned int n = 0;
@@ -454,8 +454,12 @@
 			break;
 		if (*token == '\0')
 			continue;
+		if (n >= max)
+			break;
 		parm[n++] = token;
 	}
+
+	return n;
 }
 
 static ssize_t meson_reg_debug_write(struct file *file, const char __user *ubuf,
@@ -476,19 +480,20 @@
 	buf[len] = '\0';
 
 	bufp = buf;
-	parse_param(bufp, (char **)&parm);
+	if (parse_param(bufp, parm, ARRAY_SIZE(parm)) < 1)
+		return -EINVAL;
 	if (!strcmp(parm[0], "rv")) {
-		if (kstrtoul(parm[1], 16, &val) < 0)
+		if (!parm[1] || kstrtoul(parm[1], 16, &val) < 0)
 			return -EINVAL;
 
 		reg_addr = val;
 		DRM_INFO("reg[0x%04x]=0x%08x\n", reg_addr, meson_drm_read_reg(reg_addr));
 	} else if (!strcmp(parm[0], "wv")) {
-		if (kstrtoul(parm[1], 16, &val) < 0)
+		if (!parm[1] || kstrtoul(parm[1], 16, &val) < 0)
 			return -EINVAL;
 		reg_addr = val;
 
-		if (kstrtoul(parm[2], 16, &val) < 0)
+		if (!parm[2] || kstrtoul(parm[2], 16, &val) < 0)
 			return -EINVAL;
 
 		reg_val = val;
@@ -500,9 +505,11 @@
 		}
 
 		if (i == reg_num) {
+			if (i >= ARRAY_SIZE(overwrite_reg))
+				return -ENOSPC;
 			overwrite_reg[i] = reg_addr;
 			overwrite_val[i] = reg_val;
-			reg_num++;
+			reg_num = i + 1;
 		}
 	} else if (!strcmp(parm[0], "ow")) {
 		if (parm[1] && !strcmp(parm[1], "1"))
--- a/drivers/drm/meson_sysfs.c
+++ b/drivers/drm/meson_sysfs.c
@@ -82,7 +82,7 @@
 	vunmap(addr);
 }
 
-static void parse_param(char *buf_orig, char **parm)
+static int parse_param(char *buf_orig, char **parm, unsigned int max)
 {
 	char *ps, *token;
 	unsigned int n = 0;
@@ -97,8 +97,12 @@
 			break;
 		if (*token == '\0')
 			continue;
+		if (n >= max)
+			break;
 		parm[n++] = token;
 	}
+
+	return n;
 }
 
 static ssize_t debug_show(struct device *dev, struct device_attribute *attr,
@@ -143,19 +147,20 @@
 
