 			return -EINVAL;
 
 		reg_addr = val;
 		DRM_INFO("reg[0x%04x]=0x%08x\n", reg_addr, meson_drm_read_reg(reg_addr));
 	} else if (!strcmp(parm[0], "wv")) {
-		if (kstrtoul(parm[1], 16, &val) < 0)
+		if (!parm[1] || kstrtoul(parm[1], 16, &val) < 0)
 			return -EINVAL;
 		reg_addr = val;
 
-		if (kstrtoul(parm[2], 16, &val) < 0)
+		if (!parm[2] || kstrtoul(parm[2], 16, &val) < 0)
 			return -EINVAL;
 
 		reg_val = val;
@@ -167,9 +172,11 @@
 		}
 
