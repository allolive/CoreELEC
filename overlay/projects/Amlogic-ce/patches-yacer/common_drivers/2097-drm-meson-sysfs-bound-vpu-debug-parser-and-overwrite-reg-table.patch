 			return -EINVAL;
-		if (kstrtouint(parm[4], 10, &len) < 0)
+		if (!parm[4] || kstrtouint(parm[4], 10, &len) < 0)
 			return -EINVAL;
 
 		read_val = meson_drm_read_reg(reg_addr);
@@ -206,9 +213,11 @@
 		}
 
 		if (i == reg_num) {
+			if (i >= ARRAY_SIZE(overwrite_reg))
+				return -ENOSPC;
 			overwrite_reg[i] = reg_addr;
 			overwrite_val[i] = reg_val;
-			reg_num++;
+			reg_num = i + 1;
 		}
