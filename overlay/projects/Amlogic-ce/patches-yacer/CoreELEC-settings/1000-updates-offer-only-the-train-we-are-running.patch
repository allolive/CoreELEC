--- a/src/resources/lib/modules/updates.py	2026-08-05 12:29:46.000000000 -0400
+++ b/src/resources/lib/modules/updates.py	2026-09-11 18:24:19.626607877 -0400
@@ -11,6 +11,7 @@
 import json
 import xbmc
 import xbmcgui
+import socket
 import tarfile
 import oeWindows
 import threading
@@ -27,6 +28,8 @@
     KERNEL_CMD = None
     UPDATE_REQUEST_URL = None
     UPDATE_DOWNLOAD_URL = None
+    YACER_UPDATE_URL = 'https://github.com/allolive/CoreELEC/releases/download/yacer-feed/releases.json'
+    YACER_AUTOUPDATE_URL = 'https://github.com/allolive/CoreELEC/releases/download/yacer-feed/update.json'
     LOCAL_UPDATE_DIR = None
     menu = {'2': {
         'name': 32005,
@@ -337,6 +340,14 @@
             self.update_json = self.build_json()
 
             self.struct['update']['settings']['Channel']['values'] = self.get_channels()
+            # A channel saved before the box changed train is no longer on offer,
+            # so move off it - in memory only. An empty list means the feeds did
+            # not answer, which is not the same as the channel being retired, and
+            # writing either case back to disk would destroy a choice we cannot
+            # tell apart from a failed lookup.
+            values = self.struct['update']['settings']['Channel']['values'] or []
+            if values and self.struct['update']['settings']['Channel']['value'] not in values:
+                self.struct['update']['settings']['Channel']['value'] = values[0]
             self.struct['update']['settings']['Build']['values'] = self.get_available_builds()
 
             # RPi4 EEPROM updating
@@ -429,6 +440,19 @@
         elif (a_builder > b_builder):
           return +1
 
+    def is_current_train(self, channel):
+        # channels are named <builder>-<train>; anything named otherwise is a
+        # feed we cannot reason about, so it is left in the list
+        items = channel.rsplit('-', 1)
+        if len(items) != 2:
+            return True
+        # get_os_release leaves VERSION_ID empty when /etc/os-release is short of
+        # it, and an exception here would take the whole channel list down
+        try:
+            return int(items[1]) == int(self.oe.VERSION_ID.split('.')[0])
+        except ValueError:
+            return True
+
     def get_channels(self):
         try:
             self.oe.dbg_log('updates::get_channels', 'enter_function', self.oe.LOGDEBUG)
@@ -436,7 +460,8 @@
             self.oe.dbg_log('updates::get_channels', str(self.update_json), self.oe.LOGDEBUG)
             if not self.update_json is None:
                 for channel in self.update_json:
-                    channels.append(channel)
+                    if self.is_current_train(channel):
+                        channels.append(channel)
             self.oe.dbg_log('updates::get_channels', 'exit_function', self.oe.LOGDEBUG)
             return sorted(list(set(channels)), key=cmp_to_key(self.custom_sort_train))
         except Exception as e:
@@ -497,6 +522,23 @@
         try:
             self.oe.dbg_log('updates::build_json', 'enter_function', self.oe.LOGDEBUG)
             update_json = self.get_json()
+            if update_json is None:
+                update_json = {}
+            # our own builds are always offered, so they need none of the three
+            # custom slots and survive the user clearing them
+            # load_url calls urlopen with no timeout, and this runs from
+            # start_service() before the settings socket is bound: a host that
+            # accepts the connection and then goes quiet would hang the whole
+            # settings service for good.
+            timeout = socket.getdefaulttimeout()
+            socket.setdefaulttimeout(10)
+            try:
+                yacer_json = self.get_json(self.YACER_UPDATE_URL)
+            finally:
+                socket.setdefaulttimeout(timeout)
+            if not yacer_json is None:
+                for channel in yacer_json:
+                    update_json[channel] = yacer_json[channel]
             if self.struct['update']['settings']['ShowCustomChannels']['value'] == '1':
                 custom_urls = []
                 for i in 1,2,3:
@@ -552,6 +594,34 @@
             self.oe.dbg_log('updates::get_available_builds', 'ERROR: (' + repr(e) + ')')
 
     def fetch_update_json(self):
+        # The automatic check never looked at the chosen channel: it asks
+        # update.coreelec.org what is newest, which does not know our builds and
+        # would answer with an official one - quietly moving the box off this
+        # tree. Ask our own feed instead; it publishes the shape check_updates_v2
+        # already expects.
+        #
+        # That feed is a static file, so it names the newest build whether or not
+        # the box is running it. check_updates_v2 does no version comparison of
+        # its own - upstream relies on the server staying quiet when there is
+        # nothing to do - so the comparison has to happen here, or the box would
+        # download and reinstall the build it is already running, for ever.
+        try:
+            timeout = socket.getdefaulttimeout()
+            socket.setdefaulttimeout(10)
+            try:
+                data = self.oe.load_url(self.YACER_AUTOUPDATE_URL)
+            finally:
+                socket.setdefaulttimeout(timeout)
+            if not data:
+                return ''
+            if self.oe.VERSION in json.loads(data)['data'].get('update', ''):
+                return ''
+            return data
+        except Exception as e:
+            self.oe.dbg_log('updates::fetch_update_json', 'ERROR: (' + repr(e) + ')')
+            return ''
+
+    def fetch_update_json_upstream(self):
         try:
             self.oe.dbg_log('updates::fetch_update_json', 'enter_function', 0)
 
