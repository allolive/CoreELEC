From: allolive <160342668+allolive@users.noreply.github.com>
Subject: [PATCH] AMLAudioTrim: ignore LatencyTick updates after Release

Fixes found by the S905X5/CoreELEC driver review:

- F115 xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp:2989: A LatencyTick still running while CloseDecoder releases the trim re-writes a non-zero mpll0 trim afterwards

See the review diary (S905X5-DRIVER-REVIEW-DIARY.md) for the defect
analysis and the forum discussion.

final judge sign-off did not run, so this patch still needs a human
read before it is proposed upstream. Not yet exercised on S905X5 hardware.

--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLAudioTrim.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLAudioTrim.cpp
@@ -282,7 +282,11 @@
 void CAMLAudioTrim::Release()
 {
   std::lock_guard<std::mutex> lock(m_mutex);
+  ReleaseLocked();
+}
 
+void CAMLAudioTrim::ReleaseLocked()
+{
   ForgetLocked();
 
   if (m_everWrote && m_applied != 0)
@@ -302,6 +306,26 @@
   m_lastDither = 0.0;
 }
 
+unsigned int CAMLAudioTrim::Open()
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  m_closed = false;
+
+  // Never zero, which is what a decoder that never opened hands back.
+  if (++m_generation == 0)
+    ++m_generation;
+  return m_generation;
+}
+
+void CAMLAudioTrim::Close(unsigned int generation)
+{
+  // Under the one lock, so no tick can land between the release and the latch.
+  std::lock_guard<std::mutex> lock(m_mutex);
+  ReleaseLocked();
+  if (generation != 0 && generation == m_generation)
+    m_closed = true;
+}
+
 double CAMLAudioTrim::Aim() const
 {
   if (!m_haveSlew || !m_haveLead || std::abs(m_lead) < OFFSET_DEADBAND)
@@ -478,6 +502,10 @@
 {
   std::lock_guard<std::mutex> lock(m_mutex);
 
+  // A straggling tick from a closed decoder: it must not put a level back.
+  if (m_closed)
+    return;
+
   m_haveLead = lead.has_value();
   if (lead)
     m_lead = *lead;
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLAudioTrim.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLAudioTrim.h
@@ -62,6 +62,18 @@
   //! the level must not outlive the playback that asked for it.
   void Release();
 
+  //! \brief Take updates. For a decoder opening.
+  //! \return what that decoder hands back to Close()
+  unsigned int Open();
+
+  //! \brief Release, and ignore every Update() until the next Open(). For the
+  //! decoder closing: a frame it left queued can still be ticked by the renderer
+  //! after the release, and would otherwise put back a level nothing takes off.
+  //! \param generation what Open() returned to this decoder. Only the latest
+  //! opener shuts updates off - a successor may already have opened, and a
+  //! predecessor closing late must not silence it for the whole title.
+  void Close(unsigned int generation);
+
   //! \brief Forget the measurement but keep the level. For a seek or a pause -
   //! they move the error by hand, and an interval spanning that is not a rate,
   //! but the rate the silicon runs at has not changed and the correction for it
@@ -88,6 +100,7 @@
 
   std::optional<double> ReadSlew() const;
   void ForgetLocked();
+  void ReleaseLocked();
   std::optional<int> ReadLevel() const;
   bool WriteLevel(int level);
   void Settle(double drift);
@@ -120,8 +133,10 @@
   double m_driftAtZero{0.0};  //!< the rate before the level moved, to judge that
   bool m_haveDriftAtZero{false};  //!< decisions spent at the limit with no answer
   bool m_stopped{false};
+  bool m_closed{false};       //!< between Close() and Open(): no decoder to serve
+  unsigned int m_generation{0}; //!< bumped by every Open()
 
-  mutable std::mutex m_mutex; //!< Release() comes from the player thread
+  mutable std::mutex m_mutex; //!< Open/Close/Release come from the player thread
 
   double m_lastDither{0.0};   //!< when the level was last put out
 
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
@@ -2401,6 +2401,7 @@
 
   CSysfsPath("/sys/class/video/freerun_mode", 1);
 
+  m_trimGeneration = CAMLAudioTrim::GetInstance().Open();
   m_opened = true;
 
   // vcodec is open, update speed if it was
@@ -2546,6 +2547,11 @@
   // next may not use this renderer at all.
   CAMLLatency::GetInstance().Forget();
 
+  // LatencyTick's m_opened check is not atomic with the trim update after it:
+  // latch the trim so a tick already past the check cannot put a level back.
+  CAMLAudioTrim::GetInstance().Close(m_trimGeneration);
+  m_trimGeneration = 0;
+
   am_packet_release(&am_private->am_pkt);
   am_private->extradata = {};
   free(am_private->hdr_buf.data);
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.h
@@ -110,6 +110,7 @@
   //! Whether the audio was a bitstream last frame, so the trim is given back
   //! once on the way out rather than on every frame after it.
   bool             m_trimWasPassthrough{false};
+  unsigned int     m_trimGeneration{0}; //!< from CAMLAudioTrim::Open(), 0 = not opened
   double           m_lastAudioOffset{0.0};
   bool             m_offsetStoodDown{false};
   //! Whether this took the system default vfm chain away, so the close puts back
