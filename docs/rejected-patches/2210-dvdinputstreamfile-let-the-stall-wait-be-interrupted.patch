 using namespace XFILE;
 
@@ -29,13 +30,27 @@
 void CInputStreamMultiSource::Abort()
 {
   m_aborted = true;
+  std::unique_lock lock(m_InputStreamsSection);
   for (const auto& iter : m_InputStreams)
     iter->Abort();
 }
 
+void CInputStreamMultiSource::Interrupt()
+{
+  m_interrupted = true;
+  std::unique_lock lock(m_InputStreamsSection);
+  for (const auto& iter : m_InputStreams)
+    iter->Interrupt();
+}
+
 void CInputStreamMultiSource::Close()
 {
-  m_InputStreams.clear();
+  std::vector<InputStreamPtr> streams;
+  {
+    std::unique_lock lock(m_InputStreamsSection);
+    streams.swap(m_InputStreams);
+  }
+  streams.clear();
   CDVDInputStream::Close();
 }
 
@@ -120,8 +135,11 @@
       CLog::Log(LOGERROR, "CDVDPlayer::OpenInputStream - error opening file [{}]", m_filenames[i]);
       continue;
     }
+    std::unique_lock lock(m_InputStreamsSection);
     if (m_aborted)
       inputstream->Abort();
+    if (m_interrupted)
+      inputstream->Interrupt();
     m_InputStreams.push_back(inputstream);
   }
   return !m_InputStreams.empty();
