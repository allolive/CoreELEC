From: allolive <160342668+allolive@users.noreply.github.com>
Subject: [PATCH] DVDInputStreamFile: let the stall wait be interrupted

Fixes found by the S905X5/CoreELEC driver review:

- F129 xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.cpp:104: 0017: the stall wait on the player thread only ends on Abort, so opening another file, playlist next and seeks are silently queued until the share comes back

See the review diary (S905X5-DRIVER-REVIEW-DIARY.md) for the defect
analysis and the forum discussion.

final judge sign-off did not run, so this patch still needs a human
read before it is proposed upstream. Not yet exercised on S905X5 hardware.

--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DemuxMultiSource.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DemuxMultiSource.cpp
@@ -15,6 +15,8 @@
 #include "cores/VideoPlayer/Interface/TimingConstants.h"
 #include "utils/log.h"
 
+#include <mutex>
+
 
 CDemuxMultiSource::CDemuxMultiSource() = default;
 
@@ -130,6 +132,9 @@
     DemuxPtr demuxer = DemuxPtr(CDVDFactoryDemuxer::CreateDemuxer((*iter)));
     if (!demuxer)
     {
+      // Dropped outside the lock: closing a file input can take a while.
+      InputStreamPtr dropped = *iter;
+      std::unique_lock lock(m_pInput->m_InputStreamsSection);
       iter = m_pInput->m_InputStreams.erase(iter);
     }
     else
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -186,7 +186,8 @@
   int len = pInputStream->Read(buf, size);
   if (len == 0)
     return AVERROR_EOF;
-  // Stopped while the input waited out a stall: unwind as an abort, not a read error.
+  // Stopped or interrupted while the input waited out a stall: unwind as an abort, not a
+  // read error.
   if (len == -EAGAIN)
   {
     const auto& fileInput = static_cast<CDVDDemuxFFmpeg*>(h)->m_fileInput;
@@ -1134,7 +1135,13 @@
         m_timeout.SetInfinite();
       }
 
-      if (m_pkt.result == AVERROR(EINTR) || m_pkt.result == AVERROR(EAGAIN))
+      if (m_pkt.result < 0 && m_fileInput && m_fileInput->Interrupted())
+      {
+        // The player is moving on to another item: give it control back, not an end of file.
+        // The queued item replaces this demuxer and its input, so neither is read again.
+        bReturnEmpty = true;
+      }
+      else if (m_pkt.result == AVERROR(EINTR) || m_pkt.result == AVERROR(EAGAIN))
       {
         // timeout, probably no real error, return empty packet
         bReturnEmpty = true;
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.cpp
@@ -97,11 +97,12 @@
 
   ssize_t ret = m_pFile->Read(buf, buf_size);
 
-  // Playback waits for a stalled source until stopped: a demuxer that meets the stall
-  // mid-element takes it for the end of the file.
-  if (ret == -EAGAIN && m_waitsForUser)
+  // Playback waits for a stalled source until stopped or moved on to another item: a
+  // demuxer that meets the stall mid-element takes it for the end of the file. Once
+  // aborted, a stall is handed straight back, and dvd_file_read turns it into AVERROR_EXIT.
+  if (ret == -EAGAIN && m_waitsForUser && !Aborted())
   {
-    while (ret == -EAGAIN && !m_aborted)
+    while (ret == -EAGAIN && !Aborted())
       ret = m_pFile->Read(buf, buf_size);
     m_stallCount++;
   }
