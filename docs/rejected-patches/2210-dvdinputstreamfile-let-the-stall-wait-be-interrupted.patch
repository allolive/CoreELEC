-    m_messenger.Put(std::make_shared<CDVDMsgOpenFile>(params), 1);
+
+    // The player thread may be waiting on a stalled source and only reads messages
+    // between reads. The lock keeps the input from being replaced between the Put and the
+    // Interrupt, so the interrupted input is always one this message replaces.
+    std::unique_lock lock(m_inputStreamSection);
+    if (!MSGQ_IS_ERROR(m_messenger.Put(std::make_shared<CDVDMsgOpenFile>(params), 1)) &&
+        m_pInputStream)
+      m_pInputStream->Interrupt();
 
