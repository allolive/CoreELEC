From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: allolive <160342668+allolive@users.noreply.github.com>
Date: Sat, 24 Oct 2026 16:00:00 -0400
Subject: [PATCH] ALSA: aloop: a playback that leads

With pcm_notify, a playback that prepares a new format becomes the cable's
format and stops the capture, which can reopen in it. The playback's hw
params are still refined against the cable's previous format though, so a
capture left open holds the playback to it: Kodi, reopening for a 5.1 film
or a TrueHD passthrough while binaural still captured its stereo menu
sound, was refused or downmixed to two channels.

playback_free leaves the playback's format unrefined; the capture follows.
It also lets a player list every rate and channel count while a capture is
open.

Signed-off-by: allolive <160342668+allolive@users.noreply.github.com>
---
 sound/drivers/aloop.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/sound/drivers/aloop.c b/sound/drivers/aloop.c
--- a/sound/drivers/aloop.c
+++ b/sound/drivers/aloop.c
@@ -43,6 +43,7 @@
 static int pcm_notify[SNDRV_CARDS];
 static char *timer_source[SNDRV_CARDS];
 static char *card_name[SNDRV_CARDS];
+static bool playback_free[SNDRV_CARDS];
 
 module_param_array(index, int, NULL, 0444);
 MODULE_PARM_DESC(index, "Index value for loopback soundcard.");
@@ -58,6 +59,8 @@
 MODULE_PARM_DESC(timer_source, "Sound card name or number and device/subdevice number of timer to be used. Empty string for jiffies timer [default].");
 module_param_array_named(name, card_name, charp, NULL, 0444);
 MODULE_PARM_DESC(name, "Name the loopback soundcard shows to players [Loopback].");
+module_param_array(playback_free, bool, NULL, 0444);
+MODULE_PARM_DESC(playback_free, "With pcm_notify, playback opens in any format and capture follows it.");
 
 #define NO_PITCH 100000
 
@@ -136,6 +139,7 @@
 	struct snd_pcm *pcm[2];
 	struct loopback_setup setup[MAX_PCM_SUBSTREAMS][2];
 	const char *timer_source;
+	bool playback_free;
 };
 
 struct loopback_pcm {
@@ -1227,6 +1231,11 @@
 
 	snd_pcm_hw_constraint_integer(runtime, SNDRV_PCM_HW_PARAM_PERIODS);
 
+	/* a free playback leads: an open capture follows it rather than holding it */
+	if (get_notify(dpcm) && loopback->playback_free &&
+	    substream->stream == SNDRV_PCM_STREAM_PLAYBACK)
+		goto rules_done;
+
 	/* use dynamic rules based on actual runtime->hw values */
 	/* note that the default rules created in the PCM midlevel code */
 	/* are cached -> they do not reflect the actual state */
@@ -1262,6 +1271,7 @@
 			goto unlock;
 	}
 
+ rules_done:
 	/* loopback_runtime_free() has not to be called if kfree(dpcm) was
 	 * already called here. Otherwise it will end up with a double free.
 	 */
@@ -1728,6 +1738,7 @@
 		pcm_substreams[dev] = MAX_PCM_SUBSTREAMS;
 	
 	loopback->card = card;
+	loopback->playback_free = playback_free[dev];
 	loopback_set_timer_source(loopback, timer_source[dev]);
 
 	mutex_init(&loopback->cable_lock);
