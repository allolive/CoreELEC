   //! \brief Whether the trimmed clock also paces PCM output, not only a bitstream.
   static bool ReachesPcm();
 
+  //! \brief Whether the device the stream plays on is the AML card's: another
+  //! card (a loopback, a USB DAC) keeps its own time, whatever mpll0 does.
+  static bool ReachesSink(bool passthrough);
+
   //! \brief Called once per presented frame. Paces itself.
   //! \param error audio ahead of the master clock in DVD time units, or nullopt
   //! when nothing measured it this frame. Must be the unscaled figure: this is a
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
@@ -3577,7 +3577,13 @@
   // Given back once on the way out rather than on every frame after it: the
   // release is what clears a stand-down, and repeating it would erase the loop's
   // memory of having given up as fast as it formed.
-  const bool trimmed = m_processInfo.GetAudioPassthrough() || CAMLAudioTrim::ReachesPcm();
+  //
+  // Nor on another card's device: its clock is its own, so the loop would read
+  // that card's drift, move mpll0 under whatever else plays from it, and keep
