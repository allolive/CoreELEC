@@ -10,6 +10,7 @@
 
 #include "AMLFrameMetadata.h"
 #include "AMLHdr10PlusHook.h"
+#include "AMLInbandDovi.h"
 #include "AMLSeekPreroll.h"
 #include "AMLMvcSubtitleDepth.h"
 #include "DVDVideoCodec.h"
@@ -85,6 +86,7 @@ public:
   // Required overrides
   virtual bool Open(CDVDStreamInfo &hints, CDVDCodecOptions &options) override;
   virtual bool AddData(const DemuxPacket &packet) override;
+  void OpenAsInbandDovi();
   virtual void Reset() override;
   virtual VCReturn GetPicture(VideoPicture* pVideoPicture) override;
   virtual void SetSpeed(int iSpeed) override;
@@ -134,6 +136,8 @@ private:
 
   uint32_t m_metadataToken{0};
   bool m_stripHdr10Plus{false};
+  bool m_doviStripped{false};
+  AMLInbandDovi m_inbandDovi;
   bool m_dualLayer{false};
   int m_nalLengthSize{0};
   //! the packet fed next is the one that just reset the decoder
