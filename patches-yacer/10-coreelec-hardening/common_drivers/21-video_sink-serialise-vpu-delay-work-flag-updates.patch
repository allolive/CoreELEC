 {
 	unsigned long flags;
 	unsigned int r;
+	int events;
 	enum vframe_signal_fmt_e fmt = VFRAME_SIGNAL_FMT_INVALID;
 
-	if (vpu_delay_work_flag & VPU_PRIMARY_FMT_CHANGED) {
-		vpu_delay_work_flag &= ~VPU_PRIMARY_FMT_CHANGED;
+	/*
+	 * Take and clear the event bits under the lock: the vsync path
+	 * updates other bits of vpu_delay_work_flag concurrently, and an
+	 * unlocked read-modify-write here could restore a memory power-off
+	 * bit that VDx_MEM_POWER_ON() has just cleared.
+	 */
+	spin_lock_irqsave(&delay_work_lock, flags);
+	events = vpu_delay_work_flag &
+		 (VPU_PRIMARY_FMT_CHANGED |
+		  VPU_DELAYWORK_APO_FLAG_DOLBY |
+		  VPU_VIDEO_LAYER1_CHANGED |
+		  VPU_VIDEO_LAYER2_CHANGED |
+		  VPU_VIDEO_LAYER3_CHANGED);
+	vpu_delay_work_flag &= ~events;
+	spin_unlock_irqrestore(&delay_work_lock, flags);
+
+	if (events & VPU_PRIMARY_FMT_CHANGED) {
 		fmt = (enum vframe_signal_fmt_e)atomic_read(&cur_primary_src_fmt);
 		video_send_uevent(VIDEO_FMT_EVENT, fmt);
 	}
 
 #ifdef CONFIG_AMLOGIC_MEDIA_ENHANCEMENT_DOLBYVISION
-		if (vpu_delay_work_flag & VPU_DELAYWORK_APO_FLAG_DOLBY) {
-			vpu_delay_work_flag &= ~VPU_DELAYWORK_APO_FLAG_DOLBY;
+		if (events & VPU_DELAYWORK_APO_FLAG_DOLBY) {
 			set_amdv_apo_enable(false);
 			amdv_send_uevent(AMDV_CONT_EVENT, &apo_value);
 		}
 #endif
 
-	if (vpu_delay_work_flag & VPU_VIDEO_LAYER1_CHANGED)
