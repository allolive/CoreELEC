 	if (get_amdv_apo_enable())
-		vpu_delay_work_flag |= VPU_DELAYWORK_APO_FLAG_DOLBY;
+		VPU_DELAY_WORK_FLAG_SET(VPU_DELAYWORK_APO_FLAG_DOLBY);
 }
 #endif
 
