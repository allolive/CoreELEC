From: allolive <160342668+allolive@users.noreply.github.com>
Subject: [PATCH] ASoC: auge: tdm: fix chmap control lifetime and put handler

"Playback Channel Map" was created in DAI prepare and removed from
trigger on every STOP/SUSPEND/PAUSE_PUSH, without card->controls_rwsem,
so a concurrent control ioctl can be inside the get handler while the
element is freed. The control also outlives a substream opened and
closed without starting, and the put handler dereferenced
substream->runtime unchecked; there "matches" was set only inside the
loop, so a channel count other than 2/4/6/8 read an uninitialised slot
and matched_layout, which feeds the HDMI InfoFrame channel_allocation
field, could be garbage. Prepare also leaked one aml_chmap per cycle.

Create the control once per PCM, publish handlers, WRITE access and
private_data under controls_rwsem, and chain private_free so the
aml_chmap dies with the control; trigger only resets chmap_layout.
The put handler rejects a missing substream/runtime, snapshots
runtime->channels and derives the match from the loop index. The control
now stays present after the first playback. Not exercised on hardware.
--- a/sound/soc/amlogic/auge/tdm.c
+++ b/sound/soc/amlogic/auge/tdm.c
@@ -1900,7 +1900,7 @@
 	for (layout = 0; layout < ARRAY_SIZE(channel_allocations); layout++)
 	{
 		ch = &channel_allocations[layout];
-		if (prtd->chmap_layout == ch->chmap_layout)
+		if (READ_ONCE(prtd->chmap_layout) == ch->chmap_layout)
 			break;
 		ch = NULL;
 	}
@@ -1922,8 +1922,18 @@
 	unsigned int idx = snd_ctl_get_ioffidx(kcontrol, &ucontrol->id);
 	struct snd_pcm_substream *substream = snd_pcm_chmap_substream(info, idx);
 	struct aml_chmap *prtd = info->private_data;
-	struct snd_pcm_runtime *runtime = substream->runtime;
-	int res = 0, channel, layout, matches, matched_layout;
+	struct snd_pcm_runtime *runtime;
+	unsigned int channels;
+	int res, channel, layout, matched_layout = 0;
+
+	if (!substream || !prtd)
+		return -ENODEV;
+
+	/* the control outlives the stream: no runtime once the PCM is closed */
+	runtime = substream->runtime;
+	if (!runtime)
+		return -EBADFD;
+	channels = runtime->channels;
 
 	if (mutex_lock_interruptible(&prtd->chmap_lock))
 		return -EINTR;
@@ -1933,38 +1943,43 @@
 	{
 		struct channel_speaker_allocation *ch = &channel_allocations[layout];
 
-		if (substream->runtime->channels != ch->channels)
+		if (channels != ch->channels)
 			continue;
 
-		matches = 1;
-		for (channel = 0; channel < substream->runtime->channels; channel++)
+		for (channel = 0; channel < channels; channel++)
 		{
-			if (ucontrol->value.integer.value[channel] != ch->speakers[substream->runtime->channels - channel - 1])
-			{
-				matches = 0;
+			if (ucontrol->value.integer.value[channel] != ch->speakers[channels - channel - 1])
 				break;
-			}
 		}
 
-		if (matches)
-		{
+		if (channel == channels) {
 			matched_layout = ch->chmap_layout;
 			break;
 		}
 	}
 
-	// default to first layout if we didnt find any
-	if (!matches)
-		matched_layout = 0;
+	// matched_layout stays at the first layout if we didnt find any
+	pr_info("Setting a %d channel layout matching layout #%d\n", channels, matched_layout);
 
-	pr_info("Setting a %d channel layout matching layout #%d\n", runtime->channels, matched_layout);
-
-	prtd->chmap_layout = matched_layout;
+	res = READ_ONCE(prtd->chmap_layout) != matched_layout;
+	WRITE_ONCE(prtd->chmap_layout, matched_layout);
 
 	mutex_unlock(&prtd->chmap_lock);
 	return res;
 }
 
+static void aml_dai_tdm_chmap_ctl_private_free(struct snd_kcontrol *kcontrol)
+{
+	struct snd_pcm_chmap *info = snd_kcontrol_chip(kcontrol);
+	struct aml_chmap *prtd = info->private_data;
+	void (*private_free)(struct snd_kcontrol *kcontrol) = prtd->private_free;
+
+	info->private_data = NULL;
+	kfree(prtd);
+	/* core pcm_chmap_ctl_private_free: clears chmap_kctl, frees info */
+	private_free(kcontrol);
+}
+
 static struct snd_kcontrol *aml_dai_tdm_chmap_kctrl_get(struct snd_pcm_substream *substream)
 {
 	int str;
@@ -1981,6 +1996,21 @@
 	return NULL;
 }
 
+static void aml_dai_tdm_chmap_reset(struct snd_pcm_substream *substream)
+{
+	struct snd_kcontrol *kctl = aml_dai_tdm_chmap_kctrl_get(substream);
+	struct snd_pcm_chmap *info;
+	struct aml_chmap *prtd;
+
+	if (!kctl)
+		return;
+
+	info = snd_kcontrol_chip(kctl);
+	prtd = info->private_data;
+	if (prtd)
+		WRITE_ONCE(prtd->chmap_layout, 0);
+}
+
 static int aml_dai_tdm_prepare(struct snd_pcm_substream *substream,
 			       struct snd_soc_dai *cpu_dai)
 {
@@ -2048,7 +2078,8 @@
 				if ((info = snd_kcontrol_chip(kctl)) != NULL)
 				{
 					prtd = info->private_data;
-					aud_param.chmap_layout = prtd->chmap_layout;
+					if (prtd)
+						aud_param.chmap_layout = READ_ONCE(prtd->chmap_layout);
 				}
 			}
 
@@ -2105,17 +2136,34 @@
 			tdmout_get_frddr_type(bit_depth));
 		aml_frddr_select_dst(fr, dst);
 		// Alsa Channel Mapping API handling
+		// created once per PCM, freed with the PCM (free_chmap)
 		if (!aml_dai_tdm_chmap_kctrl_get(substream))
 		{
+			struct snd_card *card = substream->pcm->card;
+
+			prtd = kzalloc(sizeof(*prtd), GFP_KERNEL);
+			if (!prtd) {
+				ret = -ENOMEM;
+				goto out;
+			}
+			mutex_init(&prtd->chmap_lock);
+
 			ret = snd_pcm_add_chmap_ctls(substream->pcm, SNDRV_PCM_STREAM_PLAYBACK, NULL, 8, 0, &chmap);
 
 			if (ret < 0)
 			{
+				kfree(prtd);
 				pr_err("aml_dai_tdm_startup error %d\n", ret);
 				goto out;
 			}
 
+			/*
+			 * The control is already visible to userspace: switch it
+			 * to our handlers under the write lock so no ioctl sees
+			 * a half set up control.
+			 */
 			kctl = chmap->kctl;
+			down_write(&card->controls_rwsem);
 			for (i = 0; i < kctl->count; i++)
 				kctl->vd[i].access |= SNDRV_CTL_ELEM_ACCESS_WRITE;
 
@@ -2123,13 +2171,10 @@
 			kctl->put = aml_dai_tdm_chmap_ctl_put;
 			kctl->tlv.c = aml_dai_tdm_chmap_ctl_tlv;
 
-			info = snd_kcontrol_chip(kctl);
-			prtd = info->private_data;
-			if (prtd == NULL) {
-				prtd = (struct aml_chmap*)kzalloc(sizeof(struct aml_chmap), GFP_KERNEL);
-				info->private_data = prtd;
-			}
-			mutex_init(&prtd->chmap_lock);
+			chmap->private_data = prtd;
+			prtd->private_free = kctl->private_free;
+			kctl->private_free = aml_dai_tdm_chmap_ctl_private_free;
+			up_write(&card->controls_rwsem);
 		}
 	out:
 		return ret;
@@ -2315,10 +2360,7 @@
 
 			aml_frddr_enable(p_tdm->fddr, false);
 
-			for (i = 0; i < 2; i++) {
-				if (substream->pcm->card && substream->pcm->streams[i].chmap_kctl)
-					snd_ctl_remove(substream->pcm->card, substream->pcm->streams[i].chmap_kctl);
-			}
+			aml_dai_tdm_chmap_reset(substream);
 		} else {
 			bool toddr_stopped = false;
 
--- a/sound/soc/amlogic/auge/tdm_hw.h
+++ b/sound/soc/amlogic/auge/tdm_hw.h
@@ -70,9 +70,12 @@
 	bool tdmin_lb_after_gain;
 };
 
+struct snd_kcontrol;
+
 struct aml_chmap {
 	struct mutex chmap_lock;
 	int chmap_layout;
+	void (*private_free)(struct snd_kcontrol *kcontrol);
 };
 
 void aml_tdm_enable(struct aml_audio_controller *actrl,
