 		sizes.fb_height = var->yres_virtual;
 		sizes.fb_width = var->xres_virtual;
 		sizes.surface_width = sizes.fb_width;
@@ -427,39 +529,60 @@
 		mode_cmd.width = sizes.surface_width;
 		mode_cmd.height = sizes.surface_height;
 		mode_cmd.pixel_format = drm_mode_legacy_fb_format(sizes.surface_bpp, depth);
-		mode_cmd.pitches[0] = ALIGN(mode_cmd.width * bytes_per_pixel, 64);
 		MESON_DRM_FBDEV("DRM Pixel Format: %c%c%c%c\n",
 				(mode_cmd.pixel_format & 0xFF),
 				((mode_cmd.pixel_format >> 8) & 0xFF),
 				((mode_cmd.pixel_format >> 16) & 0xFF),
 				((mode_cmd.pixel_format >> 24) & 0xFF));
 
+		format = drm_get_format_info(dev, &mode_cmd);
+		if (!format)
+			return -EINVAL;
+
+		/* fix.smem_len is u32, so the buffer size must fit in it */
+		pitch = ALIGN((u64)sizes.fb_width * bytes_per_pixel, 64);
+		if (pitch > U32_MAX ||
+		    check_mul_overflow(pitch, (u64)sizes.fb_height, &screen_size) ||
+		    screen_size > U32_MAX) {
+			MESON_DRM_FBDEV("%s virtual size %ux%u too large\n",
+					__func__, sizes.fb_width, sizes.fb_height);
+			return -EINVAL;
+		}
+
+		/*
+		 * Allocate the new buffer before touching the old one or the fb
+		 * geometry, so a failed realloc leaves the fbdev usable.
+		 */
+		if (!fb_gem || fb_gem->size < screen_size) {
+			if (fb_gem)
+				MESON_DRM_FBDEV("GEM SIZE is not enough, re-allocate.\n");
+			if (am_meson_fbdev_create_gem(dev, screen_size,
+						      &new_gem, &vaddr)) {
+				DRM_ERROR("%s realloc fb fail\n", __func__);
+				return -ENOMEM;
+			}
+			mutex_lock(&info->mm_lock);
+			am_meson_fbdev_swap_gem(info, new_gem, vaddr,
+						&old_gem, &old_vaddr);
+			mutex_unlock(&info->mm_lock);
+			if (old_gem)
+				am_meson_fbdev_release_gem(old_gem, old_vaddr);
+			MESON_DRM_FBDEV("%s reallocate success.\n", __func__);
+		}
+
+		fbdev->vscreen_info_changed = true;
 		fb->width = sizes.fb_width;
 		fb->height = sizes.fb_height;
-		fb->pitches[0] =  ALIGN(fb->width * bytes_per_pixel, 64);
-		fb->format = drm_get_format_info(dev, &mode_cmd);
+		fb->pitches[0] = pitch;
+		fb->format = format;
 
-		info->screen_size = fb->pitches[0] * fb->height;
+		info->screen_size = screen_size;
 		//info->fix.smem_len = info->screen_size;
 
 		drm_fb_helper_fill_info(info, fb_helper, &sizes);
