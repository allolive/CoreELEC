 	int npages;
 
-	if (!fbdev->fb_gem) {
-		meson_gem = am_meson_gem_object_create(dev, 0, size);
-		if (IS_ERR(meson_gem)) {
-			DRM_ERROR("alloc memory %d fail\n", (u32)size);
+	meson_gem = am_meson_gem_object_create(dev, 0, size);
+	if (IS_ERR(meson_gem)) {
+		DRM_ERROR("alloc memory %d fail\n", (u32)size);
+		return -ENOMEM;
+	}
+
+	if (meson_gem->is_dma) {
+		npages = PAGE_ALIGN(meson_gem->base.size) / PAGE_SIZE;
+		pages = vmalloc(array_size(npages, sizeof(struct page *)));
+		tmp = pages;
+
+		if (!pages) {
+			drm_gem_object_put(&meson_gem->base);
 			return -ENOMEM;
 		}
-		fbdev->fb_gem = &meson_gem->base;
-		fb = helper->fb;
-		meson_fb = container_of(fb, struct am_meson_fb, base);
-		if (!meson_fb) {
-			DRM_INFO("meson_fb is NULL!\n");
-			return -EINVAL;
+
+		pgprot = pgprot_writecombine(PAGE_KERNEL);
+
+		for_each_sgtable_page(meson_gem->sg, &piter, 0) {
+			WARN_ON(tmp - pages >= npages);
+			*tmp++ = sg_page_iter_page(&piter);
 		}
-		meson_fb->bufp[0] = meson_gem;
-		if (meson_gem->is_dma) {
-			npages = PAGE_ALIGN(meson_gem->base.size) / PAGE_SIZE;
-			pages = vmalloc(array_size(npages, sizeof(struct page *)));
-			tmp = pages;
 
-			if (!pages)
-				return -ENOMEM;
+		vaddr = vmap(pages, npages, VM_MAP, pgprot);
+		vfree(pages);
+		if (!vaddr) {
+			drm_gem_object_put(&meson_gem->base);
+			return -ENOMEM;
+		}
+	} else {
+		vaddr = ion_heap_map_kernel(meson_gem->ionbuffer->heap,
+					    meson_gem->ionbuffer);
+		if (IS_ERR(vaddr)) {
+			struct dma_buf *dmabuf = meson_gem->dmabuf;
+
+			/* the ion free path does not drop the dma_buf */
+			drm_gem_object_put(&meson_gem->base);
+			dma_buf_put(dmabuf);
+			return PTR_ERR(vaddr);
+		}
+	}
 
-			pgprot = pgprot_writecombine(PAGE_KERNEL);
+	*gem_out = meson_gem;
+	*vaddr_out = vaddr;
+	return 0;
+}
 
-			for_each_sgtable_page(meson_gem->sg, &piter, 0) {
-				WARN_ON(tmp - pages >= npages);
-				*tmp++ = sg_page_iter_page(&piter);
-			}
+static void am_meson_fbdev_release_gem(struct am_meson_gem_object *meson_gem,
+				       void *vaddr)
+{
+	/*
+	 * vaddr is our own vmap() in both cases; for ion,
+	 * ion_heap_unmap_kernel() would unmap buffer->vaddr instead.
+	 */
+	vunmap(vaddr);
+	if (!meson_gem->is_dma) {
+		/* the ion free path does not drop the dma_buf */
+		dma_buf_put(meson_gem->dmabuf);
+	}
+	drm_gem_object_put(&meson_gem->base);
+}
 
-			vaddr = vmap(pages, npages, VM_MAP, pgprot);
-			vfree(pages);
-		} else {
-			vaddr = ion_heap_map_kernel(meson_gem->ionbuffer->heap,
