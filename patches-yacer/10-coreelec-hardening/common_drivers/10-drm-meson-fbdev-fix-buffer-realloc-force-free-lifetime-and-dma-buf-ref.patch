+/*
+ * Install a new buffer, called with info->mm_lock held. The old buffer, if
+ * any, is returned through old_gem/old_vaddr and must be released by the
+ * caller after dropping the lock.
+ */
+static void am_meson_fbdev_swap_gem(struct fb_info *info,
+				    struct am_meson_gem_object *meson_gem,
+				    void *vaddr,
+				    struct am_meson_gem_object **old_gem,
+				    void **old_vaddr)
+{
+	struct drm_fb_helper *helper = info->par;
+	struct meson_drm_fbdev *fbdev = container_of(helper, struct meson_drm_fbdev, base);
+	struct am_meson_fb *meson_fb;
+
+	*old_gem = NULL;
+	*old_vaddr = NULL;
+	if (fbdev->fb_gem) {
+		*old_gem = container_of(fbdev->fb_gem,
+					struct am_meson_gem_object, base);
+		*old_vaddr = info->screen_base;
+	}
+
+	fbdev->fb_gem = meson_gem ? &meson_gem->base : NULL;
+	info->screen_base = (char __iomem *)vaddr;
+	if (meson_gem)
 		info->fix.smem_start = meson_gem->addr;
 
+	if (helper->fb) {
+		meson_fb = container_of(helper->fb, struct am_meson_fb, base);
+		meson_fb->bufp[0] = meson_gem;
+	} else {
+		DRM_ERROR("drm framebuffer is NULL!\n");
+	}
+}
+
+static int am_meson_fbdev_alloc_fb_gem(struct fb_info *info)
+{
+	struct drm_fb_helper *helper = info->par;
+	struct meson_drm_fbdev *fbdev = container_of(helper, struct meson_drm_fbdev, base);
+	struct am_meson_gem_object *meson_gem, *old_gem;
+	size_t size = info->screen_size;
+	void *vaddr, *old_vaddr;
+	int ret;
+
+	if (!fbdev->fb_gem) {
+		ret = am_meson_fbdev_create_gem(helper->dev, size,
+						&meson_gem, &vaddr);
+		if (ret)
+			return ret;
+
+		mutex_lock(&info->mm_lock);
+		if (fbdev->fb_gem) {
+			/* a concurrent set_par installed one meanwhile */
+			mutex_unlock(&info->mm_lock);
+			am_meson_fbdev_release_gem(meson_gem, vaddr);
+			return 0;
+		}
+		am_meson_fbdev_swap_gem(info, meson_gem, vaddr,
+					&old_gem, &old_vaddr);
+		mutex_unlock(&info->mm_lock);
+
 		MESON_DRM_FBDEV("alloc memory %d done\n", (u32)size);
 	} else {
-		struct drm_gem_object *gem_obj = fbdev->fb_gem;
-		meson_gem = container_of(gem_obj, struct am_meson_gem_object, base);
-		get_dma_buf(meson_gem->dmabuf);
+		/*
+		 * The buffer is kept across opens and only released by
+		 * force_free_mem or a realloc, so no reference is taken here.
+		 */
 		MESON_DRM_FBDEV("no need repeate alloc memory %d\n", (u32)size);
 	}
 	return 0;
@@ -97,43 +190,20 @@
 
 static void am_meson_fbdev_free_fb_gem(struct fb_info *info)
 {
-	struct drm_fb_helper *helper = info->par;
-	struct meson_drm_fbdev *fbdev;
-	struct drm_framebuffer *fb;
-	struct am_meson_fb *meson_fb;
+	struct am_meson_gem_object *old_gem;
+	void *old_vaddr;
 
-	if (!helper) {
+	if (!info->par) {
 		DRM_ERROR("fb helper is NULL!\n");
 		return;
 	}
 
-	fbdev = container_of(helper, struct meson_drm_fbdev, base);
-	if (fbdev && fbdev->fb_gem) {
-		struct drm_gem_object *gem_obj = fbdev->fb_gem;
-		struct am_meson_gem_object *meson_gem = container_of(gem_obj,
-					struct am_meson_gem_object, base);
-
-		dma_buf_put(meson_gem->dmabuf);
-		if (!meson_gem->is_dma)
-			ion_heap_unmap_kernel(meson_gem->ionbuffer->heap,
-					meson_gem->ionbuffer);
-
-		info->screen_base = NULL;
-
-		meson_gem_object_free(fbdev->fb_gem);
-		fbdev->fb_gem = NULL;
-
-		fb = helper->fb;
-		if (fb) {
-			meson_fb = container_of(fb, struct am_meson_fb, base);
-			if (meson_fb)
-				meson_fb->bufp[0] = NULL;
-			else
-				DRM_ERROR("meson_fb is NULL!\n");
-		} else {
-			DRM_ERROR("drm framebuffer is NULL!\n");
-		}
+	mutex_lock(&info->mm_lock);
+	am_meson_fbdev_swap_gem(info, NULL, NULL, &old_gem, &old_vaddr);
+	mutex_unlock(&info->mm_lock);
 
+	if (old_gem) {
+		am_meson_fbdev_release_gem(old_gem, old_vaddr);
 		MESON_DRM_FBDEV("free memory done\n");
 	} else {
 		MESON_DRM_FBDEV("memory already free before\n");
@@ -164,11 +234,25 @@
 	struct drm_fb_helper *helper = info->par;
 	struct meson_drm_fbdev *fbdev = container_of(helper, struct meson_drm_fbdev, base);
 	struct am_meson_gem_object *meson_gem;
+	int ret;
+
+	if (!fbdev->fb_gem)
+		return -ENODEV;
 
 	meson_gem = container_of(fbdev->fb_gem,
 				 struct am_meson_gem_object, base);
 
-	return meson_gem_prime_mmap(fbdev->fb_gem, vma);
+	ret = meson_gem_prime_mmap(fbdev->fb_gem, vma);
+	if (ret)
+		return ret;
+
+	/*
+	 * The pages are mapped without taking page references. Let the
+	 * mapping hold the dma_buf file so a realloc or force_free_mem cannot
+	 * release the buffer while it is still mapped.
+	 */
+	vma_set_file(vma, meson_gem->dmabuf->file);
+	return 0;
 }
 
 static int am_meson_drm_fbdev_sync(struct fb_info *info)
@@ -249,11 +333,25 @@
 
 	/*amlogic fbdev ioctl, used by gpu fbdev backend.*/
 	if (cmd == FBIOGET_OSD_DMABUF) {
+		struct dma_buf *dmabuf;
+
 		meson_fb = container_of(helper->fb, struct am_meson_fb, base);
-		fbdma.fd = dma_buf_fd(meson_fb->bufp[0]->dmabuf, O_CLOEXEC);
+		/* serialise against a realloc on the console_lock-only paths */
+		mutex_lock(&info->mm_lock);
+		if (!meson_fb->bufp[0]) {
+			mutex_unlock(&info->mm_lock);
+			return -ENODEV;
+		}
+		dmabuf = meson_fb->bufp[0]->dmabuf;
+		get_dma_buf(dmabuf);
+		mutex_unlock(&info->mm_lock);
+		fbdma.fd = dma_buf_fd(dmabuf, O_CLOEXEC);
+		if (fbdma.fd < 0) {
+			dma_buf_put(dmabuf);
+			return fbdma.fd;
+		}
 		fbdma.flags = O_CLOEXEC;
 		ret = copy_to_user(argp, &fbdma, sizeof(fbdma)) ? -EFAULT : 0;
-		get_dma_buf(meson_fb->bufp[0]->dmabuf);
 	} else if (cmd == FBIO_WAITFORVSYNC) {
 		if (plane->crtc) {
 			drm_wait_one_vblank(helper->dev, plane->crtc->index);
@@ -385,7 +484,11 @@
 	struct drm_fb_helper_surface_size sizes;
 	struct drm_device *dev = fb_helper->dev;
 	struct drm_mode_fb_cmd2 mode_cmd = { 0 };
+	const struct drm_format_info *format;
+	struct am_meson_gem_object *new_gem, *old_gem;
 	unsigned int bytes_per_pixel;
+	u64 pitch, screen_size;
+	void *vaddr, *old_vaddr;
 	u32 xres_set = var->xres;
 	u32 yres_set = var->yres;
 	int depth;
@@ -402,8 +505,7 @@
 	if (var->bits_per_pixel != fb->format->depth ||
 		var->xres_virtual != fb->width ||
 		var->yres_virtual != fb->height) {
-		fbdev->vscreen_info_changed = true;
-		/*realloc framebuffer, free old then alloc new gem*/
