-				return -ENOMEM;
-			}
-			MESON_DRM_FBDEV("%s reallocate success.\n", __func__);
-		}
 	}
 	DRM_INFO("fb_set_par: %s OUT\n", __func__);
 
@@ -798,7 +921,11 @@
 	struct fb_info *fb_info = dev_get_drvdata(device);
 
 	if (strncmp("1", buf, 1) == 0) {
