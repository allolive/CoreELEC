+#include <algorithm>
+#include <array>
+#include <iterator>
+
+namespace
+{
+constexpr const char* RegionValue = "bdregion";
+constexpr std::array Regions{CBlurayRegion::AUTOMATIC, CBlurayRegion::A, CBlurayRegion::B,
+                             CBlurayRegion::C};
+constexpr std::array Letters{"", "A", "B", "C"};
+} // unnamed namespace
+
+std::string CBlurayRegion::Disc(const std::string& path)
+{
+  std::string disc{URIUtils::IsBlurayPath(path) ? URIUtils::GetDiscFile(path) : path};
+  if (const CURL url(disc); url.IsProtocol("udf"))
+    disc = url.GetHostName();
+  if (URIUtils::IsDiscImage(disc))
+    return disc;
+  // a folder's index.bdmv or playlist, or the folder itself
+  if (URIUtils::HasExtension(disc, ".bdmv|.mpls"))
+    disc = URIUtils::GetDirectory(disc);
+  URIUtils::RemoveSlashAtEnd(disc);
+  while (StringUtils::EqualsNoCase(URIUtils::GetFileName(disc), "PLAYLIST") ||
+         StringUtils::EqualsNoCase(URIUtils::GetFileName(disc), "BDMV"))
+  {
+    disc = URIUtils::GetDirectory(disc);
+    URIUtils::RemoveSlashAtEnd(disc);
+  }
+  return disc;
+}
+
+int CBlurayRegion::Chosen(const std::string& disc)
+{
+  const std::string letter = CFilmFile::Get(disc)[RegionValue].asString();
+  const auto it = std::ranges::find_if(Letters, [&letter](const char* l)
+                                       { return !letter.empty() && letter == l; });
+  return it != Letters.end() ? Regions[std::distance(Letters.begin(), it)] : AUTOMATIC;
+}
+
+std::string CBlurayRegion::Name(int region)
+{
+  const auto& strings = CServiceBroker::GetResourcesComponent().GetLocalizeStrings();
+  switch (region)
+  {
+    case A:
+      return strings.Get(14122);
+    case B:
+      return strings.Get(14123);
+    case C:
+      return strings.Get(14124);
+    default:
+      return strings.Get(60141);
+  }
+}
+
+bool CBlurayRegion::Pick(const std::string& disc)
+{
+  auto* dialog = CServiceBroker::GetGUI()->GetWindowManager().GetWindow<CGUIDialogSelect>(
+      WINDOW_DIALOG_SELECT);
+  if (!dialog)
+    return false;
+  dialog->Reset();
+  dialog->SetHeading(CVariant{60142});
+  for (const int region : Regions)
+    dialog->Add(Name(region));
+  const int chosen = Chosen(disc);
+  dialog->SetSelected(static_cast<int>(std::distance(
+      Regions.begin(), std::ranges::find(Regions, chosen))));
+  dialog->Open();
+  const int selected = dialog->GetSelectedItem();
+  if (selected < 0 || selected >= static_cast<int>(Regions.size()))
+    return false;
+  CFilmFile::Set(disc, RegionValue,
+                 selected == 0 ? CVariant() : CVariant(Letters[selected]));
+  return true;
+}
