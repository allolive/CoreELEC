+bool CVideoBlurayRegion::IsVisible(const CFileItem& itemIn) const
+{
+  const CFileItem item(itemIn.GetItemToPlay());
+  if (item.IsFolder())
+    return false;
+  const std::string& path = item.GetDynPath();
+  return URIUtils::IsBlurayPath(path) || VIDEO::IsBDFile(item) || URIUtils::IsDiscImage(path);
+}
+
+bool CVideoBlurayRegion::Execute(const std::shared_ptr<CFileItem>& item) const
+{
+  CBlurayRegion::Pick(CBlurayRegion::Disc(item->GetItemToPlay().GetDynPath()));
+  return true;
+}
