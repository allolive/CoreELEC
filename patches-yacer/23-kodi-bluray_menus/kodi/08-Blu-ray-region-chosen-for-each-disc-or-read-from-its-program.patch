+namespace
+{
+/*!
+ * \brief The region a disc's HDMV program locks it to: the one it tests the player's region
+ * (PSR 20) is not, and leaves for another title, object or playlist when it is not, as A 1, B 2 or
+ * C 4. 0 when it has no such test, tests several regions so, or cannot be read: a test followed by
+ * anything else may as well pick a warning or a trailer as refuse the disc.
+ * A command is 12 bytes: the operand count, group and sub-group, the immediate flags, the branch,
+ * compare or set operation, then destination and source. A register is a PSR when its top bit is
+ * set. A compare that fails skips the command after it.
+ */
+int DiscRegion(BLURAY* bd)
+{
+  void* data{nullptr};
+  int64_t size{0};
+  if (!bd_read_file(bd, "BDMV/MovieObject.bdmv", &data, &size))
+    return 0;
+  const std::unique_ptr<uint8_t, decltype(&free)> owned(static_cast<uint8_t*>(data), &free);
+  const uint8_t* mobj = owned.get();
+  const auto be16 = [mobj](int64_t at) { return (mobj[at] << 8) | mobj[at + 1]; };
+  const auto be32 = [mobj](int64_t at)
+  {
+    return (static_cast<uint32_t>(mobj[at]) << 24) | (mobj[at + 1] << 16) | (mobj[at + 2] << 8) |
+           mobj[at + 3];
+  };
+  if (size < 50 || std::memcmp(mobj, "MOBJ", 4) != 0)
+    return 0;
+
+  constexpr uint32_t PSR = 0x80000000;
+  constexpr uint32_t PSR_REGION = PSR | 20;
+  constexpr int SET_MOVE = 1;
+  constexpr int SET_SWAP = 2;
+  constexpr int SET_AND = 9;
+  constexpr int COMPARE_NE = 3;
+  int locked{0};
+  int64_t at{50};
+  for (int object = be16(48); object > 0; --object)
+  {
+    if (at + 4 > size)
+      break;
+    const int commands = be16(at + 2);
+    at += 4;
+    if (at + 12 * commands > size)
+      break;
+    // the general purpose registers given the region, or the region masked
+    std::vector<uint32_t> region;
+    const auto holdsRegion = [&region](uint32_t reg, bool immediate)
+    {
+      return !immediate &&
+             (reg == PSR_REGION || (!(reg & PSR) && std::ranges::count(region, reg & 0xfff)));
+    };
+    for (int command = 0; command < commands; ++command, at += 12)
+    {
+      const int group = (mobj[at] >> 3) & 3;
+      const int subGroup = mobj[at] & 7;
+      const bool dstImmediate = mobj[at + 1] >> 7;
+      const bool srcImmediate = (mobj[at + 1] >> 6) & 1;
+      const int compare = mobj[at + 2] & 15;
+      const int set = mobj[at + 3] & 31;
+      const uint32_t dst = be32(at + 4);
+      const uint32_t src = be32(at + 8);
+      if (group == 2 && subGroup == 0 && !dstImmediate && !(dst & PSR))
+      {
+        // a register moved the region holds it, and keeps it masked; any other write ends it
+        const bool masked = set == SET_AND && holdsRegion(dst, false) && srcImmediate;
+        std::erase(region, dst & 0xfff);
+        if ((set == SET_MOVE && holdsRegion(src, srcImmediate)) || masked)
+          region.push_back(dst & 0xfff);
+        // a swap writes its source too
+        if (set == SET_SWAP && !srcImmediate && !(src & PSR))
+          std::erase(region, src & 0xfff);
+      }
+      else if (group == 1 && compare == COMPARE_NE && command + 1 < commands)
+      {
+        uint32_t value{0};
+        if (holdsRegion(dst, dstImmediate) && srcImmediate)
+          value = src;
+        else if (holdsRegion(src, srcImmediate) && dstImmediate)
+          value = dst;
+        // when the region is not that one: a jump or call (sub-group 1), or a playlist (2)
+        const int next = mobj[at + 12];
+        const int nextGroup = (next >> 3) & 3;
+        const int nextSubGroup = next & 7;
+        const bool leaves = nextGroup == 0 && (nextSubGroup == 1 || nextSubGroup == 2);
+        if ((value == 1 || value == 2 || value == 4) && leaves)
+        {
+          if (locked != 0 && locked != static_cast<int>(value))
+            return 0;
+          locked = static_cast<int>(value);
+        }
+      }
+    }
+  }
+  return locked;
+}
+} // unnamed namespace
+
+void CDVDInputStreamBluray::SetupRegion()
+{
+  const std::string disc = CBlurayRegion::Disc(m_root);
+  int region = CBlurayRegion::Chosen(disc);
+  std::string_view why{"chosen for the disc"};
+  if (region == CBlurayRegion::AUTOMATIC)
+  {
+    region = CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+        CSettings::SETTING_BLURAY_PLAYERREGION);
+    why = "the player's";
+    if (const int locked = DiscRegion(m_bd); locked != 0 && locked != region)
+    {
+      region = locked;
+      why = "the disc's program refuses any other";
+    }
+  }
+  if (region != CBlurayRegion::A && region != CBlurayRegion::B && region != CBlurayRegion::C)
+    return; // SetupPlayerSettings has set A
+  bd_set_player_setting(m_bd, BLURAY_PLAYER_SETTING_REGION_CODE, static_cast<uint32_t>(region));
+  CLog::Log(LOGINFO, "CDVDInputStreamBluray::Open - plays as {}: {}", CBlurayRegion::Name(region),
+            why);
+}
