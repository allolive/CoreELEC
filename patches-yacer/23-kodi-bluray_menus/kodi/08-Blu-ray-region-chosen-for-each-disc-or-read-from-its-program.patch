+#pragma once
+
+#include <string>
+
+/*!
+ * \brief The region a Blu-ray plays as when one is chosen for it, kept with the film's other values
+ * in the profile's film file (CFilmFile) under the disc's own image or folder, whichever path
+ * plays it.
+ */
+class CBlurayRegion
+{
+public:
+  //! as libbluray and the bluray.playerregion setting have them; AUTOMATIC is none chosen
+  static constexpr int AUTOMATIC = 0;
+  static constexpr int A = 1;
+  static constexpr int B = 2;
+  static constexpr int C = 4;
+
+  //! the disc a path plays from: its image, or the folder holding its BDMV
+  static std::string Disc(const std::string& path);
+  //! the region chosen for the disc, AUTOMATIC unless one was
+  static int Chosen(const std::string& disc);
+  //! "Automatic", "Region A"...
+  static std::string Name(int region);
+  //! asks which region the disc plays as and keeps the answer; false when cancelled
+  static bool Pick(const std::string& disc);
+};
