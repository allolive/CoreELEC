From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: allolive <160342668+allolive@users.noreply.github.com>
Date: Wed, 16 Sep 2026 13:19:02 -0400
Subject: [PATCH] AMLCodec: retire the timing callbacks with the decoder

The renderer ticks the latency and genlock loops from a queued frame, which
holds the codec past CloseDecoder. A tick could pass the m_opened check and
publish after Forget had run, carrying one decoder's measurements into the
next. Take a mutex around the retirement and both callbacks, after the poll
device is released so the presenter's step never waits on it.

Signed-off-by: allolive <160342668+allolive@users.noreply.github.com>

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
index 47eec82cca..0b7932833f 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
@@ -2654,7 +2654,13 @@ bool CAMLCodec::OpenDecoder(CDVDStreamInfo &hints, bool doviIsFEL)
 
   CSysfsPath("/sys/class/video/freerun_mode", 1);
 
-  m_opened = true;
+  {
+    std::lock_guard<std::mutex> lock(m_timingMutex);
+    // A CAMLCodec can be reopened directly and the trim flag belongs to the
+    // renderer callbacks: clear it while they still observe it as closed.
+    m_trimWasPassthrough = false;
+    m_opened.store(true, std::memory_order_release);
+  }
 
   // vcodec is open, update speed if it was
   // changed before VideoPlayer called OpenDecoder.
@@ -2790,13 +2796,16 @@ void CAMLCodec::CloseDecoder()
     m_dll->codec_close(&am_private->vcodec);
   }
   dumpfile_close(am_private);
-  m_opened = false;
   m_trimWasPassthrough = false;
 
-  // After m_opened, so a frame still queued in the renderer cannot tick this
-  // back to life: the measured path belongs to this decoder, and whatever plays
-  // next may not use this renderer at all.
-  CAMLLatency::GetInstance().Forget();
+  // A frame still queued in the renderer holds this codec and can tick it: take
+  // the retirement and the Forget together, so a tick either runs wholly before
+  // this or observes the closed state and publishes nothing.
+  {
+    std::lock_guard<std::mutex> lock(m_timingMutex);
+    m_opened.store(false, std::memory_order_release);
+    CAMLLatency::GetInstance().Forget();
+  }
 
   am_packet_release(&am_private->am_pkt);
   am_private->extradata = {};
@@ -3310,9 +3319,13 @@ bool CAMLCodec::WaitPresentStep(uint64_t& seen, int fenceFd)
 
 void CAMLCodec::LatencyTick(uint64_t omxPts)
 {
-  CDVDClock* clock = m_hints.pClock;
+  std::lock_guard<std::mutex> lock(m_timingMutex);
 
-  if (!m_opened || !clock || omxPts == DVD_NOPTS_VALUE)
+  if (!m_opened.load(std::memory_order_acquire) || omxPts == DVD_NOPTS_VALUE)
+    return;
+
+  CDVDClock* clock = m_hints.pClock;
+  if (!clock)
     return;
 
   // Trick play and a slewed clock have no steady relationship to measure
@@ -3435,8 +3448,13 @@ void CAMLCodec::LatencyTick(uint64_t omxPts)
 
 void CAMLCodec::GenlockTick(uint64_t omxPts)
 {
+  std::lock_guard<std::mutex> lock(m_timingMutex);
+
+  if (!m_opened.load(std::memory_order_acquire) || omxPts == DVD_NOPTS_VALUE)
+    return;
+
   CDVDClock* clock = m_hints.pClock;
-  if (!m_opened || !clock || omxPts == DVD_NOPTS_VALUE)
+  if (!clock)
     return;
 
   // Trick play and live streams have the player driving the clock, so there is
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.h
index 6993f098fd..ad377b0d4a 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.h
@@ -179,6 +179,8 @@ private:
 
   PosixFilePtr     m_amlVideoFile;
   std::mutex       m_amlVideoFileMutex;
+  //! Serialises the renderer's timing callbacks against decoder close.
+  std::mutex       m_timingMutex;
   std::string      m_defaultVfmMap;
 
   static std::atomic_flag  m_pollSync;
