+std::optional<DolbyVisionLegacyPair> LegacyDoviLayers(const AVFormatContext* context)
+{
+  if (!context || !context->iformat || !context->iformat->name ||
+      std::string_view(context->iformat->name).find("matroska") == std::string_view::npos ||
+      !aml_dolby_vision_enabled())
+    return std::nullopt;
