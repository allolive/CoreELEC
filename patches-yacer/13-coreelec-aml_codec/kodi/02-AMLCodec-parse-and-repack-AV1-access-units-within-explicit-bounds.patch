     }
 
-    const uint32_t total = obu_size + 4;
+    const uint32_t total = static_cast<uint32_t>(obu_size + 4);
     header[0] = (total >> 24) & 0xff;
     header[1] = (total >> 16) & 0xff;
     header[2] = (total >> 8) & 0xff;
@@ -1315,10 +1318,19 @@ int av1_parser_frame(
