+                                      bytes_read + payload_size, &header_size, is_annexb);
+        if (written == 0) {
+            return -1;
+        }
+        *frame_len += written;
 
         data += bytes_read;
-        *frame_len += 20 + bytes_read + payload_size;
 
         switch (obu_header.type) {
         case OBU_TEMPORAL_DELIMITER:
@@ -1415,7 +1434,11 @@ int av1_parser_frame(
                 seen_frame_header = 0;
             break;
         case OBU_METADATA:
-            aom_uleb_decode(data, 8, &type, &bytes_read);
+        {
+            if (aom_uleb_decode(data, payload_size, &type, &bytes_read) != 0 ||
+                bytes_read > payload_size) {
+                return -1;
+            }
             if (type < 6)
                 meta_type = static_cast<OBU_METADATA_TYPE>(type);
             else
@@ -1425,7 +1448,10 @@ int av1_parser_frame(
                       type < 6 ? meta_type_name[type] : "RESERVED", bytes_read,
                       payload_size - bytes_read);
 
+            const size_t metadata_size = payload_size - bytes_read;
             if (meta_type == OBU_METADATA_TYPE_ITUT_T35) {
+                if (metadata_size < 7)
+                    break;
                 if ((p[0] == 0xb5) /* country code */
                     && ((p[1] == 0x00) && (p[2] == 0x3b)) /* terminal_provider_code */
                     && ((p[3] == 0x00) && (p[4] == 0x00) && (p[5] == 0x08) && (p[6] == 0x00))) { /* terminal_provider_oriented_code */
@@ -1434,20 +1460,27 @@ int av1_parser_frame(
                     if (dovi_zero_level5) {
                       std::vector<uint8_t> obu;
                       if (av1_dovi_zero_level5_obu(obu_src, data, bytes_read, payload_size, obu)) {
-                          const size_t old_len = (data - obu_src) + payload_size;
-                          CLog::Log(LOGDEBUG, "\t\tdolbyvison rpu level 5 zeroed ({:d} -> {:d})",
-                                    old_len, obu.size());
-                          *frame_len -= header_size + old_len;
-                          dst_data = obu_dst + av1_write_obu_with_header(obu_dst, obu.data(), obu.size(), &header_size, is_annexb);
-                          *frame_len += header_size + obu.size();
+                          // written over the original, which stays if the rewrite does not fit
+                          const size_t rewritten = av1_write_obu_with_header(
+                              dst_data + obu_start, dst_capacity - obu_start, obu.data(),
+                              obu.size(), &header_size, is_annexb);
+                          if (rewritten != 0) {
+                              CLog::Log(LOGDEBUG, "\t\tdolbyvison rpu level 5 zeroed ({:d} -> {:d})",
+                                        (data - obu_src) + payload_size, obu.size());
+                              *frame_len = obu_start + rewritten;
+                          }
                       }
                     }
 #endif
-                    if (meta_buf != NULL) {
+                    if (meta_buf != NULL && meta_len != NULL) {
+                      if (metadata_size < 12 || meta_capacity < 5)
+                          return -1;
                       meta_buf[0] = meta_buf[1] = meta_buf[2] = 0;
                       meta_buf[3] = 0x01;    meta_buf[4] = 0x19;
 
                       if (p[11] & 0x10) {
+                          if (metadata_size < 13)
+                              return -1;
                           rpu_size = 0x100;
                           rpu_size |= (p[11] & 0x0f) << 4;
                           rpu_size |= (p[12] >> 4) & 0x0f;
@@ -1455,6 +1488,8 @@ int av1_parser_frame(
                               CLog::Log(LOGDEBUG, "\tmeta rpu in obu exceed 512 bytes");
                               break;
                           }
+                          if (rpu_size > metadata_size - 13 || rpu_size > meta_capacity - 5)
+                              return -1;
                           for (i = 0; i < rpu_size; i++) {
                               meta_buf[5 + i] = (p[12 + i] & 0x07) << 5;
                               meta_buf[5 + i] |= (p[13 + i] >> 3) & 0x1f;
@@ -1464,6 +1499,8 @@ int av1_parser_frame(
                       else {
                           rpu_size = (p[10] & 0x1f) << 3;
                           rpu_size |= (p[11] >> 5) & 0x07;
+                          if (rpu_size > metadata_size - 12 || rpu_size > meta_capacity - 5)
+                              return -1;
                           for (i = 0; i < rpu_size; i++) {
                               meta_buf[5 + i] = (p[11 + i] & 0x0f) << 4;
                               meta_buf[5 + i] |= (p[12 + i] >> 4) & 0x0f;
@@ -1475,11 +1512,15 @@ int av1_parser_frame(
                 }
             }
             else if (meta_type == OBU_METADATA_TYPE_HDR_CLL) {
