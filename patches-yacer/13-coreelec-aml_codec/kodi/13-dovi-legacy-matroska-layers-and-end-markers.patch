+std::optional<DolbyVisionLegacyPair> LegacyDoviLayers(const AVFormatContext* context)
+{
+  if (!context || !context->iformat || !context->iformat->name ||
+      std::string_view(context->iformat->name).find("matroska") == std::string_view::npos ||
+      !aml_dolby_vision_enabled())
+    return std::nullopt;
+  std::vector<DolbyVisionLegacyTrack> tracks;
+  tracks.reserve(context->nb_streams);
+  for (unsigned int i = 0; i < context->nb_streams; ++i)
+  {
+    const auto* stream = context->streams[i];
+    const auto* source = av_dict_get(stream->metadata, "SOURCE_ID", nullptr, 0);
+    if (!source)
+      source = av_dict_get(stream->metadata, "SOURCE_ID-eng", nullptr, 0);
+    const auto* codec = stream->codecpar;
+    tracks.push_back({codec->codec_type == AVMEDIA_TYPE_VIDEO && codec->codec_id == AV_CODEC_ID_HEVC,
+                      source && source->value ? source->value : "", codec->width, codec->height});
+  }
+  const auto layers = DolbyVisionLegacyLayers(tracks);
+  if (layers)
+  {
+    const auto* el = context->streams[layers->enhancement]->codecpar;
+    if (av_packet_side_data_get(el->coded_side_data, el->nb_coded_side_data,
+                               AV_PKT_DATA_DOVI_CONF))
+      return std::nullopt;
+  }
+  return layers;
+}
