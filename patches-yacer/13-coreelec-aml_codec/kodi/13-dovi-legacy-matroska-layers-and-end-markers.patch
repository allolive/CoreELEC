diff --git a/xbmc/utils/DolbyVisionLegacy.h b/xbmc/utils/DolbyVisionLegacy.h
new file mode 100644
index 0000000..455d625
--- /dev/null
+++ b/xbmc/utils/DolbyVisionLegacy.h
@@ -0,0 +1,70 @@
+/*
+ *  Copyright (C) 2026 Team CoreELEC
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#pragma once
+
+#include <optional>
+#include <string_view>
+#include <vector>
+
+struct DolbyVisionLegacyTrack
+{
+  bool hevc;
+  std::string_view sourceId;
+  int width;
+  int height;
+};
+
+struct DolbyVisionLegacyPair
+{
+  size_t base;
+  size_t enhancement;
+
+  // Neither member may be reassigned after AddStream promotes the BL to DV.
+  // Unrelated tracks retain the normal container-signalled pairing rules.
+  bool AllowsPairing(size_t first, size_t second) const
+  {
+    if (first == base || second == enhancement)
+      return first == base && second == enhancement;
+    if (first == enhancement || second == base)
+      return first == enhancement && second == base;
+    return true;
+  }
+};
+
+// Older mkvmerge versions retain Blu-ray PIDs in SOURCE_ID but do not write a
+// Dolby Vision configuration record. Accept only a unique tagged UHD BL/EL pair;
+// two video tracks, a title containing "DV", or a 1080p track alone prove nothing.
+inline std::optional<DolbyVisionLegacyPair> DolbyVisionLegacyLayers(
+    const std::vector<DolbyVisionLegacyTrack>& tracks)
+{
+  std::optional<size_t> base;
+  std::optional<size_t> enhancement;
+  for (size_t i = 0; i < tracks.size(); ++i)
+  {
+    const auto& track = tracks[i];
+    if (!track.hevc)
+      continue;
+    if (track.sourceId == "001015")
+    {
+      if (enhancement)
+        return std::nullopt;
+      enhancement = i;
+    }
+    if (track.sourceId == "001011")
+    {
+      if (base || track.width != 3840 || track.height != 2160)
+        return std::nullopt;
+      base = i;
+    }
+  }
+  if (!base || !enhancement)
+    return std::nullopt;
+  const auto& el = tracks[*enhancement];
+  if (!((el.width == 1920 && el.height == 1080) ||
+        (el.width == 3840 && el.height == 2160)))
+    return std::nullopt;
+  return DolbyVisionLegacyPair{*base, *enhancement};
+}
