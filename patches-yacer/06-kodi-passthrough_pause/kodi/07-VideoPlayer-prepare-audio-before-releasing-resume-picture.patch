+void CVideoPlayerAudio::PublishPreroll(AudioPrerollStatus::Phase phase, bool force)
+{
+  if (!m_preroll.Active())
+    return;
+  const double now = m_pClock->GetAbsoluteClock();
+  if (!force && !m_preroll.Failed() && now - m_lastPrerollStatusUs < DVD_MSEC_TO_TIME(10))
+    return;
+  m_lastPrerollStatusUs = now;
+  auto status = m_preroll.Observe(m_audioSink.GetPrerollSyncState(), now, phase);
+  if (status.phase == AudioPrerollStatus::Phase::Failed &&
+      m_lastPrerollFailureGeneration != status.generation)
+  {
+    m_lastPrerollFailureGeneration = status.generation;
+    CLog::Log(LOGDEBUG,
+              "CVideoPlayerAudio::Preroll failure: generation={} reason={} pts_us={:.6f} "
+              "duration_us={:.6f} expected_us={:.6f} delta_us={:.6f} bytes={} written={} "
+              "previous={} first_us={:.6f} end_us={:.6f} playing_us={:.6f} held={}",
+              status.generation, CAudioPreroll::FailureName(status.failure), status.packetPts,
+              status.packetDuration, status.expectedPts, status.packetPts - status.expectedPts,
+              status.packetBytes, status.writtenBytes, status.previousBytes, status.firstPts,
+              status.submittedEndPts, status.estimatedPlayingPts, status.mainHeld);
+  }
+  m_messageParent.Put(
+      std::make_shared<CDVDMsgType<AudioPrerollStatus>>(CDVDMsg::PLAYER_AUDIO_PREROLL, status));
+}
+
+void CVideoPlayerAudio::ResetPrerollCorrections()
+{
+  m_audioSink.DiscardSyncErrorWindow();
+  m_audioSink.SetSyncErrorSuppressed(m_preroll.Active());
+}
+
+void CVideoPlayerAudio::AbortPreroll()
