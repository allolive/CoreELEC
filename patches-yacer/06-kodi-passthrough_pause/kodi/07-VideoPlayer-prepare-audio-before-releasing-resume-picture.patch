+bool CRenderManager::BeginVideoPreroll(uint64_t generation, double target)
+{
+  std::unique_lock lock(m_statelock);
+  std::unique_lock lock2(m_presentlock);
+  if (!m_pRenderer || m_renderState != STATE_CONFIGURED || m_presentsource < 0 ||
+      !m_bRenderGUI || !g_application.GetRenderGUI() || m_bTriggerUpdateResolution ||
+      generation == 0 ||
+      generation <= m_videoPreroll.Read().generation ||
+      (target != DVD_NOPTS_VALUE && !std::isfinite(target)))
+    return false;
+  if (!m_pRenderer->BeginVideoPreroll(generation))
+    return false;
+  m_videoPreroll.Begin(generation, target);
+  const double fps = CServiceBroker::GetWinSystem()->GetGfxContext().GetFPS();
+  m_videoPrerollLead = std::max(100000.0, std::max(0.0, m_displayLatency) +
+                                           2.0 * DVD_TIME_BASE / std::max(1.0, fps) + 10000.0);
+  m_forceNext = false;
+  DiscardBuffer();
+  return true;
+}
+
+CVideoPrerollGate::Snapshot CRenderManager::GetVideoPreroll()
+{
+  std::unique_lock lock(m_statelock);
+  std::unique_lock lock2(m_presentlock);
+  if (m_pRenderer && m_pRenderer->IsVideoPrerollFailed(m_videoPreroll.Read().generation))
+    m_videoPreroll.Fail();
+  if (m_pRenderer && m_pRenderer->IsVideoPrerollSubmitted(m_videoPreroll.Read().generation))
+    m_videoPreroll.Submitted(m_videoPreroll.Read().generation);
+  auto state = m_videoPreroll.Read();
+  state.requiredLeadUs = m_videoPrerollLead;
+  return state;
+}
+
+bool CRenderManager::ReleaseVideoPreroll(uint64_t generation)
+{
+  std::unique_lock lock(m_statelock);
+  std::unique_lock lock2(m_presentlock);
+  const auto state = m_videoPreroll.Read();
+  if (state.generation != generation || !state.holding || !state.ready || state.failed ||
+      !m_pRenderer || !m_pRenderer->ReleaseVideoPreroll(generation))
+    return false;
+  m_forceNext = false;
+  m_showVideo = true;
+  return m_videoPreroll.Release(generation);
+}
+
+void CRenderManager::CancelVideoPreroll(uint64_t generation)
+{
+  std::unique_lock lock(m_statelock);
+  std::unique_lock lock2(m_presentlock);
+  if (!m_videoPreroll.Cancel(generation))
+    return;
+  if (m_pRenderer)
+    m_pRenderer->CancelVideoPreroll(generation);
+  DiscardBuffer();
+  m_presentevent.notifyAll();
+}
+
+uint64_t CRenderManager::ArmVideoPrerollAfterFlush()
+{
+  std::unique_lock lock(m_presentlock);
+  return m_videoPreroll.ArmAfterFlush();
+}
+
+void CRenderManager::FailVideoPreroll()
+{
+  std::unique_lock lock(m_presentlock);
+  m_videoPreroll.Fail();
+}
+
+CVideoPrerollGate::Picture CRenderManager::CheckVideoPrerollPicture(
+    uint64_t generation, double pts, bool timestampValid)
+{
+  std::unique_lock lock(m_presentlock);
+  return m_videoPreroll.Check(generation, pts, timestampValid);
+}
+
+bool CRenderManager::RetainVideoPrerollPicture(uint64_t generation, double pts)
+{
+  std::unique_lock lock(m_presentlock);
+  return m_videoPreroll.Retain(generation, pts);
+}
