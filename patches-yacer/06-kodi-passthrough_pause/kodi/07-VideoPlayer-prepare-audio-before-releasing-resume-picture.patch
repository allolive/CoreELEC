From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: allolive <160342668+allolive@users.noreply.github.com>
Date: Mon, 21 Sep 2026 23:00:00 -0400
Subject: [PATCH] VideoPlayer: prepare audio before releasing resume picture

After callback seeks settle, decode continuously from about 500 ms before
the resolved resume target. Retain the target picture while earlier audio
acquires its ordinary output clock. Require current-generation audio and
video readiness, then an audio authorization acknowledgement, before
releasing video through its normal timestamp scheduler. Failure returns
to an ordinary seek; late commands and stale output cannot release a hold.

The generic player owns seek ordering, stream clocks and demux state, so
this coordination cannot live in an AML sink. Renderers opt in through
a default-disabled capability; CoreELEC supplies its built-in AML adapter
separately. Host audio timing is not proof of receiver or panel output.

Signed-off-by: allolive <160342668+allolive@users.noreply.github.com>
---
diff --git a/xbmc/cores/VideoPlayer/AudioPreroll.h b/xbmc/cores/VideoPlayer/AudioPreroll.h
new file mode 100644
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/AudioPreroll.h
@@ -0,0 +1,276 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#pragma once
+
+#include "cores/VideoPlayer/Interface/TimingConstants.h"
+
+#include <cmath>
+#include <cstdint>
+
+struct AudioPrerollCommand
+{
+  enum class Action { Begin, End, Cancel, SetTarget };
+  Action action{Action::Cancel};
+  uint64_t generation{0};
+  double targetPts{DVD_NOPTS_VALUE};
+};
+
+// All times are DVD-time microseconds. Position is a host queue estimate,
+// never evidence that an HDMI receiver decoded or presented a payload.
+struct AudioPrerollStatus
+{
+  enum class Phase { Buffered, Progress, AtBoundary, Released, Failed };
+  enum class Failure
+  {
+    None, Timestamp, Duration, Format, Continuity, PartialWrite, NoLead,
+    PastTarget, NotInSync, Aborted, SinkUnavailable
+  };
+  Phase phase{Phase::Progress};
+  uint64_t generation{0};
+  double firstPts{DVD_NOPTS_VALUE};
+  double submittedEndPts{DVD_NOPTS_VALUE};
+  double estimatedPlayingPts{DVD_NOPTS_VALUE};
+  double hostUs{0.0};
+  bool inSync{false};
+  bool mainHeld{false};
+  Failure failure{Failure::None};
+  double packetPts{DVD_NOPTS_VALUE};
+  double packetDuration{0.0};
+  double expectedPts{DVD_NOPTS_VALUE};
+  unsigned int packetBytes{0};
+  unsigned int writtenBytes{0};
+  unsigned int previousBytes{0};
+};
+
+struct AudioPrerollSinkState
+{
+  double delayUs{0.0};
+  bool valid{false};
+  bool running{false};
+  bool inSync{false};
+};
+
+// Audio-thread state: accepted packets and current-generation queue evidence.
+// It does not authorize release of the held target-containing packet.
+class CAudioPreroll
+{
+public:
+  using Failure = AudioPrerollStatus::Failure;
+  static bool ValidPts(double pts) { return pts != DVD_NOPTS_VALUE && std::isfinite(pts); }
+  static const char* FailureName(Failure failure)
+  {
+    switch (failure)
+    {
+      case Failure::None: return "none";
+      case Failure::Timestamp: return "timestamp";
+      case Failure::Duration: return "duration";
+      case Failure::Format: return "format";
+      case Failure::Continuity: return "continuity";
+      case Failure::PartialWrite: return "partial-write";
+      case Failure::NoLead: return "no-lead";
+      case Failure::PastTarget: return "past-target";
+      case Failure::NotInSync: return "not-in-sync";
+      case Failure::Aborted: return "aborted";
+      case Failure::SinkUnavailable: return "sink-unavailable";
+    }
+    return "unknown";
+  }
+
+  bool Begin(uint64_t generation, double targetPts)
+  {
+    if (generation == 0 || generation <= m_generation || !ValidPts(targetPts))
+      return false;
+    m_generation = generation;
+    m_targetPts = targetPts;
+    m_firstPts = DVD_NOPTS_VALUE;
+    m_submittedEndPts = DVD_NOPTS_VALUE;
+    m_lastPacketEnd = DVD_NOPTS_VALUE;
+    m_active = true;
+    m_failed = false;
+    m_failure = {};
+    m_held = false;
+    m_seenRunningUnsynced = false;
+    return true;
+  }
+
+  bool Active() const { return m_active; }
+  bool Failed() const { return m_failed; }
+  bool Held() const { return m_held; }
+  bool Buffered() const { return ValidPts(m_firstPts); }
+  uint64_t Generation() const { return m_generation; }
+  bool Matches(uint64_t generation) const { return m_active && generation == m_generation; }
+
+  void Fail(Failure reason = Failure::Aborted, double pts = DVD_NOPTS_VALUE,
+            double duration = 0.0, unsigned int packetBytes = 0,
+            unsigned int writtenBytes = 0, unsigned int previousBytes = 0)
+  {
+    if (!m_active || m_failed)
+      return;
+    m_failed = true;
+    m_failure.failure = reason;
+    m_failure.packetPts = pts;
+    m_failure.packetDuration = duration;
+    m_failure.expectedPts = m_submittedEndPts;
+    m_failure.packetBytes = packetBytes;
+    m_failure.writtenBytes = writtenBytes;
+    m_failure.previousBytes = previousBytes;
+  }
+
+  bool Cancel(uint64_t generation)
+  {
+    if (!Matches(generation))
+      return false;
+    m_active = false;
+    m_held = false;
+    return true;
+  }
+
+  bool End(uint64_t generation)
+  {
+    if (!Matches(generation) || m_failed)
+      return false;
+    return Cancel(generation);
+  }
+
+  bool SetTarget(uint64_t generation, double targetPts)
+  {
+    if (!Matches(generation) || m_failed || !ValidPts(targetPts) || targetPts < m_targetPts)
+      return false;
+    m_targetPts = targetPts;
+    m_held = false; // Re-evaluate the preserved packet against the rounded target.
+    return true;
+  }
+
+  bool HoldPacket(double pts, double duration, bool timestamped, bool passthrough,
+                  unsigned int packetBytes = 0, unsigned int previousBytes = 0)
+  {
+    if (!m_active)
+      return false;
+    if (m_failed)
+      return true;
+    if (!timestamped || !ValidPts(pts))
+    {
+      Fail(Failure::Timestamp, pts, duration, packetBytes, 0, previousBytes);
+      return true;
+    }
+    if (!passthrough)
+    {
+      Fail(Failure::Format, pts, duration, packetBytes, 0, previousBytes);
+      return true;
+    }
+    if (!std::isfinite(duration) || duration <= 0 || !std::isfinite(pts + duration))
+    {
+      Fail(Failure::Duration, pts, duration, packetBytes, 0, previousBytes);
+      return true;
+    }
+    if (!Continuous(pts, duration))
+    {
+      Fail(Failure::Continuity, pts, duration, packetBytes, 0, previousBytes);
+      return true;
+    }
+    const double packetStart = Buffered() ? m_submittedEndPts : pts;
+    m_held = packetStart + duration > m_targetPts;
+    if (m_held && !Buffered())
+      Fail(Failure::NoLead, pts, duration, packetBytes, 0, previousBytes);
+    return m_held || m_failed;
+  }
+
+  bool Accepted(double pts, double duration, unsigned int written, unsigned int packetBytes,
+                unsigned int previousBytes)
+  {
+    if (!m_active || m_failed)
+      return false;
+    // RAW progress is meaningful only for a complete packet. A timeout after
+    // partial acceptance requires cancellation; never extrapolate its duration.
+    Failure reason = Failure::None;
+    if (!ValidPts(pts))
+      reason = Failure::Timestamp;
+    else if (!std::isfinite(duration) || duration <= 0 || !std::isfinite(pts + duration))
+      reason = Failure::Duration;
+    else if (packetBytes == 0 || previousBytes != 0 || written != packetBytes)
+      reason = Failure::PartialWrite;
+    else if (!Continuous(pts, duration))
+      reason = Failure::Continuity;
+    if (reason != Failure::None)
+    {
+      Fail(reason, pts, duration, packetBytes, written, previousBytes);
+      return false;
+    }
+    const double packetEnd = (Buffered() ? m_submittedEndPts : pts) + duration;
+    if (packetEnd > m_targetPts)
+    {
+      Fail(Failure::PastTarget, pts, duration, packetBytes, written, previousBytes);
+      return false;
+    }
+    if (!Buffered())
+      m_firstPts = pts;
+    // Two ends, deliberately: m_submittedEndPts accumulates real durations, so
+    // runway can never be inflated by a gap between timestamps, while
+    // m_lastPacketEnd follows the container so contiguity is judged against
+    // what the stream actually says. Conflating them made a quantized ladder
+    // look like a discontinuity.
+    m_submittedEndPts = packetEnd;
+    m_lastPacketEnd = pts + duration;
+    return true;
+  }
+
+  AudioPrerollStatus Observe(const AudioPrerollSinkState& sink, double hostUs,
+                            AudioPrerollStatus::Phase phase = AudioPrerollStatus::Phase::Progress)
+  {
+    AudioPrerollStatus status = m_failure;
+    status.phase = m_failed ? AudioPrerollStatus::Phase::Failed
+                           : m_held ? AudioPrerollStatus::Phase::AtBoundary : phase;
+    status.generation = m_generation;
+    status.firstPts = m_firstPts;
+    status.submittedEndPts = m_submittedEndPts;
+    status.hostUs = hostUs;
+    status.mainHeld = m_held;
+    if (!sink.valid || !sink.running)
+      m_seenRunningUnsynced = false;
+    if (sink.valid && std::isfinite(sink.delayUs) && sink.delayUs >= 0)
+    {
+      // Do not accept a stale pre-resume INSYNC reading. Missing the transition
+      // causes a bounded fallback rather than permission to consume the target.
+      if (sink.running && !sink.inSync)
+        m_seenRunningUnsynced = true;
+      status.inSync = m_active && !m_failed && sink.running && m_seenRunningUnsynced && sink.inSync;
+      if (Buffered())
+        status.estimatedPlayingPts = m_submittedEndPts - sink.delayUs;
+    }
+    return status;
+  }
+
+private:
+  bool Continuous(double pts, double duration) const
+  {
+    // Two things, both measured from the stream rather than assumed.
+    //
+    // Where the previous packet ended: on the container's timeline, not on the
+    // cumulative total. A container quantizes each timestamp to a millisecond
+    // while a 48 kHz frame lasts 10.667 ms, so measuring against the running
+    // total turns per-packet rounding into a drift that eventually crosses any
+    // fixed allowance.
+    //
+    // How far off is still the next packet: half a frame. Real ladders are not
+    // just 10 and 11 ms - this content also steps 12 - so a fixed millisecond
+    // rejects healthy audio, and it rejected all of it here. Half a frame
+    // admits that jitter and still refuses the thing worth refusing, a whole
+    // frame missing, which lands a full duration away.
+    return !Buffered() || std::abs(pts - m_lastPacketEnd) <= duration * 0.5;
+  }
+
+  AudioPrerollStatus m_failure;
+  uint64_t m_generation{0};
+  double m_targetPts{DVD_NOPTS_VALUE};
+  double m_firstPts{DVD_NOPTS_VALUE};
+  double m_submittedEndPts{DVD_NOPTS_VALUE};
+  double m_lastPacketEnd{DVD_NOPTS_VALUE};
+  bool m_active{false};
+  bool m_failed{false};
+  bool m_held{false};
+  bool m_seenRunningUnsynced{false};
+};
