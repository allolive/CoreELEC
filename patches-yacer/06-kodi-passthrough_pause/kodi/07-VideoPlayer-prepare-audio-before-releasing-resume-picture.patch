 }
@@ -304,5 +308,75 @@
 double CAudioSinkAE::GetSyncError()
 {
-  return m_syncError;
+  return m_syncErrorSuppressed ? 0.0 : m_syncError;
+}
+
+CAudioSinkAE::PrerollPacketResult CAudioSinkAE::AddPrerollPacket(const DVDAudioFrame& frame,
+                                                                unsigned int& written)
+{
+  written = 0;
+  std::unique_lock lock(m_critSection);
+  // ActiveAE RAW space counts packet slots. Its RAW buffers hold at most one
+  // MAX_IEC61937_PACKET of byte-sized frames; larger/partial packets cannot
+  // be promised a nonblocking whole-packet write.
+  if (!m_pAudioStream)
+  {
+    CLog::Log(LOGDEBUG, "CAudioSinkAE::AddPrerollPacket unavailable: bytes={} previous={}",
+              frame.nb_frames, frame.framesOut);
+    return PrerollPacketResult::Unavailable;
+  }
+  if (!m_bPassthrough || m_dataFormat != AE_FMT_RAW ||
+      !frame.passthrough || frame.framesOut != 0 || frame.nb_frames <= 0 ||
+      frame.nb_frames > MAX_IEC61937_PACKET || m_pAudioStream->GetFrameSize() != 1)
+  {
+    CLog::Log(LOGDEBUG,
+              "CAudioSinkAE::AddPrerollPacket format: bytes={} previous={} frameSize={} "
+              "dataFormat={} sinkPassthrough={} framePassthrough={}",
+              frame.nb_frames, frame.framesOut, m_pAudioStream->GetFrameSize(),
+              static_cast<int>(m_dataFormat), m_bPassthrough, frame.passthrough);
+    return PrerollPacketResult::InvalidFormat;
+  }
+  if (m_pAudioStream->GetSpace() == 0)
+    return PrerollPacketResult::Deferred;
+  lock.unlock();
+
+  // The audio thread is the sole producer; no other write can consume the
+  // reserved available slot while a priority resume/seek command is pending.
+  written = AddPackets(frame);
+  if (written != static_cast<unsigned int>(frame.nb_frames))
+  {
+    CLog::Log(LOGDEBUG,
+              "CAudioSinkAE::AddPrerollPacket partial-write: bytes={} written={} previous={}",
+              frame.nb_frames, written, frame.framesOut);
+    return PrerollPacketResult::Failed;
+  }
+  return PrerollPacketResult::Written;
+}
+
+AudioPrerollSinkState CAudioSinkAE::GetPrerollSyncState()
+{
+  std::unique_lock lock(m_critSection);
+  if (!m_pAudioStream || !m_bPassthrough)
+    return {};
+
+  // Delay and sync state come from one engine-stats snapshot, including while
+  // the player holds a target packet and therefore calls no AddPackets.
+  const CAESyncInfo info = m_pAudioStream->GetSyncInfo();
+  if (!std::isfinite(info.delay) || info.delay < 0.0)
+    return {};
+  return {info.delay * DVD_TIME_BASE, true, !m_bPaused,
+          info.state == CAESyncInfo::SYNC_INSYNC};
+}
+
+void CAudioSinkAE::DiscardSyncErrorWindow()
+{
+  std::unique_lock lock(m_critSection);
+  m_syncError = 0.0;
+  m_syncErrorTime = 0;
+  if (m_pAudioStream)
+  {
+    const CAESyncInfo info = m_pAudioStream->GetSyncInfo();
+    // Do not consume a preparation window as a new post-release correction.
+    m_syncErrorTime = info.errortime;
+  }
 }
 
