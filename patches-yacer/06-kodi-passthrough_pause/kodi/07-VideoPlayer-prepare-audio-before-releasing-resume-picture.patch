+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#pragma once
+
+#include "cores/VideoPlayer/Interface/TimingConstants.h"
+
+#include <cmath>
+#include <cstdint>
+
+// State only; RenderManager serializes access with its presentation lock.
+// READY means a picture is retained by the video thread, not shown by hardware.
+class CVideoPrerollGate
+{
+public:
+  struct Snapshot
+  {
+    uint64_t generation{0};
+    double target{DVD_NOPTS_VALUE};
+    double firstPts{DVD_NOPTS_VALUE};
+    double requiredLeadUs{100000.0};
+    bool holding{false};
+    bool armed{false};
+    bool ready{false};
+    bool failed{false};
+    bool released{false};
+    bool scheduled{false};
+    bool submitted{false};
+  };
+  enum class Picture { NORMAL, DROP, HOLD, CANDIDATE };
+
+  bool Begin(uint64_t generation, double target)
+  {
+    if (generation == 0 || generation <= m_state.generation ||
+        (target != DVD_NOPTS_VALUE && !std::isfinite(target)))
+      return false;
+    m_state = {};
+    m_state.generation = generation;
+    m_state.target = target;
+    m_state.holding = true;
+    return true;
+  }
+
+  uint64_t ArmAfterFlush()
+  {
+    if (!m_state.holding || m_state.failed)
+      return 0;
+    m_state.armed = true;
+    m_state.ready = false;
+    m_state.firstPts = DVD_NOPTS_VALUE;
+    return m_state.generation;
+  }
+
+  Picture Check(uint64_t generation, double pts, bool timestampValid)
+  {
+    if (generation != 0 && generation != m_state.generation)
+      return Picture::DROP;
+    if (!m_state.holding)
+      return generation == 0 || CanOutput(generation) ? Picture::NORMAL : Picture::DROP;
+    if (!m_state.armed || generation == 0 || m_state.failed ||
+        m_state.target == DVD_NOPTS_VALUE)
+      return Picture::HOLD;
+    if (!timestampValid || pts == DVD_NOPTS_VALUE || !std::isfinite(pts))
+    {
+      Fail();
+      return Picture::HOLD;
+    }
+    if (pts < m_state.target)
+      return Picture::DROP;
+    return m_state.ready ? Picture::HOLD : Picture::CANDIDATE;
+  }
+
+  bool Retain(uint64_t generation, double pts)
+  {
+    if (generation != m_state.generation || !m_state.holding || !m_state.armed ||
+        m_state.failed || m_state.ready || m_state.target == DVD_NOPTS_VALUE ||
+        !std::isfinite(pts) || pts == DVD_NOPTS_VALUE || pts < m_state.target)
+      return false;
+    m_state.ready = true;
+    m_state.firstPts = pts;
+    return true;
+  }
+
+  bool Release(uint64_t generation)
+  {
+    if (generation != m_state.generation || !m_state.holding || !m_state.ready || m_state.failed)
+      return false;
+    m_state.holding = false;
+    m_state.released = true;
+    return true;
+  }
+
+  bool Cancel(uint64_t generation)
+  {
+    if (generation != m_state.generation)
+      return false;
+    m_state.holding = false;
+    m_state.released = false;
+    m_state.ready = false;
+    m_state.armed = false;
+    m_state.failed = false;
+    m_state.scheduled = false;
+    m_state.submitted = false;
+    return true;
+  }
+
+  void Fail()
+  {
+    if (m_state.holding || AwaitingSubmission())
+      m_state.failed = true;
+  }
+  bool CanOutput(uint64_t generation) const
+  {
+    return generation == m_state.generation && m_state.released && !m_state.failed;
+  }
+  bool AwaitingPresentation() const { return m_state.released && !m_state.scheduled; }
+  bool AwaitingSubmission() const { return m_state.released && !m_state.submitted; }
+  void Scheduled() { if (m_state.released) m_state.scheduled = true; }
+  void Submitted(uint64_t generation)
+  {
+    if (CanOutput(generation) && m_state.scheduled)
+      m_state.submitted = true;
+  }
+  Snapshot Read() const { return m_state; }
+
+private:
+  Snapshot m_state;
+};
