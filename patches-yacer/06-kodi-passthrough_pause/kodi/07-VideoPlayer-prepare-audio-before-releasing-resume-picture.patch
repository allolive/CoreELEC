diff --git a/xbmc/cores/VideoPlayer/PlaybackPreroll.h b/xbmc/cores/VideoPlayer/PlaybackPreroll.h
new file mode 100644
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/PlaybackPreroll.h
@@ -0,0 +1,205 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+
+/** Player-thread permission to start preroll audio and schedule the target video.
+ *
+ * PTS and monotonic host times are in DVD microseconds. The caller resolves
+ * raw seek/EDL offsets, filters DVD_NOPTS_VALUE, supplies a unique output
+ * generation, and owns all endpoint commands. Audio observations describe
+ * complete accepted packets minus a freshly sampled delay, not DAC feedback.
+ * This class neither proves that an AVR has decoded a packet nor replaces
+ * RenderManager's normal timestamp scheduling and chosen display offsets.
+ */
+class CPlaybackPreroll
+{
+public:
+  struct Audio
+  {
+    double firstPts;
+    double submittedEndPts;
+    double playingPts;
+    double hostUs;
+    bool inSync;
+    bool mainHeld;
+  };
+
+  enum class Action
+  {
+    None,
+    StartAudio,
+    Release,
+    Fail,
+  };
+
+  struct Decision
+  {
+    Action action = Action::None;
+    uint64_t generation = 0;
+    double clockPts = 0.0;
+    double targetPts = 0.0;
+    const char* reason = "";
+  };
+
+  bool Begin(uint64_t generation, double requestedTargetPts, double nowUs)
+  {
+    Cancel();
+    if (generation == 0 || !Nonnegative(requestedTargetPts) || !Nonnegative(nowUs))
+      return false;
+    m_generation = generation;
+    m_requestedTarget = requestedTargetPts;
+    m_target = requestedTargetPts;
+    m_beginUs = nowUs;
+    m_lastNowUs = nowUs;
+    m_stage = Stage::Preparing;
+    return true;
+  }
+
+  void Cancel()
+  {
+    m_stage = Stage::Idle;
+    m_generation = 0;
+    m_videoReady = false;
+    m_audio.reset();
+    m_firstAudioPts.reset();
+    m_lastAudioHost.reset();
+    m_lastSubmittedEnd.reset();
+    m_requiredLead = MIN_RUNWAY_US;
+  }
+
+  bool Active() const { return m_stage != Stage::Idle; }
+  bool Releasing() const { return m_stage == Stage::Releasing; }
+  uint64_t Generation() const { return m_generation; }
+  double TargetPts() const { return m_target; }
+
+  bool SetVideoReady(uint64_t generation,
+                     double actualFirstPts,
+                     double nowUs,
+                     double requiredLeadUs = MIN_RUNWAY_US)
+  {
+    if (!Current(generation) || !ValidNow(nowUs) || !Nonnegative(actualFirstPts) ||
+        !Nonnegative(requiredLeadUs) || actualFirstPts < m_requestedTarget ||
+        actualFirstPts - m_requestedTarget > MAX_TARGET_ADVANCE_US ||
+        (m_videoReady && actualFirstPts != m_target))
+      return false;
+    m_lastNowUs = nowUs;
+    m_target = actualFirstPts;
+    m_requiredLead = std::max(MIN_RUNWAY_US, requiredLeadUs);
+    m_videoReady = true;
+    return true;
+  }
+
+  bool SetAudio(uint64_t generation, const Audio& audio, double nowUs)
+  {
+    if (!Current(generation) || !ValidNow(nowUs) || !Nonnegative(audio.firstPts) ||
+        !Nonnegative(audio.submittedEndPts) || !std::isfinite(audio.playingPts) ||
+        !Nonnegative(audio.hostUs) || audio.hostUs < m_beginUs || audio.hostUs > nowUs ||
+        nowUs - audio.hostUs > MAX_SAMPLE_AGE_US ||
+        audio.submittedEndPts <= audio.firstPts || audio.playingPts > audio.submittedEndPts ||
+        (m_firstAudioPts && audio.firstPts != *m_firstAudioPts) ||
+        (m_lastAudioHost && audio.hostUs < *m_lastAudioHost) ||
+        (m_lastSubmittedEnd && audio.submittedEndPts < *m_lastSubmittedEnd))
+      return false;
+    m_lastNowUs = nowUs;
+    m_firstAudioPts = audio.firstPts;
+    m_lastAudioHost = audio.hostUs;
+    m_lastSubmittedEnd = audio.submittedEndPts;
+    m_audio = audio;
+    return true;
+  }
+
+  Decision Poll(double nowUs)
+  {
+    if (!Active())
+      return {};
+    if (!ValidNow(nowUs))
+      return Finish(Action::Fail, 0.0, "invalid host time");
+    m_lastNowUs = nowUs;
+    const bool preparing = m_stage == Stage::Preparing;
+    if (nowUs - (preparing ? m_beginUs : m_startUs) >=
+        (preparing ? PREPARE_TIMEOUT_US : RUN_TIMEOUT_US))
+      return Finish(Action::Fail, 0.0, preparing ? "preparation timeout" : "preroll timeout");
+    // Release requests an audio handoff, not video permission. The caller
+    // retains the video hold until a matching audio acknowledgement passes
+    // its current presentation-lead check, then calls Cancel to finish.
+    if (Releasing())
+      return {};
+    if (!m_videoReady || !m_audio || nowUs - m_audio->hostUs > MAX_SAMPLE_AGE_US)
+      return {};
+
+    if (m_audio->firstPts >= m_target || m_audio->submittedEndPts > m_target)
+      return Finish(Action::Fail, m_audio->playingPts, "no protected preroll interval");
+
+    if (preparing)
+    {
+      const double clock = m_audio->playingPts;
+      m_stage = Stage::Running;
+      m_startUs = nowUs;
+      // Paused INSYNC/delay cannot certify a running stream. The producer must
+      // sample again after the actual start command, in this generation.
+      m_audio.reset();
+      return {Action::StartAudio, m_generation, clock, m_target, "preroll prepared"};
+    }
+
+    if (m_audio->hostUs <= m_startUs)
+      return {};
+
+    // At normal speed the sample can be up to 100ms old. Charge its age against
+    // both margins instead of letting old data spend the same runway twice.
+    // This is conservative scheduling arithmetic, not reported emitted PTS.
+    const double clock = m_audio->playingPts + (nowUs - m_audio->hostUs);
+    const double runway = m_audio->submittedEndPts - clock;
+    const double lead = m_target - clock;
+    if (m_audio->inSync && runway >= MIN_RUNWAY_US && lead >= m_requiredLead)
+    {
+      m_stage = Stage::Releasing;
+      m_audio.reset();
+      return {Action::Release, m_generation, clock, m_target, "audio ready with presentation lead"};
+    }
+    if (m_audio->mainHeld && (runway < MIN_RUNWAY_US || lead < m_requiredLead))
+      return Finish(Action::Fail, clock, "preroll runway exhausted");
+    return {};
+  }
