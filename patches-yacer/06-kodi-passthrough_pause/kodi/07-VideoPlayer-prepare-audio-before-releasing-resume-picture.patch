+void CVideoPlayer::HandleAudioPrerollStatus(const AudioPrerollStatus& status)
+{
+  if (!m_resumePreroll.Active() || status.generation != m_resumePreroll.Generation())
+    return;
+  if (status.phase == AudioPrerollStatus::Phase::Released && m_resumePreroll.Releasing())
+  {
+    // A newer user command can be behind this acknowledgement in the FIFO.
+    // Retire the old target before it becomes visible; recovery leaves the
+    // queued command responsible for the next seek or speed transition.
+    if (m_messenger.GetPacketCount(CDVDMsg::PLAYER_SEEK) != 0 ||
+        m_messenger.GetPacketCount(CDVDMsg::PLAYER_SEEK_CHAPTER) != 0 ||
+        m_messenger.GetPacketCount(CDVDMsg::PLAYER_SETSPEED) != 0 ||
+        m_messenger.GetPacketCount(CDVDMsg::PLAYER_OPENFILE) != 0 ||
+        m_messenger.GetPacketCount(CDVDMsg::PLAYER_ABORT) != 0)
+    {
+      RecoverResumePreroll("superseded before audio acknowledgement");
+      return;
+    }
+    const auto video = m_renderManager.GetVideoPreroll();
+    const double now = m_clock.GetAbsoluteClock();
+    const double age = now - status.hostUs;
+    const double playing = status.estimatedPlayingPts + age;
+    // Audio authorization can already have submitted payload. If the
+    // acknowledgement misses the presentation deadline, recover by seeking
+    // the target rather than pretending that output can be rolled back.
+    if (!status.inSync || status.estimatedPlayingPts == DVD_NOPTS_VALUE ||
+        !std::isfinite(playing) || !std::isfinite(age) ||
+        age < 0.0 || age > DVD_MSEC_TO_TIME(100) ||
+        video.generation != status.generation || !video.ready || video.failed ||
+        video.firstPts - playing < video.requiredLeadUs ||
+        m_clock.IsPaused() || std::abs(playing - m_clock.GetClock()) > DVD_MSEC_TO_TIME(50))
+    {
+      CLog::Log(LOGWARNING,
+                "CVideoPlayer::Preroll - release acknowledgement rejected generation={} "
+                "in_sync={} age_ms={:.6f} audio={:.6f} clock={:.6f} clock_paused={} "
+                "video_generation={} ready={} failed={} target={:.6f} required_lead_ms={:.6f}",
+                status.generation, status.inSync, age / 1000.0, playing / DVD_TIME_BASE,
+                m_clock.GetClock() / DVD_TIME_BASE, m_clock.IsPaused(), video.generation,
+                video.ready, video.failed, video.firstPts / DVD_TIME_BASE,
+                video.requiredLeadUs / 1000.0);
+      m_resumePrerollFailed = true;
+      return;
+    }
+    // Spend the small acquisition residual while the picture is still held.
+    // Audio's End acknowledgement has discarded the cached error window, so
+    // the next ordinary packet cannot immediately reuse that pre-anchor error.
+    m_clock.Discontinuity(playing);
+    if (!m_renderManager.ReleaseVideoPreroll(status.generation))
+    {
+      CLog::Log(LOGWARNING, "CVideoPlayer::Preroll - renderer rejected release generation={}",
+                status.generation);
+      m_resumePrerollFailed = true;
+      return;
+    }
+    m_resumePreroll.Cancel();
+    m_resumePrerollReleaseTime = now;
+    m_playSpeed = DVD_PLAYSPEED_NORMAL;
+    PublishPlaySpeed(DVD_PLAYSPEED_NORMAL, false);
+    m_processInfo->SetFrameAdvance(false);
+    m_CurrentVideo.syncState = IDVDStreamPlayer::SYNC_INSYNC;
+    m_CurrentVideo.avsync = CCurrentStream::AV_SYNC_NONE;
+    m_VideoPlayerVideo->SendMessage(
+        std::make_shared<CDVDMsgDouble>(CDVDMsg::GENERAL_RESYNC, m_clock.GetClock()), 1);
+    m_VideoPlayerVideo->SetSpeed(DVD_PLAYSPEED_NORMAL);
+    m_streamPlayerSpeed = DVD_PLAYSPEED_NORMAL;
+    m_caching = CACHESTATE_DONE;
+    m_syncTimer.Set(3000ms);
+    CLog::Log(LOGDEBUG,
+              "CVideoPlayer::Preroll - scheduled generation={} audio={:.3f} target={:.3f}",
+              status.generation, playing / DVD_TIME_BASE, video.firstPts / DVD_TIME_BASE);
+  }
+  else if (status.phase == AudioPrerollStatus::Phase::Failed)
+    m_resumePrerollFailed = true;
+  else if (status.firstPts != DVD_NOPTS_VALUE &&
+           status.submittedEndPts != DVD_NOPTS_VALUE &&
+           status.estimatedPlayingPts != DVD_NOPTS_VALUE)
+  {
+    m_resumePreroll.SetAudio(
+        status.generation,
+        {status.firstPts, status.submittedEndPts, status.estimatedPlayingPts,
+         status.hostUs, status.inSync, status.mainHeld},
+        m_clock.GetAbsoluteClock());
+  }
+}
+
+bool CVideoPlayer::CanPrepareResumePreroll() const
+{
+  // Initially support only one continuous file timeline. Navigation clocks,
+  // edit lists and interlaced display pipelines require separate adapters.
+  return m_pInputStream && m_pDemuxer && m_State.canseek && m_State.canpause &&
+         m_CurrentAudio.id >= 0 && m_CurrentVideo.id >= 0 && IsPassthrough() &&
+         (m_CurrentAudio.hint.codec == AV_CODEC_ID_TRUEHD ||
+          m_CurrentAudio.hint.codec == AV_CODEC_ID_DTS) &&
+         m_pInputStream->IsStreamType(DVDSTREAM_TYPE_FILE) &&
+         !m_pInputStream->IsRealtime() && !KODI::NETWORK::IsInternetStream(m_item) &&
+         !m_pInputStream->GetIPosTime() && !m_pInputStream->GetITimes() &&
+         !m_Edl.HasEdits() && !m_processInfo->GetVideoInterlaced() &&
+         m_State.time_offset == 0.0 && m_offset_pts == 0.0;
+}
+
+bool CVideoPlayer::BeginResumePreroll()
+{
+  if (m_resumePictureGeneration == 0 || !m_resumePrerollTarget ||
+      !CanPrepareResumePreroll())
+    return false;
+
+  const double target = *m_resumePrerollTarget;
+  if (!std::isfinite(target) || target < 0.0)
+    return false;
+  const double entry = std::max(0.0, target - DVD_MSEC_TO_TIME(500));
+  double landed = DVD_NOPTS_VALUE;
+  m_seekingResumePreroll = true;
+  const bool sought = m_pDemuxer->SeekTime(DVD_TIME_TO_MSEC(entry), true, &landed);
+  if (sought)
+  {
+    if (m_pSubtitleDemuxer)
+      m_pSubtitleDemuxer->SeekTime(DVD_TIME_TO_MSEC(entry), true);
+    m_State.dts = entry;
+    m_State.lastSeek = m_clock.GetAbsoluteClock();
+    FlushBuffers(entry, true, true);
+  }
+  m_seekingResumePreroll = false;
+  if (!sought || m_resumePictureGeneration == 0 ||
+      !m_resumePreroll.Begin(m_resumePictureGeneration, target, m_clock.GetAbsoluteClock()))
+  {
+    RecoverResumePreroll("cannot prepare the earlier seek");
+    return true;
+  }
+
+  // Decode video from the demuxer's preceding keyframe. Its output-PTS gate
+  // selects the target; a DTS cutoff would lose reordered-picture dependencies.
+  m_CurrentVideo.startpts = DVD_NOPTS_VALUE;
+  m_CurrentSubtitle.startpts = target;
+  m_resumePrerollFailed = false;
+  m_VideoPlayerAudio->SendMessage(
+      std::make_shared<CDVDMsgType<AudioPrerollCommand>>(
+          CDVDMsg::AUDIO_PREROLL,
+          AudioPrerollCommand{AudioPrerollCommand::Action::Begin,
+                              m_resumePictureGeneration, target}),
+      1);
+  CLog::Log(LOGDEBUG, "CVideoPlayer::Preroll - preparing generation={} entry={:.3f} target={:.3f}",
+            m_resumePictureGeneration, entry / DVD_TIME_BASE, target / DVD_TIME_BASE);
+  return true;
+}
+
+void CVideoPlayer::CancelResumePreroll(bool restoreSpeed)
+{
+  const bool wasPreparing = m_resumePreroll.Active();
+  const uint64_t generation = m_resumePictureGeneration;
+  m_resumePreroll.Cancel();
+  m_resumePictureGeneration = 0;
+  m_resumePrerollTarget.reset();
+  m_resumePrerollReleaseTime = 0.0;
+  m_resumePrerollFailed = false;
+  if (generation != 0)
+  {
+    m_renderManager.CancelVideoPreroll(generation);
+    m_VideoPlayerAudio->SendMessage(
+        std::make_shared<CDVDMsgType<AudioPrerollCommand>>(
+            CDVDMsg::AUDIO_PREROLL,
+            AudioPrerollCommand{AudioPrerollCommand::Action::Cancel, generation, 0.0}),
+        1);
+  }
+  if (restoreSpeed && wasPreparing)
+  {
+    m_playSpeed = DVD_PLAYSPEED_NORMAL;
+    PublishPlaySpeed(DVD_PLAYSPEED_NORMAL, false);
+  }
+}
+
+void CVideoPlayer::RecoverResumePreroll(const char* reason)
+{
+  const auto target = m_resumePrerollTarget;
+  CLog::Log(LOGWARNING, "CVideoPlayer::Preroll - ordinary seek fallback generation={} reason={}",
+            m_resumePictureGeneration, reason);
+  CancelResumePreroll(false);
+  m_clock.SetSpeed(DVD_PLAYSPEED_PAUSE);
+  m_VideoPlayerAudio->SetSpeed(DVD_PLAYSPEED_PAUSE);
+  m_VideoPlayerVideo->SetSpeed(DVD_PLAYSPEED_PAUSE);
+  m_streamPlayerSpeed = DVD_PLAYSPEED_PAUSE;
+  m_playSpeed = DVD_PLAYSPEED_NORMAL;
+  PublishPlaySpeed(DVD_PLAYSPEED_NORMAL, false);
+
+  // A queued user command takes precedence. Do not append an internal seek
+  // behind it: ordinary seek coalescing would then discard the user's target.
+  if (m_bAbortRequest || m_bStop ||
+      m_messenger.GetPacketCount(CDVDMsg::PLAYER_OPENFILE) != 0 ||
+      m_messenger.GetPacketCount(CDVDMsg::PLAYER_ABORT) != 0)
+    return;
+
+  if (m_messenger.GetPacketCount(CDVDMsg::PLAYER_SEEK) != 0 ||
+      m_messenger.GetPacketCount(CDVDMsg::PLAYER_SEEK_CHAPTER) != 0)
+  {
+    // Retire cancelled stream-local generations even if the next seek fails.
+    // The queued user command alone chooses its target. Permit that command
+    // past the ordinary recent-seek throttle, including intervening speed changes.
+    FlushBuffers(DVD_NOPTS_VALUE, false, true);
+    m_resumePrerollSeekPending = true;
+    return;
+  }
+
+  double landed = DVD_NOPTS_VALUE;
+  if (target && m_pDemuxer)
+  {
+    const bool sought = m_pDemuxer->SeekTime(DVD_TIME_TO_MSEC(*target), true, &landed);
+    if (m_pSubtitleDemuxer)
+      m_pSubtitleDemuxer->SeekTime(DVD_TIME_TO_MSEC(*target), true);
+    m_State.dts = *target;
+    m_State.lastSeek = m_clock.GetAbsoluteClock();
+    FlushBuffers(*target, sought, true);
+  }
+  else
+    FlushBuffers(DVD_NOPTS_VALUE, false, true);
+}
+
+bool CVideoPlayer::PollResumePreroll()
+{
+  if (!m_resumePreroll.Active())
+  {
+    if (m_resumePictureGeneration != 0 && !m_resumeGate.IsHolding())
+    {
+      const auto video = m_renderManager.GetVideoPreroll();
+      if (video.generation != m_resumePictureGeneration || video.failed ||
+          (!video.submitted && m_resumePrerollReleaseTime > 0.0 &&
+           m_clock.GetAbsoluteClock() - m_resumePrerollReleaseTime > DVD_MSEC_TO_TIME(2000)))
+      {
+        RecoverResumePreroll("first target picture was not submitted");
+        return true;
+      }
+      if (video.released && video.submitted)
+      {
+        CLog::Log(LOGDEBUG, "CVideoPlayer::Preroll - submitted generation={} target={:.6f}",
+                  m_resumePictureGeneration, video.firstPts / DVD_TIME_BASE);
+        m_resumePictureGeneration = 0;
+        m_resumePrerollTarget.reset();
+        m_resumePrerollReleaseTime = 0.0;
+      }
+    }
+    return false;
+  }
+  if (m_resumePrerollFailed)
+  {
+    RecoverResumePreroll("preparation or release acknowledgement failed");
+    return true;
+  }
+  if (!CanPrepareResumePreroll())
+  {
+    CLog::Log(LOGWARNING,
+              "CVideoPlayer::Preroll - eligibility changed generation={} passthrough={} "
+              "interlaced={} time_offset={:.3f} pts_offset={:.3f}",
+              m_resumePreroll.Generation(), IsPassthrough(),
+              m_processInfo->GetVideoInterlaced(), m_State.time_offset, m_offset_pts);
+    RecoverResumePreroll("stream eligibility changed");
+    return true;
+  }
+
+  const auto video = m_renderManager.GetVideoPreroll();
+  const double now = m_clock.GetAbsoluteClock();
+  if (video.generation != m_resumePreroll.Generation() || video.failed || !video.holding)
+  {
+    RecoverResumePreroll("video hold was invalidated");
+    return true;
+  }
+  if (video.ready)
+  {
+    // Reserve another 100ms for the audio authorization acknowledgement before
+    // giving the retained target to the normal display scheduler.
+    if (!m_resumePreroll.SetVideoReady(video.generation, video.firstPts, now,
+                                      video.requiredLeadUs + DVD_MSEC_TO_TIME(100)))
+    {
+      RecoverResumePreroll("invalid target picture");
+      return true;
+    }
+    if (m_resumePrerollTarget && *m_resumePrerollTarget != video.firstPts)
+    {
+      m_resumePrerollTarget = video.firstPts;
+      m_VideoPlayerAudio->SendMessage(
+          std::make_shared<CDVDMsgType<AudioPrerollCommand>>(
+              CDVDMsg::AUDIO_PREROLL,
+              AudioPrerollCommand{AudioPrerollCommand::Action::SetTarget,
+                                  video.generation, video.firstPts}),
+          1);
+    }
+  }
+
+  const auto decision = m_resumePreroll.Poll(now);
+  if (decision.action == CPlaybackPreroll::Action::StartAudio)
+  {
+    m_clock.Discontinuity(decision.clockPts);
+    m_clock.SetSpeed(DVD_PLAYSPEED_NORMAL);
+    m_CurrentAudio.syncState = IDVDStreamPlayer::SYNC_INSYNC;
+    m_CurrentAudio.avsync = CCurrentStream::AV_SYNC_NONE;
+    m_VideoPlayerAudio->SendMessage(
+        std::make_shared<CDVDMsgDouble>(CDVDMsg::GENERAL_RESYNC, decision.clockPts), 1);
+    m_VideoPlayerAudio->SetSpeed(DVD_PLAYSPEED_NORMAL);
+    CLog::Log(LOGDEBUG, "CVideoPlayer::Preroll - audio generation={} clock={:.3f} target={:.3f}",
+              decision.generation, decision.clockPts / DVD_TIME_BASE,
+              decision.targetPts / DVD_TIME_BASE);
+    return true;
+  }
+  if (decision.action == CPlaybackPreroll::Action::Release)
+  {
+    m_VideoPlayerAudio->SendMessage(
+        std::make_shared<CDVDMsgType<AudioPrerollCommand>>(
+            CDVDMsg::AUDIO_PREROLL,
+            AudioPrerollCommand{AudioPrerollCommand::Action::End,
+                                decision.generation, decision.targetPts}),
+        1);
+    return true;
+  }
+  if (decision.action == CPlaybackPreroll::Action::Fail)
+  {
+    RecoverResumePreroll(decision.reason);
+    return true;
+  }
+  if (m_resumePreroll.Releasing())
+  {
+    // Do not start a potentially blocking source read between authorizing
+    // audio and receiving its acknowledgement; process player controls too.
+    CThread::Sleep(1ms);
+    return true;
+  }
+  return false;
 }
 
