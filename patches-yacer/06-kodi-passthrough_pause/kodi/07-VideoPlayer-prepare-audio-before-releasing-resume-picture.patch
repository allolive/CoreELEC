+  enum class Stage { Idle, Preparing, Running, Releasing };
+  static constexpr double MIN_RUNWAY_US = 100000.0;
+  static constexpr double MAX_TARGET_ADVANCE_US = 100000.0;
+  static constexpr double MAX_SAMPLE_AGE_US = 100000.0;
+  static constexpr double PREPARE_TIMEOUT_US = 5000000.0;
+  static constexpr double RUN_TIMEOUT_US = 3000000.0;
+
+  static bool Nonnegative(double value) { return std::isfinite(value) && value >= 0.0; }
+  bool Current(uint64_t generation) const { return Active() && generation == m_generation; }
+  bool ValidNow(double nowUs) const { return Nonnegative(nowUs) && nowUs >= m_lastNowUs; }
+
+  Decision Finish(Action action, double clock, const char* reason)
+  {
+    const Decision decision{action, m_generation, clock, m_target, reason};
+    Cancel();
+    return decision;
+  }
+
+  Stage m_stage = Stage::Idle;
+  uint64_t m_generation = 0;
+  double m_requestedTarget = 0.0;
+  double m_target = 0.0;
+  double m_beginUs = 0.0;
+  double m_startUs = 0.0;
+  double m_lastNowUs = 0.0;
+  double m_requiredLead = MIN_RUNWAY_US;
+  bool m_videoReady = false;
+  std::optional<Audio> m_audio;
+  std::optional<double> m_firstAudioPts;
+  std::optional<double> m_lastAudioHost;
+  std::optional<double> m_lastSubmittedEnd;
+};
