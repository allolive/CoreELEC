+/** Player-thread ordering of a resume notification and its direct callback work.
+ *
+ * The player remains paused while callbacks run, but continues servicing its
+ * message queue (a callback's synchronous seek needs that queue). Poll requests
+ * one normal-priority FIFO barrier after completion. Only processing that
+ * barrier may commit the requested speed, preserving any seek's caching state.
+ *
+ * This gate establishes command ordering, not audio or display readiness. It
+ * neither holds a hardware picture nor authorizes historical audio replay.
+ * Callback-created timers/workers can still issue later seeks. Such a seek
+ * invalidates the output generation even after the request has completed.
+ */
+class CPlaybackResumeGate
+{
+public:
+  using Clock = std::chrono::steady_clock;
+  enum class Outcome
+  {
+    COMPLETED,
+    FAILED,
+    TIMED_OUT,
+  };
+  struct Release
+  {
+    uint64_t request;
+    uint64_t generation;
+    int speed;
+    bool tempo;
+    Outcome outcome;
+  };
+
+  CPlaybackResumeGate() = default;
+  CPlaybackResumeGate(const CPlaybackResumeGate&) = delete;
+  CPlaybackResumeGate& operator=(const CPlaybackResumeGate&) = delete;
+  ~CPlaybackResumeGate() { Cancel(); }
+
+  // Install the hold BEFORE dispatch. The caller seals after all recipients
+  // have registered; dispatch exceptions must cancel the returned fence.
+  std::shared_ptr<CPlaybackCallbackFence> Begin(
+      int speed,
+      bool tempo,
+      Clock::time_point now,
+      std::chrono::milliseconds timeout = std::chrono::milliseconds{2000})
+  {
+    Cancel();
+    auto fence = std::make_shared<CPlaybackCallbackFence>(++m_request);
+    m_speed = speed;
+    m_tempo = tempo;
+    m_deadline = now + (timeout.count() > 0 ? timeout : std::chrono::milliseconds{0});
+    m_fence = std::move(fence);
+    m_stage = Stage::CALLBACKS;
+    return m_fence;
+  }
+
+  // Nonblocking observation. Enqueue the returned request behind existing
+  // player commands at the SAME priority. Never commit directly from Poll.
+  std::optional<uint64_t> Poll(Clock::time_point now)
+  {
+    if (m_stage != Stage::CALLBACKS)
+      return {};
+    const auto status = m_fence->Read().status;
+    if (status == CPlaybackCallbackFence::Status::COMPLETED)
+      m_outcome = Outcome::COMPLETED;
+    else if (status == CPlaybackCallbackFence::Status::FAILED ||
+             status == CPlaybackCallbackFence::Status::CANCELLED)
+      m_outcome = Outcome::FAILED;
+    else if (now >= m_deadline)
+    {
+      // A timeout uses ordinary resume as an explicit fallback. Cancellation
+      // prevents late completion from certifying the request; it does not stop
+      // the callback body or withdraw commands it already submitted.
+      m_fence->Cancel();
+      m_outcome = Outcome::TIMED_OUT;
+    }
+    else
+      return {};
+
+    m_stage = Stage::BARRIER;
+    return m_request;
+  }
+
+  // Call only after the barrier reaches the head of the player FIFO. If seek
+  // coalescing sees another queued seek, postpone the barrier behind that seek.
+  std::optional<Release> Commit(uint64_t request)
+  {
+    if (m_stage != Stage::BARRIER || request != m_request)
+      return {};
+    if (m_outcome == Outcome::COMPLETED &&
+        m_fence->Read().status != CPlaybackCallbackFence::Status::COMPLETED)
+      m_outcome = Outcome::FAILED;
+    const Release release{m_request, m_generation, m_speed, m_tempo, m_outcome};
+    m_stage = Stage::IDLE;
+    m_fence.reset();
+    return release;
+  }
+
+  // Pause, stop, replacement playback and an overriding speed request cancel
+  // the request. Old barriers and callbacks cannot commit a subsequent resume.
+  void Cancel()
+  {
+    if (m_fence)
+      m_fence->Cancel();
+    m_fence.reset();
+    m_stage = Stage::IDLE;
+    InvalidateOutput();
+  }
+
+  // A seek/discontinuity replaces output, not the resume request. In particular
+  // a callback that seeks must complete the same request it was given.
+  void InvalidateOutput() { ++m_generation; }
+  bool IsHolding() const { return m_stage != Stage::IDLE; }
+  bool IsCurrentRequest(uint64_t request) const
+  {
+    return IsHolding() && request == m_request;
+  }
+
+private:
+  enum class Stage { IDLE, CALLBACKS, BARRIER };
+  Stage m_stage = Stage::IDLE;
+  uint64_t m_request = 0;
+  uint64_t m_generation = 0;
+  int m_speed = 0;
+  bool m_tempo = false;
+  Outcome m_outcome = Outcome::FAILED;
+  Clock::time_point m_deadline{};
+  std::shared_ptr<CPlaybackCallbackFence> m_fence;
+};
