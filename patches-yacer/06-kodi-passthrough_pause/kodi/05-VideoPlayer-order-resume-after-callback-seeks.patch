+bool CVideoPlayer::PollResumeGate()
+{
+  if (const auto request = m_resumeGate.Poll(CPlaybackResumeGate::Clock::now()))
+  {
+    if (m_messenger.Put(
+            std::make_shared<CDVDMsgType<uint64_t>>(CDVDMsg::PLAYER_RESUME_BARRIER, *request),
+            0) == MSGQ_OK)
+      return true;
+    m_resumeGate.Cancel();
+  }
+  return false;
+}
+
+void CVideoPlayer::ReleaseResumeGate(const CPlaybackResumeGate::Release& release)
+{
+  if (release.outcome == CPlaybackResumeGate::Outcome::COMPLETED)
+    CLog::Log(LOGDEBUG, "CVideoPlayer::ResumeGate - callback barrier request={} generation={}",
+              release.request, release.generation);
+  else
+    CLog::Log(LOGWARNING,
+              "CVideoPlayer::ResumeGate - ordinary resume fallback request={} generation={} reason={}",
+              release.request, release.generation,
+              release.outcome == CPlaybackResumeGate::Outcome::TIMED_OUT ? "timeout" : "callback failure");
+
+  m_playSpeed = release.speed;
+  PublishPlaySpeed(release.speed, release.tempo);
+  m_processInfo->SetFrameAdvance(false);
+
+  // A callback may have sought while paused. Preserve its buffering state;
+  // SetCaching releases the streams when the existing startup conditions pass.
+  if (m_caching == CACHESTATE_PLAY || m_caching == CACHESTATE_DONE)
+  {
+    m_clock.SetSpeed(release.speed);
+    m_VideoPlayerAudio->SetSpeed(release.speed);
+    m_VideoPlayerVideo->SetSpeed(release.speed);
+    m_streamPlayerSpeed = release.speed;
+  }
+}
