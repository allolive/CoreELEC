+void CVideoPlayer::PublishPlaySpeed(int speed, bool tempo)
+{
+  // SetSpeed also writes ProcessInfo's requested speed. Preserve a newer
+  // queued request atomically with producers, without holding this lock while
+  // notifying callbacks or changing endpoint speed.
+  std::unique_lock lock(m_speedRequestMutex);
+  const float requestedSpeed = m_processInfo->GetNewSpeed();
+  const float requestedTempo = m_processInfo->GetNewTempo();
+  if (tempo)
+    m_processInfo->SetTempo(static_cast<float>(speed) / DVD_PLAYSPEED_NORMAL);
+  else
+    m_processInfo->SetSpeed(static_cast<float>(speed) / DVD_PLAYSPEED_NORMAL);
+  if (m_messenger.GetPacketCount(CDVDMsg::PLAYER_SETSPEED) != 0)
+  {
+    m_processInfo->SetNewTempo(requestedTempo);
+    m_processInfo->SetNewSpeed(requestedSpeed);
+  }
+}
