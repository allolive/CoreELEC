+    // container runs up to 1.33 ms from the media actually submitted, and a
+    // one-millisecond allowance refused real audio. Judge against the
+    // accumulated end regardless, so a gap that repeats every frame still
+    // diverges without bound and is caught, however small each step is.
+    constexpr double QUANTIZATION_US = 2000.0;
+    constexpr double ROUNDING_US = 0.001;
+    return !Buffered() || std::abs(pts - m_submittedEndPts) <= QUANTIZATION_US + ROUNDING_US;
   }
 
