+
+double CVideoPlayer::ResumePrerollLeadIn(double rendererLeadUs,
+                                         double& settle,
+                                         double& receiverStart) const
+{
+  // What still has to be ahead of the picture when audio is authorised: the
+  // lead the renderer computes from display latency and frame time, the
+  // acknowledgement reserve, and the queued audio the preroll will not go
+  // below. PollResumePreroll charges the renderer the same reserve.
+  // A receiver's own start-up is invisible from here: host queue timing cannot
+  // see when an AVR begins producing sound, only when bytes were handed over.
+  // Judged by ear, TrueHD becomes audible appreciably later than DTS from the
+  // same submitted position, so it is given that much more lead to spend.
+  receiverStart =
+      m_CurrentAudio.hint.codec == AV_CODEC_ID_TRUEHD ? DVD_MSEC_TO_TIME(350) : 0.0;
+  // Decode this much more and throw it away. A packer restarting after a codec
+  // reset emits nothing usable until its own sync returns: for TrueHD that is
+  // the next major sync, one every 128 access units. Their rate is 1200 Hz at
+  // every sample rate - a unit carries 40 << ratebits samples, not 40 - so the
+  // interval is the same 106.7 ms throughout. Discarding it leaves every codec
+  // the same audible lead-in instead of the worst one's.
+  settle = m_CurrentAudio.hint.codec == AV_CODEC_ID_TRUEHD ? DVD_SEC_TO_TIME(128.0 / 1200.0)
+                                                           : 0.0;
+  return rendererLeadUs + CPlaybackPreroll::PresentationReserveUs() +
+         CPlaybackPreroll::AckReserveUs() + receiverStart;
+}
+
+bool CVideoPlayer::ResumePrerollHasLead(double target, double rendererLeadUs) const
+{
+  // Nearer the start than the lead-in and the settle, the earlier seek has
+  // nowhere to go back to: the audio cannot give the lead the release needs,
+  // and the preparation only adds a flush before the fallback's own.
+  double settle = 0.0;
+  double receiverStart = 0.0;
+  const double leadIn = ResumePrerollLeadIn(rendererLeadUs, settle, receiverStart);
+  if (target >= leadIn + settle)
+    return true;
+  CLog::Log(LOGDEBUG,
+            "CVideoPlayer::Preroll - not prepared: target={:.3f} within lead_in_ms={:.1f} "
+            "settle_ms={:.1f}",
+            target / DVD_TIME_BASE, leadIn / 1000.0, settle / 1000.0);
+  return false;
+}
+
+void CVideoPlayer::ArmResumePreroll()
+{
+  if (m_resumePictureGeneration != 0 || m_resumeGate.IsHolding() || !CanPrepareResumePreroll())
+    return;
+  const double target = m_clock.GetClock();
+  if (!std::isfinite(target) || target < 0.0 ||
+      !ResumePrerollHasLead(target, m_renderManager.GetVideoPrerollLead()))
+    return;
+  m_resumeGate.InvalidateOutput();
+  const uint64_t generation = m_resumeGate.OutputGeneration();
+  if (generation == 0 || !m_renderManager.BeginVideoPreroll(generation, DVD_NOPTS_VALUE))
+    return;
+  m_resumePictureGeneration = generation;
+  m_resumePrerollTarget = target;
+  m_resumePrerollPaused = true;
+  if (!BeginResumePreroll(true))
+  {
+    m_resumePrerollPaused = false;
+    m_playSpeed = DVD_PLAYSPEED_PAUSE;
+    PublishPlaySpeed(DVD_PLAYSPEED_PAUSE, false);
+  }
+}
