diff --git a/xbmc/utils/PlaybackCallbackFence.h b/xbmc/utils/PlaybackCallbackFence.h
new file mode 100644
--- /dev/null
+++ b/xbmc/utils/PlaybackCallbackFence.h
@@ -0,0 +1,172 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <utility>
+
+/** Completion of callbacks dispatched for one resume request, without waiting.
+ *
+ * A resume request survives a seek made by its callback; the output generation
+ * does not. This object intentionally tracks only the request identity. Its
+ * completion is not permission to release A/V: the player must process a FIFO
+ * barrier after callback-issued seeks, then wait for the current endpoints.
+ */
+class CPlaybackCallbackFence
+{
+public:
+  enum class Status
+  {
+    REGISTERING,
+    PENDING,
+    COMPLETED,
+    FAILED,
+    CANCELLED,
+  };
+
+  struct Snapshot
+  {
+    uint64_t request = 0;
+    Status status = Status::REGISTERING;
+    size_t pending = 0;
+    size_t returned = 0;
+    size_t failed = 0;
+    size_t discarded = 0;
+  };
+
+private:
+  struct State
+  {
+    explicit State(uint64_t id) : request(id) {}
+    std::mutex mutex;
+    const uint64_t request;
+    bool sealed = false;
+    bool cancelled = false;
+    bool lateRegistration = false;
+    size_t pending = 0;
+    size_t returned = 0;
+    size_t failed = 0;
+    size_t discarded = 0;
+  };
+
+public:
+  class Ticket
+  {
+  public:
+    Ticket(const Ticket&) = delete;
+    Ticket& operator=(const Ticket&) = delete;
+    ~Ticket() { Finish(Outcome::DISCARDED); }
+
+    // Keep this ticket alive during invocation. Exceptions still reach Kodi's
+    // existing callback handler; completion records the failure before rethrow.
+    template<typename Function>
+    bool Invoke(Function&& function)
+    {
+      if (m_invoked.exchange(true))
+        return false;
+      try
+      {
+        std::forward<Function>(function)();
+        Finish(Outcome::RETURNED);
+      }
+      catch (...)
+      {
+        Finish(Outcome::FAILED);
+        throw;
+      }
+      return true;
+    }
+
+  private:
+    friend class CPlaybackCallbackFence;
+    enum class Outcome { RETURNED, FAILED, DISCARDED };
+    explicit Ticket(std::shared_ptr<State> state) : m_state(std::move(state)) {}
+
+    void Finish(Outcome outcome)
+    {
+      if (!m_registered)
+        return;
+      if (m_finished.exchange(true))
+        return;
+      // No player calls, queue messages or external callbacks under this lock.
+      // Destruction can happen while the legacy callback-list lock is held.
+      std::lock_guard<std::mutex> lock(m_state->mutex);
+      --m_state->pending;
+      switch (outcome)
+      {
+        case Outcome::RETURNED: ++m_state->returned; break;
+        case Outcome::FAILED: ++m_state->failed; break;
+        case Outcome::DISCARDED: ++m_state->discarded; break;
+      }
+    }
+
+    std::shared_ptr<State> m_state;
+    // Armed only after shared_ptr control-block allocation succeeds. Its
+    // failure can destroy this ticket while Register still owns State::mutex.
+    bool m_registered = false;
+    std::atomic<bool> m_invoked{false};
+    std::atomic<bool> m_finished{false};
+  };
+
+  explicit CPlaybackCallbackFence(uint64_t request) : m_state(std::make_shared<State>(request)) {}
+
+  std::shared_ptr<Ticket> Register()
+  {
+    std::lock_guard<std::mutex> lock(m_state->mutex);
+    if (m_state->cancelled)
+      return {};
+    if (m_state->sealed)
+    {
+      m_state->lateRegistration = true;
+      return {};
+    }
+    auto ticket = std::shared_ptr<Ticket>(new Ticket(m_state));
+    ++m_state->pending;
+    ticket->m_registered = true;
+    return ticket;
+  }
+
+  // Called only after every recipient has been offered registration.
+  void Seal()
+  {
+    std::lock_guard<std::mutex> lock(m_state->mutex);
+    m_state->sealed = true;
+  }
+
+  // Stop/pause/replacement request and timeout invalidate permission immediately.
+  // Outstanding callbacks can finish safely; their results cannot uncancel it.
+  void Cancel()
+  {
+    std::lock_guard<std::mutex> lock(m_state->mutex);
+    m_state->cancelled = true;
+  }
+
+  Snapshot Read() const
+  {
+    std::lock_guard<std::mutex> lock(m_state->mutex);
+    Status status = Status::REGISTERING;
+    if (m_state->cancelled)
+      status = Status::CANCELLED;
+    else if (!m_state->sealed)
+      status = Status::REGISTERING;
+    else if (m_state->pending != 0)
+      status = Status::PENDING;
+    else if (m_state->failed || m_state->discarded || m_state->lateRegistration)
+      status = Status::FAILED;
+    else
+      status = Status::COMPLETED;
+    return {m_state->request, status, m_state->pending, m_state->returned,
+            m_state->failed, m_state->discarded};
+  }
+
+private:
+  std::shared_ptr<State> m_state;
+};
