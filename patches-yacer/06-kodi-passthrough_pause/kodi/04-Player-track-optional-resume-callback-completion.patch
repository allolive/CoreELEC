@@ -247,8 +247,17 @@
 
     void Player::OnPlayBackResumed()
     {
-      XBMC_TRACE;
-      invokeCallback(new CallbackFunction<Player>(this,&Player::onPlayBackResumed));
+      OnPlayBackResumed({});
+    }
+
+    void Player::OnPlayBackResumed(const std::shared_ptr<CPlaybackCallbackFence>& fence)
+    {
+      XBMC_TRACE;
+      if (fence)
+        invokeCallback(new CallbackFunctionWithCompletion<Player>(
+            this, &Player::onPlayBackResumed, fence->Register()));
+      else
+        invokeCallback(new CallbackFunction<Player>(this,&Player::onPlayBackResumed));
     }
 
     void Player::OnQueueNextItem()
@@ -607,4 +616,3 @@
     }
   }
 }
