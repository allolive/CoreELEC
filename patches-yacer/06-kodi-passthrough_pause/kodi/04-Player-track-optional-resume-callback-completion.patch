diff --git a/xbmc/cores/IPlayerCallback.h b/xbmc/cores/IPlayerCallback.h
index 3c1d99b481..165659fdec 100644
--- a/xbmc/cores/IPlayerCallback.h
+++ b/xbmc/cores/IPlayerCallback.h
@@ -9,6 +9,7 @@
 #pragma once
 
 #include "VideoSettings.h"
+#include "utils/PlaybackCallbackFence.h"
 
 #include <stdint.h>
 
@@ -24,6 +25,14 @@ public:
   virtual void OnPlayerCloseFile(const CFileItem& file, const CBookmark& bookmark) {}
   virtual void OnPlayBackPaused() {}
   virtual void OnPlayBackResumed() {}
+  // Internal opt-in completion tracking. Unknown callback implementations keep
+  // their notification, but a discarded ticket prevents claiming completion
+  // of work they may have queued asynchronously.
+  virtual void OnPlayBackResumed(const std::shared_ptr<CPlaybackCallbackFence>& fence)
+  {
+    auto unsupported = fence ? fence->Register() : nullptr;
+    OnPlayBackResumed();
+  }
   virtual void OnPlayBackStopped() = 0;
   virtual void OnPlayBackError() = 0;
   virtual void OnQueueNextItem() = 0;
diff --git a/xbmc/interfaces/legacy/CallbackFunction.h b/xbmc/interfaces/legacy/CallbackFunction.h
index 90360d57f9..82acc0c987 100644
--- a/xbmc/interfaces/legacy/CallbackFunction.h
+++ b/xbmc/interfaces/legacy/CallbackFunction.h
@@ -9,6 +9,7 @@
 #pragma once
 
 #include "AddonClass.h"
+#include "utils/PlaybackCallbackFence.h"
 
 namespace XBMCAddon
 {
@@ -65,6 +66,32 @@ namespace XBMCAddon
     void executeCallback() override { XBMC_TRACE; ((*obj).*(meth))(); }
   };
 
+  // Only a tracked resume callback uses this decorator. Queue removal, handler
+  // teardown and deallocating recipients destroy the ticket as DISCARDED.
+  // Invocation records return/exception without changing handler behavior.
+  template<class M>
+  class CallbackFunctionWithCompletion : public CallbackFunction<M>
+  {
+  public:
+    CallbackFunctionWithCompletion(
+        M* object, typename CallbackFunction<M>::MemberFunction method,
+        std::shared_ptr<CPlaybackCallbackFence::Ticket> ticket)
+      : CallbackFunction<M>(object, method), m_ticket(std::move(ticket))
+    {
+    }
+
+    void executeCallback() override
+    {
+      if (m_ticket)
+        m_ticket->Invoke([this] { CallbackFunction<M>::executeCallback(); });
+      else
+        CallbackFunction<M>::executeCallback();
+    }
+
+  private:
+    std::shared_ptr<CPlaybackCallbackFence::Ticket> m_ticket;
+  };
+
   /**
    * This is the template to carry a callback to a member function
    *  that returns 'void' (has no return) and takes one parameter.
@@ -168,4 +195,3 @@ namespace XBMCAddon
   };
 }
 
