+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "AsyncFileSink.h"
+
+#include <cstddef>
+#include <utility>
+
+namespace
+{
+//! about a minute of debug logging
+constexpr std::size_t MaxQueued = 8 * 1024 * 1024;
+constexpr std::size_t InitialQueue = 64 * 1024;
+} // unnamed namespace
+
+CAsyncFileSink::CAsyncFileSink(const spdlog::filename_t& filename)
+{
+  m_file.open(filename, false);
+  m_queue.reserve(InitialQueue);
+  m_writer = std::thread(&CAsyncFileSink::Process, this);
+}
+
+CAsyncFileSink::~CAsyncFileSink()
+{
+  {
+    std::lock_guard lock(m_lock);
+    m_stop = true;
+  }
+  m_queued.notify_one();
+  m_writer.join();
+}
+
+void CAsyncFileSink::sink_it_(const spdlog::details::log_msg& msg)
+{
+  std::unique_lock lock(m_lock);
+  m_taken.wait(lock, [this] { return m_queue.size() < MaxQueued; });
+  const bool wasEmpty = m_queue.size() == 0;
+  formatter_->format(msg, m_queue);
+  lock.unlock();
+
+  // the writer only waits on an empty queue
+  if (wasEmpty)
+    m_queued.notify_one();
+}
+
+void CAsyncFileSink::Process()
+{
+  spdlog::memory_buf_t lines;
+  lines.reserve(InitialQueue);
+
+  std::unique_lock lock(m_lock);
+  while (true)
+  {
+    m_queued.wait(lock, [this] { return m_stop || m_queue.size() > 0; });
+    if (m_queue.size() == 0)
+      break;
+
+    const bool wasFull = m_queue.size() >= MaxQueued;
+    std::swap(lines, m_queue);
+    lock.unlock();
+    if (wasFull)
+      m_taken.notify_one();
+
+    try
+    {
+      m_file.write(lines);
+      m_file.flush();
+    }
+    catch (const spdlog::spdlog_ex&)
+    {
+      // there is nowhere to report it: the lines are lost
+    }
+    lines.clear();
+
+    lock.lock();
+  }
+}
diff --git a/xbmc/utils/AsyncFileSink.h b/xbmc/utils/AsyncFileSink.h
new file mode 100644
index 0000000..6322982
--- /dev/null
+++ b/xbmc/utils/AsyncFileSink.h
@@ -0,0 +1,49 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+
+#include <spdlog/details/file_helper.h>
+#include <spdlog/details/null_mutex.h>
+#include <spdlog/sinks/base_sink.h>
+
+/*!
+ * \brief A log file written from its own thread.
+ *
+ * The thread that logs only formats its line, so a log file on storage that stops answering for a
+ * moment holds up the writer, not every thread that logs. Nothing is dropped: once the queue is
+ * full, the thread that logs waits.
+ */
+class CAsyncFileSink : public spdlog::sinks::base_sink<spdlog::details::null_mutex>
+{
+public:
+  explicit CAsyncFileSink(const spdlog::filename_t& filename);
+  ~CAsyncFileSink() override;
+
+protected:
+  void sink_it_(const spdlog::details::log_msg& msg) override;
+  //! the writer flushes everything it writes
+  void flush_() override {}
+
+private:
+  void Process();
+
+  spdlog::details::file_helper m_file;
+
+  std::mutex m_lock;
+  std::condition_variable m_queued;
+  std::condition_variable m_taken;
+  spdlog::memory_buf_t m_queue;
+  bool m_stop{false};
+
+  std::thread m_writer;
+};
