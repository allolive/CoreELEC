 // GLES2.0 cant do CLAMP, but can do CLAMP_TO_EDGE.
 #define GL_CLAMP GL_CLAMP_TO_EDGE
@@ -143,6 +148,54 @@ std::shared_ptr<COverlay> COverlay::Create(const CDVDOverlayImage& o, CRect& rSo
   return std::make_shared<COverlayTextureGLES>(o, rSource);
 }
 
+namespace
+{
+//! At most a 4x enlargement: past that the staircase is already gone and the
+//! texture only costs memory.
+constexpr int PIXELART_MAX_PASSES = 2;
+
+//! and never more texture than this. A line of subtitle text costs a megabyte
+//! or two, but a full-frame graphic doubled twice would run to tens of them,
+//! and the work happens on the thread that is drawing the frame it appears on.
+constexpr int64_t PIXELART_MAX_PIXELS = 4 * 1024 * 1024;
+
+//! How many times to double the bitmap before it is uploaded. Only whole
+//! doublings that still fit inside the area the subtitle is drawn into are
+//! taken: a 1080p canvas on a 4K screen is doubled once, the same canvas at
+//! 1080p is left alone. Going further would make the texture larger than its
+//! destination, and the driver would simply average it back down again.
+int PixelArtPasses(int sourceWidth, int sourceHeight, int width, int height)
+{
+  if (sourceWidth <= 0 || sourceHeight <= 0 || width <= 0 || height <= 0)
+    return 0;
+
+  auto& gfx = CServiceBroker::GetWinSystem()->GetGfxContext();
+  const int screenWidth = gfx.GetWidth();
+  const int screenHeight = gfx.GetHeight();
+  if (screenWidth <= 0 || screenHeight <= 0)
+    return 0;
+
+  const int enlargement = std::min(screenWidth / sourceWidth, screenHeight / sourceHeight);
+
+  GLint maxTexture = 0;
+  glGetIntegerv(GL_MAX_TEXTURE_SIZE, &maxTexture);
+  if (maxTexture <= 0)
+    return 0; // no idea what the driver will take: leave the bitmap alone
+
+  int passes = 0;
+  while (passes < PIXELART_MAX_PASSES && (1 << (passes + 1)) <= enlargement)
+  {
+    const int64_t w = width << (passes + 1);
+    const int64_t h = height << (passes + 1);
+    if (w > maxTexture || h > maxTexture || w * h > PIXELART_MAX_PIXELS)
+      break;
+    ++passes;
+  }
+
+  return passes;
+}
+} // unnamed namespace
