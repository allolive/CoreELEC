diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.cpp
index d371fe1..d87c8df 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.cpp
@@ -24,6 +24,81 @@
 namespace OVERLAY
 {
 
+namespace
+{
+//! Two samples count as the same paint within this per-channel distance.
+//! Image subtitles are painted from a small palette of flat tones, but the
+//! authored antialiasing between two of them must not read as a third.
+constexpr int PIXELART_TOLERANCE = 24;
+
+bool SameTone(uint32_t a, uint32_t b)
+{
+  if (a == b)
+    return true;
+  for (int shift = 0; shift < 32; shift += 8)
+  {
+    const int d = static_cast<int>((a >> shift) & 0xff) - static_cast<int>((b >> shift) & 0xff);
+    if (d > PIXELART_TOLERANCE || d < -PIXELART_TOLERANCE)
+      return false;
+  }
+  return true;
+}
+} // unnamed namespace
+
+void PixelArtScale(std::vector<uint32_t>& rgba, int& width, int& height, int passes)
+{
+  for (int pass = 0; pass < passes; ++pass)
+  {
+    const int w = width;
+    const int h = height;
+    if (w < 2 || h < 2 || rgba.size() < static_cast<size_t>(w) * h)
+      return;
+
+    std::vector<uint32_t> out(static_cast<size_t>(w) * h * 4);
+    for (int y = 0; y < h; ++y)
+    {
+      const uint32_t* row = rgba.data() + static_cast<size_t>(y) * w;
+      const uint32_t* above = (y > 0) ? row - w : row;
+      const uint32_t* below = (y < h - 1) ? row + w : row;
+      uint32_t* top = out.data() + static_cast<size_t>(2 * y) * (2 * w);
+      uint32_t* bottom = top + 2 * w;
+
+      for (int x = 0; x < w; ++x)
+      {
+        const uint32_t centre = row[x];
+        const uint32_t up = above[x];
+        const uint32_t down = below[x];
+        const uint32_t left = row[x > 0 ? x - 1 : x];
+        const uint32_t right = row[x < w - 1 ? x + 1 : x];
+
+        uint32_t tl = centre, tr = centre, bl = centre, br = centre;
+        // both pairs must disagree: inside a shape, or along a straight
+        // edge, at least one of them matches and the pixel is left alone
+        if (!SameTone(up, down) && !SameTone(left, right))
+        {
+          if (SameTone(up, left))
+            tl = left;
+          if (SameTone(up, right))
+            tr = right;
+          if (SameTone(down, left))
+            bl = left;
+          if (SameTone(down, right))
+            br = right;
+        }
+
+        top[2 * x] = tl;
+        top[2 * x + 1] = tr;
+        bottom[2 * x] = bl;
+        bottom[2 * x + 1] = br;
+      }
+    }
+
+    rgba.swap(out);
+    width = w * 2;
+    height = h * 2;
+  }
+}
+
 static uint32_t build_rgba(int a, int r, int g, int b, bool mergealpha)
 {
   if(mergealpha)
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.h b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.h
index 3a62975..b4a2e56 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.h
@@ -61,6 +61,15 @@ void convert_rgba(const CDVDOverlaySpu& o,
                   int& min_y,
                   int& max_y,
                   std::vector<uint32_t>& rgba);
+//! Doubles a bitmap subtitle `passes` times using the Scale2x (EPX) rule:
+//! every pixel becomes four, and a corner takes a neighbour's colour only
+//! where the two neighbours meeting at that corner match each other and the
+//! opposite pair does not - which is what a staircase step looks like and
+//! what a flat area or a straight edge does not. No colour is ever averaged
+//! into existence, so the palette, the alpha and the letter shapes survive
+//! unchanged; only step corners round off. `width` and `height` are updated.
+void PixelArtScale(std::vector<uint32_t>& rgba, int& width, int& height, int passes);
+
 bool convert_quad(ASS_Image* images, SQuads& quads, int max_x);
 int GetStereoscopicDepth(bool isPgs, int subtitleDepth);
 
