+namespace
+{
+//! Subtitles > Placement.
+enum class Placement
+{
+  OFF = 0,
+  BLACK_BARS = 1, //!< to the edges of the display, into the bars of a wide film
+};
+
+//! Gap between a moved subtitle and the edge it is moved to, in screen pixels.
+constexpr float EDGE_MARGIN = 20.0f;
+
+//! The top and bottom edges subtitles are moved to, within a frame of the
+//! given height starting at y.
+std::pair<float, float> PlacementEdges(float y, float height)
+{
+  return {y + EDGE_MARGIN, y + height - EDGE_MARGIN};
+}
+
+//! A two-line image block against the height of one of its lines, until a real
+//! two-line subtitle has been seen: measured on UHD Blu-ray PGS, 67 against 158.
+constexpr float TWO_LINES_PER_LINE = 2.36f;
+
+//! Lines in an image subtitle block by its height on the canvas: 1, 2, or 0 when
+//! it is neither and is left alone. One line of disc subtitle text is 5-6% of
+//! the canvas height, two are 13-15%.
+int ImageSubtitleLines(float height, float canvasHeight)
+{
+  if (height < 0.10f * canvasHeight)
+    return 1;
+  if (height < 0.20f * canvasHeight)
+    return 2;
+  return 0;
+}
+
+//! Lines in a text subtitle block against the height of one line of the
+//! subtitle font, borders and shadows included: 1, 2, or 0 when it is neither.
+int TextSubtitleLines(float height, float lineHeight)
+{
+  if (height < 1.6f * lineHeight)
+    return 1;
+  if (height < 2.8f * lineHeight)
+    return 2;
+  return 0;
+}
+} // unnamed namespace
+
+bool CRenderer::PlacementActive()
+{
+  // Read here rather than in LoadSettings(), which only runs while text
+  // subtitles are being prepared: with image subtitles alone it never would.
+  if (m_placementStale.exchange(false))
+    m_placement = CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+        CSettings::SETTING_SUBTITLES_PLACEMENT);
+  return static_cast<Placement>(m_placement) != Placement::OFF &&
+         (m_stereomode.empty() || m_stereomode == "mono");
+}
+
+float CRenderer::BottomBlockShift(
+    SPlacement& memory, float top, float end, int lines, float twoLinesGuess, float bottomEdge)
+{
+  const float block = end - top;
+
+  // The first line sits where a two-line subtitle's would, so it does not move
+  // between one line and two. Guessed until the first two-line subtitle of the
+  // file is seen, then fixed.
+  if (lines == 2 && !memory.learned)
+  {
+    memory.twoLineHeight = block;
+    memory.learned = true;
+  }
+
+  const float twoLines = memory.learned ? memory.twoLineHeight : twoLinesGuess;
+  // never past the edge: a block taller than two lines ends at it
+  const float firstLine = std::min(bottomEdge - twoLines, bottomEdge - block);
+  return firstLine - top;
+}
+
+std::vector<float> CRenderer::PlacementShifts(const std::vector<SElement*>& elements,
+                                              const std::vector<std::shared_ptr<COverlay>>& overlays)
+{
+  std::vector<float> shifts(overlays.size(), 0.0f);
+  if (!PlacementActive())
+    return shifts;
+
+  // Image subtitles in the lower third are one bottom block, those in the upper
+  // third one top block, each moved as a whole so lines authored as separate
+  // objects keep their spacing. Anything else stays where it was authored.
+  for (const bool bottom : {true, false})
+  {
+    std::vector<size_t> members;
+    float top = 0.0f; // on the canvas, for counting lines
+    float end = 0.0f;
+    float screenTop = 0.0f; // on screen, for moving them
+    float screenEnd = 0.0f;
+    float canvas = 0.0f;
+    bool usable = true;
+
+    for (size_t i = 0; i < overlays.size(); i++)
+    {
+      const auto& dvd = elements[i]->overlay_dvd;
+      if (!dvd->IsOverlayType(DVDOVERLAY_TYPE_IMAGE))
+        continue;
+
+      const auto& img = static_cast<const CDVDOverlayImage&>(*dvd);
+      const float height = static_cast<float>(img.source_height);
+      if (height <= 0.0f)
+        continue;
+
+      const float y = static_cast<float>(img.y);
+      const float h = static_cast<float>(img.height);
+      const float centre = y + h / 2.0f;
+      if (bottom ? centre <= height * 2.0f / 3.0f : centre >= height / 3.0f)
+        continue;
+
+      // Where Render() puts it: the centre is mapped onto the video, or onto
+      // the view, and the size with it - or, keeping the canvas's aspect
+      // ratio, by the fit of the canvas into the view.
+      float sTop = 0.0f;
+      float sEnd = 0.0f;
+      switch (overlays[i]->m_align)
+      {
+        case COverlay::ALIGN_VIDEO:
+        case COverlay::ALIGN_SCREEN:
+        {
+          const CRect& area =
+              overlays[i]->m_align == COverlay::ALIGN_VIDEO ? m_rd : m_rv;
+          const float scale = area.Height() / height;
+          sTop = area.y1 + y * scale;
+          sEnd = area.y1 + (y + h) * scale;
+          break;
+        }
+        case COverlay::ALIGN_SCREEN_AR:
+        {
+          const float width = static_cast<float>(img.source_width);
+          if (width <= 0.0f)
+          {
+            usable = false;
+            break;
+          }
+          const float fit = std::min(m_rv.Width() / width, m_rv.Height() / height);
+          const float screenCentre = m_rv.y1 + centre / height * m_rv.Height();
+          sTop = screenCentre - h / 2.0f * fit;
+          sEnd = screenCentre + h / 2.0f * fit;
+          break;
+        }
+        default:
+          usable = false;
+          break;
+      }
+      if (!usable || sEnd <= sTop)
+      {
+        usable = false;
+        break;
+      }
+
+      if (members.empty())
+      {
+        top = y;
+        end = y + h;
+        screenTop = sTop;
+        screenEnd = sEnd;
+        canvas = height;
+      }
+      else if (height != canvas)
+      {
+        usable = false;
+        break;
+      }
+      top = std::min(top, y);
+      end = std::max(end, y + h);
+      screenTop = std::min(screenTop, sTop);
+      screenEnd = std::max(screenEnd, sEnd);
+      members.push_back(i);
+    }
+
+    if (members.empty() || !usable)
+      continue;
+
+    // Lines only matter at the bottom, where the first one is held still; a top
+    // block of any height goes to the top edge.
+    const int lines = ImageSubtitleLines(end - top, canvas);
+    if (bottom && lines == 0)
+      continue;
+
+    if (m_imagePlacement.reference != canvas)
+    {
+      m_imagePlacement = {};
+      m_imagePlacement.reference = canvas;
+    }
+
+    const auto [topEdge, bottomEdge] =
+        PlacementEdges(m_rv.y1, m_rv.Height());
+    const float shift = bottom ? BottomBlockShift(m_imagePlacement, screenTop, screenEnd, lines,
+                                                  (screenEnd - screenTop) * TWO_LINES_PER_LINE,
+                                                  bottomEdge)
+                               : topEdge - screenTop;
+
+    // whole screen pixels: a fraction would lose the pixel-aligned draw and blur it
+    for (const size_t i : members)
+      shifts[i] = std::round(shift);
+  }
+
+  return shifts;
+}
+
+int CRenderer::PlaceTextSubtitles(ASS_Image* images, int frameHeight, bool place)
+{
+  // Putting back undoes exactly the moves last made, whatever the settings are now.
+  if (!place)
+  {
+    for (const auto& [img, move] : m_textMoves)
+      img->dst_y -= move;
+    const int count = static_cast<int>(m_textMoves.size());
+    m_textMoves.clear();
+    return count;
+  }
+  m_textMoves.clear();
+
+  if (!images || frameHeight <= 0 || !PlacementActive() || !m_overlayStyle)
+    return 0;
+
+  const float height = static_cast<float>(frameHeight);
+  if (m_textPlacement.reference != height)
+  {
+    m_textPlacement = {};
+    m_textPlacement.reference = height;
+  }
+
+  // libass lays out on the frame, so the edges are in its pixels
+  const auto [topEdge, bottomEdge] =
+      PlacementEdges(0.0f, height);
+
+  // One line of text: Kodi's subtitle font size is set for a 720-line frame,
+  // and the line spacing setting adds up to a sixteenth of the frame per line.
+  const float lineHeight =
+      static_cast<float>(m_overlayStyle->fontSize) * height / 720.0f +
+      static_cast<float>(m_overlayStyle->lineSpacing) / 100.0f * height / 16.0f;
+
+  // The rendered pieces in the lower third are the bottom block, those in the
+  // upper third the top block; each is moved as a whole, as image subtitles are.
+  for (const bool bottom : {true, false})
+  {
+    float top = 0.0f;
+    float end = 0.0f;
+    bool found = false;
+    for (const ASS_Image* img = images; img; img = img->next)
+    {
+      if (img->w <= 0 || img->h <= 0)
+        continue;
+      const float y = static_cast<float>(img->dst_y);
+      const float h = static_cast<float>(img->h);
+      const float centre = y + h / 2.0f;
+      if (bottom ? centre <= height * 2.0f / 3.0f : centre >= height / 3.0f)
+        continue;
+      top = found ? std::min(top, y) : y;
+      end = found ? std::max(end, y + h) : y + h;
+      found = true;
+    }
+    if (!found)
+      continue;
+
+    const int lines = TextSubtitleLines(end - top, lineHeight);
+    if (bottom && lines == 0)
+      continue;
+
+    const float shift =
+        bottom ? BottomBlockShift(m_textPlacement, top, end, lines, (end - top) + lineHeight,
+                                  bottomEdge)
+               : topEdge - top;
+
+    const int move = static_cast<int>(std::lround(shift));
+    // moved only if the whole block stays on the frame
+    if (move == 0 || top + static_cast<float>(move) < 0.0f ||
+        end + static_cast<float>(move) > height)
+      continue;
+
+    for (ASS_Image* img = images; img; img = img->next)
+    {
+      if (img->w <= 0 || img->h <= 0)
+        continue;
+      const float centre = static_cast<float>(img->dst_y) + static_cast<float>(img->h) / 2.0f;
+      if (bottom ? centre > height * 2.0f / 3.0f : centre < height / 3.0f)
+      {
+        img->dst_y += move;
+        m_textMoves.emplace_back(img, move);
+      }
+    }
+  }
+  return static_cast<int>(m_textMoves.size());
+}
