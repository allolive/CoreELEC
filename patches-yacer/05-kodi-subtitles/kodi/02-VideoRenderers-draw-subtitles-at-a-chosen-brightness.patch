+void CRenderer::ShareSubtitlePeaks(std::vector<SElement>& list)
+{
+  if (OVERLAY::SubtitleBrightnessNits() <= 0.0f)
+    return;
+
+  // HDR image subtitle objects shown together - a caption and a sign, a line
+  // and its italics - share the brightest light among them, so holding them
+  // to the chosen nits keeps their contrast instead of lifting each to it.
+  for (SElement& e : list)
+  {
+    if (!e.overlay_dvd || !e.overlay_dvd->IsOverlayType(DVDOVERLAY_TYPE_IMAGE))
+      continue;
+    auto& img = static_cast<CDVDOverlayImage&>(*e.overlay_dvd);
+    if (img.m_groupPeakNits > 0.0f || !img.m_isHDROverlay || img.m_isMenu || img.palette.empty())
+      continue;
+
+    float peak = 0.0f;
+    std::vector<CDVDOverlayImage*> group;
+    for (SElement& other : list)
+    {
+      if (!other.overlay_dvd || !other.overlay_dvd->IsOverlayType(DVDOVERLAY_TYPE_IMAGE))
+        continue;
+      auto& o = static_cast<CDVDOverlayImage&>(*other.overlay_dvd);
+      if (!o.m_isHDROverlay || o.m_isMenu || o.palette.empty() ||
+          o.iPTSStartTime != img.iPTSStartTime)
+        continue;
+      peak = std::max(peak, OVERLAY::PQPalettePeakNits(o.palette, o.pixels.data(), o.linesize,
+                                                       o.width, o.height));
+      group.push_back(&o);
+    }
+    // none visible: measured anyway, so the group is not measured again
+    for (CDVDOverlayImage* o : group)
+      o->m_groupPeakNits = std::max(peak, 1e-3f);
+  }
+}
+
 std::shared_ptr<COverlay> CRenderer::ConvertLibass(SElement& e)
 {
   // If no images not execute the renderer
@@ -664,9 +705,42 @@ std::shared_ptr<COverlay> CRenderer::ConvertLibass(SElement& e)
     }
   }
 
+  // A text subtitle is held to the chosen brightness. libass's colours are
+  // changed only while the texture is built: it compares its next frame
+  // against this one, and a change it did not make would read as a new frame.
+  std::vector<std::pair<ASS_Image*, uint32_t>> colours;
+  if (OVERLAY::SubtitleBrightnessNits() > 0.0f)
+  {
+    uint32_t brightest = 0;
+    for (ASS_Image* img = e.renderedImages; img; img = img->next)
+    {
+      if ((img->color & 0xff) == 0xff) // fully transparent
+        continue;
+      brightest = std::max({brightest, img->color >> 24, (img->color >> 16) & 0xff,
+                            (img->color >> 8) & 0xff});
+    }
+
+    if (const float light = OVERLAY::SrgbSubtitleLight(static_cast<uint8_t>(brightest));
+        light != 1.0f)
+    {
+      uint32_t lut[256];
+      for (int i = 0; i < 256; i++)
+        lut[i] = OVERLAY::ScaleSrgbLight(static_cast<uint8_t>(i), light);
+      for (ASS_Image* img = e.renderedImages; img; img = img->next)
+      {
+        colours.emplace_back(img, img->color);
+        img->color = lut[img->color >> 24] << 24 | lut[(img->color >> 16) & 0xff] << 16 |
+                     lut[(img->color >> 8) & 0xff] << 8 | (img->color & 0xff);
+      }
+    }
+  }
+
   std::shared_ptr<COverlay> overlay =
       COverlay::Create(e.renderedImages, e.renderedFrameWidth, e.renderedFrameHeight);
 
+  for (const auto& [img, colour] : colours)
+    img->color = colour;
+
   m_textureCache[m_textureid] = overlay;
   o.m_textureid = m_textureid;
   m_textureid++;
