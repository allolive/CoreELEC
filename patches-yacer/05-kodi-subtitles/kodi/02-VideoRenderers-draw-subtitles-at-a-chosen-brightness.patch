diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.cpp
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.cpp
@@ -469,6 +469,22 @@ float LinearToSrgbComponent(float c)
   c = std::clamp(c, 0.0f, 1.0f);
   return (c <= 0.0031308f) ? (12.92f * c) : (1.055f * std::pow(c, 1.0f / 2.4f) - 0.055f);
 }
+
+// linear (1.0 == 10000 nits) -> PQ code value (0-1).
+float EncodePQ(float y)
+{
+  y = std::clamp(y, 0.0f, 1.0f);
+  const float p = std::pow(y, ST2084_m1);
+  return std::pow((ST2084_c1 + ST2084_c2 * p) / (1.0f + ST2084_c3 * p), ST2084_m2);
+}
+
+float SrgbToLinearComponent(float c)
+{
+  c = std::clamp(c, 0.0f, 1.0f);
+  return (c <= 0.04045f) ? (c / 12.92f) : std::pow((c + 0.055f) / 1.055f, 2.4f);
+}
+
+constexpr int PALETTE_SHIFT[3] = {PIXEL_RSHIFT, PIXEL_GSHIFT, PIXEL_BSHIFT};
 } // namespace
 
 void ConvertPQPaletteToSRGB(std::vector<uint32_t>& palette)
@@ -514,6 +530,153 @@ void ConvertPQPaletteToSRGB(std::vector<uint32_t>& palette)
   }
 }
 
+namespace
+{
+//! Marks the palette entries a bitmap of 8-bit indices draws with.
+void MarkUsedIndices(const uint8_t* indices, int stride, int width, int height, bool used[256])
+{
+  std::fill(used, used + 256, false);
+  for (int y = 0; y < height; y++, indices += stride)
+    for (int x = 0; x < width; x++)
+      used[indices[x]] = true;
+}
+
+//! What white in an SDR picture is taken to be, in nits.
+constexpr float SDR_WHITE_NITS = 120.0f;
+
+//! ITU-R BT.2408 reference white, for HDR output without the composite.
+constexpr float REFERENCE_WHITE_NITS = 203.0f;
+} // namespace
+
+float PQPalettePeakNits(const std::vector<uint32_t>& palette,
+                        const uint8_t* indices,
+                        int stride,
+                        int width,
+                        int height)
+{
+  // Only the entries the bitmap draws with: a PGS palette lives for a whole
+  // epoch and keeps entries earlier subtitles used, up to full PQ white.
+  bool used[256];
+  MarkUsedIndices(indices, stride, width, height, used);
+
+  float peak = 0.0f;
+  for (size_t i = 0; i < palette.size() && i < 256; i++)
+  {
+    const uint32_t entry = palette[i];
+    if (!used[i] || ((entry >> PIXEL_ASHIFT) & 0xff) == 0)
+      continue;
+    for (const int shift : PALETTE_SHIFT)
+      peak = std::max(peak, DecodePQ(((entry >> shift) & 0xff) / 255.0f));
+  }
+  return peak * 10000.0f;
+}
+
+uint8_t PaletteBrightestCode(const std::vector<uint32_t>& palette,
+                             const uint8_t* indices,
+                             int stride,
+                             int width,
+                             int height)
+{
+  bool used[256];
+  MarkUsedIndices(indices, stride, width, height, used);
+
+  uint32_t brightest = 0;
+  for (size_t i = 0; i < palette.size() && i < 256; i++)
+  {
+    const uint32_t entry = palette[i];
+    if (!used[i] || ((entry >> PIXEL_ASHIFT) & 0xff) == 0)
+      continue;
+    for (const int shift : PALETTE_SHIFT)
+      brightest = std::max(brightest, (entry >> shift) & 0xff);
+  }
+  return static_cast<uint8_t>(brightest);
+}
+
+uint8_t RgbaBrightestCode(const uint8_t* rgba, int stride, int width, int height)
+{
+  uint32_t brightest = 0;
+  for (int y = 0; y < height; y++, rgba += stride)
+  {
+    for (int x = 0; x < width; x++)
+    {
+      uint32_t px;
+      std::memcpy(&px, rgba + static_cast<size_t>(x) * 4, 4);
+      if (((px >> PIXEL_ASHIFT) & 0xff) == 0)
+        continue;
+      for (const int shift : PALETTE_SHIFT)
+        brightest = std::max(brightest, (px >> shift) & 0xff);
+    }
+  }
+  return static_cast<uint8_t>(brightest);
+}
+
+float SubtitleBrightnessNits()
+{
+  return static_cast<float>(CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+      CSettings::SETTING_SUBTITLES_BRIGHTNESS));
+}
+
+float SrgbWhiteNits()
+{
+  const CWinSystemBase* winSystem = CServiceBroker::GetWinSystem();
+  // The composite converts the interface with its own peak, a PQ code; the
+  // same decode CGuiCompositeShaderGLES::PeakFromPQCode() applies, capped alike.
+  if (winSystem->IsHdrComposite())
+    return std::min(DecodePQ(winSystem->GetGuiSdrPeakLuminance()), 0.1f) * 10000.0f;
+  if (winSystem->GetEotf() != KODI::UTILS::Eotf::TRADITIONAL_SDR)
+    return REFERENCE_WHITE_NITS;
+  return SDR_WHITE_NITS;
+}
+
+float SrgbSubtitleLight(uint8_t brightestCode)
+{
+  const float nits = SubtitleBrightnessNits();
+  if (nits <= 0.0f || brightestCode == 0)
+    return 1.0f;
+
+  const float peak = SrgbToLinearComponent(brightestCode / 255.0f) * SrgbWhiteNits();
+  return peak > nits ? nits / peak : 1.0f;
+}
+
+void ScalePaletteLight(std::vector<uint32_t>& palette, bool pq, float factor)
+{
+  for (uint32_t& entry : palette)
+  {
+    uint32_t out = entry & (0xffu << PIXEL_ASHIFT);
+    for (const int shift : PALETTE_SHIFT)
+    {
+      const float c = ((entry >> shift) & 0xff) / 255.0f;
+      // PQ rounds down: an 8-bit step is several nits at subtitle levels, and
+      // rounding up would put the result over the light it was scaled to.
+      const float scaled = pq ? EncodePQ(DecodePQ(c) * factor)
+                              : LinearToSrgbComponent(SrgbToLinearComponent(c) * factor);
+      out |= static_cast<uint32_t>(scaled * 255.0f + (pq ? 1e-3f : 0.5f)) << shift;
+    }
+    entry = out;
+  }
+}
+
+uint8_t ScaleSrgbLight(uint8_t code, float factor)
+{
+  const float scaled = LinearToSrgbComponent(SrgbToLinearComponent(code / 255.0f) * factor);
+  return static_cast<uint8_t>(scaled * 255.0f + 0.5f);
+}
+
+void ScaleRgbaLight(std::vector<uint32_t>& rgba, float factor)
+{
+  uint32_t lut[256];
+  for (int i = 0; i < 256; i++)
+    lut[i] = ScaleSrgbLight(static_cast<uint8_t>(i), factor);
+
+  for (uint32_t& px : rgba)
+  {
+    uint32_t out = px & (0xffu << PIXEL_ASHIFT);
+    for (const int shift : PALETTE_SHIFT)
+      out |= lut[(px >> shift) & 0xff] << shift;
+    px = out;
+  }
+}
