From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sat, 26 Sep 2026 19:44:49 -0500
Subject: [PATCH] VideoPlayer: match subtitle overlays at the middle of the
 frame

ProcessOverlays shows an overlay only if it starts at or before the
frame pts. Containers round timestamps, so a set can start 1 ms after
the frame it belongs to. It then shows a frame late, or never when the
next set starts on the next frame.

(cherry picked from commit 0980a5dfc4b4639b2369850ce9a80239da4b1bee)
---
 xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
index 5d105fbb6b..3bfa7ab3e9 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
@@ -925,9 +925,12 @@ void CVideoPlayerVideo::Flush(bool sync)
 
 void CVideoPlayerVideo::ProcessOverlays(const VideoPicture* pSource, double pts)
 {
+  // match at mid-frame so a start rounded just past the frame pts binds to it
+  const double matchPts = pts + pSource->iDuration / 2;
+
   // remove any overlays that are out of time
   if (m_syncState == IDVDStreamPlayer::SYNC_INSYNC)
-    m_pOverlayContainer->CleanUp(pts - m_iSubtitleDelay);
+    m_pOverlayContainer->CleanUp(matchPts - m_iSubtitleDelay);
 
   VecOverlays overlays;
 
@@ -945,7 +948,7 @@ void CVideoPlayerVideo::ProcessOverlays(const VideoPicture* pSource, double pts)
       if(!pOverlay->bForced && !m_bRenderSubs)
         continue;
 
-      double pts2 = pOverlay->bForced ? pts : pts - m_iSubtitleDelay;
+      double pts2 = pOverlay->bForced ? matchPts : matchPts - m_iSubtitleDelay;
 
       if((pOverlay->iPTSStartTime <= pts2 && (pOverlay->iPTSStopTime > pts2 || pOverlay->iPTSStopTime == 0LL)))
       {
