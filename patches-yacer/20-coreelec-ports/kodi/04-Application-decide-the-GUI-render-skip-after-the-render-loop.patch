From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Sat, 26 Sep 2026 19:45:11 -0500
Subject: [PATCH] Application: decide the GUI render skip after the render loop

The dirty-driven skip is decided right after the window manager
Process and sees only the regions Process collected. The player
prepares overlays later, from DriveRenderLoop, so a subtitle change
marks the GUI dirty too late: its frame is drawn but not presented.

(cherry picked from commit 1e517a4def6dabd8175238d60e099c609e9a607b)
---
 xbmc/application/Application.cpp | 14 ++++++++------
 xbmc/guilib/GUIWindowManager.cpp |  2 ++
 xbmc/guilib/GUIWindowManager.h   |  6 ++++--
 3 files changed, 14 insertions(+), 8 deletions(-)

diff --git a/xbmc/application/Application.cpp b/xbmc/application/Application.cpp
index f32e44620f..5ca3d17fe9 100644
--- a/xbmc/application/Application.cpp
+++ b/xbmc/application/Application.cpp
@@ -1626,12 +1626,6 @@ void CApplication::FrameMove(bool processEvents, bool processGUI)
     if (!m_bStop)
       CServiceBroker::GetGUI()->GetWindowManager().Process(CTimeUtils::GetFrameTime());
 
-    // Dirty-driven skip: on paths with a persistent framebuffer (D2P plane or
-    // HDR GUI compositing FBO), skip Render when no controls dirtied themselves
-    // this frame. The persistence keeps the previous OSD on screen for free.
-    if (!m_skipGuiRender && appPlayer->IsRenderingVideoLayer() &&
-        !CServiceBroker::GetGUI()->GetWindowManager().HasDirtyRegions())
-      m_skipGuiRender = true;
     CServiceBroker::GetGUI()->GetWindowManager().FrameMove();
   }
 
@@ -1639,6 +1633,14 @@ void CApplication::FrameMove(bool processEvents, bool processGUI)
 
   // this will go away when render systems gets its own thread
   CServiceBroker::GetWinSystem()->DriveRenderLoop();
+
+  // Dirty-driven skip: on paths with a persistent framebuffer (D2P plane or
+  // HDR GUI compositing FBO), skip Render when no controls dirtied themselves
+  // this frame. The persistence keeps the previous OSD on screen for free.
+  // Decided last: the player prepares overlays in DriveRenderLoop().
+  if (processGUI && renderGUI && !m_skipGuiRender && appPlayer->IsRenderingVideoLayer() &&
+      !CServiceBroker::GetGUI()->GetWindowManager().HasDirtyRegions())
+    m_skipGuiRender = true;
 }
 
 
diff --git a/xbmc/guilib/GUIWindowManager.cpp b/xbmc/guilib/GUIWindowManager.cpp
index d8f1eb12d6..f140a94eb2 100644
--- a/xbmc/guilib/GUIWindowManager.cpp
+++ b/xbmc/guilib/GUIWindowManager.cpp
@@ -1299,6 +1299,7 @@ void CGUIWindowManager::Process(unsigned int currentTime)
   std::unique_lock lock(CServiceBroker::GetWinSystem()->GetGfxContext());
 
   m_dirtyregions.clear();
+  m_markedDirty = false;
 
   CGUIWindow* pWindow = GetWindow(GetActiveWindow());
   if (pWindow)
@@ -1342,6 +1343,7 @@ void CGUIWindowManager::MarkDirty()
 void CGUIWindowManager::MarkDirty(const CRect& rect)
 {
   m_tracker.MarkDirtyRegion(CDirtyRegion(rect));
+  m_markedDirty = true;
 
   CGUIWindow* pWindow = GetWindow(GetActiveWindow());
   if (pWindow)
diff --git a/xbmc/guilib/GUIWindowManager.h b/xbmc/guilib/GUIWindowManager.h
index 59de35c851..c210bfe2cd 100644
--- a/xbmc/guilib/GUIWindowManager.h
+++ b/xbmc/guilib/GUIWindowManager.h
@@ -100,12 +100,13 @@ public:
    */
   void MarkDirty(const CRect& rect);
 
-  /*! \brief True if Process() collected any dirty regions this frame.
+  /*! \brief True if Process() collected any dirty regions this frame or
+   *   MarkDirty() was called since.
    *   Callable after Process() to decide whether the render pass needs
    *   to run; used by the dirty-driven skip in CApplication::FrameMove
    *   (currently gated to D2P plane and HDR GUI compositing FBO contexts).
    */
-  bool HasDirtyRegions() const { return !m_dirtyregions.empty(); }
+  bool HasDirtyRegions() const { return m_markedDirty || !m_dirtyregions.empty(); }
 
   /*! \brief Rendering of the current window and any dialogs
    Render is called every frame to draw the current window and any dialogs.
@@ -305,5 +306,6 @@ private:
   mutable bool m_inhibitTouchGestureEvents{false};
 
   CDirtyRegionList m_dirtyregions;
+  bool m_markedDirty{false};
   CDirtyRegionTracker m_tracker;
 };
