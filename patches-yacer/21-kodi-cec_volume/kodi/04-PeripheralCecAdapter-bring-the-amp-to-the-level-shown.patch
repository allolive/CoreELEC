-  const int volume = status & CEC_AUDIO_VOLUME_STATUS_MASK;
-  if (volume <= CEC_AUDIO_VOLUME_MAX)
-    PublishAmpVolume(volume);
+void CPeripheralCecAdapter::SetAmpVolume(int volume)
+{
+  if (!m_ampVolumeRead.IsTimePast())
+  {
+    /* the keys pressed since the first one after a pause count from here */
+    m_ampVolumeWanted = ClampAmpVolume(volume + m_ampVolumeWanted - m_ampVolume);
+    m_ampVolume = volume;
+    m_ampVolumeRead.SetExpired();
+  }
+  else
+  {
+    /* the level shown stays, and the amp is brought to it. an answer that follows no key, as the
+       amp's second answer to a request, is no step closer or further */
+    m_ampVolume = volume;
+    if (m_bAmpKeysSinceCheck && m_ampVolumeChecked >= 0 &&
+        std::abs(m_ampVolumeWanted - volume) >= std::abs(m_ampVolumeWanted - m_ampVolumeChecked))
+      m_ampVolumeStalls++;
+    if (m_bAmpKeysSinceCheck || m_ampVolumeChecked < 0)
+      m_ampVolumeChecked = volume;
+    m_bAmpKeysSinceCheck = false;
+    /* take the amp's own level once it is reached, stalls, or was set other than by the keys */
+    if (!m_bAmpVolumeDriven || m_ampVolumeStalls >= AMP_VOLUME_STALLS ||
+        volume == m_ampVolumeWanted)
+    {
+      m_ampVolumeWanted = volume;
+      m_bAmpVolumeDriven = false;
+      m_ampVolumeStalls = 0;
+    }
+  }
+  PublishAmpVolume(m_ampVolumeWanted);
 }
 
