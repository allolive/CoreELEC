+/* the volume target does not acknowledge keys for a moment after acting on one. send a key it did
+   not acknowledge again after this time, a single press up to VOLUME_KEY_ATTEMPTS times */
+#define VOLUME_KEY_RETRY 50ms
+#define VOLUME_KEY_ATTEMPTS 4
+/* a device that acknowledges no key for this long is gone: stop sending it any */
+#define VOLUME_KEY_GIVE_UP 2s
+/* the amp can answer a request twice, so wait for the second answer before asking again. the
+   keys get the bus in between */
+#define AUDIO_STATUS_INTERVAL 150ms
 /* an amp that does not answer within this time lost the request. it is busy for a moment after
    acting on a key */
 #define AUDIO_STATUS_TIMEOUT 300ms
 /* stop asking an amp that does not answer at all */
 #define AUDIO_STATUS_GIVE_UP 2s
+/* an amp answers with the level and mute state from before the keys it has not acted on yet, so
+   it is asked only once it has had this long after the last one */
+#define VOLUME_KEY_SETTLE 1s
+/* an amp acknowledges a tap that follows the last key sooner than this, but does not act on it */
+#define AMP_TAP_INTERVAL 600ms
+/* an amp takes a key pressed again within this time for a held one and moves on its own, faster
+   than taps. it is held towards a level further than AMP_HOLD_MARGIN away, read meanwhile, and
+   released that far short of it, the rest is tapped once a level read AMP_HOLD_COAST after the
+   release is in */
+#define AMP_HOLD_REPEAT 300ms
+#define AMP_HOLD_MARGIN 4
+#define AMP_HOLD_COAST 300ms
+/* how long an amp may take to report the mute state a mute key set, and how often it is asked */
+#define MUTE_KEY_SETTLE 3s
+#define MUTE_KEY_RECHECK 500ms
+/* a held key moves the level shown by one this often */
+#define AMP_VOLUME_HOLD_STEP 100ms
+/* the first volume key after this long counts from the level the amp reports, whatever set it.
+   without a report within AMP_VOLUME_READ_TIMEOUT it counts from the last one */
+#define AMP_VOLUME_IDLE 3s
+#define AMP_VOLUME_READ_TIMEOUT 1s
+/* bring the amp to the level shown until it settles no closer to it this many times in a row,
+   as at a limit set on the amp. show the amp's level then */
+#define AMP_VOLUME_STALLS 2
 #define SYSTEM_AUDIO_MODE_RETRIES 3
 #define SYSTEM_AUDIO_MODE_RETRY_DELAY 500ms
 
