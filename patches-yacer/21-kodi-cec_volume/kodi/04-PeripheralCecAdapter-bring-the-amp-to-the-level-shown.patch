+  m_keyDown = press;
+  m_keyDownTarget = target;
+  m_lastKeyPressed = pressed;
+  if (holding == VOLUME_CHANGE_NONE)
+    m_keyToPress = VOLUME_CHANGE_NONE;
+
+  if (target != CECDEVICE_AUDIOSYSTEM)
+    return;
+
+  /* the amp acts on a key it acknowledged. a held one moves it by an unknown amount: it is read
+     meanwhile */
+  std::unique_lock lock(m_critSection);
+  if (bAmpHold)
   {
-    m_cecAdapter->SendKeyRelease(target, true);
-    m_sentHeldChange = VOLUME_CHANGE_NONE;
-    bSent = true;
+    m_bAmpHeld = true;
+    m_muteSettled = {};
+    return;
   }
-  if (held != VOLUME_CHANGE_NONE &&
-      (held != m_sentHeldChange || now - m_lastHeldKeySent >= VOLUME_HOLD_REPEAT))
+  if (press != VOLUME_CHANGE_MUTE && m_ampVolume >= 0)
   {
-    m_cecAdapter->SendKeypress(target, VolumeKey(held), true);
-    m_sentHeldChange = held;
-    m_lastHeldKeySent = now;
-    bSent = true;
+    const int step = press == VOLUME_CHANGE_UP ? 1 : -1;
+    m_ampVolume = ClampAmpVolume(m_ampVolume + step);
+    /* a key queued or held before the amp's level was known moves the level shown with it */
+    if (towards == VOLUME_CHANGE_NONE)
+    {
+      m_ampVolumeWanted = ClampAmpVolume(m_ampVolumeWanted + step);
+      PublishAmpVolume(m_ampVolumeWanted);
+    }
+    m_bAmpVolumeDriven = true;
+    m_bAmpKeysSinceCheck = true;
+    /* a volume key can unmute the amp: take the mute state it reports next */
+    m_muteSettled = {};
   }
-  else if (change != VOLUME_CHANGE_NONE)
+  m_ampVolumeSettled = std::max(m_ampVolumeSettled, pressed + VOLUME_KEY_SETTLE);
+  if (press == VOLUME_CHANGE_MUTE)
+    m_muteSettled = pressed + MUTE_KEY_SETTLE;
+}
+
+bool CPeripheralCecAdapter::SentVolumeKey(bool bAcknowledged,
+                                          std::chrono::steady_clock::time_point now)
+{
+  if (bAcknowledged)
   {
-    m_cecAdapter->SendKeypress(target, VolumeKey(change), true);
-    m_cecAdapter->SendKeyRelease(target, true);
-    bSent = true;
+    m_keyFailingSince = {};
+    return true;
   }
 
-  /* amps do not report the level a key leaves them at */
-  if (bSent)
+  m_nextKeyAttempt = now + VOLUME_KEY_RETRY;
+  if (m_keyFailingSince == std::chrono::steady_clock::time_point{})
+    m_keyFailingSince = now;
+  else if (now - m_keyFailingSince >= VOLUME_KEY_GIVE_UP)
+  {
+    /* the device is gone. leave the key to its own timeout, stop bringing the amp to the level
+       shown and show the amp's level once it answers again */
+    CLog::Log(LOGWARNING, "{} - no volume key acknowledged for {}s, giving up", __FUNCTION__,
+              std::chrono::duration_cast<std::chrono::seconds>(VOLUME_KEY_GIVE_UP).count());
+    m_keyFailingSince = {};
+    m_keyDown = VOLUME_CHANGE_NONE;
+    m_bAmpHeld = false;
+    DropVolumeKey(m_keyToPress);
+    m_keyToPress = VOLUME_CHANGE_NONE;
+    std::unique_lock lock(m_critSection);
+    m_ampVolumeWanted = m_ampVolume;
+    m_bAmpVolumeDriven = false;
+    PublishAmpVolume(m_ampVolumeWanted);
     RequestAmpAudioStatus();
+  }
+  return false;
+}
+
+void CPeripheralCecAdapter::DropVolumeKey(CecVolumeChange change)
+{
+  if (change == VOLUME_CHANGE_NONE)
+    return;
+
+  std::unique_lock lock(m_critSection);
+  if (change == VOLUME_CHANGE_MUTE)
+  {
+    m_bIsMuted = !m_bIsMuted;
+    if (!m_bIsMuted)
+      CloseMutedVolumeBar();
+  }
+  if (m_volumeTarget == CECDEVICE_AUDIOSYSTEM)
+    RequestAmpAudioStatus();
+}
+
+void CPeripheralCecAdapter::CloseMutedVolumeBar(void)
+{
+  if (!m_bVolumeBarMuted)
+    return;
+
+  /* a volume action lets the bar time out again */
+  m_bVolumeBarMuted = false;
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_VOLUME_SHOW, ACTION_VOLUME_SET);
 }
 
