+      return;
+    /* a muted amp with an unknown level still reports its mute bit */
+    const bool bMuted = (status & CEC_AUDIO_MUTE_STATUS_MASK) == CEC_AUDIO_MUTE_STATUS_MASK;
+    if (bMuted != m_bIsMuted && m_audioStatusAnswered < m_muteSettled)
+    {
+      m_audioStatusWanted =
+          std::max(m_audioStatusWanted, m_audioStatusAnswered + MUTE_KEY_RECHECK);
+      return;
+    }
+    m_bIsMuted = bMuted;
+    if (!bMuted)
+      CloseMutedVolumeBar();
+    /* after a held key, only an answer to a request sent once the amp stopped tells its level */
+    if (m_ampVolumeCoast != std::chrono::steady_clock::time_point{})
+    {
+      if (m_audioStatusRequested < m_ampVolumeCoast)
+        return;
+      m_ampVolumeCoast = {};
+    }
+    if (volume <= CEC_AUDIO_VOLUME_MAX)
+      SetAmpVolume(volume);
+    else
+      m_bAmpVolumeDriven = false;
   }
