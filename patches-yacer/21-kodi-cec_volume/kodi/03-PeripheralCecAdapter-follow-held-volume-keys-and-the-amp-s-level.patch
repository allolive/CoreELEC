     if (m_volumeTarget != CECDEVICE_AUDIOSYSTEM)
       return;
     m_bIsMuted = (status & CEC_AUDIO_MUTE_STATUS_MASK) == CEC_AUDIO_MUTE_STATUS_MASK;
+    m_audioStatusAnswered = std::chrono::steady_clock::now();
   }
 
   const int volume = status & CEC_AUDIO_VOLUME_STATUS_MASK;
@@ -537,15 +552,40 @@
 
 void CPeripheralCecAdapter::RequestAmpAudioStatus(void)
 {
+  std::unique_lock lock(m_critSection);
+  m_audioStatusWanted = std::chrono::steady_clock::now();
+}
+
+void CPeripheralCecAdapter::ProcessAudioStatus(void)
+{
+  const auto now = std::chrono::steady_clock::now();
+  std::chrono::steady_clock::time_point wanted;
+  std::chrono::steady_clock::time_point answered;
+  {
+    std::unique_lock lock(m_critSection);
+    if (m_volumeTarget != CECDEVICE_AUDIOSYSTEM)
+      return;
+    wanted = m_audioStatusWanted;
+    answered = m_audioStatusAnswered;
+  }
+
+  /* one request at a time, the next one shortly after the answer, until a request sent after the
+     status was wanted is answered */
+  const bool bAnswered = answered >= m_audioStatusRequested;
+  const bool bAsk =
+      m_audioStatusRequested < wanted || (!bAnswered && now - wanted < AUDIO_STATUS_GIVE_UP);
+  const bool bWait = bAnswered ? now - answered < AUDIO_STATUS_INTERVAL
+                               : now - m_audioStatusRequested < AUDIO_STATUS_TIMEOUT;
+  if (!bAsk || bWait)
+    return;
+
   /* AudioStatus() answers from libCEC's cache when the request is lost, which would put back a
-     state the amp has just left. send the request ourselves and take the answer from CecCommand.
-     the amp is busy for a moment after acting on a key, so try again when it is not heard */
+     state the amp has just left. send the request ourselves and take the answer from CecCommand */
   cec_command command;
   cec_command::Format(command, m_cecAdapter->GetLogicalAddresses().primary, CECDEVICE_AUDIOSYSTEM,
                       CEC_OPCODE_GIVE_AUDIO_STATUS);
-  for (int retry = 0; !m_cecAdapter->Transmit(command) && retry < AUDIO_STATUS_RETRIES && !m_bStop;
-       retry++)
-    CThread::Sleep(AUDIO_STATUS_RETRY_DELAY);
+  m_audioStatusRequested = now;
+  m_cecAdapter->Transmit(command);
 }
 
 void CPeripheralCecAdapter::PublishAmpVolume(int volume)
@@ -558,7 +598,7 @@
                  : StringUtils::Format("SetProperty(cec.ampvolume,{},home)", volume));
 }
 
-void CPeripheralCecAdapter::QueueVolumeChange(CecVolumeChange change, int actionId)
+void CPeripheralCecAdapter::QueueVolumeChange(CecVolumeChange change, int actionId, bool bHeld)
 {
   if (!HasAudioControl())
     return;
@@ -566,7 +606,13 @@
   bool bAmp;
   {
     std::unique_lock lock(m_critSection);
-    m_volumeChangeQueue.push(change);
+    if (bHeld)
+    {
+      m_heldVolumeChange = change;
+      m_lastHeldAction = std::chrono::steady_clock::now();
+    }
+    else
+      m_volumeChangeQueue.push(change);
     /* flip the mute state with the keypress, so the volume bar opened below already shows it */
     if (change == VOLUME_CHANGE_MUTE)
       m_bIsMuted = !m_bIsMuted;
@@ -579,89 +625,74 @@
     CServiceBroker::GetAppMessenger()->PostMsg(TMSG_VOLUME_SHOW, actionId);
 }
 
+static cec_user_control_code VolumeKey(CecVolumeChange change)
+{
+  return change == VOLUME_CHANGE_UP     ? CEC_USER_CONTROL_CODE_VOLUME_UP
+         : change == VOLUME_CHANGE_DOWN ? CEC_USER_CONTROL_CODE_VOLUME_DOWN
+                                        : CEC_USER_CONTROL_CODE_MUTE;
+}
+
 void CPeripheralCecAdapter::ProcessVolumeChange(void)
 {
-  bool bSendRelease(false);
-  CecVolumeChange pendingVolumeChange = VOLUME_CHANGE_NONE;
-  cec_logical_address target = CECDEVICE_UNKNOWN;
+  const auto now = std::chrono::steady_clock::now();
+  CecVolumeChange change = VOLUME_CHANGE_NONE;
+  CecVolumeChange held;
+  cec_logical_address target;
   {
     std::unique_lock lock(m_critSection);
     target = m_volumeTarget;
-    auto now = std::chrono::steady_clock::now();
-    auto duration = std::chrono::duration_cast<std::chrono::milliseconds>(now - m_lastKeypress);
-    if (!m_volumeChangeQueue.empty())
+    held = now - m_lastHeldAction < VOLUME_HOLD_TIMEOUT ? m_heldVolumeChange : VOLUME_CHANGE_NONE;
+    if (held == VOLUME_CHANGE_NONE && !m_volumeChangeQueue.empty())
     {
-      /* get the first change from the queue */
-      pendingVolumeChange = m_volumeChangeQueue.front();
+      change = m_volumeChangeQueue.front();
       m_volumeChangeQueue.pop();
-
-      /* remove all dupe entries */
-      while (!m_volumeChangeQueue.empty() && m_volumeChangeQueue.front() == pendingVolumeChange)
-        m_volumeChangeQueue.pop();
-
-      /* send another keypress after VOLUME_REFRESH_TIMEOUT ms */
-
-      bool bRefresh(duration.count() > VOLUME_REFRESH_TIMEOUT);
-
-      /* only send the keypress when it hasn't been sent yet */
-      if (pendingVolumeChange != m_lastChange)
-      {
-        m_lastKeypress = std::chrono::steady_clock::now();
-        m_lastChange = pendingVolumeChange;
-      }
-      else if (bRefresh)
-      {
-        m_lastKeypress = std::chrono::steady_clock::now();
-        pendingVolumeChange = m_lastChange;
-      }
-      else
-        pendingVolumeChange = VOLUME_CHANGE_NONE;
-    }
-    else if (m_lastKeypress.time_since_epoch().count() > 0 &&
-             duration.count() > VOLUME_CHANGE_TIMEOUT)
-    {
-      /* send a key release */
-      m_lastKeypress = {};
-      bSendRelease = true;
-      m_lastChange = VOLUME_CHANGE_NONE;
     }
   }
 
-  /* the target can be cleared while changes are queued, so drain the queue but send nothing */
+  /* the target can be cleared while a key is held or queued. send nothing then */
   if (target == CECDEVICE_UNKNOWN)
+  {
+    m_sentHeldChange = VOLUME_CHANGE_NONE;
     return;
+  }
 
-  switch (pendingVolumeChange)
+  /* a held key goes out as a press repeated while the remote repeats it, and one release when it
+     stops. a single press goes out as a press and a release, so the amp never takes it for held */
+  bool bSent = false;
+  if (m_sentHeldChange != VOLUME_CHANGE_NONE && held != m_sentHeldChange)
   {
-    case VOLUME_CHANGE_UP:
-      m_cecAdapter->SendKeypress(target, CEC_USER_CONTROL_CODE_VOLUME_UP, false);
-      break;
-    case VOLUME_CHANGE_DOWN:
-      m_cecAdapter->SendKeypress(target, CEC_USER_CONTROL_CODE_VOLUME_DOWN, false);
-      break;
-    case VOLUME_CHANGE_MUTE:
-      m_cecAdapter->SendKeypress(target, CEC_USER_CONTROL_CODE_MUTE, false);
-      break;
-    case VOLUME_CHANGE_NONE:
-      if (bSendRelease)
-      {
-        m_cecAdapter->SendKeyRelease(target, false);
-        /* amps do not report the level a keypress left them at, so ask once the key is up */
-        if (target == CECDEVICE_AUDIOSYSTEM)
-          RequestAmpAudioStatus();
-      }
-      break;
+    m_cecAdapter->SendKeyRelease(target, true);
+    m_sentHeldChange = VOLUME_CHANGE_NONE;
+    bSent = true;
   }
+  if (held != VOLUME_CHANGE_NONE &&
+      (held != m_sentHeldChange || now - m_lastHeldKeySent >= VOLUME_HOLD_REPEAT))
+  {
+    m_cecAdapter->SendKeypress(target, VolumeKey(held), true);
+    m_sentHeldChange = held;
+    m_lastHeldKeySent = now;
+    bSent = true;
+  }
+  else if (change != VOLUME_CHANGE_NONE)
+  {
+    m_cecAdapter->SendKeypress(target, VolumeKey(change), true);
+    m_cecAdapter->SendKeyRelease(target, true);
+    bSent = true;
+  }
+
+  /* amps do not report the level a key leaves them at */
+  if (bSent)
+    RequestAmpAudioStatus();
 }
 
-void CPeripheralCecAdapter::VolumeUp(void)
+void CPeripheralCecAdapter::VolumeUp(bool bHeld)
 {
