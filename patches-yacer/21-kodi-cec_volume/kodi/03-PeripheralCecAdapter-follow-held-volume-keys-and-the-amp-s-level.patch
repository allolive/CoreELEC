   m_iExitCode = EXITCODE_QUIT;
 
   /* replaced by the amp's own mute state once it reports one */
   m_bIsMuted = false;
+  m_heldVolumeChange = VOLUME_CHANGE_NONE;
+  m_lastHeldAction = {};
