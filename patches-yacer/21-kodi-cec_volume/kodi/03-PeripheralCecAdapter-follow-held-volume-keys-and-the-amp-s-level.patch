 /* time in seconds to ignore standby commands from devices after the screensaver has been activated
  */
 #define SCREENSAVER_TIMEOUT 20
-#define VOLUME_CHANGE_TIMEOUT 250
-#define VOLUME_REFRESH_TIMEOUT 100
-#define AUDIO_STATUS_RETRIES 3
-#define AUDIO_STATUS_RETRY_DELAY 200ms
+/* a remote repeats a held key every few tens of ms. the key is up once the repeats stop */
+#define VOLUME_HOLD_TIMEOUT 150ms
+#define VOLUME_HOLD_REPEAT 100ms
+/* leave the bus to the keys for a moment between an answer and the next request */
+#define AUDIO_STATUS_INTERVAL 50ms
+/* an amp that does not answer within this time lost the request. it is busy for a moment after
+   acting on a key */
+#define AUDIO_STATUS_TIMEOUT 300ms
+/* stop asking an amp that does not answer at all */
+#define AUDIO_STATUS_GIVE_UP 2s
 #define SYSTEM_AUDIO_MODE_RETRIES 3
 #define SYSTEM_AUDIO_MODE_RETRY_DELAY 500ms
 
@@ -129,12 +135,17 @@
   m_volumeTarget = CECDEVICE_UNKNOWN;
   m_tvVolumeTarget = CECDEVICE_UNKNOWN;
   m_strMenuLanguage = "???";
-  m_lastKeypress = {};
