diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLNalWalker.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLNalWalker.h
new file mode 100644
index 0000000..4b416ae
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLNalWalker.h
@@ -0,0 +1,141 @@
+/*
+ *  Copyright (C) 2026 Team CoreELEC
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#pragma once
+
+// Walks the NAL units of an H.264/HEVC access unit and the messages of an SEI
+// NAL; depends on nothing, so a parser built on it can be tested on its own.
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <iterator>
+#include <vector>
+
+enum
+{
+  HEVC_NAL_SEI_PREFIX = 39,
+  HEVC_NAL_UNSPEC62 = 62 // Dolby Vision RPU
+};
+
+enum
+{
+  AVC_NAL_SEI = 6,
+  AVC_NAL_SPS = 7,
+  AVC_NAL_PPS = 8,
+  AVC_NAL_SUBSET_SPS = 15 // the MVC second view's SPS
+};
+
+enum
+{
+  SEI_PAYLOAD_REGISTERED_ITU_T_T35 = 4,
+  SEI_PAYLOAD_USER_DATA_UNREGISTERED = 5,
+  SEI_PAYLOAD_MASTERING_DISPLAY_COLOUR_VOLUME = 137,
+  SEI_PAYLOAD_CONTENT_LIGHT_LEVEL_INFO = 144
+};
+
+// fn(nal, len) per NAL unit of an access unit until it returns false; nalLengthSize 0 means Annex-B
+template<typename Fn>
+inline void AMLForEachNal(const uint8_t* data, size_t size, int nalLengthSize, Fn&& fn)
+{
+  if (!data)
+    return;
+
+  if (nalLengthSize >= 1 && nalLengthSize <= 4)
+  {
+    size_t pos = 0;
+    while (pos + nalLengthSize <= size)
+    {
+      uint32_t len = 0;
+      for (int i = 0; i < nalLengthSize; ++i)
+        len = (len << 8) | data[pos + i];
+      pos += nalLengthSize;
+      if (len == 0 || len > size - pos || !fn(data + pos, static_cast<size_t>(len)))
+        return;
+      pos += len;
+    }
+    return;
+  }
+
+  // a 4-byte start code owns the zero before its prefix, and a NAL never ends in 0x00
+  size_t nal = SIZE_MAX;
+  const auto emit = [&](size_t end)
+  {
+    while (end > nal && data[end - 1] == 0)
+      end--;
+    return end == nal || fn(data + nal, end - nal);
+  };
+  for (size_t i = 0; i + 2 < size; ++i)
+  {
+    if (data[i] != 0 || data[i + 1] != 0 || data[i + 2] != 1)
+      continue;
+    if (nal != SIZE_MAX && !emit(i))
+      return;
+    nal = i + 3;
+    i += 2;
+  }
+  if (nal != SIZE_MAX && nal < size)
+    emit(size);
+}
+
+// fn(type, payload, size) per unescaped message of an SEI NAL until it returns false
+template<typename Fn>
+inline void AMLForEachSeiMessage(const uint8_t* nal, size_t len, size_t headerSize, Fn&& fn)
+{
+  if (len <= headerSize)
+    return;
+
+  static constexpr uint8_t escape[3] = {0, 0, 3};
+  const uint8_t* rbsp = nal + headerSize;
+  size_t end = len - headerSize;
+  std::vector<uint8_t> unescaped;
+  if (std::search(rbsp, rbsp + end, std::begin(escape), std::end(escape)) != rbsp + end)
+  {
+    unescaped.reserve(len);
+    for (size_t i = headerSize; i < len; ++i)
+    {
+      if (i + 2 < len && nal[i] == 0 && nal[i + 1] == 0 && nal[i + 2] == 3)
+      {
+        unescaped.push_back(0);
+        unescaped.push_back(0);
+        i += 2;
+      }
+      else
+        unescaped.push_back(nal[i]);
+    }
+    rbsp = unescaped.data();
+    end = unescaped.size();
+  }
+
+  size_t p = 0;
+  while (p + 2 < end)
+  {
+    uint32_t type = 0;
+    while (p < end && rbsp[p] == 0xFF)
+    {
+      type += 255;
+      ++p;
+    }
+    if (p >= end)
+      break;
+    type += rbsp[p++];
+
+    uint32_t payload = 0;
+    while (p < end && rbsp[p] == 0xFF)
+    {
+      payload += 255;
+      ++p;
+    }
+    if (p >= end)
+      break;
+    payload += rbsp[p++];
+    if (payload > end - p)
+      break;
+
+    if (!fn(type, rbsp + p, static_cast<size_t>(payload)))
+      return;
+    p += payload;
+  }
+}
