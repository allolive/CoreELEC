+// The base view waits for its second view for so long only: past that, the oldest base pictures
+// go, and the second view is moved to the base view.
+void CDemuxStreamSSIF::DropUnpairedBase()
+{
+  bool dropped = false;
+  while (m_H264queue.size() > 1)
+  {
+    const double first = Timestamp(m_H264queue.front());
+    const double last = Timestamp(m_H264queue.back());
+    // timestamps can step back at a join: the span is a magnitude, the count a backstop
+    if (m_H264queue.size() <= H264_QUEUE_MAX && std::abs(last - first) <= MVC_WAIT_MAX)
+      break;
+
+    CDVDDemuxUtils::FreeDemuxPacket(m_H264queue.front());
+    m_H264queue.pop();
+    dropped = true;
+  }
+
+  if (dropped)
+    Resync(Timestamp(m_H264queue.front()), FrontPlayItem(), "no second view for the base view");
+}
+
+// Moves the second view to the base view's picture at ts, past whatever it cannot read; once per
+// MVC_WAIT_MAX of the base view's newest picture, so that a second view that cannot be read is
+// not sought on every picture.
+void CDemuxStreamSSIF::Resync(double ts, int playItem, const char* reason)
+{
+  const double newest = m_H264queue.empty() ? ts : Timestamp(m_H264queue.back());
+  if (m_resyncTime != DVD_NOPTS_VALUE && std::abs(newest - m_resyncTime) < MVC_WAIT_MAX)
+    return;
+
+  CLog::Log(LOGWARNING, "CDemuxStreamSSIF - {}, moving the second view to {:.3f}", reason,
+            ts / DVD_TIME_BASE);
+  FlushMVC();
+  m_resyncTime = newest;
+  m_bluRay->ResyncExtention(ts, playItem);
+}
