+// ts: a timestamp Read returned; the timestamp of the file (90 kHz) it was converted from
+int64_t CDemuxMVC::ClipTimestamp(double ts) const
+{
+  if (m_lastDts != DVD_NOPTS_VALUE)
+    return m_lastClipDts + static_cast<int64_t>((ts - m_lastDts) * 90000 / DVD_TIME_BASE);
+  // Read keeps a timestamp below the start time as it is
+  const int64_t shifted = static_cast<int64_t>((ts / DVD_TIME_BASE + StartTimeSeconds()) * 90000);
+  const int64_t kept = static_cast<int64_t>(ts / DVD_TIME_BASE * 90000);
+  const auto inClip = [this](int64_t clipTs)
+  { return m_clipEnd > 0 && clipTs >= m_clipIn && clipTs < m_clipEnd; };
+  return !inClip(shifted) && inClip(kept) ? kept : shifted;
 }
 
