+// The base view's picture at ts was read in playItem. Unknown in menu mode, it is taken to be the
+// extension's clip if only that holds the picture's timestamp, else the base view's.
+void CDVDInputStreamBluray::ResyncExtention(double ts, int playItem)
+{
+  if (!m_bMVCPlayback || ts == DVD_NOPTS_VALUE)
+    return;
+
+  if (!ClipAt(playItem))
+  {
+    playItem = BaseClip();
+    if (m_pMVCDemux && playItem != m_nMVCClip)
+    {
+      const int64_t clipTs = m_pMVCDemux->ClipTimestamp(ts);
+      const auto holds = [this, clipTs](int item)
+      {
+        const BLURAY_CLIP_INFO* clip = ClipAt(item);
+        return clip && clipTs >= static_cast<int64_t>(clip->in_time) &&
+               clipTs < static_cast<int64_t>(clip->out_time);
+      };
+      if (holds(m_nMVCClip) && !holds(playItem))
+        playItem = m_nMVCClip;
+    }
+    if (!ClipAt(playItem))
+      return;
+  }
+
+  if ((playItem != m_nMVCClip || !m_pMVCDemux) && !OpenMVCDemux(playItem))
+    return;
+  m_pMVCDemux->SeekClipTimestamp(m_pMVCDemux->ClipTimestamp(ts));
+}
+
+bool CDVDInputStreamBluray::IsExtentionAtStart(int playItem)
+{
+  return m_pMVCDemux && playItem == m_nMVCClip && m_pMVCDemux->IsAtClipStart() &&
+         !m_pMVCDemux->IsEOF();
+}
