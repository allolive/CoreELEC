 //! driving the clock somewhere absurd.
 constexpr double MAX_AUDIO_OFFSET_S = 1.0;
 
+// as a picture of this codec gets its layout: the stream's stereo mode, which
+// GetPicture passes on, and the file's video settings only when it has none
+bool StreamIsStereo(const CDVDStreamInfo& hints, const CVideoSettings& settings)
+{
+  if (!hints.stereo_mode.empty())
+    return hints.stereo_mode != "mono";
+  switch (static_cast<RenderStereoMode>(settings.m_StereoMode))
+  {
+    case RenderStereoMode::SPLIT_VERTICAL:
+    case RenderStereoMode::SPLIT_HORIZONTAL:
+    case RenderStereoMode::HARDWAREBASED:
+      return true;
+    default:
+      return false;
+  }
+}
+
 
 std::mutex pollSyncMutex;
 
@@ -330,9 +347,14 @@ public:
 #define MODE_3D_TO_2D_B         0x00000a02
 #define MODE_3D_OUT_TB          0x00010000
 #define MODE_3D_OUT_LR          0x00020000
+// frame-sequential output: the video layer shows one eye per vsync
+#define MODE_3D_OUT_FA_L_FIRST  0x00001000
+#define MODE_FORCE_3D_FA_LR     0x10000000
+#define MODE_FORCE_3D_FA_TB     0x20000000
 
