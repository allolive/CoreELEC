+bool CAMLDisplay::set_fs3d_resolution(const RESOLUTION_INFO &res, std::string framebuffer_name,
+  const RenderStereoMode stereo_mode, bool force_mode_switch, bool hotplug_mode_switch)
+{
+  bool enter = aml_display_fs3d_wanted(stereo_mode);
+  // Kodi turns the stereo mode off as each film of a playlist starts and on
+  // again when it has read the new one's layout: not a reason to leave
+  if (!enter && fs3d_next_film_starting())
+  {
+    CLog::Log(LOGINFO, "CAMLDisplay::{} - frame-sequential 3D kept for the next film",
+              __FUNCTION__);
+    enter = true;
+    force_mode_switch = false;
+  }
+
+  // the sink is never told about 3D
+  if (m_stereo_mode != RenderStereoMode::OFF)
+    handle_display_stereo_mode(RenderStereoMode::OFF);
+
+  if (!enter)
+  {
+    fs3d_apply(false, 0);
+    m_fs3d_active = false;
+    m_fs3d_vrr_rate = 0;
+    CLog::Log(LOGINFO, "CAMLDisplay::{} - left frame-sequential 3D", __FUNCTION__);
+    return set_display_resolution(res, framebuffer_name, true, hotplug_mode_switch);
+  }
+
+  // The film rate: the video's own, or the refresh Kodi picked for it.
+  float fps = CServiceBroker::GetDataCacheCore().GetVideoFps();
+  if (fps <= 0)
+    fps = res.fRefreshRate;
+
+  // Kodi's GUI keeps its own size (the plane scales it); only the mode changes.
+  // A 1000/1001 film rate takes the 119.88 Hz twin, so VRR lands on it exactly.
+  RESOLUTION_INFO base = res;
+  base.strId = FS3D_MODE;
+  base.iScreenWidth = FS3D_WIDTH;
+  base.iScreenHeight = FS3D_HEIGHT;
+  base.fRefreshRate = 120.0f;
+  if (fps > 0 && std::fabs(fps * 1.001f - std::round(fps * 1.001f)) < 0.01f &&
+      std::fabs(fps - std::round(fps)) > 0.01f)
+    base.fRefreshRate = FractionalRate(120);
+
+  // the 120/119.88 twins share a mode name: switch when the policy differs
+  const int frac = base.fRefreshRate == std::floor(base.fRefreshRate) ? 0 : 1;
+  const bool twin = m_amlDRMUtils->aml_get_drmProperty("FRAC_RATE_POLICY",
+                                                      DRM_MODE_OBJECT_CONNECTOR) != frac;
+
+  if (!m_fs3d_active)
+  {
+    m_fs3d_allm = CSysfsPath(FS3D_ALLM).Get<std::string>().value_or("0");
+    StringUtils::Trim(m_fs3d_allm);
+  }
+  const bool switch_mode = force_mode_switch || !m_fs3d_active || twin;
+  if (!set_display_resolution(base, framebuffer_name, switch_mode, hotplug_mode_switch))
+  {
+    CLog::Log(LOGERROR, "CAMLDisplay::{} - could not set {}", __FUNCTION__, FS3D_MODE);
+    if (m_fs3d_active)
+      fs3d_apply(false, 0);
+    m_fs3d_active = false;
+    m_fs3d_vrr_rate = 0;
+    // for the rest of this film: it is not held back waiting for it
+    m_fs3d_entry_failed = true;
+    return set_display_resolution(res, framebuffer_name, true, hotplug_mode_switch);
+  }
+
+  // The largest even multiple of the film rate the base carries. vrr_rate is in
+  // the base mode's nominal units (the driver scales the base line rate by it),
+  // so on the 119.88 Hz twin 9600 is 95.904 Hz.
+  int multiple = fps > 0 ? static_cast<int>(base.fRefreshRate * 1.0001f / fps) : 0;
+  multiple -= multiple % 2;
+  const int vrr_rate = multiple >= 2 && fps * multiple >= 40.0f
+                           ? static_cast<int>(fps * multiple / base.fRefreshRate * 12000.0f + 0.5f)
+                           : 0;
+  // the same mode and rate again need no rewrite: the sink can take one as a change
+  if (switch_mode || vrr_rate != m_fs3d_vrr_rate)
+    fs3d_apply(true, vrr_rate);
+  m_fs3d_vrr_rate = vrr_rate;
+  m_fs3d_res = res;
+  m_fs3d_fps = fps;
+  m_fs3d_active = true;
+
+  CLog::Log(LOGINFO, "CAMLDisplay::{} - frame-sequential 3D, {:.3f} fps at vrr_rate {}",
+            __FUNCTION__, fps, vrr_rate);
+  return true;
+}
+
+// HFR VRR is for a 3D film that is playing: the GUI on its own (playback
+// stopping, the mode chosen in the menus) and a 2D film stay in their resolution.
+bool CAMLDisplay::aml_display_fs3d_wanted(const RenderStereoMode stereo_mode) const
+{
+  if (!m_support_fs3d || m_fs3d_entry_failed || stereo_mode != RenderStereoMode::HFR_VRR)
+    return false;
+  const auto appPlayer = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  if (!appPlayer || !appPlayer->IsPlayingVideo())
+    return false;
+  const std::string layout = CServiceBroker::GetDataCacheCore().GetVideoStereoMode();
+  return !layout.empty() && layout != "mono";
+}
+
+bool CAMLDisplay::aml_display_fs3d_matches(const RESOLUTION_INFO& res) const
+{
+  const float fps = CServiceBroker::GetDataCacheCore().GetVideoFps();
+  return m_fs3d_active && (fps <= 0 || fps == m_fs3d_fps) &&
+         m_fs3d_res.iWidth == res.iWidth && m_fs3d_res.iHeight == res.iHeight &&
+         m_fs3d_res.iScreenWidth == res.iScreenWidth &&
+         m_fs3d_res.iScreenHeight == res.iScreenHeight &&
+         m_fs3d_res.fRefreshRate == res.fRefreshRate &&
+         (m_fs3d_res.dwFlags & D3DPRESENTFLAG_MODEMASK) == (res.dwFlags & D3DPRESENTFLAG_MODEMASK);
+}
+
+bool CAMLDisplay::aml_display_fs3d_stale() const
+{
+  const float fps = CServiceBroker::GetDataCacheCore().GetVideoFps();
+  return m_fs3d_active && fps > 0 && fps != m_fs3d_fps;
+}
+
+void CAMLDisplay::aml_fs3d_decoder_closed()
+{
+  m_fs3d_closed_at = m_fs3d_active ? std::chrono::steady_clock::now().time_since_epoch().count()
+                                   : 0;
+}
+
+// A film follows one shown in 3D: the player plays, and its decoder has not
+// opened yet or opened on a stereo layout, not long after. Kodi asks for 2D at
+// the new film's first picture, before it has read the layout, so a picture is
+// no sign. A stop is not playing; a 2D film leaves once its decoder has opened,
+// one decoded in software at the bound, and so does a 3D one Kodi plays in 2D.
+bool CAMLDisplay::fs3d_next_film_starting() const
+{
+  const int64_t closed = m_fs3d_closed_at;
+  if (!m_fs3d_active || closed == 0 ||
+      std::chrono::steady_clock::now().time_since_epoch().count() - closed >=
+          std::chrono::duration_cast<std::chrono::steady_clock::duration>(std::chrono::seconds(5))
+              .count())
+    return false;
+  const auto appPlayer = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  return appPlayer && appPlayer->IsPlaying() &&
+         CAMLCodec::GetOpenedLayout() != CAMLCodec::OpenedLayout::MONO;
+}
+
+void CAMLDisplay::aml_fs3d_leave()
+{
+  if (!m_fs3d_active)
+    return;
+  fs3d_apply(false, 0);
+  m_fs3d_active = false;
+  m_fs3d_vrr_rate = 0;
+}
