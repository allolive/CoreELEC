+  // A Kodi that died in 3D left the sink in game VRR, and the video layer
+  // alternating the eyes. Only on the first refresh, before this Kodi has
+  // entered 3D itself: a hotplug refresh while entering (game VRR set, not
+  // yet marked active) would take its own 3D down.
+  const bool first_refresh = !m_fs3d_recovery_checked.exchange(true);
+  if (first_refresh && !m_fs3d_active &&
