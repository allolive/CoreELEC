   m_support_3d = support_3d;
+
+  // Frame-sequential 3D: a 2D sink that takes game VRR (the kernel's own test,
+  // vrr_min) and 1080p 120 Hz, and a kernel that alternates the eyes of both
+  // the video and the GUI on every vsync. A sink re-syncing its HDMI link reads
+  // disconnected with one dummy mode for a second or two: keep what it could do,
+  // or a 3D film drops to 2D and that mode switch makes the sink re-sync again.
+  if (aml_get_display_connected())
+  {
+    bool support_fs3d = false;
+    if (!support_3d && CSysfsPath(FS3D_VRR_RATE).Exists() &&
+        CSysfsPath(FS3D_OSD).Exists() && CSysfsPath("/sys/class/video/fa_sync").Exists())
+    {
