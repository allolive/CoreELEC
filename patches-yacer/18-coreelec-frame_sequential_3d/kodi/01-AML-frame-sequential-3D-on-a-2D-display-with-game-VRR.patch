+/*
+ * Frame-sequential 3D (HFR VRR). The sink keeps seeing a 2D 1080p 120 Hz signal,
+ * and game VRR slows it to the largest even multiple of the film rate it carries
+ * (24p at 96 Hz: each eye sees every frame twice). The video layer alternates the
+ * eyes; the GUI is drawn once, the same for both. ALLM keeps the TV out of motion
+ * smoothing, which would blend the eyes. Leaving puts all of it back.
+ */
+void CAMLDisplay::fs3d_apply(bool on, int vrr_rate)
+{
+  if (on)
+  {
+    CSysfsPath(FS3D_ALLM, std::string("1"));
+    CSysfsPath("/sys/class/amhdmitx/amhdmitx0/vrr_mode",
+               std::string(vrr_rate ? "game-vrr" : "none"));
+    CSysfsPath(FS3D_VRR_RATE, vrr_rate);
+    CSysfsPath(FS3D_OSD, 0);
+  }
+  else
+  {
+    CSysfsPath(FS3D_OSD, 0);
+    CSysfsPath(FS3D_VRR_RATE, 0);
+    CSysfsPath("/sys/class/amhdmitx/amhdmitx0/vrr_mode", std::string("none"));
+    CSysfsPath(FS3D_ALLM, m_fs3d_allm.empty() ? std::string("0") : m_fs3d_allm);
+  }
+}
