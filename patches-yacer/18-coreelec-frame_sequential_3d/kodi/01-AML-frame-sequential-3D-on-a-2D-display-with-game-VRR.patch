+      for (const auto& line : StringUtils::Split(vrr_cap.Get<std::string>().value_or(""), "\n"))
+      {
+        std::vector<std::string> kv = StringUtils::Split(line, ":");
+        if (kv.size() == 2 && StringUtils::Trim(kv[0]) == "vrr_min")
+          support_fs3d = std::atoi(StringUtils::Trim(kv[1]).c_str()) > 0;
+      }
+      if (support_fs3d)
+        support_fs3d = m_amlDRMUtils->aml_get_drmDevice_modes().find(FS3D_MODE) != std::string::npos;
+    }
+    if (support_fs3d != m_support_fs3d)
+      CLog::Log(LOGINFO, "CAMLDisplay::{} - frame-sequential 3D {}", __FUNCTION__,
+                support_fs3d ? "available" : "not available");
+    m_support_fs3d = support_fs3d;
