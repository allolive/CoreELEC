+  const int hfrVrr = static_cast<int>(RenderStereoMode::HFR_VRR);
+  return settings->GetInt(CSettings::SETTING_VIDEOSCREEN_PREFEREDSTEREOSCOPICMODE) == hfrVrr ||
+         settings->GetInt(CSettings::SETTING_VIDEOSCREEN_STEREOSCOPICMODE) == hfrVrr;
 }
 
