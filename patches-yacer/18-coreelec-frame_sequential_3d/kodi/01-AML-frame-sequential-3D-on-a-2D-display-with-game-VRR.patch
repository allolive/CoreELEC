+namespace
+{
+void Fs3dCheckNow(void*)
+{
+  CWinSystemBase* winSystem = CServiceBroker::GetWinSystem();
+  if (!winSystem)
+    return;
+  if (auto* aml = dynamic_cast<CWinSystemAmlogic*>(winSystem); aml && aml->HoldFs3dCheck())
+    return;
+  auto& gfxContext = winSystem->GetGfxContext();
+  gfxContext.SetVideoResolution(gfxContext.GetVideoResolution(), true);
+}
+
+KODI::MESSAGING::ThreadMessageCallback fs3dCheck{&Fs3dCheckNow, nullptr};
+} // namespace
+
+void CWinSystemAmlogic::RequestFs3dCheck()
+{
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_CALLBACK, -1, -1,
+                                             static_cast<void*>(&fs3dCheck));
+}
+
+bool CWinSystemAmlogic::HoldFs3dCheck()
+{
+  // Back-to-back 3D films: after one ends, Kodi asks for 2D until it has read
+  // the next one's stereo layout. Leaving costs the sink two re-syncs and a mode
+  // switch under the next film's decoder opening; while that decoder has not
+  // opened or opened on a stereo layout, ask again shortly, for at most a few
+  // seconds (a film decoded in software never says).
+  // A 2D film follows: a check from here leaves at the mode the 3D film had,
+  // and Kodi's resolution update, once the film shows, switches again to the
+  // mode it picks for it. Keep holding briefly for that update to leave in one
+  // switch, and leave from here if it does not come (refresh rate not adjusted).
+  using namespace std::chrono_literals;
+  const auto now = std::chrono::steady_clock::now();
+  const auto appPlayer = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  if (m_fs3dAwaitNext && m_amlDisplay && m_amlDisplay->aml_display_fs3d_active() && appPlayer &&
+      appPlayer->IsPlaying())
+  {
+    if (!m_fs3dCheckHeldSince)
+      m_fs3dCheckHeldSince = now;
+    if (CAMLCodec::GetOpenedLayout() == CAMLCodec::OpenedLayout::MONO && !m_fs3dCheckMonoSince)
+      m_fs3dCheckMonoSince = now;
+    if (now - *m_fs3dCheckHeldSince < 5s &&
+        (!m_fs3dCheckMonoSince || now - *m_fs3dCheckMonoSince < 1500ms))
+    {
+      m_fs3dCheckRetry = now + 200ms;
+      return true;
+    }
+  }
+  m_fs3dAwaitNext = false;
+  m_fs3dCheckHeldSince.reset();
+  m_fs3dCheckMonoSince.reset();
+  m_fs3dCheckRetry.reset();
+  return false;
+}
+
+void CWinSystemAmlogic::Announce(ANNOUNCEMENT::AnnouncementFlag flag,
+                                 const std::string& sender,
+                                 const std::string& message,
+                                 const CVariant& data)
+{
+  if (flag == ANNOUNCEMENT::Player && message == "OnStop" && m_amlDisplay)
+    m_amlDisplay->aml_fs3d_playback_stopped();
+  if (flag == ANNOUNCEMENT::Player && message == "OnStop" && m_amlDisplay &&
+      m_amlDisplay->aml_display_fs3d_active())
+  {
+    m_fs3dAwaitNext = true;
+    RequestFs3dCheck();
+  }
+}
