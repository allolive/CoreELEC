--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -22614,6 +22614,12 @@ msgctxt "#36511"
 msgid "Checkerboard"
 msgstr ""
 
+#. Stereoscopic 3D mode: one eye per refresh at a high refresh rate with VRR, for shutter glasses on a 2D display
+#: system/settings/settings.xml
+msgctxt "#60030"
+msgid "Active 3D for 120 Hz VRR displays"
+msgstr ""
+
 #empty strings from id 36512 to 36519
 #end of reserved strings for 3d modes
 
diff --git a/xbmc/application/Application.cpp b/xbmc/application/Application.cpp
index 0671422..15420ed 100644
--- a/xbmc/application/Application.cpp
+++ b/xbmc/application/Application.cpp
@@ -915,7 +915,9 @@ void CApplication::Render()
 
   if (guiWillRender)
   {
-    if (CServiceBroker::GetWinSystem()->GetGfxContext().GetStereoMode() != RenderStereoMode::OFF)
+    const RenderStereoMode stereoMode = CServiceBroker::GetWinSystem()->GetGfxContext().GetStereoMode();
+    // HFR VRR alternates the eyes in the video layer; the GUI is drawn once
+    if (stereoMode != RenderStereoMode::OFF && stereoMode != RenderStereoMode::HFR_VRR)
     {
       CServiceBroker::GetWinSystem()->GetGfxContext().SetStereoView(RenderStereoView::LEFT);
       hasRendered |= CServiceBroker::GetGUI()->GetWindowManager().Render();
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
index d371c41..ad81df4 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLCodec.cpp
@@ -315,9 +315,14 @@ public:
 #define MODE_3D_TO_2D_B         0x00000a02
 #define MODE_3D_OUT_TB          0x00010000
 #define MODE_3D_OUT_LR          0x00020000
+// frame-sequential output: the video layer shows one eye per vsync
+#define MODE_3D_OUT_FA_L_FIRST  0x00001000
+#define MODE_FORCE_3D_FA_LR     0x10000000
+#define MODE_FORCE_3D_FA_TB     0x20000000
 
 #define PTS_FREQ        90000
 #define UNIT_FREQ       96000
+
 #define AV_SYNC_THRESH  PTS_FREQ*30
 
 #define TRICKMODE_NONE  0x00
@@ -2823,6 +2828,14 @@ void CAMLCodec::CloseDecoder()
 
   SetPollDevice(-1);
 
+  // the next stream starts in 2D, whatever this one had the video layer do
+  if (m_fs3dMode != FS3D_UNSET)
+  {
+    aml_set_3d_video_mode(MODE_3D_DISABLE, false, 3);
+    CSysfsPath(CAMLDisplay::FS3D_SWAP, 0);
+    m_fs3dMode = FS3D_UNSET;
+  }
+
   // never leave vcodec ff/rw or paused.
   if (m_speed != DVD_PLAYSPEED_NORMAL)
   {
@@ -3836,6 +3849,40 @@ void CAMLCodec::SetVideoRect(const CRect &SrcRect, const CRect &DestRect)
     m_guiStereoMode = guiStereoMode;
     update = true;
   }
+  // the viewer's left/right swap, for frame-sequential 3D
+  const bool stereoInvert = m_processInfo.GetVideoSettings().m_StereoInvert;
+  if (m_stereoInvert != stereoInvert)
+  {
+    m_stereoInvert = stereoInvert;
+    update = true;
+  }
+  // HFR VRR switches the output on after the stereo mode has changed: work the
+  // video layer's mode out again when it does, or the video keeps the mode found
+  // before the switch, 2D, and nothing alternates.
+  const bool fs3dActive = static_cast<CWinSystemAmlogic*>(CServiceBroker::GetWinSystem())
+                              ->GetAmlDisplay()
+                              ->aml_display_fs3d_active();
+  if (m_fs3dActive != fs3dActive)
+  {
+    m_fs3dActive = fs3dActive;
+    update = true;
+  }
+  // HFR VRR is entered and left from here, whatever Kodi's refresh rate
+  // setting: ask for the output to switch while it is not as it should be (once,
+  // and again if that did not take), and show the film once it is on.
+  auto* fs3dDisplay =
+      static_cast<CWinSystemAmlogic*>(CServiceBroker::GetWinSystem())->GetAmlDisplay();
+  const bool fs3dWanted = fs3dDisplay->aml_display_fs3d_wanted(m_guiStereoMode);
+  // on for the previous film of a playlist, at its rate, counts as not as it should be
+  if (fs3dWanted == m_fs3dActive && !(fs3dWanted && fs3dDisplay->aml_display_fs3d_stale()))
+    m_fs3dAsked = {};
+  else if (m_fs3dAsked == std::chrono::steady_clock::time_point{} ||
+           std::chrono::steady_clock::now() - m_fs3dAsked > std::chrono::seconds(3))
+  {
+    m_fs3dAsked = std::chrono::steady_clock::now();
+    CWinSystemAmlogic::RequestFs3dCheck();
+  }
+  const bool fs3dPending = fs3dWanted && !m_fs3dActive;
   RenderStereoView guiStereoView = CServiceBroker::GetWinSystem()->GetGfxContext().GetStereoView();
   if (m_guiStereoView != guiStereoView)
   {
@@ -3880,7 +3927,7 @@ void CAMLCodec::SetVideoRect(const CRect &SrcRect, const CRect &DestRect)
   if (!update)
   {
     // mainvideo 'should' be showing already if we get here, make sure.
-    ShowMainVideo(true);
+    ShowMainVideo(!fs3dPending);
     return;
   }
 
@@ -3924,7 +3971,9 @@ void CAMLCodec::SetVideoRect(const CRect &SrcRect, const CRect &DestRect)
     dst_rect.y2 = info.iHeight * 2 + info.iBlanking;
   }
 
-  if (static_cast<CWinSystemAmlogic*>(CServiceBroker::GetWinSystem())->GetAmlDisplay()->aml_display_support_3d())
+  auto* amlDisplay =
+      static_cast<CWinSystemAmlogic*>(CServiceBroker::GetWinSystem())->GetAmlDisplay();
+  if (amlDisplay->aml_display_support_3d())
   {
     int mvc_view_mode = 3;
     switch (am_private->video_format)
@@ -3954,6 +4003,60 @@ void CAMLCodec::SetVideoRect(const CRect &SrcRect, const CRect &DestRect)
         break;
     }
   }
+  // also once the capability went away, to take the video layer back to 2D
+  else if (amlDisplay->aml_display_support_fs3d() ||
+           (m_fs3dMode != FS3D_UNSET && m_fs3dMode != MODE_3D_DISABLE))
+  {
+    // HFR VRR: the video layer shows one eye per vsync, full screen, taking the
+    // eyes from the source's own layout. Any other stereo mode is plain Kodi.
+    const std::string& layout = m_processInfo.GetVideoStereoMode();
+    const bool hfr = m_guiStereoMode == RenderStereoMode::HFR_VRR &&
+                     amlDisplay->aml_display_fs3d_active();
+    const bool mvc = am_private->video_format == VFORMAT_H264MVC;
+    unsigned int mode = MODE_3D_DISABLE;
+    int mvc_view_mode = 3;
+
+    if (mvc)
+    {
+      // the decoder puts the requested view first: that is MVC's eye swap
+      mvc_view_mode = (m_hints.stereo_mode == "block_rl") != m_stereoInvert ? 2 : 3;
+      mode = hfr ? MODE_3D_ENABLE | MODE_3D_FA | MODE_3D_OUT_FA_L_FIRST
+                 : MODE_3D_ENABLE | MODE_3D_FA | MODE_3D_TO_2D_L;
+    }
+    else if (hfr && (layout == "left_right" || layout == "right_left"))
+      mode = MODE_3D_ENABLE | MODE_FORCE_3D_FA_LR | MODE_3D_OUT_FA_L_FIRST;
+    else if (hfr && (layout == "top_bottom" || layout == "bottom_top"))
+      mode = MODE_3D_ENABLE | MODE_FORCE_3D_FA_TB | MODE_3D_OUT_FA_L_FIRST;
+
+    // The output is 1080p while Kodi's resolution may be 4K.
+    if (amlDisplay->aml_display_fs3d_active() && display.Width() > 0 && display.Height() > 0)
+    {
+      const float xs = static_cast<float>(CAMLDisplay::FS3D_WIDTH) / display.Width();
+      const float ys = static_cast<float>(CAMLDisplay::FS3D_HEIGHT) / display.Height();
+      dst_rect.x1 *= xs;
+      dst_rect.x2 *= xs;
+      dst_rect.y1 *= ys;
+      dst_rect.y2 *= ys;
+    }
+
+    // Side by side and top and bottom alternate the halves the same way; a
+    // right-eye-first source or the viewer's swap only changes which eye each
+    // refresh carries, and the glasses follow that.
+    const bool rightFirst = layout == "right_left" || layout == "bottom_top";
+    const bool swap = !mvc && rightFirst != m_stereoInvert;
+
+    if (mode != m_fs3dMode || swap != m_fs3dSwap || mvc_view_mode != m_fs3dView)
+    {
+      CLog::Log(LOGDEBUG,
+                "CAMLCodec::SetVideoRect: frame-sequential 3D mode {:#x} ({}, gui {}, swap {})",
+                mode, layout, static_cast<int>(m_guiStereoMode), swap);
+      CSysfsPath(CAMLDisplay::FS3D_SWAP, swap ? 1 : 0);
+      aml_set_3d_video_mode(mode, false, mvc_view_mode);
+      m_fs3dMode = mode;
+      m_fs3dSwap = swap;
+      m_fs3dView = mvc_view_mode;
+    }
+  }
 
 #if 1
   std::string s_dst_rect = StringUtils::Format("{:d},{:d},{:d},{:d}",
@@ -3991,7 +4094,7 @@ void CAMLCodec::SetVideoRect(const CRect &SrcRect, const CRect &DestRect)
 
   // we only get called once gui has changed to something
   // that would show video playback, so show it.
-  ShowMainVideo(true);
+  ShowMainVideo(!fs3dPending);
 }
 
 void CAMLCodec::SetVideoRate(int videoRate)
