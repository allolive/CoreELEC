diff --git a/xbmc/video/StereoDepth.cpp b/xbmc/video/StereoDepth.cpp
new file mode 100644
index 0000000..feea07b
--- /dev/null
+++ b/xbmc/video/StereoDepth.cpp
@@ -0,0 +1,121 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "StereoDepth.h"
+
+#include "FileItem.h"
+#include "ServiceBroker.h"
+#include "filesystem/File.h"
+#include "resources/LocalizeStrings.h"
+#include "resources/ResourcesComponent.h"
+#include "utils/JSONVariantParser.h"
+#include "utils/JSONVariantWriter.h"
+#include "utils/StringUtils.h"
+#include "utils/Variant.h"
+#include "utils/log.h"
+#include "video/VideoInfoTag.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <mutex>
+#include <optional>
+#include <vector>
+
+namespace
+{
+constexpr const char* DepthFile = "special://profile/stereodepth.json";
+constexpr const char* DepthFileNew = "special://profile/stereodepth.json.new";
+
+std::mutex depthLock;
+//! the file's contents, read once
+std::optional<CVariant> depths;
+
+//! the film's own file, as the library knows it, whichever path played it
+std::string Key(const CFileItem& item)
+{
+  if (item.HasVideoInfoTag() && !item.GetVideoInfoTag()->m_strFileNameAndPath.empty())
+    return item.GetVideoInfoTag()->m_strFileNameAndPath;
+  return item.GetPath();
+}
+
+CVariant& Depths()
+{
+  if (depths)
+    return *depths;
+  depths.emplace(CVariant::VariantTypeObject);
+  std::vector<uint8_t> buffer;
+  XFILE::CFile file;
+  if (file.LoadFile(DepthFile, buffer) <= 0)
+    return *depths;
+  CVariant read;
+  if (CJSONVariantParser::Parse(std::string(buffer.begin(), buffer.end()), read) &&
+      read.isObject())
+    *depths = read;
+  else
+    CLog::LogF(LOGWARNING, "{} is not a JSON object, starting afresh", DepthFile);
+  return *depths;
+}
+
+void Save(const CVariant& depths)
+{
+  std::string json;
+  if (!CJSONVariantWriter::Write(depths, json, false))
+    return;
+  // written aside and renamed over, so a power cut leaves the old file or the new one
+  XFILE::CFile file;
+  if (!file.OpenForWrite(DepthFileNew, true) ||
+      file.Write(json.data(), json.size()) != static_cast<ssize_t>(json.size()))
+  {
+    CLog::LogF(LOGERROR, "cannot write {}", DepthFileNew);
+    return;
+  }
+  file.Close();
+  if (!XFILE::CFile::Rename(DepthFileNew, DepthFile))
+    CLog::LogF(LOGERROR, "cannot replace {}", DepthFile);
+}
+} // unnamed namespace
+
+int CStereoDepth::Get(const CFileItem& item)
+{
+  std::lock_guard lock(depthLock);
+  const CVariant& all = Depths();
+  const std::string key = Key(item);
+  if (!all.isMember(key))
+    return 0;
+  return std::clamp(static_cast<int>(all[key].asInteger()), -MAX, MAX);
+}
+
+void CStereoDepth::Set(const CFileItem& item, int depth)
+{
+  std::lock_guard lock(depthLock);
+  CVariant& all = Depths();
+  const std::string key = Key(item);
+  if (depth == 0)
+  {
+    if (!all.isMember(key))
+      return;
+    all.erase(key);
+  }
+  else
+  {
+    if (all.isMember(key) && all[key].asInteger() == depth)
+      return;
+    all[key] = depth;
+  }
+  Save(all);
+}
+
+std::string CStereoDepth::Format(int depth)
+{
+  if (depth == 0)
+    return "0 px";
+  // as the audio offset's "Delayed by" and "Ahead by": which way the picture went
+  return StringUtils::Format(
+      CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(depth > 0 ? 60111 : 60112),
+      depth > 0 ? depth : -depth);
+}
