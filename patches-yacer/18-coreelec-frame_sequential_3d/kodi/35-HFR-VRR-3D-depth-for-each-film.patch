+#pragma once
+
+#include <string>
+
+class CFileItem;
+
+/*!
+ * \brief The 3D depth of each film: how many pixels one eye's picture goes right of the other's.
+ * Positive brings the picture forward, more of it out of the screen (the left eye's goes right);
+ * negative sets it back behind the screen (the right eye's goes right).
+ *
+ * Kept in a file of its own in the profile rather than with the film's other video settings: the
+ * video database has no column for it, and is often a library several players share.
+ */
+class CStereoDepth
+{
+public:
+  static constexpr int MAX = 20;
+
+  //! the film's depth, 0 unless one was set for it
+  static int Get(const CFileItem& item);
+  //! keep the film's depth; 0 forgets it
+  static void Set(const CFileItem& item, int depth);
+  //! "4 px closer", "4 px further", "0 px"
+  static std::string Format(int depth);
+};
