+      }
+    }
+    // Connected, but the capabilities or the mode list read short, as they do
+    // for a moment after a hotplug: dropping support would take a 3D film down
+    // with a mode switch, and that switch can make the sink re-sync again. Keep
+    // it while the mode 3D runs on is still listed, else until a second read
+    // agrees.
+    if (!support_fs3d && m_support_fs3d)
+    {
+      if (m_fs3d_active)
+        modes = m_amlDRMUtils->aml_get_drmDevice_modes();
+      const bool modeListed = m_fs3d_active && modes.find(m_fs3d_mode) != std::string::npos;
+      if (modeListed || !m_fs3d_drop_seen)
+      {
+        m_fs3d_drop_seen = !modeListed;
+        support_fs3d = true;
+        CLog::Log(LOGINFO, "CAMLDisplay::{} - frame-sequential 3D read as not available, kept",
+                  __FUNCTION__);
+      }
     }
+    else
+      m_fs3d_drop_seen = false;
     if (support_fs3d != m_support_fs3d)
       CLog::Log(LOGINFO, "CAMLDisplay::{} - frame-sequential 3D {}", __FUNCTION__,
                 support_fs3d ? "available" : "not available");
@@ -1191,14 +1229,23 @@ bool CAMLDisplay::set_native_resolution(const RESOLUTION_INFO &res, std::string
  * eyes; the GUI is drawn once, the same for both. ALLM keeps the TV out of motion
