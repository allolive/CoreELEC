   }
 
-  // The largest even multiple of the film rate the base carries. vrr_rate is in
-  // the base mode's nominal units (the driver scales the base line rate by it),
-  // so on the 119.88 Hz twin 9600 is 95.904 Hz.
-  int multiple = fps > 0 ? static_cast<int>(base.fRefreshRate * 1.0001f / fps) : 0;
-  multiple -= multiple % 2;
-  const int vrr_rate = multiple >= 2 && fps * multiple >= 40.0f
-                           ? static_cast<int>(fps * multiple / base.fRefreshRate * 12000.0f + 0.5f)
-                           : 0;
+  const int vrr_rate = rates.vrrRate;
