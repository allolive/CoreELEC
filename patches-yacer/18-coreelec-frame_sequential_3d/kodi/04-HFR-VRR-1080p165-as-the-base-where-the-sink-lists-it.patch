   return !layout.empty() && layout != "mono";
 }
 
+/*
+ * What a film rate makes of HFR VRR on the current base mode. A 1000/1001 film
+ * rate takes the 119.88 Hz twin of 1080p120, so VRR lands on it exactly; on
+ * 1080p165 there is no twin and VRR is told the 1000/1001 rate itself.
+ * vrr_rate is the largest even multiple of the film rate the base carries. On
+ * 1080p120 it is in the base mode's nominal units (the driver scales the base
+ * line rate by it), so on the twin 9600 is 95.904 Hz; on 1080p165 it is the
+ * rate itself, with the 1000/1001 flag, and the multiple stays within 120 Hz:
+ * more would shorten the time with one eye.
+ */
+CAMLDisplay::Fs3dRates CAMLDisplay::fs3d_rates(float fps) const
+{
+  const bool fast = m_fs3d_hz == 165;
+  const bool fracFilm = fps > 0 &&
+                        std::fabs(fps * 1.001f - std::round(fps * 1.001f)) < 0.01f &&
+                        std::fabs(fps - std::round(fps)) > 0.01f;
+  Fs3dRates rates;
+  rates.baseHz = static_cast<float>(m_fs3d_hz);
+  if (!fast && fracFilm)
+    rates.baseHz = FractionalRate(120);
+
+  if (fast)
+  {
+    const float fpsNom = fracFilm ? std::round(fps * 1.001f) : fps;
+    int multiple = fpsNom > 0 ? static_cast<int>(120.5f / fpsNom) : 0;
+    multiple -= multiple % 2;
+    if (multiple >= 2 && fpsNom * multiple >= 40.0f)
+    {
+      rates.vrrRate = static_cast<int>(std::lround(fpsNom * multiple * 100.0f));
+      rates.vrrFrac = fracFilm;
+    }
+  }
+  else
+  {
+    int multiple = fps > 0 ? static_cast<int>(rates.baseHz * 1.0001f / fps) : 0;
+    multiple -= multiple % 2;
+    if (multiple >= 2 && fps * multiple >= 40.0f)
+      rates.vrrRate = static_cast<int>(fps * multiple / rates.baseHz * 12000.0f + 0.5f);
+  }
+  return rates;
+}
+
+// A measured rate that moved in its last digits (23.976 then 23.97602) is the
+// same film: only a base mode, twin or VRR rate of its own makes it another.
 bool CAMLDisplay::aml_display_fs3d_matches(const RESOLUTION_INFO& res) const
 {
   const float fps = CServiceBroker::GetDataCacheCore().GetVideoFps();
-  return m_fs3d_active && (fps <= 0 || fps == m_fs3d_fps) &&
+  return m_fs3d_active && (fps <= 0 || fs3d_rates(fps) == m_fs3d_rates) &&
          m_fs3d_res.iWidth == res.iWidth && m_fs3d_res.iHeight == res.iHeight &&
          m_fs3d_res.iScreenWidth == res.iScreenWidth &&
          m_fs3d_res.iScreenHeight == res.iScreenHeight &&
@@ -1324,7 +1428,7 @@ bool CAMLDisplay::aml_display_fs3d_matches(const RESOLUTION_INFO& res) const
 bool CAMLDisplay::aml_display_fs3d_stale() const
 {
   const float fps = CServiceBroker::GetDataCacheCore().GetVideoFps();
-  return m_fs3d_active && fps > 0 && fps != m_fs3d_fps;
+  return m_fs3d_active && fps > 0 && fs3d_rates(fps) != m_fs3d_rates;
 }
 
 void CAMLDisplay::aml_fs3d_decoder_closed()
@@ -1358,6 +1462,7 @@ void CAMLDisplay::aml_fs3d_leave()
   fs3d_apply(false, 0);
   m_fs3d_active = false;
   m_fs3d_vrr_rate = 0;
+  m_fs3d_vrr_frac = false;
 }
 
