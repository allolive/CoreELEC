-    CSysfsPath("/sys/class/amhdmitx/amhdmitx0/vrr_mode",
-               std::string(vrr_rate ? "game-vrr" : "none"));
-    CSysfsPath(FS3D_VRR_RATE, vrr_rate);
+    if (vrr_rate)
+    {
+      CSysfsPath("/sys/class/amhdmitx/amhdmitx0/vrr_mode", std::string("game-vrr"));
+      // "<rate> 1": 1000/1001 of the rate, on a base mode without such a twin
+      CSysfsPath(FS3D_VRR_RATE, StringUtils::Format("{} {}", vrr_rate, vrr_frac ? 1 : 0));
+    }
+    else
+    {
+      // the rate goes back first: the kernel takes it only in game VRR
+      CSysfsPath(FS3D_VRR_RATE, 0);
+      CSysfsPath("/sys/class/amhdmitx/amhdmitx0/vrr_mode", std::string("none"));
+    }
     CSysfsPath(FS3D_OSD, 0);
   }
   else
@@ -1233,6 +1280,7 @@ bool CAMLDisplay::set_fs3d_resolution(const RESOLUTION_INFO &res, std::string fr
     fs3d_apply(false, 0);
     m_fs3d_active = false;
     m_fs3d_vrr_rate = 0;
+    m_fs3d_vrr_frac = false;
