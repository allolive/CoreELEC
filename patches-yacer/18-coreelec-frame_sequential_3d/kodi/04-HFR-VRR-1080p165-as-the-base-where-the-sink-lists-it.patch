     {
       CSysfsPath vrr_cap{"/sys/class/amhdmitx/amhdmitx0/vrr_cap"};
+      int vrr_max = 0;
       for (const auto& line : StringUtils::Split(vrr_cap.Get<std::string>().value_or(""), "\n"))
       {
         std::vector<std::string> kv = StringUtils::Split(line, ":");
         if (kv.size() == 2 && StringUtils::Trim(kv[0]) == "vrr_min")
           support_fs3d = std::atoi(StringUtils::Trim(kv[1]).c_str()) > 0;
+        else if (kv.size() == 2 && StringUtils::Trim(kv[0]) == "vrr_max")
+          vrr_max = std::atoi(StringUtils::Trim(kv[1]).c_str());
       }
       if (support_fs3d)
-        support_fs3d = m_amlDRMUtils->aml_get_drmDevice_modes().find(FS3D_MODE) != std::string::npos;
+      {
+        // a faster base mode where the sink has one: the picture is drawn in
+        // less of each frame, leaving the glasses more time with one eye
+        modes = m_amlDRMUtils->aml_get_drmDevice_modes();
+        const bool fast = modes.find(FS3D_MODE_165) != std::string::npos && vrr_max >= 165 &&
+                          modes != m_fs3d_165_failed;
+        support_fs3d = fast || modes.find(FS3D_MODE) != std::string::npos;
+        // a running 3D keeps its base until it is entered again
