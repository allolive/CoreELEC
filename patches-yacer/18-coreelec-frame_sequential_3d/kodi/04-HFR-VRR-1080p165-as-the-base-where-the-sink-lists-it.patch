   }
@@ -1242,16 +1290,22 @@ bool CAMLDisplay::set_fs3d_resolution(const RESOLUTION_INFO &res, std::string fr
   if (fps <= 0)
     fps = res.fRefreshRate;
 
+  // Entering, take the base the sink offered at its last refresh: one that came
+  // while 3D ran left the running base alone, and nothing refreshes on leaving.
