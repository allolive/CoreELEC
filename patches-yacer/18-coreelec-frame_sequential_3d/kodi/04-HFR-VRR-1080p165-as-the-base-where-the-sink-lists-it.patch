+  void fs3d_apply(bool on, int vrr_rate, bool vrr_frac = false);
+  //! what a film rate makes of HFR VRR: the base mode's rate (120, its 119.88
+  //! twin or 165) and the VRR rate with its 1000/1001 flag
+  struct Fs3dRates
+  {
+    float baseHz{0.0f};
+    int vrrRate{0};
+    bool vrrFrac{false};
+    bool operator==(const Fs3dRates&) const = default;
+  };
+  Fs3dRates fs3d_rates(float fps) const;
   static constexpr const char* FS3D_OSD = "/sys/module/aml_drm/parameters/osd_fa_3d";
   static constexpr const char* FS3D_VRR_RATE = "/sys/class/amhdmitx/amhdmitx0/vrr_rate";
   static constexpr const char* FS3D_ALLM = "/sys/class/amhdmitx/amhdmitx0/allm_mode";
@@ -252,7 +264,18 @@ private:
   std::string m_fs3d_allm;
   RESOLUTION_INFO m_fs3d_res;
   std::atomic<float> m_fs3d_fps{0.0f};
+  Fs3dRates m_fs3d_rates;
   //! the check for a 3D left behind by a Kodi that died has been made
   std::atomic<bool> m_fs3d_recovery_checked{false};
   int m_fs3d_vrr_rate = 0;
+  bool m_fs3d_vrr_frac = false;
+  //! the base mode HFR VRR runs on, and its rate: 165 where the sink offers it
+  std::string m_fs3d_mode{FS3D_MODE};
+  int m_fs3d_hz = 120;
+  //! the sink's mode list when 1080p165 could not be set: not tried again on it
+  std::string m_fs3d_165_failed;
+  //! the sink offered 1080p165 at its last refresh; taken when 3D is next entered
+  bool m_fs3d_offers_165 = false;
+  //! a refresh read frame-sequential 3D as gone and it was kept: the next one decides
+  bool m_fs3d_drop_seen = false;
 };
