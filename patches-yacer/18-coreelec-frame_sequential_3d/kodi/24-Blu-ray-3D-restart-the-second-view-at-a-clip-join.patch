+// At the end of its file the extension goes on to the next play item, if the base view has moved
+// past the one it was in; without a file it joins the base view.
 bool CDVDInputStreamBluray::OpenNextStream()
 {
-  if (m_clipQueue.empty())
-    return false;
-
-  int clip = m_clipQueue.front();
-  m_clipQueue.pop();
