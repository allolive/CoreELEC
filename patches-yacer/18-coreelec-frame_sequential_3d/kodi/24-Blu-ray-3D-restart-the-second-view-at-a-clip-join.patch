     CloseMVCDemux();
@@ -1769,6 +1745,7 @@ bool CDVDInputStreamBluray::CloseMVCDemux()
 {
   if (m_pMVCDemux)
   {
+    m_mvcStartTime = m_pMVCDemux->GetStartTime();
     delete m_pMVCDemux;
     m_pMVCDemux = nullptr;
   }
@@ -1795,6 +1772,28 @@ void CDVDInputStreamBluray::SeekMVCDemux()
   m_pMVCDemux->SeekClipTimestamp(static_cast<int64_t>(clip->in_time) + clipTime);
 }
 
+// The extension view restarts where the base view is read on: in libbluray's clip, at its time.
+void CDVDInputStreamBluray::RestartExtention()
+{
+  m_restartExtention = false;
+  if (!m_bMVCPlayback)
+    return;
+
+  // already in that clip, a seek is enough
+  OpenBaseClip();
+  SeekMVCDemux();
+}
+
+void CDVDInputStreamBluray::OnDemuxerReset()
+{
+  if (!m_restartExtention)
+    return;
+
+  CLog::Log(LOGDEBUG, "CDVDInputStreamBluray - restarting the MVC extension after a discontinuity "
+                      "or a new stream");
+  RestartExtention();
+}
+
 BLURAY_CLIP_INFO* CDVDInputStreamBluray::ClipAt(int playItem) const
 {
   if (!m_titleInfo || playItem < 0 || static_cast<uint32_t>(playItem) >= m_titleInfo->clip_count)
