+// the extension joins the base view in the clip it reads
+bool CDVDInputStreamBluray::OpenBaseClip()
+{
+  const int clip = BaseClip();
+  if (!m_bMVCPlayback || clip < 0 || clip == m_nMVCClip)
+    return false;
 
-  return res;
