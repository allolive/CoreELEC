From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: allolive <160342668+allolive@users.noreply.github.com>
Date: Sat, 10 Oct 2026 23:00:00 -0400
Subject: [PATCH] AML: do not prepare a resume on MVC

Preparing a resume behind a pause seeks back and flushes video, and an
ordinary-seek fallback flushes again. On Amlogic every video flush releases
the hardware decoder and creates it anew, and the MVC decoder's firmware can
stall on one of those re-creations. The shutter-glasses add-on pauses a 3D
film for a few seconds right after it starts and resumes it; with the
preparation that start went through about five decoder instances instead of
one, each a fresh chance for the stall.

The AML codec now says, through a generic ProcessInfo flag that it sets for
H.264 MVC (codec tag MVC1 or AMVC), that a flush of its stream is costly, and
the player does not prepare a resume for such a stream, as it already does not
for a Dolby Vision FEL. The pause and the resume are then plain speed changes,
as in stock Kodi; the resume callback barrier still applies.

The flag is cleared whenever a codec names itself (SetVideoDecoderName) and on
ResetVideoCodecInfo, like the buffers-data flag of 02_07, so another codec
never inherits it.

Shared code, unavoidable: the decision to prepare is CVideoPlayer's
(CanPrepareResumePreroll), and the codec reaches it only through ProcessInfo.
The shared part is a generic accessor and one condition; which streams are
costly to flush is decided in the AML codec alone.

Signed-off-by: allolive <160342668+allolive@users.noreply.github.com>
---
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAmlogic.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAmlogic.cpp
index 99644028f8..becdaf2ab8 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAmlogic.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAmlogic.cpp
@@ -429,6 +429,11 @@ bool CDVDVideoCodecAmlogic::Open(CDVDStreamInfo &hints, CDVDCodecOptions &option
   m_processInfo.SetVideoDecoderName(m_pFormatName, true);
   // libamcodec keeps its own stream buffer.
   m_processInfo.SetVideoCodecBuffersData(true);
+  // A flush releases the MVC decoder and creates it again, and its firmware
+  // can stall on the way: a flush nobody asked for is not worth that risk.
+  m_processInfo.SetVideoCodecFlushIsCostly(
+      m_hints.codec == AV_CODEC_ID_H264 && (m_hints.codec_tag == MKTAG('M', 'V', 'C', '1') ||
+                                            m_hints.codec_tag == MKTAG('A', 'M', 'V', 'C')));
   m_processInfo.SetVideoDimensions(m_hints.width, m_hints.height);
   m_processInfo.SetVideoDeintMethod("hardware");
   m_processInfo.SetVideoDAR(m_hints.aspect);
diff --git a/xbmc/cores/VideoPlayer/Process/ProcessInfo.cpp b/xbmc/cores/VideoPlayer/Process/ProcessInfo.cpp
index 7e0445f2fe..a5cb5d4d19 100644
--- a/xbmc/cores/VideoPlayer/Process/ProcessInfo.cpp
+++ b/xbmc/cores/VideoPlayer/Process/ProcessInfo.cpp
@@ -75,11 +75,26 @@ bool CProcessInfo::GetVideoCodecBuffersData() const
   return m_videoCodecBuffersData;
 }
 
+void CProcessInfo::SetVideoCodecFlushIsCostly(bool costly)
+{
+  std::unique_lock lock(m_videoCodecSection);
+
+  m_videoCodecFlushIsCostly = costly;
+}
+
+bool CProcessInfo::GetVideoCodecFlushIsCostly() const
+{
+  std::unique_lock lock(m_videoCodecSection);
+
+  return m_videoCodecFlushIsCostly;
+}
+
 void CProcessInfo::ResetVideoCodecInfo()
 {
   std::unique_lock lock(m_videoCodecSection);
 
   m_videoCodecBuffersData = false;
+  m_videoCodecFlushIsCostly = false;
   m_videoIsHWDecoder = false;
   m_videoDecoderName = "unknown";
   m_videoDeintMethod = "unknown";
@@ -121,6 +136,7 @@ void CProcessInfo::SetVideoDecoderName(const std::string &name, bool isHw)
 
   // A codec that holds data of its own says so after naming itself.
   m_videoCodecBuffersData = false;
+  m_videoCodecFlushIsCostly = false;
   m_videoIsHWDecoder = isHw;
   m_videoDecoderName = name;
 
diff --git a/xbmc/cores/VideoPlayer/Process/ProcessInfo.h b/xbmc/cores/VideoPlayer/Process/ProcessInfo.h
index cea0240de9..4b90bb77b2 100644
--- a/xbmc/cores/VideoPlayer/Process/ProcessInfo.h
+++ b/xbmc/cores/VideoPlayer/Process/ProcessInfo.h
@@ -39,6 +39,8 @@ public:
   bool IsVideoHwDecoder();
   void SetVideoCodecBuffersData(bool buffersData);
   bool GetVideoCodecBuffersData() const;
+  void SetVideoCodecFlushIsCostly(bool costly);
+  bool GetVideoCodecFlushIsCostly() const;
   void SetVideoDeintMethod(const std::string &method);
   std::string GetVideoDeintMethod();
   void SetVideoPixelFormat(const std::string &pixFormat);
@@ -170,6 +172,7 @@ protected:
   // player video info
   bool m_videoIsHWDecoder;
   bool m_videoCodecBuffersData{false};
+  bool m_videoCodecFlushIsCostly{false};
   std::string m_videoDecoderName;
   std::string m_videoDeintMethod;
   std::string m_videoPixelFormat;
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 97999a26a0..4223eec3f5 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -4245,7 +4245,10 @@ bool CVideoPlayer::CanPrepareResumePreroll() const
          // the kept frame with nothing to composite it: the whole output,
          // overlays included, stays black for as long as the pause lasts.
          // Only a stream decoding a full enhancement layer carries that state.
-         !m_processInfo->GetDoviIsFEL();
+         !m_processInfo->GetDoviIsFEL() &&
+         // Nor is a flush the viewer did not ask for worth it where the codec
+         // says one is costly; such a stream pauses and resumes in place.
+         !m_processInfo->GetVideoCodecFlushIsCostly();
 }
 
 bool CVideoPlayer::ResumeArmedPreroll()
