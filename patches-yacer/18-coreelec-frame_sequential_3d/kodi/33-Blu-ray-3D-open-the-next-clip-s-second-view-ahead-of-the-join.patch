+  // The entry point at or before it, a single seek: a search for the timestamp reads the file at
+  // a score of places, each a wait on a source that stalls
+  int64_t target;
+  int ret;
+  if (m_entryPointAt)
+  {
+    target = m_entryPointAt(ts);
+    ret = av_seek_frame(m_pFormatContext, -1, target, AVSEEK_FLAG_BYTE);
+  }
+  else
+  {
+    const AVRational clipTimeBase = {1, 90000};
+    const AVStream* stream = m_pFormatContext->streams[m_nStreamIndex];
+    target = std::max<int64_t>(
+        0, av_rescale_q(ts, clipTimeBase, stream->time_base) -
+               av_rescale_q(MVC_SEEK_TIME_WINDOW, clipTimeBase, stream->time_base));
