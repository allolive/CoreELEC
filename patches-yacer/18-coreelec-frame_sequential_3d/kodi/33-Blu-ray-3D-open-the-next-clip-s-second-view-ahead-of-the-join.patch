 // A job left running ends on its own, its files with it: a stalled open must not hold anything
 void CBlurayClipReader::DropPrefetchJob()
 {
   std::unique_lock lock(m_prefetchJobLock);
+  if (m_prefetchJob)
+  {
+    std::unique_lock jobLock(m_prefetchJob->lock);
+    m_prefetchJob->aborted = true;
+    if (m_prefetchJob->mvcInput)
+      m_prefetchJob->mvcInput->Abort();
+  }
   m_prefetchJob.reset();
 }
 
+// A second view opened ahead, or now, may wait out a stalled source
+void CBlurayClipReader::Abort()
+{
+  std::unique_lock lock(m_prefetchJobLock);
+  AbortLocked();
+}
+
+void CBlurayClipReader::AbortLocked()
+{
+  if (m_openingMVC)
+    m_openingMVC->Abort();
+  if (!m_prefetchJob)
+    return;
+  std::unique_lock jobLock(m_prefetchJob->lock);
+  m_prefetchJob->aborted = true;
+  if (m_prefetchJob->mvcInput)
+    m_prefetchJob->mvcInput->Abort();
+}
+
+void CBlurayClipReader::SetSecondViewSource(MVCClipAt mvcClipAt)
+{
+  m_mvcClipAt = std::move(mvcClipAt);
+}
+
+std::optional<CBlurayClipReader::SecondView> CBlurayClipReader::OpenSecondView(int playItem,
+                                                                              bool& none)
+{
+  none = false;
+  if (m_nextMVC.playItem == playItem && m_nextMVC.view.demux)
+    return std::exchange(m_nextMVC, {}).view;
+
+  const auto clip{m_mvcClipAt ? m_mvcClipAt(playItem) : std::nullopt};
+  if (!clip)
+  {
+    none = true;
+    return {};
+  }
+
+  auto input{NewMVCInput(*clip)};
+  {
+    // checked under the lock Abort takes after setting it
+    std::unique_lock lock(m_prefetchJobLock);
+    if (m_aborted)
+      return {};
+    m_openingMVC = input.get();
+  }
+  auto& entryPoints{m_mvcEntryPoints[clip->clipId]};
+  std::unique_ptr<CDemuxMVC> demux;
+  if (input->Open())
+    demux = NewMVCDemux(*clip, entryPoints, m_readRate, *input);
+  {
+    std::unique_lock lock(m_prefetchJobLock);
+    m_openingMVC = nullptr;
+  }
+  if (!demux)
+    return {};
+  return SecondView{std::move(input), std::move(demux)};
+}
+
+// the second view of the play item being read, prepared and still to be taken at its join
+bool CBlurayClipReader::CurrentMVCUntaken() const
+{
+  return m_nextMVC.view.demux && m_nextMVC.playItem == m_playItem;
+}
