+// The video's entry point map of a .clpi (CPI, EP_map), read as libbluray reads it: libbluray
+// cannot read it itself from a disc image (bd_read_clpi opens local files only)
+CBlurayClipReader::EntryPoints CBlurayClipReader::ReadEntryPoints(const std::string& path)
+{
+  std::vector<uint8_t> data;
+  XFILE::CFile file;
+  if (file.LoadFile(path, data) <= 0)
+  {
+    CLog::Log(LOGDEBUG, "CBlurayClipReader - cannot read {}", CURL::GetRedacted(path));
+    return {};
+  }
+
+  const std::span<const std::byte> bytes{std::as_bytes(std::span{data})};
+  try
+  {
+    const unsigned int cpi{GetDWord(bytes, 16)};
+    if (GetString(bytes, 0, 4) != "HDMV" || GetDWord(bytes, cpi) == 0 ||
+        GetByte(bytes, cpi + 7) == 0)
+      return {};
+
+    // the first stream's counts, and where its coarse and fine entries start
+    const unsigned int epMap{cpi + 6};
+    const uint64_t stream{GetQWord(bytes, epMap + 2)};
+    const unsigned int start{epMap + GetDWord(bytes, epMap + 10)};
+    const unsigned int fineStart{start + GetDWord(bytes, start)};
+
+    std::vector<CLPI_EP_COARSE> coarse(GetBits64(stream, 34, 16));
+    for (size_t i = 0; i < coarse.size(); ++i)
+    {
+      const uint32_t word{GetDWord(bytes, start + 4 + 8 * i)};
+      coarse[i].ref_ep_fine_id = static_cast<int>(GetBits(word, 32, 18));
+      coarse[i].pts_ep = static_cast<int>(GetBits(word, 14, 14));
+      coarse[i].spn_ep = GetDWord(bytes, start + 8 + 8 * i);
+    }
+    std::vector<CLPI_EP_FINE> fine(GetBits64(stream, 18, 18));
+    for (size_t i = 0; i < fine.size(); ++i)
+    {
+      const uint32_t word{GetDWord(bytes, fineStart + 4 * i)};
+      fine[i].pts_ep = static_cast<int>(GetBits(word, 28, 11));
+      fine[i].spn_ep = static_cast<int>(GetBits(word, 17, 17));
+    }
+
+    CLPI_EP_MAP_ENTRY map{};
+    map.num_ep_coarse = static_cast<int>(coarse.size());
+    map.num_ep_fine = static_cast<int>(fine.size());
+    map.coarse = coarse.data();
+    map.fine = fine.data();
+    return EntryPointsOf(map);
+  }
+  catch (const std::out_of_range&)
+  {
+    CLog::Log(LOGDEBUG, "CBlurayClipReader - {} is too short", CURL::GetRedacted(path));
+    return {};
+  }
+}
+
+std::unique_ptr<CDVDInputStream> CBlurayClipReader::NewMVCInput(const MVCClip& clip)
+{
+  CLog::Log(LOGDEBUG, "CBlurayClipReader - opening the second view at {}",
+            CURL::GetRedacted(clip.path));
+
+  CFileItem fileitem(CURL(clip.path), false);
+  auto input{std::make_unique<CDVDInputStreamFile>(fileitem, 0)};
+  input->SetWaitsForUser(true);
+  return input;
+}
+
+// Off the player thread too: it uses nothing of the reader
+std::unique_ptr<CDemuxMVC> CBlurayClipReader::NewMVCDemux(
+    const MVCClip& clip,
+    std::shared_ptr<const EntryPoints>& entryPoints,
+    uint32_t readRate,
+    CDVDInputStream& input)
+{
+  if (readRate > 0)
+    input.SetReadRate(readRate);
+
+  if (!entryPoints)
+    entryPoints = std::make_shared<const EntryPoints>(ReadEntryPoints(clip.clipInfoPath));
+
+  auto demux{std::make_unique<CDemuxMVC>()};
+  if (!entryPoints->empty())
+    demux->SetEntryPointLocator([points = entryPoints](int64_t clipTimestamp)
+                                { return EntryPointAt(*points, clipTimestamp); });
+  if (!demux->Open(&input))
+    return nullptr;
+
+  demux->SetClip(clip.inTime, clip.outTime);
+  return demux;
+}
