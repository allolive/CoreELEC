diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLMvcSubtitleDepth.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLMvcSubtitleDepth.h
new file mode 100644
index 0000000..238ee9c
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLMvcSubtitleDepth.h
@@ -0,0 +1,215 @@
+/*
+ *  Copyright (C) 2026 Team CoreELEC
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#pragma once
+
+// Blu-ray 3D subtitle depth ("1 plane + offset"): an MVC access unit opening a
+// GOP carries, in an SEI user_data_unregistered message, one signed offset per
+// displayed frame of the GOP for each offset sequence. A PG stream names the
+// sequence it follows (the STN-SS ss_offset_sequence_id, or a remux's 3d-plane
+// tag). The OFMD layout follows cinemaONE's CoreELEC/xbmc#77.
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <iterator>
+#include <map>
+#include <optional>
+#include <utility>
+#include <vector>
+
+namespace AML_MVC_DEPTH
+{
+
+//! offsets[sequence][frame of the GOP in display order], in pixels of a 1920 wide plane
+using Offsets = std::vector<std::vector<int8_t>>;
+
+inline constexpr uint8_t OFMD_UUID[16] = {0x17, 0xee, 0x8c, 0x60, 0xf8, 0x4d, 0x11, 0xd9,
+                                          0x8c, 0xd6, 0x08, 0x00, 0x20, 0x0c, 0x9a, 0x66};
+
+//! The OFMD table of a user_data_unregistered payload starting at its uuid, avail
+//! bytes long: "OFMD" after the uuid, the sequence count at 10, the frame count at
+//! 11 and the offsets from 14, sequence by sequence; bit 7 of an offset is its sign
+inline bool ParseOfmdPayload(const uint8_t* p, size_t avail, Offsets& offsets)
+{
+  if (avail < sizeof(OFMD_UUID) + 14 || std::memcmp(p, OFMD_UUID, sizeof(OFMD_UUID)) != 0 ||
+      std::memcmp(p + sizeof(OFMD_UUID), "OFMD", 4) != 0)
+    return false;
+  const uint8_t* o = p + sizeof(OFMD_UUID);
+  avail -= sizeof(OFMD_UUID);
+  const size_t sequences = o[10] & 0x3f;
+  const size_t frames = o[11] & 0x7f;
+  if (!sequences || !frames || 14 + sequences * frames > avail)
+    return false;
+  offsets.assign(sequences, std::vector<int8_t>(frames, 0));
+  for (size_t s = 0; s < sequences; s++)
+  {
+    for (size_t f = 0; f < frames; f++)
+    {
+      const uint8_t v = o[14 + s * frames + f];
+      offsets[s][f] = static_cast<int8_t>((v & 0x80) ? -(v & 0x7f) : (v & 0x7f));
+    }
+  }
+  return true;
+}
+
+//! The OFMD table of one SEI NAL (header byte included, emulation prevention still in).
+//! MVC streams carry it nested, in an MVC scalable nesting message (payload type 37),
+//! so any message's payload is searched for it, within that payload's bounds.
+inline bool ParseOfmdSei(const uint8_t* nal, size_t len, Offsets& offsets)
+{
+  if (len < 2 || (nal[0] & 0x1f) != 6)
+    return false;
+
+  std::vector<uint8_t> rbsp;
+  rbsp.reserve(len);
+  for (size_t i = 1; i < len; i++)
+  {
+    if (i + 2 < len && nal[i] == 0 && nal[i + 1] == 0 && nal[i + 2] == 3)
+    {
+      rbsp.push_back(0);
+      rbsp.push_back(0);
+      i += 2;
+    }
+    else
+      rbsp.push_back(nal[i]);
+  }
+
+  size_t pos = 0;
+  while (pos < rbsp.size() && rbsp[pos] != 0x80)
+  {
+    size_t type = 0;
+    while (pos < rbsp.size() && rbsp[pos] == 0xff)
+      type += rbsp[pos++];
+    if (pos >= rbsp.size())
+      return false;
+    type += rbsp[pos++];
+    size_t size = 0;
+    while (pos < rbsp.size() && rbsp[pos] == 0xff)
+      size += rbsp[pos++];
+    if (pos >= rbsp.size())
+      return false;
+    size += rbsp[pos++];
+    if (size > rbsp.size() - pos)
+      return false;
+
+    const uint8_t* p = rbsp.data() + pos;
+    const uint8_t* end = p + size;
+    // user_data_unregistered at the top level, or nested in another message
+    if (type == 5 && ParseOfmdPayload(p, size, offsets))
+      return true;
+    for (const uint8_t* q = p; q + sizeof(OFMD_UUID) + 4 <= end; q++)
+    {
+      q = std::search(q, end, std::begin(OFMD_UUID), std::end(OFMD_UUID));
+      if (q == end)
+        break;
+      if (ParseOfmdPayload(q, static_cast<size_t>(end - q), offsets))
+        return true;
+    }
+    pos += size;
+  }
+  return false;
+}
+
+//! The OFMD table of an access unit: length-prefixed NALs (avcC), or Annex B when lengthSize is 0
+inline bool ParseOfmd(const uint8_t* data, size_t size, int lengthSize, Offsets& offsets)
+{
+  if (!data)
+    return false;
+  if (lengthSize >= 1 && lengthSize <= 4)
+  {
+    for (size_t pos = 0; pos + lengthSize <= size;)
+    {
+      size_t len = 0;
+      for (int i = 0; i < lengthSize; i++)
+        len = (len << 8) | data[pos + i];
+      pos += lengthSize;
+      if (len == 0 || len > size - pos)
+        return false;
+      if (ParseOfmdSei(data + pos, len, offsets))
+        return true;
+      pos += len;
+    }
+    return false;
+  }
+  size_t start = SIZE_MAX;
+  for (size_t i = 0; i + 2 < size; i++)
+  {
+    if (data[i] != 0 || data[i + 1] != 0 || data[i + 2] != 1)
+      continue;
+    if (start != SIZE_MAX)
+    {
+      size_t end = i;
+      while (end > start && data[end - 1] == 0)
+        end--;
+      if (ParseOfmdSei(data + start, end - start, offsets))
+        return true;
+    }
+    start = i + 3;
+  }
+  return start != SIZE_MAX && start < size && ParseOfmdSei(data + start, size - start, offsets);
+}
+
+/*!
+ * The tables of the last few GOPs, each from its first picture in display
+ * order: the access unit carrying it (the GOP's first in decode order) until a
+ * later one of the GOP turns out to be shown before it (an open GOP's leading
+ * pictures). A picture's offset is then read by its own pts, however many
+ * pictures the decoder holds between input and output.
+ */
+class CTables
+{
+public:
+  void Add(double pts, Offsets offsets)
+  {
+    m_tables[pts] = std::move(offsets);
+    while (m_tables.size() > MAX_TABLES)
+      m_tables.erase(m_tables.begin());
+  }
+
+  //! a picture of the newest table's GOP fed after it: shown before its start, it is the new start
+  void Fed(double pts)
+  {
+    if (m_tables.empty())
+      return;
+    auto last = std::prev(m_tables.end());
+    if (pts >= last->first)
+      return;
+    if (last != m_tables.begin() && pts <= std::prev(last)->first)
+      return;
+    auto node = m_tables.extract(last);
+    node.key() = pts;
+    m_tables.insert(std::move(node));
+  }
+
+  //! the offset for the picture shown at pts on the sequence; the last one of a table holds past its end
+  std::optional<int> Offset(double pts, int sequence, double frameDuration) const
+  {
+    if (m_tables.empty() || sequence < 0 || frameDuration <= 0)
+      return std::nullopt;
+    auto it = m_tables.upper_bound(pts + frameDuration / 2);
+    if (it == m_tables.begin())
+      return std::nullopt;
+    --it;
+    if (static_cast<size_t>(sequence) >= it->second.size() || it->second[sequence].empty())
+      return std::nullopt;
+    const std::vector<int8_t>& frames = it->second[sequence];
+    const long index =
+        std::clamp(std::lround((pts - it->first) / frameDuration), 0L,
+                   static_cast<long>(frames.size()) - 1);
+    return frames[index];
+  }
+
+  void Clear() { m_tables.clear(); }
+  bool Empty() const { return m_tables.empty(); }
+
+private:
+  static constexpr size_t MAX_TABLES = 4;
+  std::map<double, Offsets> m_tables;
+};
+
+} // namespace AML_MVC_DEPTH
