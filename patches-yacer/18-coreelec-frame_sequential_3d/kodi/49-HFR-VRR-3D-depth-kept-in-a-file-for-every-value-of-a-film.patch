diff --git a/xbmc/video/FilmFile.cpp b/xbmc/video/FilmFile.cpp
new file mode 100644
index 0000000000..9f523761de
--- /dev/null
+++ b/xbmc/video/FilmFile.cpp
@@ -0,0 +1,143 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "FilmFile.h"
+
+#include "FileItem.h"
+#include "filesystem/File.h"
+#include "filesystem/SpecialProtocol.h"
+#include "utils/JSONVariantParser.h"
+#include "utils/JSONVariantWriter.h"
+#include "utils/Variant.h"
+#include "utils/log.h"
+#include "video/VideoInfoTag.h"
+
+#include <cstdint>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace
+{
+constexpr const char* FilmsFile = "special://profile/films.json";
+constexpr const char* FilmsFileNew = "special://profile/films.json.new";
+//! what the file was before it held more than the 3D depths
+constexpr const char* DepthFile = "special://profile/stereodepth.json";
+
+std::mutex filmLock;
+//! the file's contents, read once for each profile
+std::optional<CVariant> films;
+std::string filmsProfile;
+
+std::optional<CVariant> Load(const char* path)
+{
+  if (!XFILE::CFile::Exists(path))
+    return {};
+  std::vector<uint8_t> buffer;
+  XFILE::CFile file;
+  CVariant read;
+  if (file.LoadFile(path, buffer) > 0 &&
+      CJSONVariantParser::Parse(std::string(buffer.begin(), buffer.end()), read) &&
+      read.isObject())
+    return read;
+  // kept aside rather than written over with what is set next
+  const std::string bad = std::string(path) + ".bad";
+  CLog::LogF(LOGERROR, "{} is not a JSON object, moved to {}", path, bad);
+  XFILE::CFile::Rename(path, bad);
+  return {};
+}
+
+CVariant& Stored()
+{
+  const std::string profile = CSpecialProtocol::TranslatePath(FilmsFile);
+  if (films && filmsProfile == profile)
+    return *films;
+  filmsProfile = profile;
+  films.emplace(CVariant::VariantTypeObject);
+  if (auto read = Load(FilmsFile))
+    *films = std::move(*read);
+  // the depths a build before this file set, the film's own kept where both have one
+  if (auto depths = Load(DepthFile))
+  {
+    for (auto it = depths->begin_map(); it != depths->end_map(); ++it)
+    {
+      if (films->isMember(it->first))
+        continue;
+      // a film was its picture's depth alone, or its picture's and its subtitles'
+      if (it->second.isObject())
+        (*films)[it->first] = it->second;
+      else
+        (*films)[it->first]["picture"] = it->second;
+    }
+  }
+  return *films;
+}
+
+void Save(const CVariant& films)
+{
+  std::string json;
+  if (!CJSONVariantWriter::Write(films, json, false))
+    return;
+  // written aside and renamed over, so a power cut leaves the old file or the new one
+  XFILE::CFile file;
+  if (!file.OpenForWrite(FilmsFileNew, true) ||
+      file.Write(json.data(), json.size()) != static_cast<ssize_t>(json.size()))
+  {
+    CLog::LogF(LOGERROR, "cannot write {}", FilmsFileNew);
+    return;
+  }
+  file.Close();
+  if (!XFILE::CFile::Rename(FilmsFileNew, FilmsFile))
+  {
+    CLog::LogF(LOGERROR, "cannot replace {}", FilmsFile);
+    return;
+  }
+  if (XFILE::CFile::Exists(DepthFile))
+    XFILE::CFile::Delete(DepthFile);
+}
+} // unnamed namespace
+
+std::string CFilmFile::Key(const CFileItem& item)
+{
+  if (item.HasVideoInfoTag() && !item.GetVideoInfoTag()->m_strFileNameAndPath.empty())
+    return item.GetVideoInfoTag()->m_strFileNameAndPath;
+  return item.GetPath();
+}
+
+CVariant CFilmFile::Get(const std::string& key)
+{
+  std::lock_guard lock(filmLock);
+  const CVariant& all = Stored();
+  if (!all.isMember(key) || !all[key].isObject())
+    return CVariant(CVariant::VariantTypeObject);
+  return all[key];
+}
+
+void CFilmFile::Set(const std::string& key, const char* name, const CVariant& value)
+{
+  std::lock_guard lock(filmLock);
+  CVariant& all = Stored();
+  if (value.isNull())
+  {
+    if (!all.isMember(key) || !all[key].isObject() || !all[key].isMember(name))
+      return;
+    all[key].erase(name);
+    if (all[key].empty())
+      all.erase(key);
+  }
+  else
+  {
+    if (all.isMember(key) && all[key].isMember(name) && all[key][name] == value)
+      return;
+    if (!all[key].isObject())
+      all[key] = CVariant(CVariant::VariantTypeObject);
+    all[key][name] = value;
+  }
+  Save(all);
+}
