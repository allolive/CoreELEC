+#pragma once
+
+#include <string>
+
+class CFileItem;
+class CVariant;
+
+/*!
+ * \brief What is kept for each film on this player: a JSON object of values per film, in a file of
+ * its own in the profile rather than in the video database, which has no columns for them and is
+ * often a library several players share.
+ */
+class CFilmFile
+{
+public:
+  //! the film's own file, as the library knows it, whichever path played it
+  static std::string Key(const CFileItem& item);
+  //! the film's values, an empty object unless some were kept
+  static CVariant Get(const std::string& film);
+  //! keep one of the film's values; a null value forgets it, and a film with none is dropped
+  static void Set(const std::string& film, const char* name, const CVariant& value);
+};
