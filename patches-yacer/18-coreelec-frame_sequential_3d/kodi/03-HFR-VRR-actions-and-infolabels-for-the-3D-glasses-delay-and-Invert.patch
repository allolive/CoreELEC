 //! Open the dialog window to select a subtitle stream
 constexpr const int ACTION_DIALOG_SELECT_SUBTITLE = 272;
 
+//! Show the slider for the 3D glasses delay (HFR VRR)
+constexpr const int ACTION_FS3D_DELAY = 273;
+
+//! Swap the eyes of the playing 3D video (its Invert stereoscopic 3D mode)
+constexpr const int ACTION_STEREO_INVERT = 274;
+
 // Voice actions
 constexpr const int ACTION_VOICE_RECOGNIZE = 300;
 
