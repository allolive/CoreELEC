 #include <algorithm>
+#include <cmath>
 
 using namespace KODI;
 using namespace UTILS;
@@ -226,6 +228,33 @@ bool CPlayerController::OnAction(const CAction &action)
         return true;
       }
 
+      case ACTION_FS3D_DELAY:
+      {
+        // the setting's own range and step, the slider of its row in the video settings
+        const auto setting = std::static_pointer_cast<const CSettingInt>(
+            CServiceBroker::GetSettingsComponent()->GetSettings()->GetSetting(
+                CSettings::SETTING_VIDEOSCREEN_FS3DDELAY));
+        if (!setting)
+          return false;
+        ShowSlider(action.GetID(), 60031, static_cast<float>(setting->GetValue()),
+                   static_cast<float>(setting->GetMinimum()),
+                   static_cast<float>(setting->GetStep()),
+                   static_cast<float>(setting->GetMaximum()), true);
+        return true;
+      }
+
+      case ACTION_STEREO_INVERT:
+      {
+        CVideoSettings vs = appPlayer->GetVideoSettings();
+        vs.m_StereoInvert = !vs.m_StereoInvert;
+        appPlayer->SetVideoSettings(vs);
+        const auto& strings = CServiceBroker::GetResourcesComponent().GetLocalizeStrings();
+        CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Info, strings.Get(36536),
+                                              strings.Get(vs.m_StereoInvert ? 16041 : 16039),
+                                              DisplTime, false, MsgTime);
+        return true;
+      }
+
       case ACTION_AUDIO_DELAY:
       {
         float videoAudioDelayRange = CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_videoAudioDelayRange;
@@ -669,6 +698,19 @@ void CPlayerController::OnSliderChange(void *data, CGUISliderControl *slider)
     std::string strValue = StringUtils::Format("{:.0f}px", slider->GetFloatValue());
     slider->SetTextValue(strValue);
   }
+  else if (m_sliderAction == ACTION_FS3D_DELAY)
+  {
+    const int value = static_cast<int>(std::lround(slider->GetFloatValue()));
+    slider->SetTextValue(StringUtils::Format(
+        CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(60032), value));
+    // a display setting rather than the film's: it applies with or without a
+    // player, and is saved with the others when Kodi exits (as the volume is),
+    // not on every step of the slider
+    const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+    if (settings->GetInt(CSettings::SETTING_VIDEOSCREEN_FS3DDELAY) != value)
+      settings->SetInt(CSettings::SETTING_VIDEOSCREEN_FS3DDELAY, value);
+    return;
+  }
   else if (m_sliderAction == ACTION_VOLAMP_UP ||
           m_sliderAction == ACTION_VOLAMP_DOWN ||
           m_sliderAction == ACTION_VOLAMP)
