From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: allolive <160342668+allolive@users.noreply.github.com>
Date: Fri, 9 Oct 2026 10:26:25 -0400
Subject: [PATCH] HFR VRR: actions and infolabels for the 3D glasses delay and Invert

A skin can offer the 3D glasses delay and the eye swap where it offers
the audio and subtitle offsets (its stream select dialogs) rather than
only inside the player's video settings:

- Action fs3ddelay (273) opens the slider dialog for the 3D glasses
  delay, as audiodelay does for the audio offset, with the setting's own
  range and step. A change applies at once; it is a display setting, not
  the film's, saved with the others when Kodi exits (as the volume is),
  not on every step of the slider.
- Action stereoinvert (274) swaps the eyes of the playing video (its
  Invert stereoscopic 3D mode, saved with the film like the dialog's
  toggle) and says which way it now is.
- Player.Fs3dDelay shows the delay ("1300 µs") and the boolean
  Player.StereoInvert whether the eyes are swapped, for button labels.

Shared code: actions, infolabels and the player controller are generic
Kodi; nothing here is Amlogic-specific.

The two actions are numbered 990 and 991, just under ACTION_ERROR, and the
two info labels 20000 and 20001, between the window ids (up to 10002) and
the control ids (from 29996). The ids they took first, actions 273-274 and
labels 75-76, are the next ones free in Kodi's own tables, which Kodi
master (xbmc/xbmc 494721df6f) has not yet taken but will hand to its next
action or player label. Kodi numbers its actions upwards from the bottom
and its labels in blocks below the window ids, so neither reaches these.
Keymaps, skins and JSON-RPC refer to both by name, never by number, so the
move changes nothing for them. A static_assert in each header keeps them
above Kodi's last action (ACTION_ANALOG_MOVE_Y_DOWN, 604) and below
ACTION_ERROR, and between the window and control info labels.

Signed-off-by: allolive <160342668+allolive@users.noreply.github.com>
---
diff --git a/xbmc/GUIInfoManager.cpp b/xbmc/GUIInfoManager.cpp
index 0800996..723512a 100644
--- a/xbmc/GUIInfoManager.cpp
+++ b/xbmc/GUIInfoManager.cpp
@@ -862,7 +862,7 @@ constexpr std::array<InfoMap, 7> integer_bools = {{
 ///     <p>
 ///   }
 // clang-format off
-constexpr std::array<InfoMap, 60> player_labels = {{
+constexpr std::array<InfoMap, 62> player_labels = {{
     {"hasmedia",              PLAYER_HAS_MEDIA},
     {"hasaudio",              PLAYER_HAS_AUDIO},
     {"hasvideo",              PLAYER_HAS_VIDEO},
@@ -899,6 +899,8 @@ constexpr std::array<InfoMap, 60> player_labels = {{
     {"volume",                PLAYER_VOLUME},
     {"subtitledelay",         PLAYER_SUBTITLE_DELAY},
     {"audiodelay",            PLAYER_AUDIO_DELAY},
+    {"fs3ddelay",             PLAYER_FS3D_DELAY},
+    {"stereoinvert",          PLAYER_STEREO_INVERT},
     {"chapter",               PLAYER_CHAPTER},
     {"chaptercount",          PLAYER_CHAPTERCOUNT},
     {"chaptername",           PLAYER_CHAPTERNAME},
diff --git a/xbmc/guilib/guiinfo/GUIInfoLabels.h b/xbmc/guilib/guiinfo/GUIInfoLabels.h
index 8f38ea6..ce4b632 100644
--- a/xbmc/guilib/guiinfo/GUIInfoLabels.h
+++ b/xbmc/guilib/guiinfo/GUIInfoLabels.h
@@ -843,6 +843,14 @@ constexpr uint32_t CONTROL_IS_VISIBLE                = 29998;
 constexpr uint32_t CONTROL_GROUP_HAS_FOCUS           = 29999;
 constexpr uint32_t CONTROL_HAS_FOCUS                 = 30000;
 
+// Info labels this build adds, in the gap between the window and the control ids, which Kodi does
+// not number into from either side. Skins name an info label, never number it.
+constexpr uint32_t PLAYER_FS3D_DELAY                 = 20000;
+constexpr uint32_t PLAYER_STEREO_INVERT              = 20001;
+static_assert(PLAYER_FS3D_DELAY > WINDOW_IS_MODAL_DIALOG_TOPMOST &&
+              PLAYER_STEREO_INVERT < CONTROL_GET_LABEL,
+              "the info labels this build adds must stay clear of Kodi's own");
+
 constexpr int      LISTITEM_START                    = 35000;
 constexpr uint32_t LISTITEM_THUMB                    = LISTITEM_START;
 constexpr uint32_t LISTITEM_LABEL                    = LISTITEM_START + 1;
diff --git a/xbmc/guilib/guiinfo/PlayerGUIInfo.cpp b/xbmc/guilib/guiinfo/PlayerGUIInfo.cpp
index 905438e..dff138c 100644
--- a/xbmc/guilib/guiinfo/PlayerGUIInfo.cpp
+++ b/xbmc/guilib/guiinfo/PlayerGUIInfo.cpp
@@ -28,6 +28,8 @@
 #include "guilib/guiinfo/GUIInfoLabels.h"
 #include "resources/LocalizeStrings.h"
 #include "resources/ResourcesComponent.h"
+#include "settings/Settings.h"
+#include "settings/SettingsComponent.h"
 #include "utils/StringUtils.h"
 #include "utils/URIUtils.h"
 #include "utils/Variant.h"
@@ -199,6 +201,12 @@ bool CPlayerGUIInfo::GetLabel(std::string& value,
     case PLAYER_AUDIO_DELAY:
       value = StringUtils::Format("{:2.3f} s", m_appPlayer->GetVideoSettings().m_AudioDelay);
       return true;
+    case PLAYER_FS3D_DELAY:
+      value = StringUtils::Format(
+          CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(60032),
+          CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+              CSettings::SETTING_VIDEOSCREEN_FS3DDELAY));
+      return true;
     case PLAYER_CHAPTER:
       value = StringUtils::Format("{:02}", m_appPlayer->GetChapter());
       return true;
@@ -508,6 +516,9 @@ bool CPlayerGUIInfo::GetBool(bool& value,
     case PLAYER_IS_LIVE:
       value = m_appPlayer->IsLiveStream();
       return true;
+    case PLAYER_STEREO_INVERT:
+      value = m_appPlayer->GetVideoSettings().m_StereoInvert;
+      return true;
     case PLAYER_PLAYING:
       value = m_appPlayer->GetPlaySpeed() == 1.0f;
       return true;
diff --git a/xbmc/input/actions/ActionIDs.h b/xbmc/input/actions/ActionIDs.h
index 16f1fdb..839e4fc 100644
--- a/xbmc/input/actions/ActionIDs.h
+++ b/xbmc/input/actions/ActionIDs.h
@@ -521,8 +521,21 @@ constexpr const int ACTION_ANALOG_MOVE_Y_DOWN = 604;
 
 ///@}
 
+// Actions this build adds. Kodi numbers its own upwards from the bottom, so these sit just under
+// ACTION_ERROR, out of the way of the next upstream ones. Keymaps, skins and JSON-RPC name an
+// action, never number it, so the value is free to move.
+
+//! Show the slider for the 3D glasses delay (HFR VRR)
+constexpr const int ACTION_FS3D_DELAY = 990;
+
+//! Swap the eyes of the playing 3D video (its Invert stereoscopic 3D mode)
+constexpr const int ACTION_STEREO_INVERT = 991;
+
 // The NOOP action can be specified to disable an input event. This is
 // useful in user keyboard.xml etc to disable actions specified in the
 // system mappings. ERROR action is used to play an error sound
 constexpr const int ACTION_ERROR = 998;
 constexpr const int ACTION_NOOP = 999;
+
+static_assert(ACTION_FS3D_DELAY > ACTION_ANALOG_MOVE_Y_DOWN && ACTION_STEREO_INVERT < ACTION_ERROR,
+              "the actions this build adds must stay clear of Kodi's own");
diff --git a/xbmc/input/actions/ActionTranslator.cpp b/xbmc/input/actions/ActionTranslator.cpp
index 242f63c..94d414a 100644
--- a/xbmc/input/actions/ActionTranslator.cpp
+++ b/xbmc/input/actions/ActionTranslator.cpp
@@ -60,6 +60,8 @@ constexpr auto ActionMappings = make_map<ActionName, ActionID>({
     {"dialogselectvideo", ACTION_DIALOG_SELECT_VIDEO},
     {"dialogselectaudio", ACTION_DIALOG_SELECT_AUDIO},
     {"dialogselectsubtitle", ACTION_DIALOG_SELECT_SUBTITLE},
+    {"fs3ddelay", ACTION_FS3D_DELAY},
+    {"stereoinvert", ACTION_STEREO_INVERT},
     {"playerdebug", ACTION_PLAYER_DEBUG},
     {"playerdebugvideo", ACTION_PLAYER_DEBUG_VIDEO},
     {"codecinfo", ACTION_PLAYER_PROCESS_INFO},
diff --git a/xbmc/video/PlayerController.cpp b/xbmc/video/PlayerController.cpp
index e585ae8..74776aa 100644
--- a/xbmc/video/PlayerController.cpp
+++ b/xbmc/video/PlayerController.cpp
@@ -29,6 +29,7 @@
 #include "settings/Settings.h"
 #include "settings/SettingsComponent.h"
 #include "settings/SubtitlesSettings.h"
+#include "settings/lib/Setting.h"
 #include "utils/StringUtils.h"
 #include "utils/Variant.h"
 #include "video/PlayerControllerActions.h"
@@ -38,6 +39,7 @@
 #include "windowing/WinSystem.h"
 
 #include <algorithm>
+#include <cmath>
 
 using namespace KODI;
 using namespace UTILS;
@@ -226,6 +228,33 @@ bool CPlayerController::OnAction(const CAction &action)
         return true;
       }
 
+      case ACTION_FS3D_DELAY:
+      {
+        // the setting's own range and step, the slider of its row in the video settings
+        const auto setting = std::static_pointer_cast<const CSettingInt>(
+            CServiceBroker::GetSettingsComponent()->GetSettings()->GetSetting(
+                CSettings::SETTING_VIDEOSCREEN_FS3DDELAY));
+        if (!setting)
+          return false;
+        ShowSlider(action.GetID(), 60031, static_cast<float>(setting->GetValue()),
+                   static_cast<float>(setting->GetMinimum()),
+                   static_cast<float>(setting->GetStep()),
+                   static_cast<float>(setting->GetMaximum()), true);
+        return true;
+      }
+
+      case ACTION_STEREO_INVERT:
+      {
+        CVideoSettings vs = appPlayer->GetVideoSettings();
+        vs.m_StereoInvert = !vs.m_StereoInvert;
+        appPlayer->SetVideoSettings(vs);
+        const auto& strings = CServiceBroker::GetResourcesComponent().GetLocalizeStrings();
+        CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Info, strings.Get(36536),
+                                              strings.Get(vs.m_StereoInvert ? 16041 : 16039),
+                                              DisplTime, false, MsgTime);
+        return true;
+      }
+
       case ACTION_AUDIO_DELAY:
       {
         float videoAudioDelayRange = CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_videoAudioDelayRange;
@@ -669,6 +698,19 @@ void CPlayerController::OnSliderChange(void *data, CGUISliderControl *slider)
     std::string strValue = StringUtils::Format("{:.0f}px", slider->GetFloatValue());
     slider->SetTextValue(strValue);
   }
+  else if (m_sliderAction == ACTION_FS3D_DELAY)
+  {
+    const int value = static_cast<int>(std::lround(slider->GetFloatValue()));
+    slider->SetTextValue(StringUtils::Format(
+        CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(60032), value));
+    // a display setting rather than the film's: it applies with or without a
+    // player, and is saved with the others when Kodi exits (as the volume is),
+    // not on every step of the slider
+    const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+    if (settings->GetInt(CSettings::SETTING_VIDEOSCREEN_FS3DDELAY) != value)
+      settings->SetInt(CSettings::SETTING_VIDEOSCREEN_FS3DDELAY, value);
+    return;
+  }
   else if (m_sliderAction == ACTION_VOLAMP_UP ||
           m_sliderAction == ACTION_VOLAMP_DOWN ||
           m_sliderAction == ACTION_VOLAMP)
