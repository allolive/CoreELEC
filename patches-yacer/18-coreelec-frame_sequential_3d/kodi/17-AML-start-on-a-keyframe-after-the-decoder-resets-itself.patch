+// whether decoding can start on this HEVC access unit: its first picture is IRAP
+inline bool AMLHevcCanStart(const uint8_t* data, size_t size, int nalLengthSize)
+{
+  bool irap = false;
+  AMLForEachNal(data, size, nalLengthSize,
+                [&irap](const uint8_t* nal, size_t)
+                {
+                  const int type = (nal[0] >> 1) & 0x3f;
+                  if (type >= HEVC_NAL_VPS)
+                    return true;
+                  irap = type >= HEVC_NAL_BLA_W_LP && type <= HEVC_NAL_CRA_NUT;
+                  return false;
+                });
+  return irap;
+}
+
+// whether an H.264 slice NAL holds an I or SI slice: first_mb_in_slice, then slice_type
+inline bool AMLAvcIsISlice(const uint8_t* nal, size_t len)
+{
+  size_t pos = 1;
+  int zeros = 0;
+  int bit = 8;
+  uint8_t byte = 0;
+  const auto readBit = [&]() -> int
+  {
+    if (bit == 8)
+    {
+      if (pos < len && zeros >= 2 && nal[pos] == 3) // emulation prevention
+      {
+        pos++;
+        zeros = 0;
+      }
+      if (pos >= len)
+        return -1;
+      byte = nal[pos++];
+      zeros = byte ? 0 : zeros + 1;
+      bit = 0;
+    }
+    return (byte >> (7 - bit++)) & 1;
+  };
+  const auto readUe = [&](uint32_t& value)
+  {
+    int leadingZeros = 0;
+    int b;
+    while ((b = readBit()) == 0)
+      if (++leadingZeros > 31)
+        return false;
+    if (b < 0)
+      return false;
+    value = 0;
+    for (int i = 0; i < leadingZeros; ++i)
+    {
+      if ((b = readBit()) < 0)
+        return false;
+      value = (value << 1) | static_cast<uint32_t>(b);
+    }
+    value += (1u << leadingZeros) - 1;
+    return true;
+  };
+  uint32_t firstMb = 0;
+  uint32_t sliceType = 0;
+  return readUe(firstMb) && readUe(sliceType) &&
+         (sliceType == 2 || sliceType == 4 || sliceType == 7 || sliceType == 9);
+}
+
+// on H.264: an IDR picture, a recovery point SEI ahead of the first slice, or an I first slice
+// after an SPS; not a lone SPS
+inline bool AMLAvcCanStart(const uint8_t* data, size_t size, int nalLengthSize)
+{
+  bool start = false;
+  bool sps = false;
+  AMLForEachNal(data, size, nalLengthSize,
+                [&start, &sps](const uint8_t* nal, size_t len)
+                {
+                  const int type = nal[0] & 0x1f;
+                  if (type == AVC_NAL_SPS)
+                    sps = true;
+                  else if (type == AVC_NAL_SEI)
+                    AMLForEachSeiMessage(nal, len, 1,
+                                         [&start](uint32_t payloadType, const uint8_t*, size_t)
+                                         {
+                                           if (payloadType == SEI_PAYLOAD_RECOVERY_POINT)
+                                             start = true;
+                                           return !start;
+                                         });
+                  else if (type >= AVC_NAL_SLICE && type <= AVC_NAL_IDR_SLICE)
+                  {
+                    start = type == AVC_NAL_IDR_SLICE ||
+                            (sps && type <= AVC_NAL_SLICE_DPA && AMLAvcIsISlice(nal, len));
+                    return false;
+                  }
+                  return !start;
+                });
+  return start;
+}
+
 inline bool AMLReadLeb128(const uint8_t* data, size_t end, size_t& pos, uint64_t& value)
 {
   value = 0;
