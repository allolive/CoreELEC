 enum
 {
+  HEVC_NAL_BLA_W_LP = 16, // first IRAP type
+  HEVC_NAL_CRA_NUT = 21, // last IRAP type
+  HEVC_NAL_VPS = 32, // first non-VCL type
   HEVC_NAL_SEI_PREFIX = 39,
   HEVC_NAL_UNSPEC62 = 62 // Dolby Vision RPU
 };
 
 enum
 {
+  AVC_NAL_SLICE = 1,
+  AVC_NAL_SLICE_DPA = 2, // data partition A, which holds the slice header
+  AVC_NAL_IDR_SLICE = 5,
   AVC_NAL_SEI = 6,
   AVC_NAL_SPS = 7,
   AVC_NAL_PPS = 8,
@@ -32,6 +38,7 @@ enum
 {
   SEI_PAYLOAD_REGISTERED_ITU_T_T35 = 4,
   SEI_PAYLOAD_USER_DATA_UNREGISTERED = 5,
+  SEI_PAYLOAD_RECOVERY_POINT = 6,
   SEI_PAYLOAD_MASTERING_DISPLAY_COLOUR_VOLUME = 137,
   SEI_PAYLOAD_CONTENT_LIGHT_LEVEL_INFO = 144
 };
