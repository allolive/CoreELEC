+
+int CDVDVideoCodecAmlogic::PicturesIn(const CDVDStreamInfo& hints, double seconds)
 {
   const double fps = hints.fpsrate > 0 && hints.fpsscale > 0
                          ? static_cast<double>(hints.fpsrate) / hints.fpsscale
                          : 24.0;
-  return std::max(1, static_cast<int>(fps * 2.0 + 0.5));
