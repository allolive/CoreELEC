 }
 
 // Whether the picture carries SPS, subset SPS and PPS; notes whether they are
@@ -613,6 +620,30 @@ bool CDVDVideoCodecAmlogic::MvcParamsReady(const uint8_t* data, uint32_t size)
   return false;
 }
 
+void CDVDVideoCodecAmlogic::ArmKeyframeGate()
+{
+  // other codecs keep what a seek gives them
+  if (m_hints.codec != AV_CODEC_ID_HEVC && m_hints.codec != AV_CODEC_ID_H264)
+    return;
+  m_keyframeWait = PicturesIn(m_hints, 10.0);
+  m_keyframeSkipped = 0;
+  m_keyframeWaitDrain = false;
+}
+
+bool CDVDVideoCodecAmlogic::KeyframeGateOpens(const uint8_t* data, uint32_t size)
+{
+  const bool keyframe = m_hints.codec == AV_CODEC_ID_HEVC
+                            ? AMLHevcCanStart(data, size, m_nalLengthSize)
+                            : AMLAvcCanStart(data, size, m_nalLengthSize);
+  if (!keyframe && ++m_keyframeSkipped < m_keyframeWait)
+    return false;
+  CLog::Log(LOGINFO, "CDVDVideoCodecAmlogic::{}: decoding restarts {} after {} packets",
+            __FUNCTION__, keyframe ? "on a keyframe" : "without a keyframe", m_keyframeSkipped);
+  m_keyframeWait = 0;
+  m_Codec->RestartDecoderTimeout();
+  return true;
+}
+
 bool CDVDVideoCodecAmlogic::AddData(const DemuxPacket &packet)
 {
   m_seekPreroll.SetDrop((m_codecControlFlags & DVD_CODEC_CTRL_DROP) != 0);
@@ -622,6 +653,13 @@ bool CDVDVideoCodecAmlogic::AddData(const DemuxPacket &packet)
   if (!packet.pData || packet.iSize <= 0)
     return true;
 
+  if (m_keyframeWait > 0 && !KeyframeGateOpens(packet.pData, packet.iSize))
+  {
+    m_refedAfterReset = false;
+    m_pendingMeta = m_streamMeta;
+    return true;
+  }
+
   // a full decoder: refused before anything runs on the packet
   if (m_opened && m_Codec && !m_Codec->AcceptsInput(packet.iSize + packet.elSize))
     return false;
@@ -873,14 +911,14 @@ bool CDVDVideoCodecAmlogic::AddData(const DemuxPacket &packet)
       m_retryPts = packet.pts;
       return false;
     case CAMLCodec::AddResult::RESET_NEEDED:
-      m_Codec->Reset();
+      ResetStream();
+      ArmKeyframeGate();
       // fed again once; one that fails on the reset decoder too is dropped
       if (!refedAfterReset)
       {
         m_refedAfterReset = true;
         return false;
       }
-      m_pendingMeta = m_streamMeta;
       return true;
   }
 
@@ -906,6 +944,16 @@ bool CDVDVideoCodecAmlogic::AddData(const DemuxPacket &packet)
 }
 
 void CDVDVideoCodecAmlogic::Reset(void)
+{
+  ResetStream();
+  m_refedAfterReset = false;
+  m_keyframeWait = 0;
+  // a decoder timeout flushed it mid-stream, and the player feeds nothing again
+  if (std::exchange(m_timedOut, false))
+    ArmKeyframeGate();
+}
+
+void CDVDVideoCodecAmlogic::ResetStream()
 {
   if (m_Codec)
     m_Codec->Reset();
@@ -921,7 +969,6 @@ void CDVDVideoCodecAmlogic::Reset(void)
     m_mvcParamsSkipped = 0;
   }
   m_seekPreroll.Reset();
-  m_refedAfterReset = false;
   m_retrySource = nullptr;
   std::vector<uint8_t>().swap(m_retryData);
   m_metadataSequencer.Reset();
@@ -948,7 +995,14 @@ CDVDVideoCodec::VCReturn CDVDVideoCodecAmlogic::GetPicture(VideoPicture* pVideoP
   if (!m_Codec)
     return VC_ERROR;
 
+  // the decoder holds nothing until a packet passes the gate, so no timeout can apply
+  if (m_keyframeWait > 0)
+    return m_keyframeWaitDrain && (m_codecControlFlags & DVD_CODEC_CTRL_DRAIN) ? VC_EOF
+                                                                              : VC_BUFFER;
+
   VCReturn retVal = m_Codec->GetPicture(&m_videobuffer);
+  if (retVal == VC_FLUSHED)
+    m_timedOut = true;
 
   if (retVal == VC_PICTURE)
   {
@@ -1004,6 +1058,8 @@ CDVDVideoCodec::VCReturn CDVDVideoCodecAmlogic::GetPicture(VideoPicture* pVideoP
 
