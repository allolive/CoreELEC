       URIUtils::AddFileToFolder(m_root, "BDMV", "CLIPINF", mvcClip.clipId + ".clpi");
   mvcClip.inTime = static_cast<int64_t>(clip->in_time);
   mvcClip.outTime = static_cast<int64_t>(clip->out_time);
