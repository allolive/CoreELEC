+// A timestamp of the file on title time, as the base view's packets are
+double CDemuxMVC::TitleTime(int64_t ts, const AVStream* stream) const
+{
+  const CDVDInputStreamBluray::ClipTime clip{static_cast<uint64_t>(m_clipIn),
+                                             static_cast<uint64_t>(*m_titleStart)};
+  const auto titleTime = CDVDInputStreamBluray::TitleTime(ts, clip, *stream);
+  return titleTime ? *titleTime * DVD_TIME_BASE : DVD_NOPTS_VALUE;
+}
+
 // ts: a timestamp Read returned; the timestamp of the file (90 kHz) it was converted from
 int64_t CDemuxMVC::ClipTimestamp(double ts) const
 {
+  // back into the file's timestamps, which wrap
+  if (m_titleStart && m_pFormatContext && m_nStreamIndex >= 0)
+    return (static_cast<int64_t>(ts * 90000 / DVD_TIME_BASE) - *m_titleStart + m_clipIn) &
+           ((INT64_C(1) << m_pFormatContext->streams[m_nStreamIndex]->pts_wrap_bits) - 1);
   if (m_lastDts != DVD_NOPTS_VALUE)
     return m_lastClipDts + static_cast<int64_t>((ts - m_lastDts) * 90000 / DVD_TIME_BASE);
   // Read keeps a timestamp below the start time as it is
