-int CStereoDepth::Get(const CFileItem& item)
+CStereoDepth::Depths CStereoDepth::Get(const CFileItem& item)
 {
   std::lock_guard lock(depthLock);
-  const CVariant& all = Depths();
+  const CVariant& all = Stored();
   const std::string key = Key(item);
   if (!all.isMember(key))
-    return 0;
-  return std::clamp(static_cast<int>(all[key].asInteger()), -MAX, MAX);
+    return {};
+  // the picture's depth alone, or both
+  const CVariant& entry = all[key];
+  const auto read = [](const CVariant& depth)
+  { return std::clamp(static_cast<int>(depth.asInteger()), -MAX, MAX); };
+  if (!entry.isObject())
+    return {read(entry), 0};
+  return {read(entry["picture"]), read(entry["subtitles"])};
 }
 
