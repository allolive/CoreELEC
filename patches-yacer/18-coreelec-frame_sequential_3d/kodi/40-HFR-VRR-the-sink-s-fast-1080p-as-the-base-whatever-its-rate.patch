+// A progressive 1080p the connector lists faster than 120 Hz: the fast 1080p the
+// kernel takes from the sink's EDID. Its rate, as DRM rounds it, else 0.
+int CAMLDisplay::fs3d_fast_hz(const std::string& mode) const
+{
+  const std::optional<drmModeModeInfo> info = m_amlDRMUtils->aml_get_drmDevice_mode_info(mode);
+  if (!info || info->hdisplay != FS3D_WIDTH || info->vdisplay != FS3D_HEIGHT ||
+      (info->flags & DRM_MODE_FLAG_INTERLACE) || info->vrefresh <= 120)
+    return 0;
+  return static_cast<int>(info->vrefresh);
+}
+
+// the base in use is one even while a mode list reads short after a hotplug
+bool CAMLDisplay::is_fs3d_base(const std::string& mode) const
+{
+  return StringUtils::EqualsNoCase(mode, FS3D_MODE) ||
+         StringUtils::EqualsNoCase(mode, m_fs3d_mode) || fs3d_fast_hz(mode) > 0;
+}
+
+void CAMLDisplay::fs3d_set_base(const std::string& mode, int hz)
+{
+  m_fs3d_mode = mode;
+  m_fs3d_hz = hz > 0 ? hz : 120;
+}
