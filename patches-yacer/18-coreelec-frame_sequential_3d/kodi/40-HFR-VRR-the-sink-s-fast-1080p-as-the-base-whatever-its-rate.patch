+std::optional<drmModeModeInfo> CAMLDRMUtils::aml_get_drmDevice_mode_info(const std::string& mode)
+{
+  std::unique_lock<CCriticalSection> lock(m_drmSection);
+
+  if (!m_connector)
+    return std::nullopt;
+  for (int i = 0; i < m_connector->count_modes; i++)
+  {
+    if (StringUtils::EqualsNoCase(m_connector->modes[i].name, mode))
+      return m_connector->modes[i];
+  }
+  return std::nullopt;
+}
