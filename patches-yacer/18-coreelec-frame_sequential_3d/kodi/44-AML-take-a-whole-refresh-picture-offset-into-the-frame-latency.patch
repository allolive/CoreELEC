+  //! where a frame spans several refreshes.
+  void TrackRefreshShift(double alignment);
+  int m_shiftRefreshes{0};
+  unsigned int m_shiftRun{0};
+  bool m_shiftDone{false}; //!< one correction per settled measurement
+
   //! \brief Whether a warning may be emitted now. Capped in number and spaced in
   //! time: each one is a synchronous log flush on the frame loop.
   bool MayWarn();
