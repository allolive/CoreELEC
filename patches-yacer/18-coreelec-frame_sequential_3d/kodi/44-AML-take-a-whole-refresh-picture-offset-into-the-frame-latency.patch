 void CAMLLatency::Forget()
 {
   // The published value goes now: the caller may be closing the decoder, and no
@@ -130,6 +163,8 @@
 
 void CAMLLatency::Rearm()
 {
+  m_shiftDone = false;
+  m_shiftRun = 0;
   m_candidate = 0;
   m_agreed = 0;
   m_settled = false;
@@ -626,6 +661,7 @@
                              static_cast<double>(RDMA_COMMIT_VBLANKS) * m_period;
     CAMLLatencyStore::GetInstance().SetAlignment(static_cast<float>(alignment / 1000.0));
     m_lastAlign = alignment;
+    TrackRefreshShift(alignment);
 
     if (m_reports == 0)
     {
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLLatency.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLLatency.h
@@ -7,9 +7,11 @@
 
 #pragma once
 
+#include <algorithm>
 #include <array>
 #include <atomic>
 #include <cstdint>
+#include <cstdlib>
 #include <optional>
 #include <utility>
 
@@ -56,7 +58,35 @@
       if (rateKey == Key(rate))
         refreshes = count;
     m_expectedMs.store(static_cast<float>(refreshes * 1000.0 / rate), std::memory_order_relaxed);
+    int shift = 0;
+    for (const auto& [rateKey, refreshShift] : m_shifts)
+      if (rateKey == Key(rate))
+        shift = refreshShift;
+    m_shiftMs.store(static_cast<float>(shift * 1000.0 / rate), std::memory_order_relaxed);
+  }
+  //! \brief Whole refreshes added to the frame latency where a frame spans
+  //! several: there the renderer can hand frames out a whole refresh off the
+  //! phase the genlock aims at, which no placement inside one period reaches.
+  //! Learnt from the measured alignment and kept for the rate, so the next
+  //! start lands where this one was brought. Polling thread only.
+  void Shift(double rate, int refreshes)
+  {
+    const int key = Key(rate);
+    auto slot = std::find_if(m_shifts.begin(), m_shifts.end(),
+                             [key](const auto& entry) { return entry.first == key; });
+    if (slot == m_shifts.end())
+      slot = std::find_if(m_shifts.begin(), m_shifts.end(),
+                          [](const auto& entry) { return entry.first == 0; });
+    if (slot == m_shifts.end())
+      slot = m_shifts.begin();
+    int total = (slot->first == key ? slot->second : 0) + refreshes;
+    // A reading this far out is not a placement this can mend: off for the rate.
+    if (std::abs(total) > MAX_SHIFT_REFRESHES)
+      total = 0;
+    *slot = {key, total};
+    m_shiftMs.store(static_cast<float>(total * 1000.0 / rate), std::memory_order_relaxed);
   }
+  float GetShift() const { return m_shiftMs.load(std::memory_order_relaxed); }
   void Remember(double rate, unsigned int refreshes)
   {
     // The next start at this rate expects it even without a rate change.
@@ -91,6 +121,9 @@
 
   static int Key(double rate) { return static_cast<int>(rate * 100.0 + 0.5); }
   std::array<std::pair<int, unsigned int>, 4> m_counts{};
+  static constexpr int MAX_SHIFT_REFRESHES = 2;
+  std::array<std::pair<int, int>, 4> m_shifts{};
+  std::atomic<float> m_shiftMs{0.0f};
   size_t m_nextSlot = 0;
 };
 
@@ -174,6 +207,13 @@
