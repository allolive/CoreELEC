+
+/* a free slot, else a STALE one, else -1 */
+static int vf_slot_take(void)
+{
+	int i, stale = -1;
+
+	for (i = 0; i < VF_POOL_SIZE; i++) {
+		if (vfpool_idx[i].state == VF_SLOT_FREE)
+			return i;
+		if (stale < 0 && vfpool_idx[i].state == VF_SLOT_STALE)
+			stale = i;
+	}
+	return stale;
+}
