+/* the helpers below run with lock held */
+static void vfbuf_ref(int view, int id)
+{
+	vfbuf_use[view][id]++;
+	__clear_bit(id, vfbuf_return[view]);
+}
+
+static void vfbuf_unref(int view, int id)
+{
+	if (vfbuf_use[view][id] <= 0) {
+		pr_warn_ratelimited("vh264mvc: view %d buffer %d released while unused\n",
+			view, id);
+		return;
+	}
+	if (--vfbuf_use[view][id] == 0)
+		__set_bit(id, vfbuf_return[view]);
