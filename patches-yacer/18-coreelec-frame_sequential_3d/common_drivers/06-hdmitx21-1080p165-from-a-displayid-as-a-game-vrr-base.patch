+		hdmitx_vrr_publish_rate(&tx_comm->hdmitx_vinfo,
+			tx_comm->hdmitx_vinfo.sync_duration_num,
+			tx_comm->hdmitx_vinfo.sync_duration_den);
 	} else { /* for vrr-game */
 		para.duration = rate;
+		game_vrr_vinfo_rate(tx_comm, rate, frac, &num, &den);
+		hdmitx_vrr_publish_rate(&tx_comm->hdmitx_vinfo, num, den);
+		tx_comm->hdmitx_vinfo.brr_duration =
+			(fmt_para->timing.v_freq + 999) / 1000;
 	}
-	updata_vinfo_sync_duration(&tx_comm->hdmitx_vinfo, rate,
-		tx_comm->frac_rate_policy,
-		(fmt_para->timing.v_freq + 999) / 1000);
-	hdmitx_vrr_publish_rate(&tx_comm->hdmitx_vinfo,
-		tx_comm->hdmitx_vinfo.sync_duration_num,
-		tx_comm->hdmitx_vinfo.sync_duration_den);
 
 	para.vrr_enabled = 1;
 	para.fapa_end_extended = prxcap->fapa_end_extended;
@@ -1734,22 +1847,37 @@ static void hdmitx_vrr_game_handler(struct hdmitx_dev *hdev)
 	struct vrr_conf_para *conf = &vrr->conf_params;
 	const struct hdmi_timing *timing = NULL;
 	u32 vtotal_tmp = 0;
-	u32 rem;
+	u64 num, den, rem;
 
 	timing = hdmitx_mode_vic_to_hdmi_timing(conf->brr_vic);
-	if (!timing || !conf->duration) {
+	if (!timing || !conf->duration || !timing->h_total) {
 		vrr_debug_info("%s[%d] failed to get timing of brr_vic %d\n",
 			__func__, __LINE__, conf->brr_vic);
