 		para.type = hdev->tx_comm.vrr_mode;
@@ -1652,15 +1761,19 @@ static int hdmitx_set_fr_hint_locked(int rate, void *data)
 				break;
 			}
 		}
+		updata_vinfo_sync_duration(&tx_comm->hdmitx_vinfo, rate,
+			tx_comm->frac_rate_policy,
