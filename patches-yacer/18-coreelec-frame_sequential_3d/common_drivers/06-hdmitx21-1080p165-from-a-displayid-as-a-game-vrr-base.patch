 }
 
diff --git a/drivers/media/vout/hdmitx21/hdmi_tx_video.c b/drivers/media/vout/hdmitx21/hdmi_tx_video.c
index 8db4051..854ece8 100644
--- a/drivers/media/vout/hdmitx21/hdmi_tx_video.c
+++ b/drivers/media/vout/hdmitx21/hdmi_tx_video.c
@@ -51,6 +51,9 @@ static void construct_avi_packet(struct hdmitx_dev *hdev)
 	info->quantization_range = HDMI_QUANTIZATION_RANGE_LIMITED;
 	info->nups = HDMI_NUPS_UNKNOWN;
 	info->video_code = para->timing.vic;
