+++ b/drivers/media/vout/hdmitx21/hdmi_tx_main.c
@@ -3848,7 +3848,8 @@ static DEVICE_ATTR_RW(vrr_mode);
 
 /*
  * vrr_rate: the game-VRR rate x100 on the current mode (9600 = 96 Hz), 0 to
- * leave VRR. /sys/class/display/fr_hint cannot carry it: with DRM in charge
+ * leave VRR; "9600 1" is 1000/1001 of it (95.904 Hz), for a base mode with no
+ * 1000/1001 twin of its own. /sys/class/display/fr_hint cannot carry it: with DRM in charge
  * its vout server is a stub, and the decoders also send it frame durations
  * in other units.
  */
@@ -3856,11 +3857,12 @@ static ssize_t vrr_rate_store(struct device *dev,
 			      struct device_attribute *attr,
 			      const char *buf, size_t count)
 {
-	int rate;
+	int rate, frac = 0;
 
-	if (kstrtoint(buf, 10, &rate) || rate < 0)
+	/* "<rate>", or "<rate> 1" for 1000/1001 of it on a mode without a twin */
+	if (sscanf(buf, "%d %d", &rate, &frac) < 1 || rate < 0)
 		return -EINVAL;
-	hdmitx_set_fr_hint(rate, NULL);
+	hdmitx_set_fr_hint_frac(rate, frac == 1);
