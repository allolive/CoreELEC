-	if (rate < 2397 || rate > 12000 || rate > tmp_rate) {
+	if (rate < 2397 || rate > tmp_rate) {
 		HDMITX_INFO("vrr rate over range %d [2397~%d]\n", rate, tmp_rate);
 		return 0;
 	}
@@ -1644,7 +1669,8 @@
 		para.duration = rate;
 	}
 	updata_vinfo_sync_duration(&tx_comm->hdmitx_vinfo, rate,
-		tx_comm->frac_rate_policy,
+		para.type == T_VRR_GAME && !fmt_para->frac_mode ?
+		game_vrr_frac : tx_comm->frac_rate_policy,
 		(fmt_para->timing.v_freq + 999) / 1000);
 
 	para.vrr_enabled = 1;
@@ -1719,22 +1745,37 @@
 	struct vrr_conf_para *conf = &vrr->conf_params;
 	const struct hdmi_timing *timing = NULL;
 	u32 vtotal_tmp = 0;
-	u32 rem;
+	u64 num, den, rem;
 
 	timing = hdmitx_mode_vic_to_hdmi_timing(conf->brr_vic);
-	if (!timing || !conf->duration) {
+	if (!timing || !conf->duration || !timing->h_total) {
 		vrr_debug_info("%s[%d] failed to get timing of brr_vic %d\n",
 			__func__, __LINE__, conf->brr_vic);
 		return;
 	}
-	vtotal_tmp = timing->v_total * timing->v_freq / 10;
-	rem = vtotal_tmp % conf->duration;
-	vtotal_tmp = vtotal_tmp / conf->duration;
+	/* lines a frame at the rate: pixel clock / (h_total * rate), the rate
+	 * x100; a mode's 1000/1001 twin scales its clock and rate alike
+	 */
+	num = (u64)timing->pixel_freq * 100000;
+	den = (u64)timing->h_total * conf->duration;
+	if (game_vrr_frac && !hdev->tx_comm.fmt_para.frac_mode) {
+		num *= 1001;
+		den *= 1000;
+	}
+	vtotal_tmp = div64_u64_rem(num, den, &rem);
+	/* a new rate (the 1000/1001 flag alone changes no conf): start afresh */
+	if (den != game_vtotal_den) {
+		game_vtotal_den = den;
+		game_vtotal_rem = 0;
+	}
 	game_vtotal_rem += rem;
-	if (game_vtotal_rem >= conf->duration) {
-		game_vtotal_rem -= conf->duration;
+	if (game_vtotal_rem >= den) {
+		game_vtotal_rem -= den;
 		vtotal_tmp++;
 	}
+	/* never shorter than the mode: DRM names 164.917 Hz 165 */
+	if (vtotal_tmp < timing->v_total)
+		vtotal_tmp = timing->v_total;
 	vrr->game_val.vtotal_fixed = vtotal_tmp;
 	vrr_debug_info("game-vrr vtotal = %d\n", vrr->game_val.vtotal_fixed);
 
