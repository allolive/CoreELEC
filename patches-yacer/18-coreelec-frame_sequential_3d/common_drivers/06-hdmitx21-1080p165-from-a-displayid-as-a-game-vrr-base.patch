-	vtotal_tmp = timing->v_total * timing->v_freq / 10;
-	rem = vtotal_tmp % conf->duration;
-	vtotal_tmp = vtotal_tmp / conf->duration;
+	/* lines a frame at the rate: pixel clock / (h_total * rate), the rate
+	 * x100; a mode's 1000/1001 twin scales its clock and rate alike
+	 */
+	game_vrr_lines(timing, conf->duration,
+		       game_vrr_frac && !hdev->tx_comm.fmt_para.frac_mode,
+		       &num, &den);
+	vtotal_tmp = div64_u64_rem(num, den, &rem);
+	/* a new rate (the 1000/1001 flag alone changes no conf): start afresh */
