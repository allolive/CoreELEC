diff --git a/drivers/media/vout/hdmitx21/hdmi_tx_vrr.c b/drivers/media/vout/hdmitx21/hdmi_tx_vrr.c
index 3dfa46b..74e8853 100644
--- a/drivers/media/vout/hdmitx21/hdmi_tx_vrr.c
+++ b/drivers/media/vout/hdmitx21/hdmi_tx_vrr.c
@@ -913,7 +913,12 @@ static enum TARGET_FRAME_RATE vsync_match_to_tfr(const u16 duration)
 }
 
 /* lines carried between frames so game-vrr averages the exact rate */
-static u32 game_vtotal_rem;
+static u64 game_vtotal_rem;
+static u64 game_vtotal_den;	/* the divisor game_vtotal_rem is counted in */
+/* the game-vrr rate is 1000/1001 of the one given, on a base mode without a
+ * 1000/1001 twin (a VESA timing): 95.904 Hz on 1080p165
+ */
+static bool game_vrr_frac;
 
 static void vrr_init_game_para(struct tx_vrr_params *para)
 {
@@ -929,6 +934,7 @@ static void vrr_init_game_para(struct tx_vrr_params *para)
 		fva_factor = 1; /* at least be 1 */
 	para->frame_cnt = 0;
 	game_vtotal_rem = 0;
+	game_vtotal_den = 0;
 	memset(&para->emp_vrr_pkt, 0, sizeof(para->emp_vrr_pkt));
 
 	memset(vrr_pkt, 0, sizeof(*vrr_pkt));
@@ -1533,6 +1539,80 @@ static void updata_vinfo_sync_duration(struct vinfo_s *vinfo,
 /* rate: Unit *100. Example, 1080p23.976Hz, rate = 2397 */
 static DEFINE_MUTEX(fr_hint_mutex);
 
+/* ENCP_VIDEO_MAX_LNCNT holds the line count - 1 in 13 bits */
+#define GAME_VRR_MAX_LINES 8192
+
+/* game VRR's lines a frame at rate (x100), as num / den: pixel clock /
+ * (h_total * rate); a mode's 1000/1001 twin scales its clock and rate alike,
+ * frac asks for 1000/1001 of the rate on a mode without one
+ */
+static void game_vrr_lines(const struct hdmi_timing *timing, int rate,
+			   bool frac, u64 *num, u64 *den)
+{
+	*num = (u64)timing->pixel_freq * 100000;
+	*den = (u64)timing->h_total * rate;
+	if (frac) {
+		*num *= 1001;
+		*den *= 1000;
+	}
+}
+
+/* whether the encoder can count the lines a frame takes at rate */
+static bool game_vrr_rate_fits(struct hdmitx_common *tx_comm, int rate,
+			       bool frac)
+{
+	struct hdmi_format_para *fmt_para = &tx_comm->fmt_para;
+	const struct hdmi_timing *timing;
+	u64 num, den;
+
+	timing = hdmitx_mode_vic_to_hdmi_timing(fmt_para->timing.vic);
+	if (!timing || !timing->h_total || rate <= 0)
+		return false;
+	game_vrr_lines(timing, rate, frac && !fmt_para->frac_mode, &num, &den);
+	return div64_u64(num + den - 1, den) <= GAME_VRR_MAX_LINES;
+}
+
+/* the rate of the line count game VRR programs, for vinfo */
+static void game_vrr_vinfo_rate(struct hdmitx_common *tx_comm, int rate,
+				bool frac, u32 *num, u32 *den)
+{
+	struct hdmi_format_para *fmt_para = &tx_comm->fmt_para;
+	const struct hdmi_timing *timing;
+	u64 lnum, lden;
+
+	timing = hdmitx_mode_vic_to_hdmi_timing(fmt_para->timing.vic);
+	if (rate && timing && timing->h_total) {
+		game_vrr_lines(timing, rate, frac && !fmt_para->frac_mode,
+			       &lnum, &lden);
+		/* never shorter than the mode: then it runs at the mode's rate */
+		if (lnum < (u64)timing->v_total * lden) {
+			rate = 0;
+			frac = false;
+		}
+	}
+	if (!rate) {
+		u32 v_freq = fmt_para->timing.v_freq;
+
+		if (v_freq % 1000 == 0) {
+			*num = v_freq / 1000;
+			*den = 1;
+		} else {
+			*num = v_freq;
+			*den = 1000;
+		}
+	} else if (frac || fmt_para->frac_mode) {
+		/* rate / 100 * 1000 / 1001 */
+		*num = rate * 10;
+		*den = 1001;
+	} else if (rate % 100 == 0) {
+		*num = rate / 100;
+		*den = 1;
+	} else {
+		*num = rate;
+		*den = 100;
+	}
+}
+
 /* give vinfo a new rate, and the video layer, which times frames by it */
 static void hdmitx_vrr_publish_rate(struct vinfo_s *vinfo, u32 num, u32 den)
 {
@@ -1543,7 +1623,24 @@ static void hdmitx_vrr_publish_rate(struct vinfo_s *vinfo, u32 num, u32 den)
 #endif
 }
 
-static int hdmitx_set_fr_hint_locked(int rate, void *data);
+static int hdmitx_set_fr_hint_locked(int rate, void *data, bool frac);
+
+/* the vrr_rate attribute: the rate, or 1000/1001 of it on a mode with no
+ * 1000/1001 twin
+ */
+int hdmitx_set_fr_hint_frac(int rate, bool frac)
+{
+	struct hdmitx_dev *hdev = get_hdmitx21_device();
