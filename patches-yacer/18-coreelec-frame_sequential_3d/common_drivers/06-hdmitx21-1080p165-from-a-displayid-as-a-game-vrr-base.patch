diff --git a/drivers/media/vout/hdmitx_common/hdmitx_edid_parse.c b/drivers/media/vout/hdmitx_common/hdmitx_edid_parse.c
index 617f613..e694b31 100644
--- a/drivers/media/vout/hdmitx_common/hdmitx_edid_parse.c
+++ b/drivers/media/vout/hdmitx_common/hdmitx_edid_parse.c
