diff --git a/drivers/drm/meson_vpu_util.c b/drivers/drm/meson_vpu_util.c
index 5335565..11d5cbc 100644
--- a/drivers/drm/meson_vpu_util.c
+++ b/drivers/drm/meson_vpu_util.c
@@ -139,6 +139,19 @@ int meson_vpu_write_reg(u32 addr, u32 val)
 #endif
 }
 
+/* rewrite registers' values in the armed vsync table of one VPP */
+int meson_vpu_patch_regs(int vpp_index, const u32 *addr, const u32 *val, int n)
+{
+#ifdef CONFIG_AMLOGIC_MEDIA_RDMA
+	if (vpp_index < 0 || vpp_index >= RDMA_COUNT ||
+	    drm_vsync_rdma_handle[vpp_index] == -1)
+		return 0;
+	return rdma_table_patch_regs(drm_vsync_rdma_handle[vpp_index], addr, val, n);
+#else
+	return 0;
+#endif
+}
+
 int meson_vpu_write_reg_bits(u32 addr, u32 val, u32 start, u32 len)
 {
 #ifdef CONFIG_AMLOGIC_MEDIA_RDMA
diff --git a/drivers/drm/meson_vpu_util.h b/drivers/drm/meson_vpu_util.h
index dd53121..694db93 100644
--- a/drivers/drm/meson_vpu_util.h
+++ b/drivers/drm/meson_vpu_util.h
@@ -32,6 +32,7 @@ struct osd_scope_s {
 
 u32 meson_vpu_read_reg(u32 addr);
 int meson_vpu_write_reg(u32 addr, u32 val);
+int meson_vpu_patch_regs(int vpp_index, const u32 *addr, const u32 *val, int n);
 int meson_vpu_write_reg_bits(u32 addr, u32 val, u32 start, u32 len);
 int meson_vpu1_write_reg_bits(u32 addr, u32 val, u32 start, u32 len);
 int meson_vpu1_write_reg_bits_g12b(u32 addr, u32 val, u32 start, u32 len);
diff --git a/drivers/drm/vpu-hw/meson_vpu_osd_mif.c b/drivers/drm/vpu-hw/meson_vpu_osd_mif.c
index 49bcb33..6bbfc00 100644
--- a/drivers/drm/vpu-hw/meson_vpu_osd_mif.c
+++ b/drivers/drm/vpu-hw/meson_vpu_osd_mif.c
@@ -24,6 +24,7 @@
 #include "meson_vpu_reg.h"
 #include "meson_vpu_util.h"
 #include <linux/amlogic/media/registers/register.h>
+#include <linux/amlogic/media/video_sink/vpp.h>
 
 u32 frame_seq[MESON_MAX_OSDS];
 
@@ -1289,7 +1290,9 @@ static bool osd_check_config(struct meson_vpu_osd_state *mvos,
 		old_mvos->pixel_format != mvos->pixel_format ||
 		old_mvos->global_alpha != mvos->global_alpha ||
 		old_mvos->crtc_index != mvos->crtc_index ||
-		old_mvos->afbc_en != mvos->afbc_en) {
+		old_mvos->afbc_en != mvos->afbc_en ||
+		old_mvos->fa_mode != mvos->fa_mode ||
+		old_mvos->fa_shift != mvos->fa_shift) {
 		return true;
 	} else {
 		return false;
@@ -1336,6 +1339,8 @@ static int osd_check_state(struct meson_vpu_block *vblk,
 	mvos->sec_en = plane_info->sec_en;
 	mvos->palette_arry = plane_info->palette_arry;
 	mvos->process_unit = plane_info->process_unit;
+	mvos->fa_mode = plane_info->fa_mode;
+	mvos->fa_shift = plane_info->fa_shift;
 
 	return 0;
 }
@@ -1449,6 +1454,157 @@ static int osd_format_is_rgbx(u32 pixel_format)
 	return is_rgbx;
 }
 
+/*
+ * Frame-sequential 3D GUI. The GUI framebuffer holds both eyes (1: side by
+ * side, 2: top and bottom), the plane scans out one half of it, and every
+ * vsync the fetch window moves to the half for the eye the video layer shows
+ * on that frame. A commit writes the window with the current eye; between
+ * commits the DRM table is replayed every vsync, so the vsync hook rewrites
+ * the window inside that table.
+ */
+static int osd_fa_3d;
+module_param(osd_fa_3d, int, 0664);
+MODULE_PARM_DESC(osd_fa_3d, "frame-sequential 3D GUI: 0 off, 1 side by side, 2 top and bottom");
+
+struct osd_fa_block {
+	bool valid;
+	bool vertical;			/* top and bottom: the eyes are rows apart */
+	u32 shift;			/* from the first eye's half to the second's */
+	u32 w1_reg;
+	u32 w2_reg;
+	struct osd_scope_s scope;	/* the first half */
+};
+
+/*
+ * osd_fa: the blocks of the armed table, which the vsync hook moves.
+ * osd_fa_next: the blocks of the table a commit is building, made current
+ * once that table is armed, so the hook never moves an older table's
+ * window by a newer layout (or the reverse).
+ */
+static struct osd_fa_block osd_fa[MESON_MAX_OSDS];
+static struct osd_fa_block osd_fa_next[MESON_MAX_OSDS];
+static DEFINE_SPINLOCK(osd_fa_lock);
+static int osd_fa_eye;
+static u32 osd_fa_gen;
+
+int meson_osd_fa_mode(void)
+{
+	int fa = READ_ONCE(osd_fa_3d);
+
+	return (fa == 1 || fa == 2) ? fa : 0;
+}
+
+static void osd_fa_drop(u32 index)
+{
+	unsigned long flags;
+
+	if (index >= MESON_MAX_OSDS)
+		return;
+	spin_lock_irqsave(&osd_fa_lock, flags);
+	osd_fa_next[index].valid = false;
+	spin_unlock_irqrestore(&osd_fa_lock, flags);
+}
+
+static struct osd_scope_s osd_fa_scope(const struct osd_fa_block *b, int eye)
+{
+	struct osd_scope_s s = b->scope;
+
+	if (eye == 1 && b->vertical) {
+		s.v_start += b->shift;
+		s.v_end += b->shift;
+	} else if (eye == 1) {
+		s.h_start += b->shift;
+		s.h_end += b->shift;
+	}
+	return s;
+}
+
+/*
+ * Move the window of every frame-sequential block to the eye the video layer
+ * shows next, in the armed VPP0 table: on a new eye generation, or always
+ * (force) right after a commit armed a table built with an older eye.
+ * Under osd_fa_lock, which is taken before rdma_lock.
+ */
+static void osd_fa_update_locked(bool force)
+{
+	u32 adr[2 * MESON_MAX_OSDS], val[2 * MESON_MAX_OSDS];
+	struct osd_scope_s s;
+	int eye, i, n = 0;
+	u32 gen;
+
+	for (i = 0; i < MESON_MAX_OSDS; i++)
+		if (osd_fa[i].valid)
+			break;
+	if (i == MESON_MAX_OSDS)
+		return;
+	eye = amvideo_get_fa_eye(&gen);
+	if (eye < 0 || (!force && gen == osd_fa_gen))
+		return;
+	osd_fa_gen = gen;
+	if (eye > 1)
+		return;			/* blank frame: keep the last eye */
+	osd_fa_eye = eye;
+	for (i = 0; i < MESON_MAX_OSDS; i++) {
+		if (!osd_fa[i].valid)
+			continue;
+		s = osd_fa_scope(&osd_fa[i], eye);
+		adr[n] = osd_fa[i].w1_reg;
+		val[n++] = (s.h_end << 16) | s.h_start;
+		adr[n] = osd_fa[i].w2_reg;
+		val[n++] = (s.v_end << 16) | s.v_start;
+	}
+	if (n)
+		meson_vpu_patch_regs(0, adr, val, n);
+}
+
+static void osd_fa_update(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&osd_fa_lock, flags);
+	osd_fa_update_locked(false);
+	spin_unlock_irqrestore(&osd_fa_lock, flags);
+}
+
+/* from the VPU vsync irq */
+void meson_osd_fa_vsync(int crtc_index)
+{
+	if (crtc_index == 0)
+		osd_fa_update();
+}
+
+/* from the video vsync irq, right after it chose the next frame's eye */
+static void meson_osd_fa_notify(void)
+{
+	osd_fa_update();
+}
+
+/*
+ * Arm the VPP0 table a commit built, under osd_fa_lock so no hook moves it
+ * by the previous layout: its blocks become the ones the hooks move, and the
+ * window is set again for the current eye, which was sampled when the table
+ * was built.
+ */
+int meson_osd_fa_arm_vpp0(void)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&osd_fa_lock, flags);
+#ifdef CONFIG_AMLOGIC_MEDIA_RDMA
+	ret = meson_vpu_reg_vsync_config(0);
+#endif
+	memcpy(osd_fa, osd_fa_next, sizeof(osd_fa));
+	osd_fa_update_locked(true);
+	spin_unlock_irqrestore(&osd_fa_lock, flags);
+	return ret;
+}
+
+void meson_osd_fa_attach(bool on)
+{
+	amvideo_set_fa_notify(on ? meson_osd_fa_notify : NULL);
+}
+
 static void osd_set_state(struct meson_vpu_block *vblk,
 			  struct meson_vpu_block_state *state,
 			  struct meson_vpu_block_state *old_state)
@@ -1498,6 +1654,8 @@ static void osd_set_state(struct meson_vpu_block *vblk,
 		process_unit = mvos->process_unit;
 		if (process_unit == GFCD_AFBC || process_unit == GFCD_AFRC) {
 			MESON_DRM_BLOCK("set gfcd %d.\n", process_unit);
+			/* the frame-sequential GUI moves the MIF window only */
+			osd_fa_drop(vblk->index);
 			osd_gfcd_axi_input_en(vblk, reg_ops, reg, vblk->index, 1);
 			osd_gfcd_dout_en(vblk, reg_ops, reg, vblk->index, 1);
 			if (osd->mali_src_en_switch)
@@ -1518,6 +1676,9 @@ static void osd_set_state(struct meson_vpu_block *vblk,
 
 	flush_reg = osd_check_config(mvos, old_mvos);
 	MESON_DRM_BLOCK("flush_reg-%d index-%d\n", flush_reg, vblk->index);
+	/* frame-sequential 3D needs the window in every table, to move it */
+	if (mvos->fa_mode)
+		flush_reg = 1;
 	if (!flush_reg &&
 		meson_drm_read_reg(reg->viu_osd_tcolor_ag3) == frame_seq[vblk->index]) {
 		/*after v7 chips, always linear addr*/
@@ -1543,6 +1704,9 @@ static void osd_set_state(struct meson_vpu_block *vblk,
 		global_alpha = 0x100;
 
 	src_h = mvos->src_h + mvos->src_y;
+	/* frame-sequential 3D: the second eye lies below the scanned-out half */
+	if (mvos->fa_mode)
+		src_h = max(src_h, mvos->fb_h);
 	byte_stride = mvos->byte_stride;
 	if (osd->mif_acc_mode == LINEAR_MIF)
 		byte_stride = line_stride_calc(mvos->pixel_format,
@@ -1582,6 +1746,37 @@ static void osd_set_state(struct meson_vpu_block *vblk,
 		osd_canvas_index[vblk->index] ^= 1;
 	}
 
+	if (vblk->index < MESON_MAX_OSDS &&
+	    (osd_fa_next[vblk->index].valid || mvos->fa_mode)) {
+		struct osd_fa_block *b = &osd_fa_next[vblk->index];
+		bool vertical = mvos->fa_mode == 2;
+		u32 shift = mvos->fa_shift;
+		unsigned long flags;
+		bool fits;
+		int eye;
+
+		/* the second eye's window has to stay inside the framebuffer */
+		fits = vertical ? scope_src.v_end + shift < mvos->fb_h :
+				  scope_src.h_end + shift < mvos->fb_w;
+		spin_lock_irqsave(&osd_fa_lock, flags);
+		b->valid = mvos->fa_mode && crtc_index == 0 && shift && fits &&
+			   !mvsps->more_60;
+		if (b->valid) {
+			eye = amvideo_get_fa_eye(NULL);
+			if (eye == 0 || eye == 1)
+				osd_fa_eye = eye;
+			else if (eye < 0)
+				osd_fa_eye = 0;	/* video in 2D: the first eye */
+			b->vertical = vertical;
+			b->shift = shift;
+			b->w1_reg = reg->viu_osd_blk0_cfg_w1;
+			b->w2_reg = reg->viu_osd_blk0_cfg_w2;
+			b->scope = scope_src;
+			scope_src = osd_fa_scope(b, osd_fa_eye);
+		}
+		spin_unlock_irqrestore(&osd_fa_lock, flags);
+	}
+
 	osd_rpt_y_config(vblk, reg_ops, reg);
 	osd_input_size_config(vblk, reg_ops, reg, scope_src);
 	osd_color_config(vblk, reg_ops, reg, pixel_format, mvos->pixel_blend, afbc_en);
@@ -1655,6 +1850,7 @@ static void osd_hw_disable(struct meson_vpu_block *vblk,
 	reg = osd->reg;
 	version = vblk->pipeline->osd_version;
 
+	osd_fa_drop(vblk->index);
 	/*G12B should always enable,avoid afbc decoder error*/
 	if (version != OSD_V2 && version != OSD_V3)
 		osd_block_enable(vblk, state->sub->reg_ops, reg, 0);
diff --git a/drivers/media/common/rdma/rdma_mgr.c b/drivers/media/common/rdma/rdma_mgr.c
index e2f77d1..94ac2c8 100644
--- a/drivers/media/common/rdma/rdma_mgr.c
+++ b/drivers/media/common/rdma/rdma_mgr.c
@@ -1430,6 +1430,40 @@ int rdma_write_reg(int handle, u32 adr, u32 val)
 }
 EXPORT_SYMBOL(rdma_write_reg);
 
+/*
+ * Rewrite in place the values the armed table gives registers adr[0..n-1]. A
+ * vsync table is replayed every vsync until the next rdma_config(), so the
+ * new values go out from the next vsync on. One pass over the table; returns
+ * how many entries were rewritten.
+ */
+int rdma_table_patch_regs(int handle, const u32 *adr, const u32 *val, int n)
+{
