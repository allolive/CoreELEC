From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: allolive <160342668+allolive@users.noreply.github.com>
Date: Fri, 18 Sep 2026 17:00:00 -0400
Subject: [PATCH] FileCache: a stalled source is not the end of the file

A source that stops answering is turned into zero bytes here, and everything
above reads that as the end of the file. Playback then ends on a share that is
only slow.

Pass the stall on instead. Only a clean zero or a real error end the file now.

Signed-off-by: allolive <160342668+allolive@users.noreply.github.com>

diff --git a/xbmc/filesystem/FileCache.cpp b/xbmc/filesystem/FileCache.cpp
index f9f8b52..105e8b3 100644
--- a/xbmc/filesystem/FileCache.cpp
+++ b/xbmc/filesystem/FileCache.cpp
@@ -25,6 +25,7 @@
 
 #include <algorithm>
 #include <cassert>
+#include <cerrno>
 #include <inttypes.h>
 #include <memory>
 #include <stdexcept>
@@ -410,8 +411,10 @@ void CFileCache::Process()
       iRead = m_source->Read(buffer.get(), maxSourceRead);
     if (iRead <= 0)
     {
-      // Check for actual EOF and retry as long as we still have data in our cache
-      if (m_writePos < m_fileSize && m_pCache->WaitForData(0, 0ms) > 0)
+      // A source that can answer a later read says so with -EAGAIN, whatever length
+      // it advertised, so a stalled live or chunked stream is retried too. Anything
+      // else is the source's own answer and keeps the stock test.
+      if (iRead == -EAGAIN || (m_writePos < m_fileSize && m_pCache->WaitForData(0, 0ms) > 0))
       {
         CLog::Log(LOGWARNING, "CFileCache::{} - <{}> source read returned {}! Will retry",
                   __FUNCTION__, m_sourcePath, iRead);
@@ -554,6 +557,11 @@ retry:
   iRc = m_pCache->ReadFromCache((char *)lpBuf, uiBufSize);
   if (iRc > 0)
   {
+    if (m_readStalled)
+    {
+      CLog::Log(LOGINFO, "CFileCache::{} - <{}> source resumed", __FUNCTION__, m_sourcePath);
+      m_readStalled = false;
+    }
     m_readPos += iRc;
     return (int)iRc;
   }
@@ -566,15 +574,29 @@ retry:
       return -1;
     }
 
-    // just wait for some data to show up
-    iRc = m_pCache->WaitForData(1, 10s);
+    // The player decides whether to buffer between reads, so a read that parks
+    // for ten seconds on a stalled source takes those decisions with it.
+    iRc = m_pCache->WaitForData(1, 1s);
     if (iRc > 0)
       goto retry;
+
     if (!m_sourcePositionValid)
     {
       SetLastError(m_seekError != 0 ? m_seekError : EIO);
       return -1;
     }
+
+    // Nothing arrived and the source has not reported the end of the file, so it
+    // has stalled. Say that, instead of the zero bytes every caller reads as EOF.
+    if (!m_pCache->IsEndOfInput())
+    {
+      if (!m_readStalled)
+        CLog::Log(LOGWARNING, "CFileCache::{} - <{}> source stalled, no data to read",
+                  __FUNCTION__, m_sourcePath);
+      m_readStalled = true;
+      SetLastError(EAGAIN);
+      return -1;
+    }
   }
 
   if (iRc == CACHE_RC_TIMEOUT)
@@ -611,6 +633,8 @@ int64_t CFileCache::Seek(int64_t iFilePosition, int iWhence)
     return -1;
   }
 
+  m_readStalled = false;
+
   int64_t iCurPos = m_readPos;
   int64_t iTarget = iFilePosition;
   if (iWhence == SEEK_END)
@@ -727,6 +751,7 @@ int CFileCache::IoControl(IOControl request, void* param)
     status->maxrate = m_writeRate;
     status->currate = m_writeRateActual;
     status->lowrate = m_writeRateLowSpeed;
+    status->endOfInput = m_pCache->IsEndOfInput();
     m_writeRateLowSpeed = 0; // Reset low speed condition
     return 0;
   }
diff --git a/xbmc/filesystem/FileCache.h b/xbmc/filesystem/FileCache.h
index c5cb97a..0a9de08 100644
--- a/xbmc/filesystem/FileCache.h
+++ b/xbmc/filesystem/FileCache.h
@@ -109,6 +109,7 @@ public:
     int64_t m_forwardCacheSize = 0;
     int64_t m_maxForward = 0;
     bool m_bFilling = false;
+    bool m_readStalled = false;
     std::atomic<int64_t> m_fileSize;
     unsigned int m_flags;
     CCriticalSection m_sync;
