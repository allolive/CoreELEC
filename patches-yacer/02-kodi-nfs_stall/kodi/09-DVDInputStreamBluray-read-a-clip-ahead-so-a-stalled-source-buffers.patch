+#pragma once
+
+#include "threads/CriticalSection.h"
+#include "threads/SystemClock.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <libbluray/bluray.h>
+#include <libbluray/filesystem.h>
+
+namespace XFILE
+{
+class CFile;
+struct SCacheStatus;
+} // namespace XFILE
+
+/*!
+ * \brief Reads the clips of a Blu-ray played from a folder or an image through the file cache.
+ *
+ * libbluray reads its clips on the player thread. Read ahead, a share that stops answering is a
+ * cache running dry, which the player buffers over, rather than a read that blocks with the clock
+ * running. The next play item's file is opened ahead of the join, off the player thread.
+ */
+class CBlurayClipReader
+{
+public:
+  //! A clip's entry points: the time of each (90 kHz) and its offset in the .m2ts, in order
+  using EntryPoints = std::vector<std::pair<int64_t, int64_t>>;
+
+  //! aborted: set when the player stops, a read waits out a stalled source until then
+  explicit CBlurayClipReader(const std::atomic<bool>& aborted);
+  ~CBlurayClipReader();
+
+  //! A disc read through Kodi's filesystem, at rootPath
+  void Open(std::string rootPath);
+  void Close();
+  //! The play item libbluray reads, in the playlist it plays
+  void SetPlayItem(BLURAY* bd, int playItem, unsigned int angle);
+  //! Open a clip (.m2ts) of the disc for libbluray
+  BD_FILE_H* OpenFile(const std::string& path);
+  //! The read ahead of the clip being played; false without one
+  bool GetCacheStatus(XFILE::SCacheStatus* status);
+  //! The title's average rate, in bytes per second
+  void SetReadRate(uint32_t rate);
+
+private:
+  struct ClipFile
+  {
+    //! libbluray closes its clips, so they are not kept open here
+    std::weak_ptr<XFILE::CFile> file;
+    bool filled{false};
+  };
+
+  //! The play item after the one read, opened before the join where it starts in its .m2ts:
+  //! libbluray closes the file it reads at every join, and opens the next play item's again
+  struct NextClip
+  {
+    int playItem{-1};
+    std::string name;
+    std::shared_ptr<XFILE::CFile> file;
+  };
+
+  //! The opens of the next play item's files, run off the player thread: on a share that
+  //! stopped answering they wait for as long as it is gone
+  struct PrefetchJob
+  {
+    CCriticalSection lock;
+    bool done{false};
+    bool failed{false};
+    NextClip next;
+    std::string path;
+    int64_t start{0};
+    //! how long the player plays on before it waits for the job
+    XbmcThreads::EndTime<> grace{std::chrono::seconds(1)};
+  };
+
+  struct Clip
+  {
+    std::string id;
+    int64_t inTime{0};
+    int64_t outTime{0};
+    bool operator==(const Clip&) const = default;
+  };
+
+  void SetClipReadRate(XFILE::CFile& file) const;
+  void PrefetchNextClip(const std::shared_ptr<XFILE::CFile>& playing, int64_t cached);
+  bool TakePrefetchJob(int nextPlayItem);
+  static void RunPrefetchJob(const std::shared_ptr<PrefetchJob>& job);
+  bool NextClipReady() const;
+  void GiveUpNextClip(int playItem);
+  void DropPrefetchJob();
+  //! where a play item starts and ends in its .m2ts, -1 where it is not known
+  std::pair<int64_t, int64_t> GetPlayItemSpan(int playItem) const;
+
+  std::string m_rootPath;
+  const std::atomic<bool>& m_aborted;
+
+  BLURAY* m_bd{nullptr};
+  std::vector<Clip> m_clips;
+  int m_playItem{0};
+  int64_t m_playItemEnd{-1};
+
+  //! The clips libbluray opened, latest last
+  std::vector<ClipFile> m_clipFiles;
+  uint32_t m_readRate{0};
+  CCriticalSection m_clipFilesLock;
+
+  NextClip m_nextClip;
+  XbmcThreads::EndTime<> m_nextClipRetry;
+  int m_nextClipFailures{0};
+
+  //! guards m_prefetchJob against Abort
+  CCriticalSection m_prefetchJobLock;
+  std::shared_ptr<PrefetchJob> m_prefetchJob;
+};
