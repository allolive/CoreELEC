+#include "BlurayClipReader.h"
+
+#include "URL.h"
+#include "filesystem/BlurayCallback.h"
+#include "filesystem/File.h"
+#include "filesystem/IFileTypes.h"
+#include "utils/StringUtils.h"
+#include "utils/URIUtils.h"
+#include "utils/log.h"
+
+#include <algorithm>
+#include <cstring>
+#include <mutex>
+#include <thread>
+
+#include <libbluray/clpi_data.h>
+#include <libbluray/mpls_data.h>
+
+using namespace std::chrono_literals;
+
+namespace
+{
+// A play item's file is read ahead from a little before its entry point: libbluray seeks to the
+// start of the aligned unit before it
+constexpr int64_t NEXT_CLIP_MARGIN{1024 * 1024};
+// opens of the next play item that fail before the join opens it as it can
+constexpr int NEXT_CLIP_ATTEMPTS{5};
+
+// An entry point map's entry points: the time of each (90 kHz) and its offset in the .m2ts
+CBlurayClipReader::EntryPoints EntryPointsOf(const CLPI_EP_MAP_ENTRY& map)
+{
+  CBlurayClipReader::EntryPoints entryPoints;
+  entryPoints.reserve(map.num_ep_fine);
+  for (int coarse = 0; coarse < map.num_ep_coarse; ++coarse)
+  {
+    const int end{coarse + 1 < map.num_ep_coarse ? map.coarse[coarse + 1].ref_ep_fine_id
+                                                 : map.num_ep_fine};
+    for (int fine = map.coarse[coarse].ref_ep_fine_id; fine < end && fine < map.num_ep_fine;
+         ++fine)
+    {
+      // 45 kHz, and 192 byte source packets
+      const uint32_t pts{(static_cast<uint32_t>(map.coarse[coarse].pts_ep & ~0x01) << 18) +
+                         (static_cast<uint32_t>(map.fine[fine].pts_ep) << 8)};
+      const uint32_t spn{(map.coarse[coarse].spn_ep & ~0x1FFFFu) +
+                         static_cast<uint32_t>(map.fine[fine].spn_ep)};
+      entryPoints.emplace_back(int64_t{pts} * 2, int64_t{spn} * 192);
+    }
+  }
+  return entryPoints;
+}
+
+// the offset of the last entry point at or before time, 0 if there is none
+int64_t EntryPointAt(const CBlurayClipReader::EntryPoints& entryPoints, int64_t time)
+{
+  int64_t offset{0};
+  for (const auto& [pointTime, pointOffset] : entryPoints)
+  {
+    if (pointTime > time)
+      break;
+    offset = pointOffset;
+  }
+  return offset;
+}
+} // namespace
+
+CBlurayClipReader::CBlurayClipReader(const std::atomic<bool>& aborted) : m_aborted(aborted)
+{
+}
+
+CBlurayClipReader::~CBlurayClipReader()
+{
+  DropPrefetchJob();
+}
+
+void CBlurayClipReader::Open(std::string rootPath)
+{
+  m_rootPath = std::move(rootPath);
+}
+
+void CBlurayClipReader::Close()
+{
+  DropPrefetchJob();
+  m_bd = nullptr;
+  m_clips.clear();
+  m_playItem = 0;
+  m_playItemEnd = -1;
+  m_nextClipFailures = 0;
+  std::unique_lock lock(m_clipFilesLock);
+  m_clipFiles.clear();
+  m_nextClip = {};
+}
+
+// The playlist's play items are taken from libbluray at every one, so a new playlist or angle
+// is seen at its first
+void CBlurayClipReader::SetPlayItem(BLURAY* bd, int playItem, unsigned int angle)
+{
+  std::vector<Clip> clips;
+  if (const MPLS_PL* pl = bd_get_title_mpls(bd))
+  {
+    for (int i = 0; i < pl->list_count; ++i)
+    {
+      const MPLS_PI& item{pl->play_item[i]};
+      const MPLS_CLIP& clip{item.clip[angle < item.angle_count ? angle : 0]};
+      // 45 kHz
+      clips.push_back({std::string(clip.clip_id, strnlen(clip.clip_id, sizeof(clip.clip_id))),
+                       int64_t{item.in_time} * 2, int64_t{item.out_time} * 2});
+    }
+  }
+  m_bd = bd;
+  if (clips != m_clips)
+  {
+    m_clips = std::move(clips);
+    m_nextClipFailures = 0;
+    {
+      std::unique_lock lock(m_clipFilesLock);
+      m_nextClip = {};
+    }
+    DropPrefetchJob();
+  }
+  m_playItem = playItem;
+  m_playItemEnd = GetPlayItemSpan(playItem).second;
+}
+
+BD_FILE_H* CBlurayClipReader::OpenFile(const std::string& path)
+{
+  // a job done since the player last asked
+  TakePrefetchJob(m_playItem + 1);
+
+  std::unique_lock lock(m_clipFilesLock);
+  std::erase_if(m_clipFiles, [](const auto& clip) { return clip.file.expired(); });
+
+  // the clip opened ahead of the join, already filling; or not the one libbluray went to
+  std::shared_ptr<XFILE::CFile> file;
+  if (m_nextClip.file &&
+      StringUtils::EqualsNoCase(URIUtils::GetFileName(path), m_nextClip.name))
+    file = std::move(m_nextClip.file);
+  else
+    m_nextClip = {};
+
+  // A clip is read ahead as any video is, so the player sees a stalled source run dry and
+  // buffers, rather than block in libbluray with the clock running
+  if (!file)
+  {
+    file = std::make_shared<XFILE::CFile>();
+    if (!file->Open(path, XFILE::READ_AUDIO_VIDEO))
+    {
+      CLog::Log(LOGDEBUG, "CBlurayClipReader - cannot open {}", CURL::GetRedacted(path));
+      return nullptr;
+    }
+    SetClipReadRate(*file);
+  }
+  m_clipFiles.push_back({file});
+  return CBlurayCallback::OpenFile(std::move(file), &m_aborted);
+}
+
+bool CBlurayClipReader::GetCacheStatus(XFILE::SCacheStatus* status)
+{
+  std::shared_ptr<XFILE::CFile> playing;
+  bool filled{false};
+  {
+    // The clip being played: a clip preloaded for its menus or subtitles is closed at once
+    std::unique_lock lock(m_clipFilesLock);
+    for (auto clip = m_clipFiles.rbegin(); clip != m_clipFiles.rend() && !playing; ++clip)
+    {
+      playing = clip->file.lock();
+      if (!playing)
+        continue;
+      if (playing->IoControl(XFILE::IOControl::CACHE_STATUS, status) < 0)
+        return false;
+
+      // A clip opened at a join starts empty while the one before it still plays from the
+      // player's queues. Until it has filled once, an empty cache is no stall.
+      if (!clip->filled)
+        clip->filled = status->endOfInput || m_readRate == 0 || status->forward >= m_readRate;
+      filled = clip->filled;
+    }
+  }
+  if (!playing)
+    return false;
+
+  // The rest of the play item is cached, so the next one is read ahead from here, or a stall
+  // in the last of this one would only show at the join
+  const int64_t cached{playing->GetPosition() + static_cast<int64_t>(status->forward)};
+  if (status->endOfInput || (m_playItemEnd >= 0 && cached >= m_playItemEnd))
+  {
+    PrefetchNextClip(playing, cached);
+
+    // Not open yet, as on a share that stopped answering: the rest of this play item is all
+    // there is, so the player buffers before the join, where the open would block it. A job
+    // just started is given a second.
+    if (!NextClipReady() && (!m_prefetchJob || m_prefetchJob->grace.IsTimePast()))
+    {
+      status->endOfInput = false;
+      if (m_playItemEnd >= 0)
+        status->forward = static_cast<uint64_t>(std::clamp<int64_t>(
+            m_playItemEnd - playing->GetPosition(), 0, static_cast<int64_t>(status->forward)));
+    }
+  }
+
+  return filled;
+}
+
+void CBlurayClipReader::PrefetchNextClip(const std::shared_ptr<XFILE::CFile>& playing,
+                                         int64_t cached)
+{
+  const int nextPlayItem{m_playItem + 1};
+  if (nextPlayItem >= static_cast<int>(m_clips.size()))
+    return;
+
+  if (!TakePrefetchJob(nextPlayItem))
+    return;
+
+  // an open that failed, as it does on a share that stopped answering, is tried again
+  if (!m_nextClipRetry.IsTimePast())
+    return;
+
+  std::shared_ptr<PrefetchJob> job;
+  if (m_nextClip.playItem != nextPlayItem)
+  {
+    const std::string name{m_clips[nextPlayItem].id + ".m2ts"};
+    const int64_t start{
+        std::max<int64_t>(0, GetPlayItemSpan(nextPlayItem).first - NEXT_CLIP_MARGIN)};
+
+    // in the file being read, and cached already: that cache is kept for it
+    if (StringUtils::EqualsNoCase(m_clips[nextPlayItem].id, m_clips[m_playItem].id) &&
+        start >= playing->GetPosition() && start <= cached)
+    {
+      std::unique_lock lock(m_clipFilesLock);
+      m_nextClip = {nextPlayItem, name, playing};
+    }
+    else
+    {
+      job = std::make_shared<PrefetchJob>();
+      job->next = {nextPlayItem, name, nullptr};
+      job->path = URIUtils::AddFileToFolder(m_rootPath, "BDMV", "STREAM", name);
+      job->start = start;
+    }
+  }
+
+  if (!job)
+    return;
+  if (m_aborted)
+    return;
+  {
+    std::unique_lock lock(m_prefetchJobLock);
+    m_prefetchJob = job;
+  }
+  std::thread([job] { RunPrefetchJob(job); }).detach();
+}
+
+// The last job's files, once it is done: false while it runs
+bool CBlurayClipReader::TakePrefetchJob(int nextPlayItem)
+{
+  if (!m_prefetchJob)
+    return true;
+  {
+    std::unique_lock lock(m_prefetchJob->lock);
+    if (!m_prefetchJob->done)
+      return false;
+  }
+
+  std::shared_ptr<PrefetchJob> job;
+  {
+    std::unique_lock lock(m_prefetchJobLock);
+    job = std::exchange(m_prefetchJob, nullptr);
+  }
+  if (job->failed)
+  {
+    m_nextClipRetry.Set(1s);
+    // A share that answers, and a file that cannot be opened: a stalled open does not fail
+    if (++m_nextClipFailures >= NEXT_CLIP_ATTEMPTS)
+      GiveUpNextClip(nextPlayItem);
+  }
+  else
+    m_nextClipFailures = 0;
+  if (job->next.file && job->next.playItem == nextPlayItem)
+  {
+    SetClipReadRate(*job->next.file);
+    std::unique_lock lock(m_clipFilesLock);
+    m_nextClip = std::move(job->next);
+  }
+  return true;
+}
+
+void CBlurayClipReader::RunPrefetchJob(const std::shared_ptr<PrefetchJob>& job)
+{
+  bool failed{false};
+  if (!job->path.empty())
+  {
+    auto file{std::make_shared<XFILE::CFile>()};
+    if (file->Open(job->path, XFILE::READ_AUDIO_VIDEO) && file->Seek(job->start) == job->start)
+    {
+      std::unique_lock lock(job->lock);
+      job->next.file = std::move(file);
+    }
+    else
+      failed = true;
+  }
+
+  std::unique_lock lock(job->lock);
+  job->failed = failed;
+  job->done = true;
+}
+
+// the join opens the play item's files itself, as before they were opened ahead
+void CBlurayClipReader::GiveUpNextClip(int playItem)
+{
+  CLog::Log(LOGDEBUG, "CBlurayClipReader - play item {} could not be opened ahead", playItem);
+  m_nextClipFailures = 0;
+  std::unique_lock lock(m_clipFilesLock);
+  if (m_nextClip.playItem != playItem)
+    m_nextClip = {playItem, {}, nullptr};
+}
+
+// the next play item's files are open, or there is none
+bool CBlurayClipReader::NextClipReady() const
+{
+  const int nextPlayItem{m_playItem + 1};
+  return nextPlayItem >= static_cast<int>(m_clips.size()) || m_nextClip.playItem == nextPlayItem;
+}
+
+// A job left running ends on its own, its files with it: a stalled open must not hold anything
+void CBlurayClipReader::DropPrefetchJob()
+{
+  std::unique_lock lock(m_prefetchJobLock);
+  m_prefetchJob.reset();
+}
+
+std::pair<int64_t, int64_t> CBlurayClipReader::GetPlayItemSpan(int playItem) const
+{
+  if (!m_bd || playItem < 0 || playItem >= static_cast<int>(m_clips.size()))
+    return {-1, -1};
+
+  // a copy of what libbluray read when it opened the title, so this costs no disc access
+  clpi_cl* clipInfo{bd_get_clpi(m_bd, playItem)};
+  if (!clipInfo)
+    return {-1, -1};
+  // the video's, the first stream's
+  const CLPI_CPI& cpi{clipInfo->cpi};
+  const EntryPoints entryPoints{cpi.num_stream_pid > 0 && cpi.entry ? EntryPointsOf(cpi.entry[0])
+                                                                    : EntryPoints{}};
+  bd_free_clpi(clipInfo);
+  if (entryPoints.empty())
+    return {-1, -1};
+
+  return {EntryPointAt(entryPoints, m_clips[playItem].inTime),
+          EntryPointAt(entryPoints, m_clips[playItem].outTime)};
+}
+
+void CBlurayClipReader::SetReadRate(uint32_t rate)
+{
+  std::unique_lock lock(m_clipFilesLock);
+  m_readRate = rate;
+  for (const auto& clip : m_clipFiles)
+  {
+    if (const auto file{clip.file.lock()})
+      SetClipReadRate(*file);
+  }
+}
+
+void CBlurayClipReader::SetClipReadRate(XFILE::CFile& file) const
+{
+  if (m_readRate == 0)
+    return;
+
+  // as CDVDInputStreamFile does: the title's rate, and a tenth more
+  uint32_t maxrate{static_cast<uint32_t>(1.1 * m_readRate)};
+  file.IoControl(XFILE::IOControl::CACHE_SETRATE, &maxrate);
+}
