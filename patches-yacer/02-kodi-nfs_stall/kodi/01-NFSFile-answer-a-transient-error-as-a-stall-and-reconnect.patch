From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: allolive <160342668+allolive@users.noreply.github.com>
Date: Fri, 18 Sep 2026 17:00:00 -0400
Subject: [PATCH] NFSFile: answer a transient error as a stall, and reconnect

When a share drops the connection the read fails, but that is not the end of
the file. Say -EAGAIN for the errors a retry can fix, and reopen the file where
the reader got to.

Reopening remounts the share, and every NFS file shares that mount, so doing it
while the server is down takes playback with it. Check the server is answering
first, and until it does, keep answering -EAGAIN.

The reconnect used to tear the whole connection down (gNfsConnection.Deinit),
which destroys every open libnfs context, including the ones other open files
(the library scan, thumbnails, a second reader) were still reading through:
their handles pointed into freed memory. A reconnect now leaves the shared
context alone. It drops its own handle from the keep-alive list, mounts a
context of its own for the export and reopens the file on it. That context is
kept apart from the shared ones, under a key no other file uses: the NFSv4
keep-alive finds it (and runs while only such contexts are open), but
Deinit() and its teardown of every shared context do not free it. It is
destroyed with the file on Close or on the next reconnect. GetPosition asks
the file's own context, not the shared one, since the two can now differ. If
the reopened file cannot be positioned where the reader was, it is closed
again, rather than read from its start as if from that position.

Open() had the same bug in upstream code: on NFS4ERR_EXPIRED it called
Deinit(), freeing the contexts and handles of every other open file, and
then opened through the connection's context, which Deinit() had just reset.
It belongs with this fix: Open() now retries on a context of its own, as a
reconnect does, and leaves the others alone. The size and the directory check
then come from the open handle (nfs_fstat64): Stat() goes through the shared
context whose lease just expired, and would fail the open after all. The
expired shared context itself is left in place; it is rebuilt when it times
out, and files still on it reconnect on their own.

Not fixed: the handle on the old context is dropped, not closed. Closing it
is a round trip on a connection that has just failed and would hold the
reader for the RPC timeout, and libnfs has no call that frees a handle
without closing it; the server drops its open state with the lease. The
reconnect's log line counts the handles a file has let go of this way.

Signed-off-by: allolive <160342668+allolive@users.noreply.github.com>

diff --git a/xbmc/filesystem/NFSFile.cpp b/xbmc/filesystem/NFSFile.cpp
index 3242b96..2cef1a1 100644
--- a/xbmc/filesystem/NFSFile.cpp
+++ b/xbmc/filesystem/NFSFile.cpp
@@ -12,6 +12,10 @@
 
 #include "NFSFile.h"
 
+#include <netdb.h>
+#include <poll.h>
+#include <sys/socket.h>
+
 #include "ServiceBroker.h"
 #include "network/DNSNameCache.h"
 #include "settings/AdvancedSettings.h"
@@ -21,6 +25,7 @@
 #include "utils/URIUtils.h"
 #include "utils/log.h"
 
+#include <cerrno>
 #include <inttypes.h>
 #include <mutex>
 
@@ -55,9 +60,43 @@ namespace
 constexpr auto CONTEXT_TIMEOUT = 60s; // 2/3 parts of lease_time
 constexpr auto KEEP_ALIVE_TIMEOUT = 45s; // half of lease_time
 constexpr auto IDLE_TIMEOUT = 30s; // close fast unused contexts when no active connections
+// A share that is down stays down for a while; asking more often only costs
+// mounts. Long enough not to hammer it, short enough not to be noticed.
+constexpr auto RECONNECT_INTERVAL = 2s;
+// The reachability probe is only there to avoid mounting into a dead server, so
+// it must give up quickly and never become the stall itself.
+constexpr auto PROBE_TIMEOUT = 1s;
 
 constexpr int NFS4ERR_EXPIRED = -11; // client session expired due idle time greater than lease_time
 
+// libnfs hands back the RPC layer's verdict: a transport failure as -EFAULT, a
+// cancelled call as -EINTR, NFS3ERR_JUKEBOX as -EAGAIN, and a server that stopped
+// answering as one of the socket errors. A later read can succeed after any of
+// them; the file's own answers stand.
+bool IsTransientReadError(ssize_t err)
+{
+  switch (-err)
+  {
+    case EAGAIN:
+    case EINTR:
+    case EFAULT:
+    case EIO:
+    case EPIPE:
+    case ETIMEDOUT:
+    case ECONNRESET:
+    case ECONNABORTED:
+    case ECONNREFUSED:
+    case ENETDOWN:
+    case ENETRESET:
+    case ENETUNREACH:
+    case EHOSTDOWN:
+    case EHOSTUNREACH:
+      return true;
+    default:
+      return false;
+  }
+}
+
 constexpr auto SETTING_NFS_VERSION = "nfs.version";
 constexpr auto SETTING_NFS_CHUNKSIZE = "nfs.chunksize";
 } // unnamed namespace
@@ -177,6 +216,12 @@ struct nfs_context *CNfsConnection::getContextFromMap(const std::string &exportn
       m_openContextMap.erase(it);
     }
   }
+  else if (auto own = m_privateContextMap.find(exportname); own != m_privateContextMap.end())
+  {
+    // a file's own context lives as long as the file
+    own->second.lastAccessedTime = std::chrono::steady_clock::now();
+    pRet = own->second.pContext;
+  }
   return pRet;
 }
 
@@ -380,6 +425,50 @@ bool CNfsConnection::Connect(const CURL& url, std::string &relativePath)
   return ret;
 }
 
+struct nfs_context* CNfsConnection::OpenPrivateContext(const CURL& url,
+                                                       std::string& relativePath,
+                                                       std::string& mapId)
+{
+  std::unique_lock lock(*this);
+  std::string exportPath;
+
+  resolveHost(url);
+  if (!splitUrlIntoExportAndPath(url, exportPath, relativePath))
+    return nullptr;
+
+  struct nfs_context* context = nfs_init_context();
+  if (!context)
+    return nullptr;
+  setOptions(context);
+
+  if (nfs_mount(context, m_resolvedHostName.c_str(), exportPath.c_str()) != 0)
+  {
+    CLog::Log(LOGERROR, "NFS: Failed to mount nfs share: {} ({})", exportPath,
+              nfs_get_error(context));
+    nfs_destroy_context(context);
+    return nullptr;
+  }
+
+  mapId = StringUtils::Format("{}{}#{}", url.GetHostName(), exportPath,
+                              static_cast<const void*>(context));
+  std::unique_lock contextLock(openContextLock);
+  m_privateContextMap[mapId] = {context, std::chrono::steady_clock::now()};
+  m_privateContexts = m_privateContextMap.size();
+  return context;
+}
+
+void CNfsConnection::DestroyPrivateContext(const std::string& mapId)
+{
+  std::unique_lock lock(openContextLock);
+  auto it = m_privateContextMap.find(mapId);
+  if (it != m_privateContextMap.end())
+  {
+    nfs_destroy_context(it->second.pContext);
+    m_privateContextMap.erase(it);
+  }
+  m_privateContexts = m_privateContextMap.size();
+}
+
 void CNfsConnection::Deinit()
 {
   if(m_pNfsContext)
@@ -412,7 +501,8 @@ void CNfsConnection::CheckIfIdle()
     }
   }
 
-  if( m_pNfsContext != NULL )
+  // a file on a context of its own needs its lease kept with no shared one open
+  if (m_pNfsContext != NULL || m_privateContexts > 0)
   {
     std::unique_lock lock(keepAliveLock);
 
@@ -606,13 +696,13 @@ int64_t CNFSFile::GetPosition()
   uint64_t offset = 0;
   std::unique_lock lock(gNfsConnection);
 
-  if (gNfsConnection.GetNfsContext() == NULL || m_pFileHandle == NULL) return 0;
+  if (m_pNfsContext == NULL || m_pFileHandle == NULL) return 0;
 
-  ret = nfs_lseek(gNfsConnection.GetNfsContext(), m_pFileHandle, 0, SEEK_CUR, &offset);
+  ret = nfs_lseek(m_pNfsContext, m_pFileHandle, 0, SEEK_CUR, &offset);
 
   if (ret < 0)
   {
-    CLog::Log(LOGERROR, "NFS: Failed to lseek({})", nfs_get_error(gNfsConnection.GetNfsContext()));
+    CLog::Log(LOGERROR, "NFS: Failed to lseek({})", nfs_get_error(m_pNfsContext));
   }
   return offset;
 }
@@ -652,17 +742,28 @@ bool CNFSFile::Open(const CURL& url)
               "CNFSFile::Open: Unable to open file - trying again with a new context: error: '{}'",
               nfs_get_error(m_pNfsContext));
 
-    gNfsConnection.Deinit();
-    m_pNfsContext = gNfsConnection.GetNfsContext();
-    m_exportPath = gNfsConnection.GetContextMapId();
-    ret = nfs_open(m_pNfsContext, filename.c_str(), O_RDONLY, &m_pFileHandle);
+    // A context of its own: tearing the connection down (Deinit) would free the
+    // contexts and handles every other open file is reading through.
+    std::string mapId;
+    std::string privateName;
+    m_pNfsContext = gNfsConnection.OpenPrivateContext(url, privateName, mapId);
+    if (m_pNfsContext)
+    {
+      m_exportPath = mapId;
+      m_privateContext = true;
+      ret = nfs_open(m_pNfsContext, privateName.c_str(), O_RDONLY, &m_pFileHandle);
+    }
   }
 
-  if (ret != 0)
+  if (ret != 0 || !m_pNfsContext)
   {
     CLog::Log(LOGERROR, "CNFSFile::Open: Unable to open file: '{}' error: '{}'", url.GetFileName(),
-              nfs_get_error(m_pNfsContext));
+              m_pNfsContext ? nfs_get_error(m_pNfsContext) : "no context");
 
+    if (m_privateContext)
+      gNfsConnection.DestroyPrivateContext(m_exportPath);
+    m_privateContext = false;
+    m_pFileHandle = nullptr;
     m_pNfsContext = nullptr;
     m_exportPath.clear();
     return false;
@@ -670,15 +771,33 @@ bool CNFSFile::Open(const CURL& url)
 
   CLog::Log(LOGDEBUG, "CNFSFile::Open - opened {}", url.GetFileName());
   m_url=url;
+  m_filePos = 0;
+  m_reconnecting = false;
 
   struct __stat64 tmpBuffer;
 
+  // On a context of its own (the shared one's lease expired), ask the open handle:
+  // Stat() goes through the shared context, which would fail the same way.
+  if (m_privateContext)
+  {
+    nfs_stat_64 st = {};
+    if (nfs_fstat64(m_pNfsContext, m_pFileHandle, &st) != 0)
+    {
+      m_url.Reset();
+      Close();
+      return false;
+    }
+    tmpBuffer = {};
+    tmpBuffer.st_mode = st.nfs_mode;
+    tmpBuffer.st_size = st.nfs_size;
+  }
+
   // nfs_open succeeds on directories, which lets libdvdread / libbluray
   // mis-classify a folder structure (DVD VIDEO_TS, Bluray BDMV) as a disc image
   // and run UDF/BDMV parsing on it, which then fails. Reject directories here
   // so callers fall back to file-by-file mode, the correct behaviour for folder
   // structures on remote VFS shares.
-  if (Stat(&tmpBuffer) != 0 || S_ISDIR(tmpBuffer.st_mode))
+  if ((!m_privateContext && Stat(&tmpBuffer) != 0) || S_ISDIR(tmpBuffer.st_mode))
   {
     m_url.Reset();
     Close();
@@ -742,6 +861,103 @@ int CNFSFile::Stat(const CURL& url, struct __stat64* buffer)
   return ret;
 }
 
+// Is the server answering at all? Reconnecting means remounting the export, and
+// the mount runs through the connection every NFS file and the directory listing
+// share. On a share that is down that mount fails, and failing it under a running
+// player ends playback - measured: nine failed mounts, two seconds apart, then
+// "eof reading from demuxer". So ask the cheap question first, with a socket of
+// our own that nothing else is waiting on.
+static bool server_answers(const CURL& url)
+{
+  const int port = url.HasPort() ? url.GetPort() : 2049;
+  struct addrinfo hints = {};
+  hints.ai_family = AF_UNSPEC;
+  hints.ai_socktype = SOCK_STREAM;
+  struct addrinfo* res = nullptr;
+  if (getaddrinfo(url.GetHostName().c_str(), std::to_string(port).c_str(), &hints, &res) != 0)
+    return false;
+
+  bool answered = false;
+  for (struct addrinfo* a = res; a && !answered; a = a->ai_next)
+  {
+    const int fd = socket(a->ai_family, a->ai_socktype | SOCK_NONBLOCK, a->ai_protocol);
+    if (fd < 0)
+      continue;
+    if (connect(fd, a->ai_addr, a->ai_addrlen) == 0)
+      answered = true;
+    else if (errno == EINPROGRESS)
+    {
+      struct pollfd p = {fd, POLLOUT, 0};
+      if (poll(&p, 1, std::chrono::milliseconds(PROBE_TIMEOUT).count()) > 0)
+      {
+        int err = 0;
+        socklen_t len = sizeof(err);
+        answered = getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &len) == 0 && err == 0;
+      }
+    }
+    close(fd);
+  }
+  freeaddrinfo(res);
+  return answered;
+}
+
+bool CNFSFile::Reconnect()
+{
+  const auto now = std::chrono::steady_clock::now();
+  if (now < m_nextReconnect)
+    return false;
+  m_nextReconnect = now + RECONNECT_INTERVAL;
+
+  if (!server_answers(m_url))
+    return false;
+
+  std::string filename;
+  std::string mapId;
+  std::unique_lock lock(gNfsConnection);
+
+  // Other files read through the context this one used: let go of the handle and
+  // leave the context to them. The new handle gets a mount of its own.
+  if (m_pFileHandle)
+  {
+    gNfsConnection.removeFromKeepAliveList(m_pFileHandle);
+    m_droppedHandles++;
+  }
+  m_pFileHandle = nullptr;
+  if (m_privateContext)
+    gNfsConnection.DestroyPrivateContext(m_exportPath);
+  m_pNfsContext = nullptr;
+  m_exportPath.clear();
+  m_privateContext = false;
+
+  struct nfs_context* context = gNfsConnection.OpenPrivateContext(m_url, filename, mapId);
+  if (!context)
+    return false;
+
+  m_pNfsContext = context;
+  m_exportPath = mapId;
+  m_privateContext = true;
+
+  if (nfs_open(m_pNfsContext, filename.c_str(), O_RDONLY, &m_pFileHandle) != 0)
+  {
+    m_pFileHandle = nullptr;
+    return false;
+  }
+
+  uint64_t offset = 0;
+  if (nfs_lseek(m_pNfsContext, m_pFileHandle, m_filePos, SEEK_SET, &offset) < 0)
+  {
+    // at the start of the file, the next read would hand that over as if from m_filePos
+    nfs_close(m_pNfsContext, m_pFileHandle);
+    m_pFileHandle = nullptr;
+    return false;
+  }
+
+  CLog::Log(LOGINFO, "CNFSFile::{} - reopened {} at {} ({} handle(s) left unclosed)",
+            __FUNCTION__, m_url.GetFileName(), m_filePos, m_droppedHandles);
+  m_reconnecting = false;
+  return true;
+}
+
 ssize_t CNFSFile::Read(void *lpBuf, size_t uiBufSize)
 {
   if (uiBufSize > SSIZE_MAX)
@@ -751,7 +967,17 @@ ssize_t CNFSFile::Read(void *lpBuf, size_t uiBufSize)
   std::unique_lock lock(gNfsConnection);
 
   if (m_pFileHandle == NULL || m_pNfsContext == NULL )
+  {
+    // Between a failed reconnect and a good one there is nothing to read from,
+    // but it is the same stall it came from: -1 would have the cache latch the
+    // end of input and end playback.
+    if (m_reconnecting)
+    {
+      Reconnect();
+      return -EAGAIN;
+    }
     return -1;
+  }
 #ifdef LIBNFS_API_V2
   numberOfBytesRead = nfs_read(m_pNfsContext, m_pFileHandle, lpBuf, uiBufSize);
 #else
@@ -764,9 +990,21 @@ ssize_t CNFSFile::Read(void *lpBuf, size_t uiBufSize)
 
   //something went wrong ...
   if (numberOfBytesRead < 0)
+  {
     CLog::Log(LOGERROR, "{} - Error( {}, {} )", __FUNCTION__, (int64_t)numberOfBytesRead,
               nfs_get_error(m_pNfsContext));
 
+    if (IsTransientReadError(numberOfBytesRead))
+    {
+      // The answer is unchanged - this only prepares the next read.
+      m_reconnecting = true;
+      Reconnect();
+      return -EAGAIN;
+    }
+  }
+  else
+    m_filePos += numberOfBytesRead;
+
   return numberOfBytesRead;
 }
 
@@ -786,6 +1024,7 @@ int64_t CNFSFile::Seek(int64_t iFilePosition, int iWhence)
               iFilePosition, iWhence, m_fileSize, nfs_get_error(m_pNfsContext));
     return -1;
   }
+  m_filePos = static_cast<int64_t>(offset);
   return (int64_t)offset;
 }
 
@@ -828,6 +1067,16 @@ void CNFSFile::Close()
     m_pFileHandle = NULL;
     m_pNfsContext = NULL;
     m_fileSize = 0;
+    if (!m_privateContext)
+      m_exportPath.clear();
+  }
+
+  // a context of its own from a reconnect goes with the file
+  if (m_privateContext)
+  {
+    gNfsConnection.DestroyPrivateContext(m_exportPath);
+    m_privateContext = false;
+    m_pNfsContext = NULL;
     m_exportPath.clear();
   }
 }
