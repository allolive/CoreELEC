From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: allolive <160342668+allolive@users.noreply.github.com>
Date: Fri, 18 Sep 2026 17:00:00 -0400
Subject: [PATCH] NFSFile: answer a transient error as a stall, and reconnect

When a share drops the connection the read fails, but that is not the end of
the file. Say -EAGAIN for the errors a retry can fix, and reopen the file where
the reader got to.

Reopening remounts the share, and every NFS file shares that mount, so doing it
while the server is down takes playback with it. Check the server is answering
first, and until it does, keep answering -EAGAIN.

Signed-off-by: allolive <160342668+allolive@users.noreply.github.com>

diff --git a/xbmc/filesystem/NFSFile.cpp b/xbmc/filesystem/NFSFile.cpp
index 3242b96..9684e3d 100644
--- a/xbmc/filesystem/NFSFile.cpp
+++ b/xbmc/filesystem/NFSFile.cpp
@@ -12,6 +12,10 @@
 
 #include "NFSFile.h"
 
+#include <netdb.h>
+#include <poll.h>
+#include <sys/socket.h>
+
 #include "ServiceBroker.h"
 #include "network/DNSNameCache.h"
 #include "settings/AdvancedSettings.h"
@@ -21,6 +25,7 @@
 #include "utils/URIUtils.h"
 #include "utils/log.h"
 
+#include <cerrno>
 #include <inttypes.h>
 #include <mutex>
 
@@ -55,9 +60,43 @@ namespace
 constexpr auto CONTEXT_TIMEOUT = 60s; // 2/3 parts of lease_time
 constexpr auto KEEP_ALIVE_TIMEOUT = 45s; // half of lease_time
 constexpr auto IDLE_TIMEOUT = 30s; // close fast unused contexts when no active connections
+// A share that is down stays down for a while; asking more often only costs
+// mounts. Long enough not to hammer it, short enough not to be noticed.
+constexpr auto RECONNECT_INTERVAL = 2s;
+// The reachability probe is only there to avoid mounting into a dead server, so
+// it must give up quickly and never become the stall itself.
+constexpr auto PROBE_TIMEOUT = 1s;
 
 constexpr int NFS4ERR_EXPIRED = -11; // client session expired due idle time greater than lease_time
 
+// libnfs hands back the RPC layer's verdict: a transport failure as -EFAULT, a
+// cancelled call as -EINTR, NFS3ERR_JUKEBOX as -EAGAIN, and a server that stopped
+// answering as one of the socket errors. A later read can succeed after any of
+// them; the file's own answers stand.
+bool IsTransientReadError(ssize_t err)
+{
+  switch (-err)
+  {
+    case EAGAIN:
+    case EINTR:
+    case EFAULT:
+    case EIO:
+    case EPIPE:
+    case ETIMEDOUT:
+    case ECONNRESET:
+    case ECONNABORTED:
+    case ECONNREFUSED:
+    case ENETDOWN:
+    case ENETRESET:
+    case ENETUNREACH:
+    case EHOSTDOWN:
+    case EHOSTUNREACH:
+      return true;
+    default:
+      return false;
+  }
+}
+
 constexpr auto SETTING_NFS_VERSION = "nfs.version";
 constexpr auto SETTING_NFS_CHUNKSIZE = "nfs.chunksize";
 } // unnamed namespace
@@ -670,6 +709,8 @@ bool CNFSFile::Open(const CURL& url)
 
   CLog::Log(LOGDEBUG, "CNFSFile::Open - opened {}", url.GetFileName());
   m_url=url;
+  m_filePos = 0;
+  m_reconnecting = false;
 
   struct __stat64 tmpBuffer;
 
@@ -742,6 +783,84 @@ int CNFSFile::Stat(const CURL& url, struct __stat64* buffer)
   return ret;
 }
 
+// Is the server answering at all? Reconnecting means remounting the export, and
+// the mount runs through the connection every NFS file and the directory listing
+// share. On a share that is down that mount fails, and failing it under a running
+// player ends playback - measured: nine failed mounts, two seconds apart, then
+// "eof reading from demuxer". So ask the cheap question first, with a socket of
+// our own that nothing else is waiting on.
+static bool server_answers(const CURL& url)
+{
+  const int port = url.HasPort() ? url.GetPort() : 2049;
+  struct addrinfo hints = {};
+  hints.ai_family = AF_UNSPEC;
+  hints.ai_socktype = SOCK_STREAM;
+  struct addrinfo* res = nullptr;
+  if (getaddrinfo(url.GetHostName().c_str(), std::to_string(port).c_str(), &hints, &res) != 0)
+    return false;
+
+  bool answered = false;
+  for (struct addrinfo* a = res; a && !answered; a = a->ai_next)
+  {
+    const int fd = socket(a->ai_family, a->ai_socktype | SOCK_NONBLOCK, a->ai_protocol);
+    if (fd < 0)
+      continue;
+    if (connect(fd, a->ai_addr, a->ai_addrlen) == 0)
+      answered = true;
+    else if (errno == EINPROGRESS)
+    {
+      struct pollfd p = {fd, POLLOUT, 0};
+      if (poll(&p, 1, std::chrono::milliseconds(PROBE_TIMEOUT).count()) > 0)
+      {
+        int err = 0;
+        socklen_t len = sizeof(err);
+        answered = getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &len) == 0 && err == 0;
+      }
+    }
+    close(fd);
+  }
+  freeaddrinfo(res);
+  return answered;
+}
+
+bool CNFSFile::Reconnect()
+{
+  const auto now = std::chrono::steady_clock::now();
+  if (now < m_nextReconnect)
+    return false;
+  m_nextReconnect = now + RECONNECT_INTERVAL;
+
+  if (!server_answers(m_url))
+    return false;
+
+  std::string filename;
+  std::unique_lock lock(gNfsConnection);
+
+  m_pFileHandle = nullptr;
+  gNfsConnection.Deinit();
+
+  if (!gNfsConnection.Connect(m_url, filename))
+    return false;
+
+  m_pNfsContext = gNfsConnection.GetNfsContext();
+  m_exportPath = gNfsConnection.GetContextMapId();
+
+  if (nfs_open(m_pNfsContext, filename.c_str(), O_RDONLY, &m_pFileHandle) != 0)
+  {
+    m_pFileHandle = nullptr;
+    return false;
+  }
+
+  uint64_t offset = 0;
+  if (nfs_lseek(m_pNfsContext, m_pFileHandle, m_filePos, SEEK_SET, &offset) < 0)
+    return false;
+
+  CLog::Log(LOGINFO, "CNFSFile::{} - reopened {} at {}", __FUNCTION__, m_url.GetFileName(),
+            m_filePos);
+  m_reconnecting = false;
+  return true;
+}
+
 ssize_t CNFSFile::Read(void *lpBuf, size_t uiBufSize)
 {
   if (uiBufSize > SSIZE_MAX)
@@ -751,7 +870,17 @@ ssize_t CNFSFile::Read(void *lpBuf, size_t uiBufSize)
   std::unique_lock lock(gNfsConnection);
 
   if (m_pFileHandle == NULL || m_pNfsContext == NULL )
+  {
+    // Between a failed reconnect and a good one there is nothing to read from,
+    // but it is the same stall it came from: -1 would have the cache latch the
+    // end of input and end playback.
+    if (m_reconnecting)
+    {
+      Reconnect();
+      return -EAGAIN;
+    }
     return -1;
+  }
 #ifdef LIBNFS_API_V2
   numberOfBytesRead = nfs_read(m_pNfsContext, m_pFileHandle, lpBuf, uiBufSize);
 #else
@@ -764,9 +893,21 @@ ssize_t CNFSFile::Read(void *lpBuf, size_t uiBufSize)
 
   //something went wrong ...
   if (numberOfBytesRead < 0)
+  {
     CLog::Log(LOGERROR, "{} - Error( {}, {} )", __FUNCTION__, (int64_t)numberOfBytesRead,
               nfs_get_error(m_pNfsContext));
 
+    if (IsTransientReadError(numberOfBytesRead))
+    {
+      // The answer is unchanged - this only prepares the next read.
+      m_reconnecting = true;
+      Reconnect();
+      return -EAGAIN;
+    }
+  }
+  else
+    m_filePos += numberOfBytesRead;
+
   return numberOfBytesRead;
 }
 
@@ -786,6 +927,7 @@ int64_t CNFSFile::Seek(int64_t iFilePosition, int iWhence)
               iFilePosition, iWhence, m_fileSize, nfs_get_error(m_pNfsContext));
     return -1;
   }
+  m_filePos = static_cast<int64_t>(offset);
   return (int64_t)offset;
 }
 
diff --git a/xbmc/filesystem/NFSFile.h b/xbmc/filesystem/NFSFile.h
index 237aae2..250cd5c 100644
--- a/xbmc/filesystem/NFSFile.h
+++ b/xbmc/filesystem/NFSFile.h
@@ -139,10 +139,16 @@ namespace XFILE
   protected:
     CURL m_url;
     bool IsValidFile(const std::string& strFileName);
+    // Reopen the file where the reader is, once the server is answering again.
+    bool Reconnect();
     int64_t m_fileSize = 0;
     struct nfsfh *m_pFileHandle;
     struct nfs_context *m_pNfsContext;//current nfs context
     std::string m_exportPath;
+    // Where the reader is, kept here because a dead handle cannot be asked.
+    int64_t m_filePos{0};
+    bool m_reconnecting{false};
+    std::chrono::time_point<std::chrono::steady_clock> m_nextReconnect{};
   };
 }
 
