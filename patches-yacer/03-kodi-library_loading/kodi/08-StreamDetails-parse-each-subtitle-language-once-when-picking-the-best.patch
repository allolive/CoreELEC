From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: allolive <160342668+allolive@users.noreply.github.com>
Date: Sun, 13 Sep 2026 20:03:01 -0400
Subject: [PATCH] StreamDetails: pick the preferred subtitle stream faster

For subtitles, DetermineBestStreams re-parsed the best stream's language
tag and refetched the preferred language on every comparison. Parse each
subtitle's language once, keep the best one's parsed tag, and fetch the
preferred language once per call. The decision moves to a helper shared
with CStreamDetailSubtitle::IsWorseThan, so the result is identical.
Shared code: the comparison and its loop both live in StreamDetails.

The code this patch adds never names CLanguageTag's namespace: it uses a
local alias, the type CLangInfo::GetSubtitleLanguage() returns, for the
helper's parameters, its locals and the Parse calls. Kodi master moves the
class from KODI::UTILS to KODI::LANGUAGE (xbmc/xbmc 9a33d95c42, "Move
CLanguageTag to xbmc/language"); written this way, the patch's own lines
build on either side of that move. The include and the lines it leaves
as they were are Kodi's, and change with the move upstream.

Signed-off-by: allolive <160342668+allolive@users.noreply.github.com>

diff --git a/xbmc/utils/StreamDetails.cpp b/xbmc/utils/StreamDetails.cpp
index 8b2f63d353..f8d0d29fc4 100644
--- a/xbmc/utils/StreamDetails.cpp
+++ b/xbmc/utils/StreamDetails.cpp
@@ -19,9 +19,28 @@
 #include <algorithm>
 #include <cmath>
 #include <ranges>
+#include <type_traits>
 
 const float VIDEOASPECT_EPSILON = 0.025f;
 
+namespace
+{
+// the language tag type as CLangInfo hands it out, whichever namespace it lives in
+using LanguageTag = std::remove_cvref_t<decltype(g_langInfo.GetSubtitleLanguage(true))>;
+
+bool IsWorseSubtitleLanguage(const LanguageTag& language,
+                             const LanguageTag& other,
+                             const LanguageTag& preferred)
+{
+  if (language.Matches(other))
+    return false;
+
+  // the best subtitle should be the one in the user's preferred language
+  // If preferred language is set to "original" this is "eng"
+  return language.IsEmpty() || preferred.Matches(other);
+}
+} // namespace
+
 CStreamDetail::Source CStreamDetail::GetSource() const
 {
   return m_source;
@@ -217,16 +236,10 @@ bool CStreamDetailSubtitle::IsWorseThan(const CStreamDetail& that) const
   if (that.m_eType != CStreamDetail::SUBTITLE)
     return true;
 
-  const KODI::UTILS::CLanguageTag language{KODI::UTILS::CLanguageTag::Parse(m_strLanguage)};
-  const KODI::UTILS::CLanguageTag other{KODI::UTILS::CLanguageTag::Parse(
-      static_cast<const CStreamDetailSubtitle&>(that).m_strLanguage)};
-
-  if (language.Matches(other))
-    return false;
-
-  // the best subtitle should be the one in the user's preferred language
-  // If preferred language is set to "original" this is "eng"
-  return language.IsEmpty() || g_langInfo.GetSubtitleLanguage(true).Matches(other);
+  const auto& other = static_cast<const CStreamDetailSubtitle&>(that);
+  return IsWorseSubtitleLanguage(LanguageTag::Parse(m_strLanguage),
+                                 LanguageTag::Parse(other.m_strLanguage),
+                                 g_langInfo.GetSubtitleLanguage(true));
 }
 
 CStreamDetailVideo& CStreamDetailVideo::operator=(const CStreamDetailVideo& that)
@@ -763,6 +776,10 @@ void CStreamDetails::DetermineBestStreams(void)
   m_pBestAudio = NULL;
   m_pBestSubtitle = NULL;
 
+  // A subtitle's language is parsed once, not on every comparison
+  const LanguageTag preferredSubtitle = g_langInfo.GetSubtitleLanguage(true);
+  LanguageTag bestSubtitleLanguage;
+
   for (const auto &iter : m_vecItems)
   {
     const CStreamDetail **champion;
@@ -775,8 +792,17 @@ void CStreamDetails::DetermineBestStreams(void)
       champion = (const CStreamDetail **)&m_pBestAudio;
       break;
     case CStreamDetail::SUBTITLE:
-      champion = (const CStreamDetail **)&m_pBestSubtitle;
-      break;
+    {
+      const auto& subtitle = static_cast<const CStreamDetailSubtitle&>(*iter);
+      auto language = LanguageTag::Parse(subtitle.m_strLanguage);
+      if (!m_pBestSubtitle ||
+          IsWorseSubtitleLanguage(bestSubtitleLanguage, language, preferredSubtitle))
+      {
+        m_pBestSubtitle = &subtitle;
+        bestSubtitleLanguage = std::move(language);
+      }
+      continue;
+    }
     default:
       champion = NULL;
     }  /* switch type */
