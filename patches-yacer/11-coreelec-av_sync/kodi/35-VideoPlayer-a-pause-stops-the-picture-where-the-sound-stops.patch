+void CVideoPlayer::FinishDeferredPause(bool now)
+{
+  if (!m_pauseDeferred)
+    return;
+
+  const double absolute = m_clock.GetAbsoluteClock();
+  if (!now && absolute - m_pauseDeferStart < DVD_SEC_TO_TIME(1) &&
+      absolute - m_pauseDeferLastPoll < DVD_MSEC_TO_TIME(10))
+    return;
+  m_pauseDeferLastPoll = absolute;
+  const double heard = m_VideoPlayerAudio->GetHeardPts();
+  if (!now && absolute - m_pauseDeferStart < DVD_SEC_TO_TIME(1))
+  {
+    if (heard != DVD_NOPTS_VALUE &&
+        (m_pauseDeferLastHeard == DVD_NOPTS_VALUE ||
+         heard > m_pauseDeferLastHeard + DVD_MSEC_TO_TIME(1)))
+    {
+      m_pauseDeferLastHeard = heard;
+      m_pauseDeferLastAdvance = absolute;
+    }
+    // The sink delay moves a period at a time, so still for a while before
+    // the queue counts as played out.
+    if (absolute - m_pauseDeferLastAdvance < DVD_MSEC_TO_TIME(80))
+      return;
+  }
+
+  m_pauseDeferred = false;
+  // The picture stops where the sound did.
+  if (!now && heard != DVD_NOPTS_VALUE && std::abs(heard - m_clock.GetClock()) < DVD_MSEC_TO_TIME(500))
+    m_clock.Discontinuity(heard);
+  m_clock.SetSpeed(DVD_PLAYSPEED_PAUSE);
+  m_VideoPlayerVideo->SetSpeed(DVD_PLAYSPEED_PAUSE);
+  // Nothing is left in the engine for the pause to flush.
+  m_VideoPlayerAudio->SetSpeed(DVD_PLAYSPEED_PAUSE);
+  m_VideoPlayerAudio->SendMessage(
+      std::make_shared<CDVDMsgBool>(CDVDMsg::GENERAL_PAUSE, m_displayLost || m_startAudioHeld), 1);
+  CLog::Log(LOGDEBUG, "CVideoPlayer::Pause - clock stopped {}ms after the audio, at {:.3f}",
+            DVD_TIME_TO_MSEC(absolute - m_pauseDeferStart), m_clock.GetClock() / DVD_TIME_BASE);
+}
+
+void CVideoPlayer::CancelDeferredPause()
+{
+  if (!std::exchange(m_pauseDeferred, false))
+    return;
+  m_VideoPlayerAudio->SendMessage(
+      std::make_shared<CDVDMsgBool>(CDVDMsg::GENERAL_PAUSE, m_displayLost || m_startAudioHeld), 1);
+}
+
 void CVideoPlayer::HandlePlaySpeed()
 {
+  if (m_pauseDeferred)
+  {
+    if (m_playSpeed == DVD_PLAYSPEED_PAUSE)
+      FinishDeferredPause(false);
+    else
+      CancelDeferredPause();
+  }
+
   // Audio preparation has its own clock anchor and output ordering. Ordinary
   // startup would pull that clock to the later video target or resume both
   // stream players while the target picture is deliberately held.
@@ -3927,6 +3983,12 @@
       if (m_resumeGate.IsHolding() && speed == DVD_PLAYSPEED_NORMAL && !msg->IsTempo())
         continue;
 
+      // A resume before a deferred pause took effect: nothing was paused, so
+      // it is no resume to prepare.
+      const bool pauseCancelled = m_pauseDeferred && speed != DVD_PLAYSPEED_PAUSE;
+      if (pauseCancelled)
+        CancelDeferredPause();
+
       const bool resumingArmed = m_resumePreroll.Armed() && !msg->IsTempo() &&
                                  speed == DVD_PLAYSPEED_NORMAL &&
                                  notification == CDVDMsgPlayerSetSpeed::Notification::RESUMED;
@@ -3941,7 +4003,7 @@
 
       const bool deferResume =
           notification == CDVDMsgPlayerSetSpeed::Notification::RESUMED &&
-          speed == DVD_PLAYSPEED_NORMAL && !msg->IsTempo() &&
+          speed == DVD_PLAYSPEED_NORMAL && !msg->IsTempo() && !pauseCancelled &&
           m_playSpeed == DVD_PLAYSPEED_PAUSE && m_CurrentAudio.id >= 0 &&
           m_CurrentVideo.id >= 0 && m_State.canseek && m_State.canpause && m_pInputStream &&
           m_pInputStream->IsStreamType(DVDSTREAM_TYPE_FILE) && !m_pInputStream->IsRealtime() &&
@@ -4058,9 +4120,35 @@
 
       m_srcUnderrunHold = false;
       m_caching = CACHESTATE_DONE;
-      m_clock.SetSpeed(speed);
-      m_VideoPlayerAudio->SetSpeed(speed);
-      m_VideoPlayerVideo->SetSpeed(speed);
+
+      // A pause the resume will not be prepared behind (an MVC film, a source
+      // that is struggling) paused the audio stream at once, and pausing the
+      // only stream flushes the engine: the audio already queued in it was
+      // never heard, the resume went on after it, and the gap was filled with
+      // silence. Stop feeding the audio instead, let the engine play out what
+      // it has, and stop the clock and the picture where it ends.
+      const bool deferPause = speed == DVD_PLAYSPEED_PAUSE &&
+                              m_streamPlayerSpeed == DVD_PLAYSPEED_NORMAL &&
+                              notification == CDVDMsgPlayerSetSpeed::Notification::PAUSED &&
+                              m_CurrentAudio.id >= 0 && m_CurrentVideo.id >= 0 &&
+                              !m_clock.IsPaused() && !m_displayLost && !m_startAudioHeld &&
+                              !(sourceReady && CanPrepareResumePreroll());
+      if (deferPause)
+      {
+        m_VideoPlayerAudio->SendMessage(std::make_shared<CDVDMsgBool>(CDVDMsg::GENERAL_PAUSE, true),
+                                        1);
+        m_pauseDeferred = true;
+        m_pauseDeferStart = m_clock.GetAbsoluteClock();
+        m_pauseDeferLastHeard = DVD_NOPTS_VALUE;
+        m_pauseDeferLastAdvance = m_pauseDeferStart;
+        m_pauseDeferLastPoll = 0.0;
+      }
+      else
+      {
+        m_clock.SetSpeed(speed);
+        m_VideoPlayerAudio->SetSpeed(speed);
+        m_VideoPlayerVideo->SetSpeed(speed);
+      }
       m_streamPlayerSpeed = speed;
 
       // The picture is frozen from here until the viewer resumes. Prepare the
@@ -6081,6 +6169,7 @@
 
 void CVideoPlayer::FlushBuffers(double pts, bool accurate, bool sync)
 {
+  FinishDeferredPause(true);
   if (m_startAudioHeld)
     ReleaseStartHold("a seek");
   m_syncStartPtsWait.reset();
--- a/xbmc/cores/VideoPlayer/VideoPlayer.h
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.h
@@ -657,6 +657,15 @@
   //! the audio of the file's first start is held, its packets queued, until
   //! the preparation takes them from the first one
   bool m_startAudioHeld = false;
+  // A pause that will not be prepared stops feeding the audio at once but the
+  // clock only once the audio already queued has been heard.
+  bool m_pauseDeferred = false;
+  double m_pauseDeferStart = 0.0;
+  double m_pauseDeferLastHeard = DVD_NOPTS_VALUE;
+  double m_pauseDeferLastAdvance = 0.0;
+  double m_pauseDeferLastPoll = 0.0;
+  void FinishDeferredPause(bool now);
+  void CancelDeferredPause();
   double m_startAudioFirstPts = DVD_NOPTS_VALUE;
   bool m_resumeAudioCommitPending = false;
   int m_demuxerSpeed = DVD_PLAYSPEED_NORMAL;
