+// The bitstreams a preparation can restart: TrueHD and DTS at a codec-safe
+// point, the AC-3 family anywhere, since its every frame is one.
+static bool PrerollBitstream(AVCodecID codec)
+{
+  return codec == AV_CODEC_ID_TRUEHD || codec == AV_CODEC_ID_DTS || codec == AV_CODEC_ID_AC3 ||
+         codec == AV_CODEC_ID_EAC3;
+}
+
+// Decoded audio leaves no packer to restart, so any codec whose output is PCM.
+static bool PrerollAudio(bool passthrough, AVCodecID codec)
+{
+  return !passthrough || PrerollBitstream(codec);
+}
