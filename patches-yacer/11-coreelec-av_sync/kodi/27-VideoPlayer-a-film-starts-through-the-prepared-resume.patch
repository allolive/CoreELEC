index 7fa06b1..d422c5d 100644
--- a/xbmc/cores/VideoPlayer/AudioPreroll.h
+++ b/xbmc/cores/VideoPlayer/AudioPreroll.h
@@ -182,7 +182,10 @@ public:
       Fail(Failure::Timestamp, pts, duration, packetBytes, 0, previousBytes);
       return true;
     }
-    if (!passthrough)
+    // PCM is held a decoded frame at a time, as a bitstream is a packet at a
+    // time; after a partial write only what is left of it is judged.
+    if (!passthrough &&
+        !Slice(pts, duration, packetBytes, previousBytes, packetBytes - previousBytes))
     {
       Fail(Failure::Format, pts, duration, packetBytes, 0, previousBytes);
       return true;
@@ -205,18 +208,20 @@ public:
   }
 
   bool Accepted(double pts, double duration, unsigned int written, unsigned int packetBytes,
-                unsigned int previousBytes)
+                unsigned int previousBytes, bool passthrough = true)
   {
     if (!m_active || m_failed || m_releasePending)
       return false;
     // RAW progress is meaningful only for a complete packet. A timeout after
     // partial acceptance requires cancellation; never extrapolate its duration.
+    // PCM is counted in sample frames, so a partial write is the share written.
     Failure reason = Failure::None;
     if (!ValidPts(pts))
       reason = Failure::Timestamp;
     else if (!std::isfinite(duration) || duration <= 0 || !std::isfinite(pts + duration))
       reason = Failure::Duration;
-    else if (packetBytes == 0 || previousBytes != 0 || written != packetBytes)
+    else if (passthrough ? packetBytes == 0 || previousBytes != 0 || written != packetBytes
+                         : !Slice(pts, duration, packetBytes, previousBytes, written))
       reason = Failure::PartialWrite;
     else if (!Continuous(pts))
       reason = Failure::Continuity;
@@ -265,6 +270,20 @@ public:
   }
 
 private:
+  // The part of a decoded frame from sample frame `previous`, `count` long, in
+  // proportion to its frames. The whole frame is left exactly as given.
+  static bool Slice(double& pts, double& duration, unsigned int frames, unsigned int previous,
+                    unsigned int count)
+  {
+    if (frames == 0 || previous >= frames || count == 0 || count > frames - previous)
+      return false;
+    if (count == frames)
+      return true;
+    pts += duration * previous / frames;
+    duration = duration * count / frames;
+    return true;
+  }
+
   bool Continuous(double pts) const
   {
     // Both the timestamps and the reported durations arrive rounded to whole
