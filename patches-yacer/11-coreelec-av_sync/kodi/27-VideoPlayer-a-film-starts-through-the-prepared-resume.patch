+// What a preparation needs without the seek and flush a resume adds to it: a
+// file's first start prepares where the decoder already is.
+bool CVideoPlayer::CanPrepareStartPreroll(AVCodecID codec) const
+{
+  // the resume's conditions, CanPrepareResumePreroll, but its seek and flush's
+  return m_pInputStream && m_pDemuxer && m_State.canseek && m_State.canpause &&
+         PrerollAudio(IsPassthrough(), codec) &&
+         m_pInputStream->IsStreamType(DVDSTREAM_TYPE_FILE) &&
+         !m_pInputStream->IsRealtime() && !KODI::NETWORK::IsInternetStream(m_item) &&
+         !m_pInputStream->GetIPosTime() && !m_pInputStream->GetITimes() &&
+         !m_Edl.HasEdits() && !m_processInfo->GetVideoInterlaced() &&
+         m_State.time_offset == 0.0 && m_offset_pts == 0.0 &&
+         // a failed start recovers through a flush, which FEL does not survive
+         !m_processInfo->GetDoviIsFEL();
+}
+
+/*
+ * The file's first start, once the display has settled, through the same
+ * preparation as a resume: audio from the first packet, the picture held at a
+ * target a lead-in later until the audio is measured running in sync, then both
+ * released together, with no correction left for the engine to make. The audio
+ * was held from its open, packets queued and untouched, so nothing is read
+ * twice: no seek, no flush. The first frame stays on screen while the lead-in
+ * plays.
+ */
+void CVideoPlayer::StartHeldAudio()
+{
+  // Video has to be running first: its first picture is what changes the
+  // display mode, and only then do the change, its re-lock and the renderer's
+  // reset follow. The wait for those is counted from there.
+  if (m_CurrentVideo.id < 0 || m_CurrentVideo.syncState != IDVDStreamPlayer::SYNC_WAITSYNC)
+    return;
+  if (m_CurrentVideo.starttime == DVD_NOPTS_VALUE)
+  {
+    ReleaseStartHold("no video start time");
+    return;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  if (!m_startPrerollWait)
+    m_startPrerollWait = now;
+  const bool ready = m_startAudioFirstPts != DVD_NOPTS_VALUE && !m_displayLost &&
+                     !HoldForDisplayChange() &&
+                     m_renderManager.DisplayResets() >= m_startRendererResets;
+  const bool late = now - *m_startPrerollWait >= 8s;
+  if (!ready)
+  {
+    if (late)
+      ReleaseStartHold("the start did not settle");
+    return;
+  }
+  if (m_playSpeed != DVD_PLAYSPEED_NORMAL || m_resumePictureGeneration != 0 ||
+      m_resumeGate.IsHolding() || !CanPrepareStartPreroll(m_CurrentAudio.hint.codec) ||
+      // too short to reach the lead-in's target picture
+      (m_State.timeMax > 0 && m_State.timeMax < 10000))
+  {
+    ReleaseStartHold("not eligible");
+    return;
+  }
+  // the decoder resets after 5 s with no picture taken: the ordinary start waits paused
+  if (HoldForSubtitleTranslation(m_CurrentVideo.starttime))
+  {
+    ReleaseStartHold("the subtitle is being translated");
+    return;
+  }
+
+  double settle = 0.0;
+  double receiverStart = 0.0;
+  const double leadIn =
+      ResumePrerollLeadIn(m_renderManager.GetVideoPrerollLead(), settle, receiverStart);
+  const double acceptFrom = std::max(m_CurrentVideo.starttime, m_startAudioFirstPts);
+  // a file's own start begins on a major sync; a bookmark's need not
+  const double target = acceptFrom + leadIn + (acceptFrom > DVD_SEC_TO_TIME(1) ? settle : 0.0);
+  if (!TakeNewResumeHold(target, target))
+  {
+    if (late)
+      ReleaseStartHold("the renderer took no held picture");
+    return;
+  }
+  if (!m_resumePreroll.Begin(m_resumePictureGeneration, target, m_clock.GetAbsoluteClock(),
+                             CPlaybackPreroll::START_TARGET_ADVANCE_US))
+  {
+    m_renderManager.CancelVideoPreroll(m_resumePictureGeneration);
