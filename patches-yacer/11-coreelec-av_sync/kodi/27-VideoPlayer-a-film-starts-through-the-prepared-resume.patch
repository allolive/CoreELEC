+}
+
+// The held audio goes on to an ordinary start.
+void CVideoPlayer::ReleaseStartHold(const char* reason)
+{
+  CLog::Log(LOGDEBUG, "CVideoPlayer::Preroll - ordinary start: {}", reason);
+  m_startAudioHeld = false;
+  EndStartPreroll();
+  m_VideoPlayerAudio->SendMessage(std::make_shared<CDVDMsgBool>(CDVDMsg::GENERAL_PAUSE, m_displayLost),
+                                  1);
+}
+
+// A new output generation whose next picture the renderer holds (the first at
+// or after holdPts), for a preparation aiming at target. The generation is
+// taken only if the hold is.
+bool CVideoPlayer::TakeNewResumeHold(double target, double holdPts)
+{
+  const uint64_t generation = m_resumeGate.OutputGeneration() + 1;
+  if (!m_renderManager.BeginVideoPreroll(generation, holdPts))
+    return false;
+  m_resumeGate.InvalidateOutput();
+  m_resumePictureGeneration = generation;
+  m_resumePrerollTarget = target;
+  return true;
+}
+
+void CVideoPlayer::EndStartPreroll()
+{
+  m_startPrerollPending = false;
+  m_startPrerollWait.reset();
+}
+
+// The skin goes fullscreen and the started callbacks fire once, when the
+// streams first run in sync: from the start sync, or from a start's preroll.
+void CVideoPlayer::AnnounceStreamsReady()
+{
+  if (m_State.streamsReady)
+    return;
+  // Activate the fullscreen-video skin now that streams are ready, so
+  // video frames will fully paint the swap chain from the first frame
+  // the skin is visible.
+  if (m_playerOptions.fullscreen)
+  {
+    CServiceBroker::GetAppMessenger()->PostMsg(TMSG_SWITCHTOFULLSCREEN);
+  }
+
+  IPlayerCallback *cb = &m_callback;
+  CFileItem fileItem = m_item;
+  m_outboundEvents->Submit([=]() {
+    cb->OnAVStarted(fileItem);
+  });
+  m_State.streamsReady = true;
+}
