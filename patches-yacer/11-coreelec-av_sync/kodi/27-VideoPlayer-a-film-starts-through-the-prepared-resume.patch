       frame.nb_frames > MAX_IEC61937_PACKET || m_pAudioStream->GetFrameSize() != 1)
@@ -400,7 +423,7 @@ CAudioSinkAE::PrerollPacketResult CAudioSinkAE::AddPrerollPacket(const DVDAudioF
