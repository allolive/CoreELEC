+    }
+    const unsigned int space = m_pAudioStream->GetSpace() / frameSize;
+    if (space == 0)
+      return PrerollPacketResult::Deferred;
+    DVDAudioFrame part = frame;
+    part.nb_frames = frame.framesOut + std::min(space, frame.nb_frames - frame.framesOut);
+    lock.unlock();
+
+    written = AddPackets(part);
+    return written > 0 ? PrerollPacketResult::Written : PrerollPacketResult::Failed;
+  }
   if (!m_bPassthrough || m_dataFormat != AE_FMT_RAW ||
