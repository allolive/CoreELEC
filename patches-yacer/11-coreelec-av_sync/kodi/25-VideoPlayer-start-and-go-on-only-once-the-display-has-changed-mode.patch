diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 6e88957..ca62e37 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -1778,10 +1778,20 @@ void CVideoPlayer::Process()
     // check display lost
     if (m_displayLost)
     {
-      if (m_nextStream.Pending())
-        m_nextStream.Begin(); // the outage is no stall
-      CThread::Sleep(50ms);
-      continue;
+      bool relocked = false;
+      {
+        std::unique_lock lock(m_displayResetMutex);
+        relocked = m_displayRelocking && std::chrono::steady_clock::now() >= m_displayRelockUntil;
+        if (relocked)
+          FinishDisplayReset();
+      }
+      if (!relocked)
+      {
+        if (m_nextStream.Pending())
+          m_nextStream.Begin(); // the outage is no stall
+        CThread::Sleep(50ms);
+        continue;
+      }
     }
 
     // check if in an edit (cut or commercial break) that should be automatically skipped
@@ -4702,8 +4712,40 @@ bool CVideoPlayer::PollResumePreroll()
   return false;
 }
 
+namespace
+{
+// a mode change that never comes does not keep playback from starting
+constexpr auto DISPLAY_HOLD_LIMIT = 5s;
+} // namespace
+
+bool CVideoPlayer::HoldForDisplayChange()
+{
+  if (!m_renderManager.IsResolutionUpdatePending() && !m_processInfo->IsDisplayChangePending())
+  {
+    m_displayHoldSince.reset();
+    return false;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  if (!m_displayHoldSince)
+  {
+    m_displayHoldSince = now;
+    CLog::Log(LOGDEBUG, "CVideoPlayer: playback waits for the display to change mode");
+  }
+  if (now - *m_displayHoldSince < DISPLAY_HOLD_LIMIT)
+    return true;
+  if (now - *m_displayHoldSince < DISPLAY_HOLD_LIMIT + 50ms)
+    CLog::Log(LOGWARNING, "CVideoPlayer: the display has not changed mode, playback starts");
+  return false;
+}
+
 void CVideoPlayer::SetCaching(ECacheState state)
 {
+  // A mode change drops the sound of the link: playback starts after it, not
+  // into it.
+  if ((state == CACHESTATE_PLAY || state == CACHESTATE_DONE) &&
+      (m_caching == CACHESTATE_INIT || m_caching == CACHESTATE_FULL) && HoldForDisplayChange())
+    return;
+
   // Any move off CACHESTATE_FULL ends a source-underrun hold, a seek included.
   const bool wasSourceUnderrunHold = m_srcUnderrunHold;
   if (state != CACHESTATE_FULL)
@@ -7380,6 +7422,8 @@ void CVideoPlayer::UpdateVideoRender(bool video)
 void CVideoPlayer::OnLostDisplay()
 {
   CLog::Log(LOGINFO, "VideoPlayer: OnLostDisplay received");
+  std::unique_lock lock(m_displayResetMutex);
+  m_displayRelocking = false;
   if (m_VideoPlayerAudio->IsInited())
     m_VideoPlayerAudio->SendMessage(std::make_shared<CDVDMsgBool>(CDVDMsg::GENERAL_PAUSE, true), 1);
   if (m_VideoPlayerVideo->IsInited())
@@ -7396,6 +7440,21 @@ void CVideoPlayer::OnResetDisplay()
     return;
 
   CLog::Log(LOGINFO, "VideoPlayer: OnResetDisplay received");
+  // The TV and a receiver behind it find the sound again only a while after the
+  // signal changed: the player stays paused that long, its audio output sending
+  // silence for them to lock on to, and goes on from its loop.
+  const int relockMs = CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+      CSettings::SETTING_COREELEC_AMLOGIC_DISPLAYRELOCK);
+  std::unique_lock lock(m_displayResetMutex);
+  m_displayRelockUntil =
+      std::chrono::steady_clock::now() + std::chrono::milliseconds(std::max(relockMs, 0));
+  m_displayRelocking = true;
+}
+
+void CVideoPlayer::FinishDisplayReset()
+{
+  CLog::Log(LOGINFO, "VideoPlayer: display reset done, playback goes on");
+  m_displayRelocking = false;
   m_VideoPlayerAudio->SendMessage(std::make_shared<CDVDMsgBool>(CDVDMsg::GENERAL_PAUSE, false), 1);
   m_VideoPlayerVideo->SendMessage(std::make_shared<CDVDMsgBool>(CDVDMsg::GENERAL_PAUSE, false), 1);
   m_clock.Pause(false);
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.h b/xbmc/cores/VideoPlayer/VideoPlayer.h
index a263248..bbee472 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.h
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.h
@@ -398,6 +398,9 @@ public:
   // IDispResource interface
   void OnLostDisplay() override;
   void OnResetDisplay() override;
+  //! the display is back and its sink has had its wait: playback goes on
+  void FinishDisplayReset();
+  bool HoldForDisplayChange();
 
   bool IsCaching() const override;
   int GetCacheLevel() const override;
@@ -723,6 +726,11 @@ protected:
   bool m_updateStreamDetails{false};
 
   std::atomic<bool> m_displayLost;
+  //! between the display coming back and its sink finding the signal again
+  std::mutex m_displayResetMutex;
+  bool m_displayRelocking{false};
+  std::chrono::steady_clock::time_point m_displayRelockUntil;
+  std::optional<std::chrono::steady_clock::time_point> m_displayHoldSince;
 
   double m_messageQueueTimeSize{0.0};
 };
