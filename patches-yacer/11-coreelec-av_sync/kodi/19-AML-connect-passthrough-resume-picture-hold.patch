-std::shared_ptr<CAMLCodec> CRendererAML::QueueFrame(int index, bool setVideoRect, bool* drop)
+bool CRendererAML::BeginVideoPreroll(uint64_t generation)
 {
+  std::lock_guard<std::mutex> lock(m_prerollMutex);
+  if (!m_bConfigured || generation <= m_prerollGeneration)
+    return false;
+  m_prerollGeneration = generation;
+  m_prerollHold = true;
+  m_prerollFirst = false;
+  m_prerollFailed = false;
+  m_prerollSubmitted = false;
+  return true;
+}
+
+bool CRendererAML::ReleaseVideoPreroll(uint64_t generation)
+{
+  std::lock_guard<std::mutex> lock(m_prerollMutex);
+  if (generation != m_prerollGeneration || !m_prerollHold || m_prerollFailed)
+    return false;
+  m_prerollHold = false;
+  m_prerollFirst = true;
+  return true;
+}
+
+void CRendererAML::CancelVideoPreroll(uint64_t generation)
+{
+  std::lock_guard<std::mutex> lock(m_prerollMutex);
+  if (generation != m_prerollGeneration)
+    return;
+  m_prerollHold = false;
+  m_prerollFirst = false;
+  m_prerollFailed = true;
+  m_prerollSubmitted = false;
+}
+
+void CRendererAML::SetVideoPrerollFrameGeneration(int index, uint64_t generation)
+{
+  m_buffers[index].prerollGeneration = generation;
+}
+
+bool CRendererAML::IsVideoPrerollFailed(uint64_t generation) const
+{
+  std::lock_guard<std::mutex> lock(m_prerollMutex);
+  return generation == m_prerollGeneration && m_prerollFailed;
+}
+
+bool CRendererAML::IsVideoPrerollSubmitted(uint64_t generation) const
+{
+  std::lock_guard<std::mutex> lock(m_prerollMutex);
+  return generation == m_prerollGeneration && m_prerollSubmitted;
+}
+
+std::shared_ptr<CAMLCodec> CRendererAML::QueueFrame(int index, bool setVideoRect, bool& drop)
+{
+  // This is the final, non-retractable QBUF boundary. Begin/cancel serialize
+  // against it; a renderer-selected frame alone is not permission to submit.
+  std::lock_guard<std::mutex> lock(m_prerollMutex);
+  const uint64_t generation = m_buffers[index].prerollGeneration;
+  if (m_prerollHold ||
+      (generation != 0 && (generation != m_prerollGeneration || m_prerollFailed)))
+    return nullptr;
+
   CAMLVideoBuffer *amli = dynamic_cast<CAMLVideoBuffer *>(m_buffers[index].videoBuffer);
   if(amli && amli->m_amlCodec)
   {
     uint64_t pts = amli->m_omxPts;
-    if (pts != m_prevVPts)
+    const bool firstPreroll = generation != 0 && m_prerollFirst;
+    if (pts != m_prevVPts || firstPreroll)
     {
-      const bool dropFrame =
-          m_prevVPts == DVD_NOPTS_VALUE && amli->m_amlCodec->IsRealtimeStream();
-      if (drop)
-        *drop = dropFrame;
-
-      amli->m_amlCodec->ReleaseFrame(amli->m_bufferIndex, dropFrame);
+      // the first frame after a reset is dropped on a live stream only, and
+      // never when it is the picture a resume was prepared on
+      drop = !firstPreroll && m_prevVPts == DVD_NOPTS_VALUE &&
+             amli->m_amlCodec->IsRealtimeStream();
+      const int result = amli->m_amlCodec->ReleaseFrame(amli->m_bufferIndex, drop,
+                                                        amli->m_frameGeneration);
+      if (result != 0)
+      {
+        if (generation != 0)
+          m_prerollFailed = true;
+        amli->m_amlCodec = nullptr;
+        return nullptr;
+      }
+      if (firstPreroll)
+      {
+        m_prerollFirst = false;
+        m_prerollSubmitted = true;
+      }
       if (setVideoRect)
         amli->m_amlCodec->SetVideoRect(m_sourceRect, m_destRect);
       // Refreshes what the decode thread and the debug overlay read.
@@ -290,7 +363,8 @@ void CRendererAML::RenderUpdate(int index, int index2, bool clear, unsigned int
   }
 
   ObserveRefresh();
-  QueueFrame(index, true);
+  bool drop = false;
+  QueueFrame(index, true, drop);
   CAMLCodec::PollFrame();
 }
 
@@ -363,9 +437,10 @@ void CRendererAML::WakeVsyncPresent()
 
