+  // which may itself be waiting for this lock in ReleaseFrame.
+  std::unique_lock<std::mutex> frameLock(m_frameMutex);
+  ++m_frameGeneration;
+
   // set the system blackout_policy to leave the last frame showing
   int blackout_policy = 0;
   CSysfsPath video_blackout_policy{"/sys/class/video/blackout_policy"};
@@ -2857,6 +2871,7 @@ void CAMLCodec::Reset()
   m_buffer_level_ready = false;
 
   SetSpeed(m_speed);
