diff --git a/xbmc/cores/AudioEngine/Utils/AESyncObservation.h b/xbmc/cores/AudioEngine/Utils/AESyncObservation.h
new file mode 100644
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Utils/AESyncObservation.h
@@ -0,0 +1,170 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
