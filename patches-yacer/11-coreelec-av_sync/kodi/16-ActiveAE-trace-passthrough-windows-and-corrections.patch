+
+#pragma once
+
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+
+// Error, PTS and delay are milliseconds. Host timestamps are steady-clock microseconds.
+// Validity describes the samples, not receiver readiness or clock-epoch coherence.
+struct AESyncObservation
+{
+  uint64_t stream{0};
+  uint64_t epoch{0};
+  uint64_t sequence{0};
+  uint64_t delayGeneration{0};
+  int64_t begin{0};
+  int64_t end{0};
+  uint64_t samples{0};
+  double measured{0.0};
+  double raw{0.0};
+  double control{0.0};
+  double scale{1.0};
+  double clamp{0.0};
+  double playingPts{0.0};
+  double clock{0.0};
+  double delay{0.0};
+  bool finite{true};
+  bool saturated{false};
+  bool mixed{false};
+
+  bool Valid() const { return samples != 0 && finite && !mixed; }
+  bool SameWindow(const AESyncObservation& other) const
+  {
+    return stream == other.stream && epoch == other.epoch && sequence == other.sequence;
+  }
+};
+
+struct AESyncActions
+{
+  uint64_t firstSequence{0};
+  uint64_t lastSequence{0};
+  uint64_t muted{0};
+  uint64_t inserted{0};
+  uint64_t dropped{0};
+  double muteDuration{0.0};
+  double insertDuration{0.0};
+  double dropDuration{0.0};
+};
+
+// Diagnostic sidecar: never supplies an error or a deadline to the sync controller.
+class CAESyncObservations
+{
+public:
+  static int64_t Now()
+  {
+    return std::chrono::duration_cast<std::chrono::microseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+  }
+
+  void Add(double measured,
+           double raw,
+           double control,
+           double scale,
+           double clamp,
+           double playingPts,
+           double clock,
+           double delay,
+           uint64_t delayGeneration,
+           int64_t now)
+  {
+    if (m_pending.samples == 0)
+    {
+      m_pending.begin = now;
+      m_pending.scale = scale;
+      m_pending.clamp = clamp;
+      m_pending.delayGeneration = delayGeneration;
+    }
+    m_pending.mixed |= m_pending.scale != scale || m_pending.clamp != clamp ||
+                       m_pending.delayGeneration != delayGeneration;
+    m_pending.end = now;
+    ++m_pending.samples;
+    m_pending.measured += measured;
+    m_pending.raw += raw;
+    m_pending.control += control;
+    m_pending.playingPts = playingPts;
+    m_pending.clock = clock;
+    m_pending.delay = delay;
+    m_pending.saturated |= std::abs(measured) >= clamp;
+    m_pending.finite &= std::isfinite(measured) && std::isfinite(raw) && std::isfinite(control) &&
+                        std::isfinite(playingPts) && std::isfinite(clock) && std::isfinite(delay) &&
+                        std::isfinite(scale) && std::isfinite(clamp);
+  }
+
+  AESyncObservation Pending(uint64_t stream) const
+  {
+    auto result = m_pending;
+    result.stream = stream;
+    result.epoch = m_epoch;
+    result.sequence = m_sequence + 1;
+    if (result.samples != 0)
+    {
+      result.measured /= result.samples;
+      result.raw /= result.samples;
+      result.control /= result.samples;
+      result.finite &= std::isfinite(result.measured) && std::isfinite(result.raw) &&
+                       std::isfinite(result.control);
+    }
+    return result;
+  }
+
+  void Latch(uint64_t stream)
+  {
+    m_last = Pending(stream);
+    ++m_sequence;
+    m_pending = {};
+  }
+
+  void Flush()
+  {
+    ++m_epoch;
+    m_last = {};
+    m_pending = {};
+    m_actions = {};
+  }
+
+  void RestartWindow() { m_pending = {}; }
+  const AESyncObservation& Last() const { return m_last; }
+  const AESyncActions& Actions() const { return m_actions; }
+  void ClearActions() { m_actions = {}; }
+  void Mute(double duration)
+  {
+    RecordAction();
+    ++m_actions.muted;
+    m_actions.muteDuration += duration;
+  }
+  void Insert(double duration)
+  {
+    RecordAction();
+    ++m_actions.inserted;
+    m_actions.insertDuration += duration;
+  }
+  void Drop(double duration)
+  {
+    RecordAction();
+    ++m_actions.dropped;
+    m_actions.dropDuration += duration;
+  }
+
+private:
+  void RecordAction()
+  {
+    if (m_actions.muted + m_actions.inserted + m_actions.dropped == 0)
+      m_actions.firstSequence = m_last.sequence;
+    m_actions.lastSequence = m_last.sequence;
+  }
+
+  uint64_t m_epoch{0};
+  uint64_t m_sequence{0};
+  AESyncObservation m_pending;
+  AESyncObservation m_last;
+  AESyncActions m_actions;
+};
