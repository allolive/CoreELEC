+void CActiveAE::TraceSync(CActiveAEStream* stream, const char* event, bool discarded)
+{
+  const auto observation = discarded ? stream->m_syncObservations.Pending(stream->m_id)
+                                     : stream->m_syncObservations.Last();
+  const auto& actions = stream->m_syncObservations.Actions();
+  CLog::Log(LOGDEBUG, LOGAUDIO,
+            "AESYNC event={} stream={} epoch={} seq={} published={} state={} type={} rate={} "
+            "host_us={} first_sample_us={} last_sample_us={} delay_generation={} samples={} "
+            "valid={} finite={} "
+            "saturated={} mixed={} measured_ms={:.6f} raw_ms={:.6f} control_ms={:.6f} scale={} "
+            "clamp_ms={} last_playing_pts_ms={:.6f} last_clock_ms={:.6f} last_delay_ms={:.6f} "
+            "actions_first_seq={} actions_last_seq={} mute_count={} mute_requested_ms={:.6f} "
+            "insert_count={} insert_requested_ms={:.6f} drop_count={} drop_requested_ms={:.6f}",
+            event, stream->m_id, observation.epoch, observation.sequence, !discarded,
+            static_cast<int>(stream->m_syncState),
+            static_cast<int>(stream->m_format.m_streamInfo.m_type), stream->m_format.m_sampleRate,
+            CAESyncObservations::Now(), observation.begin, observation.end,
+            observation.delayGeneration, observation.samples, observation.Valid(),
+            observation.finite, observation.saturated, observation.mixed, observation.measured,
+            observation.raw, observation.control, observation.scale, observation.clamp,
+            observation.playingPts, observation.clock, observation.delay, actions.firstSequence,
+            actions.lastSequence, actions.muted, actions.muteDuration, actions.inserted,
+            actions.insertDuration, actions.dropped, actions.dropDuration);
+  stream->m_syncObservations.ClearActions();
+}
+
+void CActiveAE::ResetSyncObservation(CActiveAEStream* stream, const char* reason)
+{
+  if (stream->m_format.m_dataFormat == AE_FMT_RAW)
+    TraceSync(stream, reason, true);
+  stream->m_syncObservations.Flush();
+}
