From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: allolive <160342668+allolive@users.noreply.github.com>
Date: Sun, 18 Oct 2026 09:30:00 -0400
Subject: [PATCH] VideoPlayer: a preparation waits for a dry source instead of
 timing out

A 3D film's first read from a cold NAS emptied the source cache right
after the display had changed mode: the preparation got its first
picture, then no audio for five seconds, timed out and fell back to an
ordinary start, which waited for the cache all over again and changed
mode a second time - twelve seconds on the first picture.

While the source cache holds under a second and is not at the end of
the file, hold off the preparation's timeout, for up to 20 s from its
start: the wait is the source's, and a fallback would only wait again.

Signed-off-by: allolive <160342668+allolive@users.noreply.github.com>
---
--- a/xbmc/cores/VideoPlayer/PlaybackPreroll.h
+++ b/xbmc/cores/VideoPlayer/PlaybackPreroll.h
@@ -67,11 +67,22 @@
     m_maxTargetAdvance = maxTargetAdvanceUs;
     m_target = requestedTargetPts;
     m_beginUs = nowUs;
+    m_firstBeginUs = nowUs;
     m_lastNowUs = nowUs;
     m_stage = Stage::Preparing;
     return true;
   }
 
+  //! The source has nothing more to give yet. The preparation waits for it
+  //! instead of timing out, the buffering being no fault of its own, for up
+  //! to MAX_SOURCE_WAIT_US from its start.
+  void SourceDry(double nowUs)
+  {
+    if (m_stage != Stage::Preparing || nowUs - m_firstBeginUs > MAX_SOURCE_WAIT_US)
+      return;
+    m_beginUs = std::max(m_beginUs, nowUs - PREPARE_TIMEOUT_US / 2);
+  }
+
   void Cancel()
   {
     m_stage = Stage::Idle;
@@ -104,6 +115,7 @@
     m_stage = Stage::Preparing;
     m_armWhenPrepared = false;
     m_beginUs = nowUs;
+    m_firstBeginUs = nowUs;
     m_lastNowUs = std::max(m_lastNowUs, nowUs);
     return true;
   }
@@ -225,6 +237,7 @@
   static constexpr double MAX_TARGET_ADVANCE_US = 100000.0;
   static constexpr double MAX_SAMPLE_AGE_US = 100000.0;
   static constexpr double PREPARE_TIMEOUT_US = 5000000.0;
+  static constexpr double MAX_SOURCE_WAIT_US = 20000000.0;
   static constexpr double RUN_TIMEOUT_US = 3000000.0;
 
   static bool Nonnegative(double value) { return std::isfinite(value) && value >= 0.0; }
@@ -244,6 +257,7 @@
   double m_maxTargetAdvance = MAX_TARGET_ADVANCE_US;
   double m_target = 0.0;
   double m_beginUs = 0.0;
+  double m_firstBeginUs = 0.0;
   double m_startUs = 0.0;
   double m_lastNowUs = 0.0;
   double m_requiredLead = MIN_RUNWAY_US;
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -4934,6 +4934,9 @@
 
   const auto video = m_renderManager.GetVideoPreroll();
   const double now = m_clock.GetAbsoluteClock();
+  if (m_srcCache.valid && !m_srcCache.endCached && !m_srcCache.endOfInput &&
+      m_srcCache.forwardTime >= 0.0 && m_srcCache.forwardTime < SRC_UNDERRUN_TIME)
+    m_resumePreroll.SourceDry(now);
   if (video.generation != m_resumePreroll.Generation() || video.failed || !video.holding)
   {
     RecoverResumePreroll("video hold was invalidated");
