From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: allolive <160342668+allolive@users.noreply.github.com>
Date: Sun, 18 Oct 2026 06:30:00 -0400
Subject: [PATCH] ActiveAE: aim the first correction after a resync at zero

A start or resume of TrueHD passthrough handed over its first picture
with the audio 15-25 ms late, every time, and the trim then took some
40 s to walk it out.

Two things in the engine's first correction add up to that. The error
it corrects from is the average of the first 100 ms window, and that
window opens while the engine is still filling its queue: the first
samples read up to a frame early (one 20 ms MAT frame on TrueHD; -16.6
against a steady -36.7 ms). And it stops correcting once inside the
30 ms band, which on TrueHD means anything up to 30 ms is kept.

Correct from the last sample of the window, taken with the queue full,
and aim the first correction after a resync at 2 ms rather than the
band: a passthrough frame is dropped even when that overshoots, and the
remainder is given back as a pause of the exact length. This all
happens during the lead-in, before the picture starts. Corrections
after that keep the band.

Signed-off-by: allolive <160342668+allolive@users.noreply.github.com>
---
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index f323c06..27c1e5d 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -49,6 +49,11 @@ constexpr double MAX_LATE_START_MS = 500.0; // late start of audio left to the p
 // loop sees it. Named so the unscaled copy kept beside it has one source.
 constexpr double TRUEHD_SYNC_ERROR_SCALE = 0.45;
 
+// How close the first correction after a resync aims, in milliseconds: it is
+// made before the picture starts, where a skip or a pause costs nothing, and
+// what it leaves is otherwise left to the trim to walk out.
+constexpr double START_SYNC_BAND = 2.0;
+
 //! \brief Retry interval for a sink that will not open, doubling to a ceiling.
 //! A device that returns announces itself, so only a fault that clears by itself needs the
 //! interval to stay short.
@@ -2267,6 +2272,7 @@ bool CActiveAE::RunStages()
         }
         (*it)->m_syncError.Add(error);
         (*it)->m_syncErrorRaw.Add(errorRaw);
+        (*it)->m_lastSyncSample = error;
         if (m_mode == MODE_RAW)
           (*it)->m_syncObservations.Add(errorMeasured, errorRaw, error, (*it)->m_errorScale,
                                         maxError, playingPts, clock, delay, m_syncDelayGeneration,
@@ -2771,14 +2777,28 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
       stream->m_syncErrorRaw.Correction(error);
       stream->m_resampleIntegral = 0;
       stream->m_lateStartHandedOver = true;
+      stream->m_startAdjust = false;
       CLog::Log(LOGDEBUG,
                 "ActiveAE::SyncStream - average error of {:f}, left to the player's clock", error);
     }
     else
     {
+      // The window opened while the engine was still filling its queue, and the
+      // first samples read up to a frame early. The last one is taken with the
+      // queue full: correct from it.
+      const double average = error;
+      if (stream->m_syncError.LastErrorValid())
+      {
+        error = stream->m_lastSyncSample;
+        stream->m_syncError.Correction(error - average);
+        stream->m_syncErrorRaw.Correction((error - average) / stream->m_errorScale);
+      }
       stream->m_syncState = CAESyncInfo::AESyncState::SYNC_ADJUST;
+      stream->m_startAdjust = m_mode != MODE_TRANSCODE;
       stream->m_lastSyncError = error;
-      CLog::Log(LOGDEBUG, "ActiveAE::SyncStream - average error of {:f}, start adjusting", error);
+      CLog::Log(LOGDEBUG,
+                "ActiveAE::SyncStream - error of {:f} (window average {:f}), start adjusting",
+                error, average);
     }
   }
 
@@ -2876,7 +2896,9 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
         // The same crossing as the delay branch: a whole frame of real time
         // goes, and the scaled error is owed only its share of it.
         const double dropped = stream->m_format.m_streamInfo.GetDuration();
-        if (-error / stream->m_errorScale > dropped / 2)
+        // Aiming at zero, a frame goes even when it overshoots: the delay branch
+        // gives back the remainder to the millisecond.
+        if (-error / stream->m_errorScale > (stream->m_startAdjust ? START_SYNC_BAND : dropped / 2))
         {
           stream->m_syncError.Correction(dropped * stream->m_errorScale);
           stream->m_syncErrorRaw.Correction(dropped);
@@ -2903,8 +2925,9 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
 
     // The band is a tolerance on real time - the comment on the scaling calls it
     // a frame - so it is compared in the units the bursts were spent in.
-    if (fabs(error) < 30 * stream->m_errorScale)
+    if (fabs(error) < (stream->m_startAdjust ? START_SYNC_BAND : 30) * stream->m_errorScale)
     {
+      stream->m_startAdjust = false;
       if (stream->m_lastSyncError > threshold * 2)
       {
         stream->m_syncState = CAESyncInfo::AESyncState::SYNC_MUTE;
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
index c3098b0..f050eef 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
@@ -182,6 +182,10 @@ protected:
   //! two always describe the same window.
   CSyncError<XbmcThreads::EndTime<>> m_syncErrorRaw;
   CAESyncObservations m_syncObservations;
+  //! The error measured on the last pass, scaled as the window's samples are.
+  double m_lastSyncSample{0.0};
+  //! The first correction after a resync, which aims at zero rather than the band.
+  bool m_startAdjust{false};
   double m_errorScale{1.0};
   bool m_errorSaturated{false};
   double m_lastSyncError;
