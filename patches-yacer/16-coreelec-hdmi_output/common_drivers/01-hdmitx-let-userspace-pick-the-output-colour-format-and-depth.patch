+const char *hdmitx_cs_name(enum hdmi_colorspace cs)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(parse_cs_); i++)
+		if (cs == parse_cs_[i].cs)
+			return parse_cs_[i].name;
+	return "";
+}
+
+const char *hdmitx_cd_name(enum hdmi_color_depth cd)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(parse_cd_); i++)
+		if (cd == parse_cd_[i].cd)
