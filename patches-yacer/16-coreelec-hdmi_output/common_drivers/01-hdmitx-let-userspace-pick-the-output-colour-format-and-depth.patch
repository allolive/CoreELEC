 }
 EXPORT_SYMBOL(hdmitx_get_attr);
 
+/*
+ * "<rgb|444|422|420>,<8bit|10bit|12bit>[,full|limited]" asks for that output
+ * format at every mode set it is valid for; "", "auto" or a bare newline clears
+ * it. Nothing is kept across a reboot.
+ */
+int hdmitx_common_set_user_attr(struct hdmitx_common *tx_comm, const char *buf)
+{
+	static DEFINE_MUTEX(user_attr_lock);
+	struct hdmitx_user_attr new = { 0 }, old;
+	int cs = -1, cd = -1, v;
+	char tmp[32], *s, *tok;
+	int (*cb)(void *data);
+	void *cb_data;
+	int ret = 0;
+
+	if (strscpy(tmp, buf, sizeof(tmp)) < 0)
+		return -EINVAL;
+	s = strim(tmp);
+	if (*s && strcmp(s, "auto")) {
+		while ((tok = strsep(&s, ","))) {
+			tok = strim(tok);
+			v = hdmitx_cs_from_name(tok);
+			if (v >= 0 && cs < 0) {
+				cs = v;
+				continue;
+			}
+			v = hdmitx_cd_from_name(tok);
+			if (v >= 0 && v <= COLORDEPTH_36B && cd < 0) {
+				cd = v;
+				continue;
+			}
+			if (!strcmp(tok, "full") && !new.cr)
+				new.cr = HDMI_QUANTIZATION_RANGE_FULL;
+			else if (!strcmp(tok, "limited") && !new.cr)
+				new.cr = HDMI_QUANTIZATION_RANGE_LIMITED;
+			else
+				return -EINVAL;
+		}
+		if (cs < 0 || cd < 0)
+			return -EINVAL;
+		if (!new.cr)
+			new.cr = HDMI_QUANTIZATION_RANGE_LIMITED;
+		/* full range ycbcr, or any full range the hw cannot make */
+		if (new.cr == HDMI_QUANTIZATION_RANGE_FULL &&
+		    (cs != HDMI_COLORSPACE_RGB || !tx_comm->user_range_cap))
+			return -EOPNOTSUPP;
+		new.set = true;
+		new.cs = cs;
+		new.cd = cd;
+	}
+
+	mutex_lock(&user_attr_lock);
+	mutex_lock(&tx_comm->valid_mutex);
+	old = tx_comm->user_attr;
+	if (!memcmp(&new, &old, sizeof(new))) {
+		mutex_unlock(&tx_comm->valid_mutex);
+		goto out;
+	}
+	tx_comm->user_attr = new;
+	cb = tx_comm->user_attr_cb;
+	cb_data = tx_comm->user_attr_cb_data;
+	mutex_unlock(&tx_comm->valid_mutex);
+
+	if (new.set)
+		HDMITX_INFO("user_attr %s,%s,%s\n", hdmitx_cs_name(new.cs),
+			    hdmitx_cd_name(new.cd),
+			    new.cr == HDMI_QUANTIZATION_RANGE_FULL ? "full" : "limited");
+	else
+		HDMITX_INFO("user_attr auto\n");
+	/* the mode set takes valid_mutex itself */
+	if (cb)
+		ret = cb(cb_data);
+	if (ret) {
+		HDMITX_ERROR("user_attr commit failed %d, previous value restored\n", ret);
+		mutex_lock(&tx_comm->valid_mutex);
+		tx_comm->user_attr = old;
+		mutex_unlock(&tx_comm->valid_mutex);
+	}
+out:
+	mutex_unlock(&user_attr_lock);
+	return ret;
+}
+EXPORT_SYMBOL(hdmitx_common_set_user_attr);
+
+struct hdmitx_user_attr hdmitx_common_get_user_attr(struct hdmitx_common *tx_comm)
+{
+	struct hdmitx_user_attr ua;
+
+	mutex_lock(&tx_comm->valid_mutex);
+	ua = tx_comm->user_attr;
+	mutex_unlock(&tx_comm->valid_mutex);
+	return ua;
+}
+EXPORT_SYMBOL(hdmitx_common_get_user_attr);
+
+void hdmitx_register_user_attr_cb(struct hdmitx_common *tx_comm,
+				  int (*cb)(void *data), void *data)
+{
+	mutex_lock(&tx_comm->valid_mutex);
+	tx_comm->user_attr_cb = cb;
+	tx_comm->user_attr_cb_data = data;
+	mutex_unlock(&tx_comm->valid_mutex);
+}
+EXPORT_SYMBOL(hdmitx_register_user_attr_cb);
