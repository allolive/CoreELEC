From: allolive <160342668+allolive@users.noreply.github.com>
Subject: [PATCH] hdmitx: let userspace pick the output colour format and depth

A calibration pattern generator needs to send a known format: RGB or YCbCr
444/422/420 at 8, 10 or 12 bit. On the android path CoreELEC runs, the attr
is decided in meson_hdmitx_encoder_atomic_check() and nowhere else; the
attr node is read only, and Kodi as DRM master keeps add-ons off the
connector properties.

Add /sys/class/amhdmitx/amhdmitx0/user_attr, in hdmitx_common:

  echo rgb,10bit,full > user_attr    format and depth required, range
                                     optional, limited by default
  echo > user_attr                   automatic again ("auto" also works)

Malformed input is EINVAL. Full range YCbCr, or full range on hw without
user_range_cap, is EOPNOTSUPP. A change re-commits the current mode with
the connector's update flag set, as a hotplug does; if that commit fails
the old value is restored and write() gets the error. Nothing is saved.

atomic_check validates the request strictly, through a strict mode of the
stock validator (TMDS clock against both ends, cs/cd against the sink), and
stays automatic, logged once, where it does not fit. Dolby Vision, 3D frame
packing, the boot commit and the non-android path stay automatic. With the
node unwritten, the decide condition, validation and format para are stock.

Built against the pinned tree, not run on hardware.

Signed-off-by: allolive <160342668+allolive@users.noreply.github.com>
--- a/drivers/drm/meson_hdmi.c
+++ b/drivers/drm/meson_hdmi.c
@@ -1248,6 +1248,7 @@ struct drm_connector_state *meson_hdmitx_atomic_duplicate_state
 	new_state->allm_mode = cur_state->allm_mode;
 	cur_state->hcs.state_sequence_id = am_hdmi_info.sequence_id;
 	new_state->frac_rate_policy = cur_state->frac_rate_policy;
+	new_state->user_attr_applied = cur_state->user_attr_applied;
 	memcpy(&new_state->hcs, &cur_state->hcs, sizeof(struct hdmitx_common_state));
 
 	return &new_state->base;
@@ -2133,6 +2134,82 @@ void meson_hdmitx_encoder_atomic_disable(struct drm_encoder *encoder,
 	msleep(100);
 }
 
+/*
+ * Put the format asked for through user_attr in place of the attr this mode
+ * set would use, when there is one and the mode set may take it. Returns
+ * true with hdmitx_state->hcs built and strictly validated for it. On false
+ * the stock validation runs on *attr, decided afresh when a user_attr was
+ * refused or has just stopped applying.
+ */
+static bool meson_hdmitx_user_attr(struct hdmitx_common *common,
+				   struct am_meson_crtc_state *crtc_state,
+				   struct am_hdmitx_connector_state *hdmitx_state,
+				   struct hdmitx_color_attr *attr, char *modename,
+				   u64 sequence_id)
+{
+	/* no padding, so it compares with memcmp() */
+	static struct refusal {
+		int err, clock;
+		u16 hdisplay, vdisplay, cs, cd;
+	} last_refused;
+	struct refusal refused;
+	const struct drm_display_mode *mode = &crtc_state->base.adjusted_mode;
+	/* a user_attr that stops applying leaves its attr behind: decide */
+	bool decide = hdmitx_state->user_attr_applied;
+	struct hdmitx_user_attr ua;
+	char attr_str[HDMITX_ATTR_LEN_MAX];
+	int bitdepth, ret;
+
+	hdmitx_state->user_attr_applied = false;
+	/* the boot commit keeps what uboot set up without a mode set */
+	if (!am_hdmi_info.android_path ||
+	    (crtc_state->uboot_mode_init == 1 && !hdmitx_state->update))
+		return false;
+	/* 3D frame packing and dolby vision pick their own format */
+	if (common->flag_3dfp || is_amdv_output_dv() ||
+	    crtc_state->crtc_eotf_type == HDMI_EOTF_MESON_DOLBYVISION ||
+	    crtc_state->crtc_eotf_type == HDMI_EOTF_MESON_DOLBYVISION_LL)
+		goto automatic;
+
+	ua = hdmitx_common_get_user_attr(common);
+	if (!ua.set)
+		goto automatic;
+
+	bitdepth = colordepth_to_bitdepth(ua.cd);
+	build_hdmitx_attr_str(attr_str, ua.cs, bitdepth);
+	ret = hdmitx_common_validate_user_mode_locked(common, &hdmitx_state->hcs,
+						      modename, attr_str,
+						      crtc_state->valid_brr);
+	if (ret) {
+		refused = (struct refusal){ ret, mode->clock, mode->hdisplay,
+					    mode->vdisplay, ua.cs, ua.cd };
+		if (memcmp(&refused, &last_refused, sizeof(refused))) {
+			DRM_INFO("user_attr %s refused for %s (%d), automatic\n",
+				 attr_str, modename, ret);
+			last_refused = refused;
+		}
+		decide = true;
+		goto automatic;
+	}
+	memset(&last_refused, 0, sizeof(last_refused));
+
+	attr->colorformat = ua.cs;
+	attr->bitdepth = bitdepth;
+	hdmitx_state->user_attr_applied = true;
+	/* only where the hw puts the range out as asked, see user_range_cap */
+	if (common->user_range_cap) {
+		hdmitx_state->hcs.para.cr = ua.cr;
+		hdmitx_state->hcs.para.user_attr = true;
+	}
+	DRM_DEBUG_KMS("user_attr %s applied for %s\n", attr_str, modename);
+	return true;
+
+automatic:
+	if (decide)
+		meson_hdmitx_decide_color_attr(common, crtc_state, attr, sequence_id);
+	return false;
+}
+
 static int meson_hdmitx_encoder_atomic_check(struct drm_encoder *encoder,
 					     struct drm_crtc_state *crtc_state,
 					     struct drm_connector_state *conn_state)
@@ -2193,6 +2270,9 @@ static int meson_hdmitx_encoder_atomic_check(struct drm_encoder *encoder,
 		meson_hdmitx_decide_color_attr(common, meson_crtc_state,
 						 attr, sequence_id);
 
+	if (meson_hdmitx_user_attr(common, meson_crtc_state, hdmitx_state, attr,
+				   modename, sequence_id))
+		goto validated;
 	build_hdmitx_attr_str(attr_str, attr->colorformat, attr->bitdepth);
 
 	ret = hdmitx_common_validate_mode_locked(common, &hdmitx_state->hcs,
@@ -2203,6 +2283,7 @@ static int meson_hdmitx_encoder_atomic_check(struct drm_encoder *encoder,
 		return -EINVAL;
 	}
 
+validated:
 	DRM_DEBUG("vic: %d, cs: %d, cd: %d\n", hdmitx_state->hcs.para.vic,
 		 hdmitx_state->hcs.para.cs, hdmitx_state->hcs.para.cd);
 
@@ -2638,6 +2719,43 @@ static void meson_hdmitx_hpd_cb(void *data)
 	drm_kms_helper_hotplug_event(am_hdmi->base.connector.dev);
 }
 
+/*
+ * user_attr changed: re-run the mode set at the current mode, the way a
+ * hotplug forces one, so the new attr is decided and applied now.
+ */
+static int meson_hdmitx_user_attr_cb(void *data)
+{
+	struct am_hdmi_tx *am_hdmi = data;
+	struct drm_connector *connector = &am_hdmi->base.connector;
+	struct drm_device *dev = connector->dev;
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_atomic_state *state;
+	struct drm_connector_state *conn_state;
+	struct drm_crtc_state *crtc_state;
+	int ret;
+
+	/* no sink: the mode set after the next hotplug picks it up */
+	if (!hdmitx_get_hpd_state(am_hdmi->hdmitx_dev->hdmitx_common))
+		return 0;
+
+	DRM_MODESET_LOCK_ALL_BEGIN(dev, ctx, 0, ret);
+	state = drm_atomic_helper_duplicate_state(dev, &ctx);
+	ret = PTR_ERR_OR_ZERO(state);
+	if (!ret) {
+		conn_state = drm_atomic_get_new_connector_state(state, connector);
+		crtc_state = conn_state && conn_state->crtc ?
+			drm_atomic_get_new_crtc_state(state, conn_state->crtc) : NULL;
+		/* not showing anything: the next mode set picks it up */
+		if (crtc_state && crtc_state->active) {
+			to_am_hdmitx_connector_state(conn_state)->update = true;
+			ret = drm_atomic_commit(state);
+		}
+		drm_atomic_state_put(state);
+	}
+	DRM_MODESET_LOCK_ALL_END(dev, ctx, ret);
+	return ret;
+}
+
 int meson_hdmitx_dev_bind(struct drm_device *drm,
 	int type, struct meson_connector_dev *intf)
 {
@@ -2725,6 +2843,7 @@ int meson_hdmitx_dev_bind(struct drm_device *drm,
 	hpd_cb.callback = meson_hdmitx_hpd_cb;
 	hpd_cb.data = &am_hdmi_info;
 	hdmitx_register_hpd_cb(tx_comm, &hpd_cb);
+	hdmitx_register_user_attr_cb(tx_comm, meson_hdmitx_user_attr_cb, &am_hdmi_info);
 
 	/*hdcp init, default is disable state*/
 	if (!am_hdmi_info.android_path) {
@@ -2790,6 +2909,7 @@ int meson_hdmitx_dev_bind(struct drm_device *drm,
 int meson_hdmitx_dev_unbind(struct drm_device *drm,
 	int type, int connector_id)
 {
+	hdmitx_register_user_attr_cb(am_hdmi_info.hdmitx_dev->hdmitx_common, NULL, NULL);
 	if (am_hdmi_info.hdmitx_dev->hdcp_exit)
 		am_hdmi_info.hdmitx_dev->hdcp_exit();
 
