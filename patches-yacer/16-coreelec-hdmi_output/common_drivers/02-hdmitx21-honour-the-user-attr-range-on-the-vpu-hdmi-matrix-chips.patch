+/* rgb comes out of the VPU_HDMI ycbcr2rgb matrix, see hdmitx_set_dispmode() */
+bool hdmitx21_rgb_via_vpu_matrix(struct hdmitx_dev *hdev)
+{
+	switch (hdev->tx_hw.chip_data->chip_type) {
+	case MESON_CPU_ID_S1A:
+	case MESON_CPU_ID_S7:
+		return true;
+	case MESON_CPU_ID_S7D:
+	case MESON_CPU_ID_S6:
+		return CSC_type == yuv2rgb;
+	default:
+		return false;
+	}
+}
+
+/*
+ * The AVI colorimetry changed without a mode set: have the ycbcr2rgb matrix
+ * of a user_attr format follow it. MMIO only, it may run under the edid spinlock.
+ */
+void hdmitx21_user_attr_colorimetry(const struct hdmi_avi_infoframe *avi)
+{
+	struct hdmitx_dev *hdev = get_hdmitx21_device();
+
+	if (!hdev->tx_comm.fmt_para.user_attr || vpu_hdmi_matrix < 0 ||
+	    avi->colorspace != HDMI_COLORSPACE_RGB || !hdmitx21_rgb_via_vpu_matrix(hdev))
+		return;
+	if (vpu_hdmi_ycbcr2rgb_id(hdev, avi) != vpu_hdmi_matrix)
+		vpu_hdmi_set_matrix_ycbcr2rgb(avi);
+}
+
+/* with every AVI sent: Q and YQ as a user_attr format has them */
+void hdmitx21_user_attr_avi_fixup(struct hdmi_avi_infoframe *info)
+{
+	struct hdmitx_dev *hdev = get_hdmitx21_device();
+
+	if (!user_matrix_active(hdev))
+		return;
+	info->ycc_quantization_range = HDMI_YCC_QUANTIZATION_RANGE_LIMITED;
+	if (info->colorspace != HDMI_COLORSPACE_RGB)
+		info->quantization_range = HDMI_QUANTIZATION_RANGE_DEFAULT;
+	else if (hdmitx21_rgb_via_vpu_matrix(hdev))
+		info->quantization_range =
+			hdev->tx_comm.fmt_para.cr == HDMI_QUANTIZATION_RANGE_FULL ?
+			HDMI_QUANTIZATION_RANGE_FULL : HDMI_QUANTIZATION_RANGE_LIMITED;
+}
