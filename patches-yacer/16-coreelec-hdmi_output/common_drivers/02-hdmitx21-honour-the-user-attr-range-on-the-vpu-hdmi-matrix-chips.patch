+/*
+ * YCbCr -> RGB in S2.10: Y, Cr->R, Cb->G, Cr->G, Cb->B, by [rgb range]
+ * [colorimetry]. Stock always loads [full][601]: 601 limited range YCbCr to
+ * full range RGB. A format from user_attr gets the colorimetry the AVI
+ * declares, into the range it declares; limited adds a 64 offset.
+ */
+enum { YCC2RGB_601, YCC2RGB_709, YCC2RGB_2020, YCC2RGB_NR };
+static const char * const ycbcr2rgb_name[YCC2RGB_NR] = { "601", "709", "2020" };
+static const u32 ycbcr2rgb_coef[2][YCC2RGB_NR][5] = {
+	{	/* limited */
+		{0x400, 0x57c, 0x1ea7, 0x1d35, 0x6ee},
+		{0x400, 0x629, 0x1f44, 0x1e2b, 0x742},
+		{0x400, 0x5c4, 0x1f5b, 0x1dc4, 0x75c},
+	}, {	/* full */
+		{0x4a8, 0x662, 0x1e6f, 0x1cbf, 0x811},
+		{0x4a8, 0x72c, 0x1f26, 0x1dde, 0x873},
+		{0x4a8, 0x6b7, 0x1f40, 0x1d66, 0x891},
+	},
+};
+
+/* the matrix in VPU_HDMI_MATRIX: full * YCC2RGB_NR + colorimetry, or -1 */
+static int vpu_hdmi_matrix = -1;
+
+/* a format from user_attr is on; the dolby vision tunnel keeps the stock matrix */
+static bool user_matrix_active(struct hdmitx_dev *hdev)
+{
+	enum eotf_type eotf = hdev->tx_comm.hdmi_current_eotf_type;
+
+	return hdev->tx_comm.fmt_para.user_attr &&
+	       ((eotf != EOTF_T_DOLBYVISION && eotf != EOTF_T_LL_MODE &&
+		 eotf != EOTF_T_DV_AHEAD) || hdev->hdmi_current_signal_sdr);
+}
+
+/*
+ * The ycbcr2rgb matrix for the rgb @avi declares. @avi is NULL in a mode set,
+ * where construct_avi_packet() has yet to declare 601 up to 576 lines, else 709.
+ */
+static int vpu_hdmi_ycbcr2rgb_id(struct hdmitx_dev *hdev,
+				 const struct hdmi_avi_infoframe *avi)
+{
+	struct hdmi_format_para *para = &hdev->tx_comm.fmt_para;
+	int full = 1, m = YCC2RGB_601;
+
+	if (!user_matrix_active(hdev))
+		return full * YCC2RGB_NR + m;
+	full = para->cr == HDMI_QUANTIZATION_RANGE_FULL;
+	if (!avi)
+		m = para->timing.v_active <= 576 ? YCC2RGB_601 : YCC2RGB_709;
+	else if (avi->colorimetry == HDMI_COLORIMETRY_EXTENDED &&
+		 avi->extended_colorimetry == HDMI_EXTENDED_COLORIMETRY_BT2020)
+		m = YCC2RGB_2020;
+	else if (avi->colorimetry != HDMI_COLORIMETRY_ITU_601)
+		m = YCC2RGB_709;
+	return full * YCC2RGB_NR + m;
+}
