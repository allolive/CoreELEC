+    if (generation)
+      CLog::Log(LOGDEBUG, "Subtitle translation: line at {:.1f} s read {:.1f} s ahead of playback",
+                start / DVD_TIME_BASE,
+                (start - KODI::SUBTITLES::AI::PlaybackTime()) / DVD_TIME_BASE);
+  }
+  m_cues.Submit(std::move(text), start, stop);
+}
