 class CDVDDemux;
 class CDVDInputStream;
 class CDVDStreamInfo;
+struct DemuxPacket;
 
 namespace KODI::SUBTITLES
 {
-namespace MODEL
+/*!
+ * \brief A subtitle track of the playing video read ahead of playback, in a demuxer of its own:
+ * the video opened again as playback opens it - a disc's playlist through the disc - so both
+ * count time from the same start. Closing lets its thread go: it ends once a read stalled on the
+ * network returns, and closing waits only for a packet being handed on, never for the network.
+ */
+class CReadAhead
 {
-class CCueWorker;
-}
+public:
+  //! A packet of the track, with the seek it was read after (match's Generation()), on the
+  //! read-ahead's thread; freed after. Never called once the read-ahead is closed.
+  using Packet = std::function<void(DemuxPacket* packet, unsigned int generation)>;
+  //! The track is read again from elsewhere: what was half decoded goes.
+  using Restart = std::function<void()>;
+
+  enum class Mode
+  {
+    WHOLE, //!< the whole film, a minute ahead of playback; a disc too
+    CATCH_UP, //!< a file only, a minute from where playback opens or seeks to, then no more
+  };
+
+  /*!
+   * \param name how the log names the subtitle ("Subtitle pictures")
