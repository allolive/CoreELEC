+struct CReadAhead::State
+{
+  void Run();
+  //! Wait as long as this, or until closed or moved again.
+  void Wait(std::unique_lock<std::mutex>& guard, std::chrono::milliseconds time)
+  {
+    m_wake.wait_for(guard, time, [this] { return m_stop || m_seek; });
+  }
+  //! f(), unless closed: what it reaches may be gone then.
+  template<class F>
+  bool Call(F f)
+  {
+    std::unique_lock guard(m_callLock);
+    if (m_closed)
+      return false;
+    f();
+    return true;
+  }
+
+  std::string m_video;
+  int m_id;
+  int m_codec;
+  std::string m_name;
+  Mode m_mode;
+  const MODEL::CAheadMatch* m_match; //!< reached only through Call
+  Packet m_packet;
+  Restart m_restart;
+  std::mutex m_lock;
+  std::condition_variable m_wake;
+  std::shared_ptr<CDVDInputStream> m_input; //!< the video read, to abort
+  bool m_stop{false};
+  bool m_seek{true};
+  std::optional<double> m_before; //!< where playback was before the seek, until it moves
+  std::mutex m_callLock; //!< held while a packet is handed on, and to close
+  bool m_closed{false};
+};
+
+CReadAhead::CReadAhead(const CDVDStreamInfo& hints,
+                       std::string name,
+                       const MODEL::CAheadMatch& match,
+                       Packet packet,
+                       Restart restart,
+                       Mode mode)
+  : m_state(std::make_shared<State>())
+{
+  m_state->m_video = hints.video;
+  m_state->m_id = hints.uniqueId;
+  m_state->m_codec = hints.codec;
+  m_state->m_name = std::move(name);
+  m_state->m_mode = mode;
+  m_state->m_match = &match;
+  m_state->m_packet = std::move(packet);
+  m_state->m_restart = std::move(restart);
+  std::thread([state = m_state] { state->Run(); }).detach();
+}
+
+CReadAhead::~CReadAhead()
+{
+  {
+    std::unique_lock guard(m_state->m_lock);
+    m_state->m_stop = true;
+    if (m_state->m_input)
+      m_state->m_input->Abort();
+  }
+  m_state->m_wake.notify_all();
+  std::unique_lock guard(m_state->m_callLock);
+  m_state->m_closed = true;
+}
+
+void CReadAhead::Seek()
+{
+  {
+    std::unique_lock guard(m_state->m_lock);
+    m_state->m_seek = true;
+    // the player moves its clock after the streams are flushed
+    m_state->m_before = AI::PlaybackTime();
+  }
+  m_state->m_wake.notify_all();
+}
+
+void CReadAhead::State::Run()
+{
+  using namespace std::chrono_literals;
+  CFileItem item(m_video, false);
+  std::shared_ptr<CDVDInputStream> input = CDVDFactoryInputStream::CreateInputStream(nullptr, item);
+  // a file without the player's cache, which would only hold a second copy of what it reads; a
+  // disc through its own navigation
+  if (input && input->IsStreamType(DVDSTREAM_TYPE_FILE))
+    input = std::make_shared<CDVDInputStreamFile>(
+        item, XFILE::READ_TRUNCATED | XFILE::READ_BITRATE | XFILE::READ_NO_CACHE);
+  else if (m_mode == Mode::CATCH_UP)
+    input.reset();
+  {
+    std::unique_lock guard(m_lock);
+    if (m_stop)
+      return;
+    m_input = input;
+  }
+  const auto release = [this]
+  {
+    std::unique_lock guard(m_lock);
+    m_input.reset();
+  };
+  if (!input || !input->Open())
+  {
+    CLog::Log(LOGINFO, "{}: {} cannot be read ahead", m_name, CURL::GetRedacted(m_video));
+    release();
+    return;
+  }
+  std::unique_ptr<CDVDDemux> demux(CDVDFactoryDemuxer::CreateDemuxer(input, false));
+  const CDemuxStream* track = nullptr;
+  for (const CDemuxStream* stream : demux ? demux->GetStreams() : std::vector<CDemuxStream*>{})
+    if (stream && stream->type == StreamType::SUBTITLE && stream->uniqueId == m_id &&
+        stream->codec == m_codec)
+      track = stream;
+  if (!track)
+  {
+    CLog::Log(LOGINFO, "{}: the track is not found again to read it ahead", m_name);
+    demux.reset();
+    release();
+    return;
+  }
+  CLog::Log(LOGDEBUG, "{}: reading the track ahead of playback", m_name);
+
+  const bool whole = m_mode == Mode::WHOLE;
+  const double pace = whole ? READ_PACE : CATCH_UP_PACE;
+  double target = 0; //!< where playback went
+  double reached = 0; //!< where the reading is, in the stream's time
+  double from = 0; //!< and where it was after the last seek
+  auto since = std::chrono::steady_clock::now();
+  unsigned int generation = 0;
+  bool caughtUp = false;
+  int failures = 0;
+  while (true)
+  {
+    {
+      std::unique_lock guard(m_lock);
+      if (m_stop)
+        break;
+      if (m_seek)
+      {
+        m_seek = false;
+        // where playback goes: the player's time once it moves off where it was
+        const std::optional<double> before = std::exchange(m_before, std::nullopt);
+        for (int i = 0; before && i < 40 && !m_stop && !m_seek && AI::PlaybackTime() == *before;
+             ++i)
+          Wait(guard, 50ms);
+        if (m_stop || m_seek)
+          continue;
+        guard.unlock();
+        if (!Call([&] { generation = m_match->Generation(); }))
+          break;
+        target = AI::PlaybackTime();
+        // from a little before, the subtitle shown then included
+        demux->SeekTime(std::max(0.0, target / 1000.0 - 5000.0), true);
+        if (m_restart && !Call(m_restart))
+          break;
+        reached = 0;
+        from = 0;
+        since = std::chrono::steady_clock::now();
+        caughtUp = false;
+        failures = 0;
+        continue;
+      }
+      // a minute ahead, or read faster than its pace - with a minute's head start for the whole
+      // film only: wait; caught up, until playback moves
+      const double read = reached - from;
+      const double allowed =
+          pace * DVD_TIME_BASE *
+              std::chrono::duration<double>(std::chrono::steady_clock::now() - since).count() +
+          (whole ? READ_AHEAD / 6 : 0);
+      if (!whole && !caughtUp && reached > target + READ_AHEAD)
+      {
+        caughtUp = true;
+        CLog::Log(LOGDEBUG, "{}: read a minute ahead of {:.1f} s: no further until a seek",
+                  m_name, target / DVD_TIME_BASE);
+      }
+      if (caughtUp ||
+          (reached > 0 && (reached > AI::PlaybackTime() + READ_AHEAD || read > allowed)))
+      {
+        Wait(guard, 500ms);
+        continue;
+      }
+    }
+    DemuxPacket* packet = demux->Read();
+    if (!packet)
+    {
+      std::unique_lock guard(m_lock);
+      if (m_stop)
+        break;
+      // a read that failed - the network - before the end: from where it was, a few times
+      if (!input->IsEOF() && reached > 0)
+      {
+        if (++failures > READ_RETRIES)
+        {
+          CLog::Log(LOGWARNING, "{}: reading ahead stopped at {:.1f} s: the video cannot be read",
+                    m_name, reached / DVD_TIME_BASE);
+          break;
+        }
+        Wait(guard, 1s);
+        guard.unlock();
+        demux->SeekTime(reached / 1000.0, false);
+        continue;
+      }
+      // the end, or nothing yet: until a seek
+      Wait(guard, 1s);
+      continue;
+    }
+    failures = 0;
+    if (packet->pts != DVD_NOPTS_VALUE)
+    {
+      if (from == 0)
+        from = packet->pts;
+      reached = std::max(reached, packet->pts);
+    }
+    bool open = true;
+    if (packet->iStreamId == track->uniqueId)
+      open = Call([&] { m_packet(packet, generation); });
+    CDVDDemuxUtils::FreeDemuxPacket(packet);
+    bool missed = false;
+    if (!open || !Call([&] { missed = m_match->Missed(); }) || missed)
+      break;
+  }
+  demux.reset();
+  release();
+}
