+CAheadMatch::Take CAheadMatch::Hand(double start, const std::string& key, unsigned int generation)
+{
+  // the same cue from both paths starts within this
+  constexpr double SAME = 10000;
+  // how far behind its latest the read-ahead may be missing a cue the player read, timing aside
+  constexpr double BEHIND = 2000000;
+  if (generation && generation != m_generation)
+    return Take::STALE;
+  if (!m_seen.emplace(std::llround(start / SAME), key).second)
+    return Take::AGAIN;
+  if (generation)
+    m_aheadUpTo = std::max(m_aheadUpTo, start);
+  else if (!m_missed && m_aheadUpTo > start + BEHIND)
+  {
+    m_missed = true;
+    return Take::MISSED;
+  }
+  return Take::FIRST;
+}
+
+void CAheadMatch::Seek()
+{
+  ++m_generation;
+  m_seen.clear();
+  m_aheadUpTo = 0;
+}
