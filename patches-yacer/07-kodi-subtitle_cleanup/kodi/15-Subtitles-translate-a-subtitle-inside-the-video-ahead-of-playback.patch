+{
+  // under the lock, so the repair and the worker get the cues one at a time, and a seek waits
+  std::unique_lock guard(m_handLock);
+  if (m_readsAhead)
+  {
+    using Take = KODI::SUBTITLES::MODEL::CAheadMatch::Take;
+    const Take take = m_match.Hand(start, text, generation);
+    if (take == Take::STALE || take == Take::AGAIN)
+      return;
+    if (take == Take::MISSED)
+      CLog::Log(LOGWARNING, "Subtitle translation: the read-ahead missed a line at {:.1f} s: stopped",
