+constexpr size_t EDGE_CUES = 3;
+
+bool ContainsAny(const std::wstring& lower, std::initializer_list<const wchar_t*> needles)
+{
+  for (const wchar_t* needle : needles)
+    if (lower.find(needle) != std::wstring::npos)
+      return true;
+  return false;
+}
+
+bool HasWordBy(const std::wstring& lower)
+{
+  auto word = [](wchar_t c) { return IsAsciiLetter(c) || IsAsciiDigit(c) || c == L'_'; };
+  for (size_t at = lower.find(L"by"); at != std::wstring::npos; at = lower.find(L"by", at + 1))
+    if ((at == 0 || !word(lower[at - 1])) && (at + 2 == lower.size() || !word(lower[at + 2])))
+      return true;
+  return false;
+}
+
+//! Every alternative of AdAnywhere() holds one of these words, so a line holding none cannot
+//! match it and the regex, slow over so many alternatives, need not run.
+bool MayBeAd(const std::wstring& lower)
+{
+  return ContainsAny(lower, {L"opensubtitles", L"osdb.link", L"addic7ed", L"subscene",
+                             L"podnapisi", L"titlovi", L"yify", L"yts", L"explosiveskull",
+                             L"advertise your", L"vip member", L"remove all ads", L"please rate",
+                             L"help other users", L"danishbits", L"admit", L"4kvod", L"playships",
+                             L"iptv.cat", L"released on", L"kaboomskull", L"saveanilluminati",
+                             L"subtitle", L"tv series and live", L"live tv", L"la tv live",
+                             L"browser of future", L"code", L"discount on your next",
+                             L"watch any video", L"watch more movies", L"aidez les autres",
+                             L"professional translation", L"translat", L"vertal", L"versatt",
+                             L"traducere", L"improved", L"ripped", L"sync", L"sous-titre"}) ||
+         HasWordBy(lower);
+}
+
+//! The same for AdAtEdges().
+bool MayBeAdAtEdge(const std::wstring& lower)
+{
+  return ContainsAny(lower, {L"http", L"www.", L"@", L"downloaded from", L"find us on the web"});
+}
+
+//! A line is removed only for what it says itself, never for the line it shares a cue with:
+//! "Woohoo" and "WWW.CRAZY-TORRENT.COM" can be one cue, and "Woohoo" is the film.
+bool IsAd(const std::wstring& line, bool atEdge)
+{
+  const std::wstring text = Visible(line);
+  const std::wstring lower = AsciiLower(text);
+  return (MayBeAd(lower) && std::regex_search(text, AdAnywhere())) ||
+         (atEdge && MayBeAdAtEdge(lower) && std::regex_search(text, AdAtEdges()));
+}
+
+//! Nothing but markup and ASCII white space.
+bool OnlyMarkup(const std::wstring& line)
+{
+  const std::wstring visible = Visible(line);
+  return std::all_of(visible.begin(), visible.end(), [](wchar_t c) {
+    return c == L' ' || c == L'\t' || c == L'\n' || c == L'\r' || c == L'\f' || c == L'\v';
+  });
+}
