+namespace
+{
+void RepairSubRip(const std::string& file, const std::string& raw, std::string& data)
+{
+  using namespace KODI::SUBTITLES::CLEANUP;
+  Options options;
+  if (!CurrentOptions(options))
+    return;
+  // a character set the user chose wins over the one the file's name suggests
+  const bool userCharset =
+      CServiceBroker::GetSettingsComponent()->GetSettings()->GetString(
+          CSettings::SETTING_SUBTITLES_CHARSET) != "DEFAULT";
+  std::string repaired;
+  Report report;
+  const std::shared_ptr<const Packs> packs = options.fixOcr ? InstalledPacks() : nullptr;
+  if (!CleanSubRip(userCharset ? data : raw, LanguageOfPath(file), options, packs.get(),
+                   DetectLanguage, repaired, report) ||
+      !report.Changed())
+    return;
+  data = std::move(repaired);
+  CLog::Log(LOGINFO,
+            "Subtitle repair: {} read as {}; {} lines with damaged characters, {} music notes, "
+            "{} letters, {} timings corrected; {} advertising lines removed ({} cues)",
+            CURL::GetRedacted(file), report.readAs, report.repairedLines, report.notesFixed,
+            report.ocrFixes, report.timingFixes, report.adLines, report.cuesDropped);
+  if (!report.ocrLanguage.empty())
+    CLog::Log(LOGDEBUG, "Subtitle repair: OCR letters read in {}, misreadings {}",
+              report.ocrLanguage, report.ocrPattern.empty() ? "none" : report.ocrPattern);
+  for (const std::string& line : report.removed)
+    CLog::Log(LOGDEBUG, "Subtitle repair: removed \"{}\"", line);
+  for (const std::string& fix : report.corrected)
+    CLog::Log(LOGDEBUG, "Subtitle repair: {}", fix);
+}
