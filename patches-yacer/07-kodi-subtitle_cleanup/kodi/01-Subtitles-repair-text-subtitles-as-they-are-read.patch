+const std::unordered_map<wchar_t, wchar_t>& UpperToLower()
+{
+  static const std::unordered_map<wchar_t, wchar_t> table = [] {
+    std::unordered_map<wchar_t, wchar_t> t;
+    for (const CaseRun& run : CASE_RUNS)
+      for (uint32_t cp = run.first; cp <= run.last; cp += run.step)
+        t[static_cast<wchar_t>(cp)] = static_cast<wchar_t>(static_cast<int>(cp) + run.delta);
+    return t;
+  }();
+  return table;
+}
+
+const std::unordered_set<wchar_t>& Lowers()
+{
+  static const std::unordered_set<wchar_t> set = [] {
+    std::unordered_set<wchar_t> s;
+    for (const auto& [upper, lower] : UpperToLower())
+      s.insert(lower);
+    return s;
+  }();
+  return set;
+}
+
+bool IsUpper(wchar_t c)
+{
+  return UpperToLower().count(c) > 0;
+}
+
+bool IsLower(wchar_t c)
+{
+  return Lowers().count(c) > 0;
+}
+
+wchar_t Lower(wchar_t c)
+{
+  const auto it = UpperToLower().find(c);
+  return it == UpperToLower().end() ? c : it->second;
+}
+
+//! ASCII letters and digits, the "|" an OCR puts for "l" or "I", and any character beyond
+//! ASCII that is not white space, punctuation or a symbol: an accented or non-Latin letter
+//! belongs to its word ("là", "Hélène", "lähden"), so the "l" in it is not a word of its own.
+bool IsWordChar(wchar_t c)
+{
+  const uint32_t cp = static_cast<uint32_t>(c);
+  if (cp < 0x80)
+    return IsAsciiLetter(c) || IsAsciiDigit(c) || c == L'|';
+  return !(IsSpace(c) || cp <= 0xBF || cp == 0xD7 || cp == 0xF7 ||
+           (cp >= 0x2000 && cp <= 0x2BFF) || (cp >= 0x3000 && cp <= 0x303F) ||
+           (cp >= 0xFE10 && cp <= 0xFE6F) || (cp >= 0xFF00 && cp <= 0xFF0F) ||
+           (cp >= 0x1F000 && cp <= 0x1FAFF) || cp == 0xFEFF);
+}
+
+bool IsLetter(wchar_t c)
+{
+  return IsWordChar(c) && !IsAsciiDigit(c) && c != L'|';
+}
+
+bool IsApostrophe(wchar_t c)
+{
+  return c == L'\'' || c == 0x2019;
+}
+
+bool HasLetter(const std::wstring& w)
+{
+  return std::any_of(w.begin(), w.end(), IsLetter);
+}
+
+//! Every cased letter a capital, and at least one.
+bool AllUpper(const std::wstring& w)
+{
+  return std::any_of(w.begin(), w.end(), IsUpper) && std::none_of(w.begin(), w.end(), IsLower);
+}
+
+bool AllLower(const std::wstring& w)
+{
+  return std::any_of(w.begin(), w.end(), IsLower) && std::none_of(w.begin(), w.end(), IsUpper);
+}
+
+using Spans = std::vector<std::pair<size_t, size_t>>;
+
+//! The words of a text as (start, length): word characters, joined by an apostrophe followed
+//! by more of them ("l'm", "couldn’t").
+Spans Words(const std::wstring& text)
+{
+  Spans words;
+  size_t i = 0;
+  while (i < text.size())
+  {
+    if (!IsWordChar(text[i]))
+    {
+      ++i;
+      continue;
+    }
+    const size_t start = i;
+    while (i < text.size() && IsWordChar(text[i]))
+      ++i;
+    while (i + 1 < text.size() && IsApostrophe(text[i]) && IsWordChar(text[i + 1]))
+    {
+      ++i;
+      while (i < text.size() && IsWordChar(text[i]))
+        ++i;
+    }
+    words.emplace_back(start, i - start);
+  }
+  return words;
+}
+
+bool Contains(const wchar_t* set, wchar_t c)
+{
+  return c != 0 && std::wcschr(set, c) != nullptr;
+}
+
+//! A capital after a small letter, or a digit among letters, is no word's spelling; and a
+//! Roman numeral is never what a misread word was ("Il Mondo" is not "II Mondo").
+bool PlausibleWord(const std::wstring& w)
+{
+  for (size_t i = 0; i + 1 < w.size(); ++i)
+    if (IsLower(w[i]) && IsUpper(w[i + 1]))
+      return false;
+  if (w.size() > 1 &&
+      std::all_of(w.begin(), w.end(), [](wchar_t c) { return Contains(L"IVXLCDM", c); }))
+    return false;
+  return !(std::any_of(w.begin(), w.end(), IsAsciiDigit) && HasLetter(w));
+}
+
+//! A one-letter word stands on its own: joined by a hyphen to a letter it is a stutter or a
+//! word spelt out ("l-l-low", "l-T-H"); inside punctuation, a damaged word ("Sa?l"). A dash
+//! that ends there ("l-- I'm sorry") breaks off a word.
+bool Alone(const std::wstring& text, size_t start, size_t length)
+{
+  bool beforeOk;
+  if (start > 0 && text[start - 1] == L'-')
+    beforeOk = start < 2 || IsSpace(text[start - 2]);
+  else
+    beforeOk = start == 0 || IsSpace(text[start - 1]) ||
+               Contains(L"\"'([“‘¿¡*.…", text[start - 1]);
+  const size_t rest = start + length;
+  if (rest < text.size() && text[rest] == L'-')
+  {
+    size_t end = rest;
+    while (end < text.size() && text[end] == L'-')
+      ++end;
+    return beforeOk && (end == text.size() || IsSpace(text[end]));
+  }
+  return beforeOk && (rest == text.size() || IsSpace(text[rest]) ||
+                      Contains(L".,!?;:)]\"”’…*", text[rest]));
+}
+
+std::vector<std::wstring> SplitSpaces(const std::wstring& s)
+{
+  std::vector<std::wstring> out;
+  std::wstring cur;
+  for (const wchar_t c : s)
+  {
+    if (IsSpace(c))
+    {
+      if (!cur.empty())
+        out.push_back(std::move(cur));
+      cur.clear();
+    }
+    else
+      cur.push_back(c);
+  }
+  if (!cur.empty())
+    out.push_back(std::move(cur));
+  return out;
+}
+
+//! w with the confusion undone at some of the places it could apply: every choice of them,
+//! fewest first, or all at once when there are more than four.
+std::vector<std::wstring> Variants(const std::wstring& w, const Confusion& confusion)
+{
+  const auto& [wrong, right] = confusion;
+  std::vector<size_t> spots;
+  for (size_t i = w.find(wrong); i != std::wstring::npos; i = w.find(wrong, i + wrong.size()))
+    spots.push_back(i);
+  if (spots.empty())
+    return {};
+  std::vector<std::vector<size_t>> choices;
+  if (spots.size() <= 4)
+  {
+    for (unsigned mask = 1; mask < (1u << spots.size()); ++mask)
+    {
+      std::vector<size_t> chosen;
+      for (size_t k = 0; k < spots.size(); ++k)
+        if (mask >> k & 1)
+          chosen.push_back(spots[k]);
+      choices.push_back(std::move(chosen));
+    }
+    std::sort(choices.begin(), choices.end(), [](const auto& a, const auto& b) {
+      return a.size() != b.size() ? a.size() < b.size() : a < b;
+    });
+  }
+  else
+    choices.push_back(spots);
+  std::vector<std::wstring> out;
+  for (const std::vector<size_t>& chosen : choices)
+  {
+    std::wstring v;
+    size_t last = 0;
+    for (const size_t s : chosen)
+    {
+      v += w.substr(last, s - last) + right;
+      last = s + wrong.size();
+    }
+    out.push_back(v + w.substr(last));
+  }
+  return out;
+}
+
+//! What w could have been through the given confusions, in any mix, in a fixed order.
+std::vector<std::wstring> Candidates(const std::wstring& w, const std::vector<Confusion>& confusions)
+{
+  std::unordered_set<std::wstring> found{w};
+  std::vector<std::wstring> order{w};
+  for (const Confusion& confusion : confusions)
+  {
+    const size_t bases = order.size();
+    for (size_t b = 0; b < bases; ++b)
+      for (std::wstring& v : Variants(order[b], confusion))
+        if (!found.count(v) && order.size() < MAX_CANDIDATES)
+        {
+          found.insert(v);
+          order.push_back(std::move(v));
+        }
+  }
+  order.erase(order.begin());
+  return order;
+}
+
+// -- SubRip ----------------------------------------------------------------------------------
+
+struct Cue
+{
+  std::wstring number; // as written; renumbered only when a cue is dropped
+  std::wstring timing; // the "-->" line
+  std::vector<std::wstring> lines;
+};
+
+struct Block
+{
+  std::optional<Cue> cue; // or text that is not a cue, kept verbatim
+  std::wstring raw;
+};
+
+std::vector<Block> Parse(const std::wstring& source)
+{
+  std::wstring text = UnixLines(source);
+  const size_t first = text.find_first_not_of(L'\n');
+  if (first == std::wstring::npos)
+    return {};
+  text = text.substr(first, text.find_last_not_of(L'\n') + 1 - first);
+
+  // blocks are separated by a line that is empty or holds only spaces and tabs
+  std::vector<std::wstring> raws;
+  size_t start = 0;
+  size_t i = 0;
+  while (i < text.size())
+  {
+    if (text[i] != L'\n')
+    {
+      ++i;
+      continue;
+    }
+    size_t j = i + 1;
+    while (j < text.size() && (text[j] == L' ' || text[j] == L'\t'))
+      ++j;
+    if (j < text.size() && text[j] == L'\n')
+    {
+      raws.push_back(text.substr(start, i - start));
+      start = j + 1;
+      i = j + 1;
+    }
+    else
+      ++i;
+  }
+  raws.push_back(text.substr(start));
+
+  std::vector<Block> blocks;
+  for (const std::wstring& raw : raws)
+  {
+    if (Strip(raw).empty())
+      continue;
+    std::vector<std::wstring> lines = Split(raw, L'\n');
+    size_t lead = 0;
+    while (lead < lines.size() && Strip(lines[lead]).empty()) // after a whitespace-only line
+      ++lead;
+    lines.erase(lines.begin(), lines.begin() + lead);
+    std::optional<size_t> timingAt;
+    for (size_t k = 0; k < lines.size() && k < 3; ++k)
+    {
+      if (lines[k].find(L"-->") != std::wstring::npos)
+      {
+        timingAt = k;
+        break;
+      }
+    }
+    if (!timingAt)
+    {
+      blocks.push_back({std::nullopt, raw});
+      continue;
+    }
+    // the number is the line before the timing; one before it ("776" in "776/799/...") is a
+    // stray the source left, kept with the number so nothing is lost
+    Cue cue;
+    cue.number = Join({lines.begin(), lines.begin() + *timingAt}, L"\n");
+    cue.timing = lines[*timingAt];
+    cue.lines.assign(lines.begin() + *timingAt + 1, lines.end());
+    blocks.push_back({std::move(cue), raw});
+  }
+  return blocks;
+}
+
+std::wstring Serialize(const std::vector<Block>& blocks, bool renumber)
+{
+  std::vector<std::wstring> out;
+  int n = 0;
+  for (const Block& block : blocks)
+  {
+    if (!block.cue)
+    {
+      out.push_back(block.raw);
+      continue;
+    }
+    ++n;
+    const Cue& cue = *block.cue;
+    const std::wstring number = renumber ? std::to_wstring(n) : cue.number;
+    std::vector<std::wstring> parts;
+    if (!number.empty())
+      parts.push_back(number);
+    parts.push_back(cue.timing);
+    parts.insert(parts.end(), cue.lines.begin(), cue.lines.end());
+    out.push_back(Join(parts, L"\n"));
+  }
+  return Join(out, L"\n\n") + L"\n";
+}
+
+// -- timing ----------------------------------------------------------------------------------
+
+#define STAMP L"(\\d{1,2}):(\\d{2}):(\\d{2})([,.])(\\d{1,3})"
+
+const std::wregex& TimingLine()
+{
+  static const std::wregex r =
+      Pattern(L"^(\\s*)" STAMP L"(\\s*\\S*?-->\\S*?\\s*)" STAMP L"(.*)$");
+  return r;
+}
+
+#undef STAMP
+
+const std::wregex& PositionTag()
+{
+  static const std::wregex r = Pattern(L"\\{\\\\an(\\d)\\}");
+  return r;
+}
+
+int PositionOf(const std::wstring& text)
+{
+  std::wsmatch m;
+  if (std::regex_search(text, m, PositionTag()))
+    return static_cast<int>(m.str(1)[0] - L'0');
+  return 2;
+}
+
+long long Millis(const std::wstring& h,
+                 const std::wstring& m,
+                 const std::wstring& s,
+                 const std::wstring& frac)
+{
+  std::wstring f = frac;
+  f.resize(3, L'0');
+  return ((std::stoll(h) * 60 + std::stoll(m)) * 60 + std::stoll(s)) * 1000 + std::stoll(f);
+}
+
+std::wstring Stamp(long long ms, wchar_t sep)
+{
+  const long long h = ms / 3600000;
+  const long long m = ms % 3600000 / 60000;
+  const long long s = ms % 60000 / 1000;
+  const long long f = ms % 1000;
+  wchar_t buf[48];
+  swprintf(buf, sizeof(buf) / sizeof(buf[0]), L"%02lld:%02lld:%02lld%lc%03lld", h, m, s,
+           static_cast<wint_t>(sep), f);
+  return buf;
+}
+
+struct Timed
+{
+  Cue* cue{nullptr};
+  bool ok{false};
+  std::wstring lead;
+  std::wstring arrow;
+  std::wstring tail;
+  std::wstring startText;
+  std::wstring endText;
+  wchar_t sep{L','};
+  long long start{0};
+  long long end{0};
+  long long origEnd{0};
+  int position{2};
+};
+
+Timed Read(Cue& cue)
+{
+  Timed t;
+  t.cue = &cue;
+  std::wsmatch m;
+  if (!std::regex_search(cue.timing, m, TimingLine()))
+    return t;
+  t.ok = true;
+  t.lead = m.str(1);
+  t.arrow = m.str(7);
+  t.tail = m.str(13);
+  t.start = Millis(m.str(2), m.str(3), m.str(4), m.str(6));
+  t.end = Millis(m.str(8), m.str(9), m.str(10), m.str(12));
+  t.origEnd = t.end;
+  t.startText = cue.timing.substr(m.position(2), m.position(6) + m.length(6) - m.position(2));
+  t.endText = cue.timing.substr(m.position(8), m.position(12) + m.length(12) - m.position(8));
+  t.sep = m.str(11)[0];
+  t.position = PositionOf(Join(cue.lines, L" "));
+  return t;
+}
+
+//! Only timing that is plainly broken; a start time is never moved.
+void FixTiming(std::vector<Cue*>& cues, Report& report)
+{
+  std::vector<Timed> timed;
+  timed.reserve(cues.size());
+  for (Cue* cue : cues)
+    timed.push_back(Read(*cue));
+  std::vector<const Timed*> following(timed.size(), nullptr); // the next readable cue
+  const Timed* upcoming = nullptr;
+  for (size_t i = timed.size(); i-- > 0;)
+  {
+    following[i] = upcoming;
+    if (timed[i].ok)
+      upcoming = &timed[i];
+  }
+  for (size_t i = 0; i < timed.size(); ++i)
+  {
+    Timed& t = timed[i];
+    if (!t.ok)
+      continue;
+    const Timed* next = following[i];
+    const bool nextStarts = next && next->start > t.start;
+    if (t.end - t.start < MIN_SHOWN_MS)
+    {
+      long long target = t.start + READABLE_MS;
+      if (nextStarts)
+        target = std::min(target, next->start);
+      if (target > t.end)
+        t.end = target;
+    }
+    else if (nextStarts && next->position == t.position &&
+             t.end - next->start >= MIN_OVERLAP_MS && t.end - next->start <= MAX_SLOP_MS)
+      t.end = next->start;
+  }
+  for (Timed& t : timed)
+  {
+    if (!t.ok)
+      continue;
+    const bool arrowJunk = Strip(t.arrow) != L"-->";
+    if (t.end == t.origEnd && !arrowJunk)
+      continue;
+    const std::wstring end = t.end != t.origEnd ? Stamp(t.end, t.sep) : t.endText;
+    const std::wstring rewritten = t.lead + t.startText + L" --> " + end + t.tail;
+    const char* what = t.end == t.origEnd                     ? "arrow"
+                       : t.origEnd - t.start < MIN_SHOWN_MS ? "too short"
+                                                              : "overlap";
+    ++report.timingFixes;
+    report.corrected.push_back(std::string(what) + ": " + ToUtf8(t.cue->timing) + " -> " +
+                               ToUtf8(rewritten));
+    t.cue->timing = rewritten;
+  }
+}
