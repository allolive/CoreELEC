+void CDVDOverlayCodecText::RepairTiming(double startTime, double& stopTime, int position)
+{
+  using namespace KODI::SUBTITLES::CLEANUP;
+  constexpr double MS = DVD_TIME_BASE / 1000.0;
+
+  // the previous line: ends where this one starts if it runs briefly into it at the same place,
+  // or if it was lengthened to be seen and this one comes sooner
+  if (m_prevSubId != NO_SUBTITLE_ID && !m_changePrevStopTime && startTime > m_prevStartTime)
+  {
+    const double overlap = m_prevStopTime - startTime;
+    if ((m_prevPosition == position && overlap >= MIN_OVERLAP_MS * MS &&
+         overlap <= MAX_SLOP_MS * MS) ||
+        (m_prevLengthened && overlap > 0))
+      ChangeSubtitleStopTime(m_prevSubId, startTime);
+  }
+
+  // a line up for less than two frames cannot be seen; one whose end comes before its start is
+  // Kodi's to time already
+  m_prevLengthened = stopTime >= startTime && stopTime - startTime < MIN_SHOWN_MS * MS;
+  if (m_prevLengthened)
+    stopTime = startTime + READABLE_MS * MS;
+  m_prevStartTime = startTime;
+  m_prevStopTime = stopTime;
+  m_prevPosition = position;
+}
+
 void CDVDOverlayCodecText::PostProcess(std::string& text)
 {
   // The data that come from InputStream could contains \r chars
@@ -119,6 +176,7 @@ void CDVDOverlayCodecText::Flush()
 {
