+
+const Codepage* FindCodepage(const std::string& name)
+{
+  for (const Codepage& cp : CODEPAGES)
+    if (name == cp.name)
+      return &cp;
+  return nullptr;
+}
+
+const Codepage& Cp1252()
+{
+  static const Codepage* cp = FindCodepage("cp1252");
+  return *cp;
+}
+
+// The code page a subtitle in each language was most likely saved in, by ISO 639-1/-2 code or
+// by the English name a file is often labelled with ("Arabic.srt").
+const std::unordered_map<std::string, std::string>& CodepageOf()
+{
+  static const std::unordered_map<std::string, std::string> map = [] {
+    const std::pair<const char*, const char*> table[] = {
+        {"cp1252", "en eng english fr fre fra french de ger deu german es spa spanish it ita "
+                   "italian pt por portuguese nl dut nld dutch da dan danish sv swe swedish no "
+                   "nor nb nob norwegian fi fin finnish is ice isl icelandic ca cat catalan"},
+        {"cp1250", "pl cs cz sk hu hr sl ro bs pol cze ces slo slk hun hrv scr slv rum ron bos "
+                   "polish czech slovak hungarian croatian slovenian romanian bosnian"},
+        {"cp1251", "ru uk bg be mk rus ukr bul bel mac mkd russian ukrainian bulgarian "
+                   "macedonian"},
+        {"cp1253", "el gre ell greek"},
+        {"cp1254", "tr tur turkish"},
+        {"cp1255", "he iw heb hebrew"},
+        {"cp1256", "ar fa ara per fas arabic persian farsi"},
+        {"cp1257", "lt lv et lit lav est lithuanian latvian estonian"},
+        {"cp1258", "vi vie vietnamese"},
+    };
+    std::unordered_map<std::string, std::string> m;
+    for (const auto& [cp, codes] : table)
+    {
+      std::string code;
+      for (const char* p = codes;; ++p)
+      {
+        if (*p == ' ' || *p == '\0')
+        {
+          if (!code.empty())
+            m.emplace(code, cp);
+          code.clear();
+          if (*p == '\0')
+            break;
+        }
+        else
+          code.push_back(*p);
+      }
+    }
+    return m;
+  }();
+  return map;
+}
+
+std::optional<std::string> CodepageFor(const std::string& language)
+{
+  const auto it = CodepageOf().find(AsciiLower(language));
+  if (it == CodepageOf().end())
+    return std::nullopt;
+  return it->second;
+}
+
+std::wstring DecodeCodepage(const std::string& in, const Codepage& cp)
+{
+  std::wstring out;
+  out.reserve(in.size());
+  for (const char ch : in)
+  {
+    const unsigned b = static_cast<unsigned char>(ch);
+    out.push_back(b < 0x80 ? static_cast<wchar_t>(b) : static_cast<wchar_t>(cp.high[b - 0x80]));
+  }
+  return out;
+}
+
+//! A letter among what Windows-1252 decodes to.
+bool IsCp1252Letter(wchar_t c)
+{
+  if (IsAsciiLetter(c))
+    return true;
+  switch (c)
+  {
+    case 0x0192: case 0x02C6: case 0x0160: case 0x0152: case 0x017D: case 0x0161:
+    case 0x0153: case 0x017E: case 0x0178: case 0x00AA: case 0x00B5: case 0x00BA:
+      return true;
+    default:
+      return c >= 0xC0 && c <= 0xFF && c != 0xD7 && c != 0xF7;
+  }
+}
+
+//! Text read as Windows-1252 that is mostly accented capitals and the like is some other code
+//! page: Arabic, Cyrillic, Greek and Hebrew all land in 0xC0-0xFF.
+bool LooksMisread(const std::wstring& text)
+{
+  size_t letters = 0;
+  size_t high = 0;
+  for (const wchar_t c : text)
+  {
+    if (!IsCp1252Letter(c))
+      continue;
+    ++letters;
+    if (c >= 0xC0 && c <= 0xFF)
+      ++high;
+  }
+  return letters > 50 && static_cast<double>(high) > 0.3 * static_cast<double>(letters);
+}
+
+//! A file that is not UTF-8 is read line by line: files stitched together from two sources
+//! carry UTF-8 lines among code-page ones, and each is read in its own encoding ("mixed").
+std::wstring Decode(const std::string& data, const std::string& language, std::string& readAs)
+{
+  std::wstring text;
+  if (data.compare(0, 3, "\xEF\xBB\xBF") == 0)
+  {
+    readAs = "utf-8";
+    DecodeUtf8(data.substr(3), false, text);
+    return text;
+  }
+  if (data.compare(0, 2, "\xFF\xFE") == 0)
+  {
+    readAs = "utf-16-le";
+    return DecodeUtf16(data, 2, false);
+  }
+  if (data.compare(0, 2, "\xFE\xFF") == 0)
+  {
+    readAs = "utf-16-be";
+    return DecodeUtf16(data, 2, true);
+  }
+  if (DecodeUtf8(data, true, text))
+  {
+    readAs = "utf-8";
+    return text;
+  }
+  const std::optional<std::string> named = CodepageFor(language);
+  if (!named && LooksMisread(DecodeCodepage(data, Cp1252())))
+  {
+    readAs = "unsure";
+    return DecodeCodepage(data, Cp1252());
+  }
+  const std::string cpName = named.value_or("cp1252");
+  const Codepage& cp = *FindCodepage(cpName);
+  text.clear();
+  bool utfLines = false;
+  size_t start = 0;
+  for (size_t i = 0; i <= data.size(); ++i)
+  {
+    if (i != data.size() && data[i] != '\n')
+      continue;
+    const std::string raw = data.substr(start, i - start);
+    std::wstring line;
+    if (DecodeUtf8(raw, true, line))
+      utfLines = utfLines || std::any_of(raw.begin(), raw.end(), [](char c) {
+                   return static_cast<unsigned char>(c) >= 0x80;
+                 });
+    else
+      line = DecodeCodepage(raw, cp);
+    if (start)
+      text.push_back(L'\n');
+    text += line;
+    start = i + 1;
+  }
+  readAs = utfLines ? "mixed:" + cpName : cpName;
+  return text;
+}
+
+// -- damaged characters ----------------------------------------------------------------------
+
+//! The byte Windows-1252 (or Latin-1, for its five holes) shows as this character.
+std::optional<unsigned> Cp1252Byte(wchar_t c)
+{
+  if (c < 0x80)
+    return std::nullopt;
+  if (c >= 0xA0 && c <= 0xFF)
+    return static_cast<unsigned>(c);
+  if (c == 0x81 || c == 0x8D || c == 0x8F || c == 0x90 || c == 0x9D)
+    return static_cast<unsigned>(c);
+  for (unsigned b = 0x80; b < 0xA0; ++b)
+    if (Cp1252().high[b - 0x80] == c && c != REPLACEMENT)
+      return b;
+  return std::nullopt;
+}
+
+//! What UTF-8 read as Windows-1252 turns back into in a subtitle: Latin letters, general
+//! punctuation (’ “ ” … –), currency and letterlike signs (€ ™), symbols (♪) and emoji.
+//! Nothing else: in Czech, "Úž" also happens to read as a UTF-8 pair - of an Arabic letter.
+bool Plausible(uint32_t cp)
+{
+  return (cp >= 0xA0 && cp <= 0x17F) || (cp >= 0x2000 && cp <= 0x206F) ||
+         (cp >= 0x20A0 && cp <= 0x214F) || (cp >= 0x2190 && cp <= 0x27BF) ||
+         (cp >= 0x1F300 && cp <= 0x1FAFF);
+}
+
+std::wstring UnmojibakeOnce(const std::wstring& text)
+{
+  if (text.find_first_of(L"\u00c2\u00c3\u00e2\u00f0") == std::wstring::npos)
+    return text;
+  std::wstring out;
+  out.reserve(text.size());
+  size_t i = 0;
+  while (i < text.size())
+  {
+    const std::optional<unsigned> lead = Cp1252Byte(text[i]);
+    // "Ã"/"Â" start an accented letter, "â" punctuation and symbols, "ð" an emoji; any other
+    // lead is as likely to be Central European text ("Äš") as damage, so it stays
+    size_t need = 0;
+    if (lead == 0xC2u || lead == 0xC3u)
+      need = 1;
+    else if (lead == 0xE2u)
+      need = 2;
+    else if (lead == 0xF0u)
+      need = 3;
+    if (need)
+    {
+      std::string bytes(1, static_cast<char>(*lead));
+      for (size_t k = 1; k <= need && i + k < text.size(); ++k)
+      {
+        const std::optional<unsigned> b = Cp1252Byte(text[i + k]);
+        if (!b || *b < 0x80 || *b > 0xBF)
+          break;
+        bytes.push_back(static_cast<char>(*b));
+      }
+      std::wstring decoded;
+      if (bytes.size() == need + 1 && DecodeUtf8(bytes, true, decoded) && decoded.size() == 1 &&
+          Plausible(static_cast<uint32_t>(decoded[0])))
+      {
+        out.push_back(decoded[0]);
+        i += 1 + need;
+        continue;
+      }
+    }
+    out.push_back(text[i]);
+    ++i;
+  }
+  return out;
+}
+
+//! Undo UTF-8 read as Windows-1252, twice over if it happened twice.
+std::wstring Unmojibake(std::wstring text)
+{
+  for (int pass = 0; pass < 3; ++pass)
+  {
+    std::wstring fixed = UnmojibakeOnce(text);
+    if (fixed == text)
+      break;
+    text = std::move(fixed);
+  }
+  return text;
+}
+
+//! Characters that were damaged on the way, put back; the words are not touched.
+std::wstring RepairChars(const std::wstring& line, bool utf)
+{
+  const std::wstring source = utf ? Unmojibake(line) : line;
+  std::wstring out;
+  out.reserve(source.size());
+  for (const wchar_t c : source)
+  {
+    if (c >= 0x80 && c <= 0x9F)
+    {
+      // a C1 control is a Windows-1252 byte read as Latin-1: 0x9C is "œ", 0x92 is "’"
+      const wchar_t mapped = static_cast<wchar_t>(Cp1252().high[c - 0x80]);
+      out.push_back(mapped == REPLACEMENT ? c : mapped);
+    }
+    else if (c == 0x7F || c == 0x200B || c == 0x2060 || c == 0xFEFF)
+      continue; // DEL, zero-width space, word joiner, zero-width no-break space
+    else if (c == 0x2028 || c == 0x2029)
+      out.push_back(L' '); // Unicode line breaks: not SubRip's
+    else if (c >= 0xFB00 && c <= 0xFB06)
+    {
+      static const wchar_t* const ligatures[] = {L"ff", L"fi", L"fl", L"ffi", L"ffl", L"st", L"st"};
+      out += ligatures[c - 0xFB00];
+    }
+    else
+      out.push_back(c);
+  }
+  static const std::pair<const wchar_t*, const wchar_t*> entities[] = {
+      {L"&amp;", L"&"},  {L"&quot;", L"\""}, {L"&apos;", L"'"},
+      {L"&#39;", L"'"},  {L"&#039;", L"'"},  {L"&nbsp;", L" "}};
+  std::wstring result;
+  result.reserve(out.size());
+  for (size_t i = 0; i < out.size();)
+  {
+    bool replaced = false;
+    if (out[i] == L'&')
+    {
+      for (const auto& [entity, text] : entities)
+      {
+        const std::wstring e(entity);
+        if (AsciiLower(out.substr(i, e.size())) == e)
+        {
+          result += text;
+          i += e.size();
+          replaced = true;
+          break;
+        }
+      }
+    }
+    if (!replaced)
+      result.push_back(out[i++]);
+  }
+  return result;
+}
+
+// -- music notes -----------------------------------------------------------------------------
+
+#define SKIP L"(?:<[^>]*>|\\{[^}]*\\}|\\s)*" // tags and spaces around the visible text
+
+const std::wregex& LeadHash()
+{
+  static const std::wregex r = Pattern(L"^(" SKIP L"(?:-" SKIP L")?)#+(?!\\d)"); // "#260": a number
+  return r;
+}
+
+const std::wregex& TrailHash()
+{
+  static const std::wregex r = Pattern(L"#+(" SKIP L")$");
+  return r;
+}
+
+const std::wregex& Paired()
+{
+  // "J Happy birthday to you J"
+  static const std::wregex r = Pattern(L"^(" SKIP L")([JjÌì]) (.+) \\2(" SKIP L")$");
+  return r;
+}
+
+//! Whether a line counts toward "#" being this file's note: wrapped in it ("#ah-ah-ah#") -
+//! first - or opening with it and a space ("# Love is in the air") - second. A hashtag
+//! ("#260", "#random") never has a space after it.
+std::pair<bool, bool> HashEvidence(const std::wstring& line)
+{
+  const std::wstring v = LStrip(Strip(Visible(line)), L"- ");
+  if (v.size() >= 2 && v.front() == L'#' && v.back() == L'#')
+    return {true, false};
+  if (v.size() > 2 && v.compare(0, 2, L"# ") == 0)
+    return {false, true};
+  return {false, false};
+}
+
+bool HashIsNote(const std::vector<std::wstring>& lines)
+{
+  int wrapped = 0;
+  int opened = 0;
+  for (const std::wstring& line : lines)
+  {
+    const auto [w, o] = HashEvidence(line);
+    wrapped += w;
+    opened += o;
+    if (wrapped >= 2 || opened >= 3)
+      return true;
+  }
+  return false;
+}
+
+std::wstring NotesInText(const std::wstring& text)
+{
+  std::wstring out;
+  out.reserve(text.size());
+  for (size_t i = 0; i < text.size(); ++i)
+  {
+    const wchar_t c = text[i];
+    if (c == 0x1F3B5 || c == 0x1F3B6 || c == 0x1F3BC)
+    {
+      out.push_back(NOTE);
+      if (i + 1 < text.size() && text[i + 1] == 0xFE0F)
+        ++i;
+    }
+    else if (c == 0xB6) // "¶" is never text in a subtitle
+    {
+      out.push_back(NOTE);
+      while (i + 1 < text.size() && text[i + 1] == 0xB6)
+        ++i;
+    }
+    else
+      out.push_back(c);
+  }
+  return out;
+}
+
+//! Inside a tag or a {label} a mark is left alone: "{Man ¶¶ 2}" is an OCR'd "#2".
+std::wstring FixNotes(const std::wstring& input, bool hashNotes)
+{
+  std::wstring line = MapText(input, NotesInText);
+  const std::wstring note(1, NOTE);
+  if (hashNotes && line.find(L'#') != std::wstring::npos)
+  {
+    line = std::regex_replace(line, LeadHash(), L"$1" + note);
+    line = std::regex_replace(line, TrailHash(), note + L"$1");
+  }
+  // Paired() needs the same mark before a space and after one
+  for (const wchar_t mark : {L'J', L'j', static_cast<wchar_t>(0xCC), static_cast<wchar_t>(0xEC)})
+  {
+    if (line.find(std::wstring{mark, L' '}) != std::wstring::npos &&
+        line.find(std::wstring{L' ', mark}) != std::wstring::npos)
+      return std::regex_replace(line, Paired(), L"$1" + note + L" $3 " + note + L"$4");
+  }
+  return line;
+}
