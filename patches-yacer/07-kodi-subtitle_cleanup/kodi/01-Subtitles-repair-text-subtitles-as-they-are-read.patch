+// -- OCR letters -----------------------------------------------------------------------------
+//
+// Every rule that depends on a character is decided by the tables here, not by the C++ locale,
+// so the repair does the same on every system as the reference it is checked against
+// (tests/subtitle-repair/ocr_engine.py).
+
+constexpr int MIN_WORDS = 3; // different words a confusion must explain to be the file's
+constexpr int MIN_TIMES = 5; // and how often in all
+constexpr int MANY_TIMES = 20; // or one misreading this often ("l" for "I", 384 times in a film)
+constexpr double MIN_SHARE = 0.2; // of the file's uses of the right letter that come out wrong,
+constexpr size_t MANY_WORDS = 10; // unless it recurs across this many different words
+constexpr double LANGUAGE_SHARE = 0.6; // of a line's other words, for it to be the language's
+constexpr double OTHER_MARGIN = 0.2; // how much better another language must explain a line
+constexpr size_t MAX_CANDIDATES = 256;
