+
+class CLanguagePack::CDictionary
+{
+public:
+#ifdef HAS_HUNSPELL
+  CDictionary(const std::string& aff, const std::string& dic) : m_hunspell(aff.c_str(), dic.c_str())
+  {
+    const std::string encoding = m_hunspell.get_dic_encoding();
+    m_utf8 = AsciiLower(encoding) == "utf-8";
+    if (!m_utf8)
+      m_iconv = iconv_open(encoding.c_str(), "UTF-8");
+  }
+  ~CDictionary()
+  {
+    if (m_iconv != reinterpret_cast<iconv_t>(-1))
+      iconv_close(m_iconv);
+  }
+
+  bool Spell(const std::wstring& word)
+  {
+    std::wstring w = word;
+    std::replace(w.begin(), w.end(), static_cast<wchar_t>(0x2019), L'\'');
+    std::string raw = ToUtf8(w);
+    std::lock_guard<std::mutex> lock(m_lock);
+    if (!m_utf8 && !Encode(raw))
+      return false; // not a word the dictionary's character set can hold
+    return m_hunspell.spell(raw);
+  }
+
+private:
+  bool Encode(std::string& text)
+  {
+    if (m_iconv == reinterpret_cast<iconv_t>(-1))
+      return false;
+    iconv(m_iconv, nullptr, nullptr, nullptr, nullptr);
+    std::string out(text.size() * 4 + 4, '\0');
+    char* in = text.data();
+    size_t inLeft = text.size();
+    char* to = out.data();
+    size_t outLeft = out.size();
+    if (iconv(m_iconv, &in, &inLeft, &to, &outLeft) == static_cast<size_t>(-1) ||
+        iconv(m_iconv, nullptr, nullptr, &to, &outLeft) == static_cast<size_t>(-1))
+      return false;
+    out.resize(out.size() - outLeft);
+    text = std::move(out);
+    return true;
+  }
+
+  Hunspell m_hunspell;
+  bool m_utf8{true};
+  iconv_t m_iconv{reinterpret_cast<iconv_t>(-1)};
+  std::mutex m_lock;
+#else
+  bool Spell(const std::wstring&) { return false; }
+#endif
+};
+
+CLanguagePack::CLanguagePack() = default;
+CLanguagePack::~CLanguagePack() = default;
+
+bool CLanguagePack::Load(const std::string& dir, const std::string& name)
+{
+  std::ifstream file(dir + "/profile.txt", std::ios::binary);
+  if (!file)
+    return false;
+  std::map<std::wstring, std::wstring> profile;
+  std::string raw;
+  while (std::getline(file, raw))
+  {
+    const std::wstring line = Strip(Widen(raw));
+    const size_t eq = line.find(L'=');
+    if (line.empty() || line[0] == L'#' || eq == std::wstring::npos)
+      continue;
+    profile[Strip(line.substr(0, eq))] = Strip(line.substr(eq + 1));
+  }
+  const auto value = [&](const wchar_t* key) {
+    const auto it = profile.find(key);
+    return it == profile.end() ? std::wstring() : it->second;
+  };
+
+  m_name = name;
+  m_codes.clear();
+  const auto codes = profile.find(L"codes");
+  for (const std::wstring& code : SplitSpaces(codes == profile.end() ? Widen(name) : codes->second))
+    m_codes.insert(AsciiLower(ToUtf8(code)));
+  m_dictionaries.clear();
+  for (const std::wstring& dic : SplitSpaces(value(L"dictionaries")))
+  {
+#ifdef HAS_HUNSPELL
+    const std::string base = dir + "/" + ToUtf8(dic);
+    if (!std::ifstream(base + ".aff") || !std::ifstream(base + ".dic"))
+      return false;
+    m_dictionaries.push_back(std::make_unique<CDictionary>(base + ".aff", base + ".dic"));
+#else
+    (void)dic;
+    return false; // no Hunspell to read it with
+#endif
+  }
+  const std::vector<std::wstring> one = SplitSpaces(value(L"one_letter_words"));
+  m_one = {one.begin(), one.end()};
+  const std::vector<std::wstring> lone = SplitSpaces(value(L"lone_one"));
+  m_lone = {lone.begin(), lone.end()};
+  m_capitalisedNouns = value(L"capitalised_nouns") == L"yes";
+  const std::wstring alphabet = value(L"alphabet");
+  m_alphabet = {alphabet.begin(), alphabet.end()};
+  m_confusions = GeneralConfusions();
+  for (const std::wstring& group : SplitSpaces(value(L"accents")))
+  {
+    const size_t colon = group.find(L':');
+    const std::wstring base = group.substr(0, colon);
+    if (colon != std::wstring::npos)
+      for (const wchar_t marked : group.substr(colon + 1))
+        m_confusions.emplace_back(base, std::wstring(1, marked));
+  }
+  return true;
+}
+
+bool CLanguagePack::HasCode(const std::string& code) const
+{
+  return m_codes.count(AsciiLower(code)) > 0;
+}
+
+bool CLanguagePack::Word(const std::wstring& w) const
+{
+  if (w.size() == 1)
+    return m_one.count(w) > 0;
+  return std::any_of(m_dictionaries.begin(), m_dictionaries.end(),
+                     [&](const auto& d) { return d->Spell(w); });
+}
+
+bool CLanguagePack::Readable(const std::wstring& w) const
+{
+  return std::all_of(w.begin(), w.end(), [&](wchar_t c) {
+    return m_alphabet.count(c) || Contains(L"0123456789|'’-", c);
+  });
+}
+
+Packs LoadPacks(const std::string& root)
+{
+  std::vector<std::string> names;
+  std::error_code error;
+  for (const auto& entry : std::filesystem::directory_iterator(root, error))
+    if (entry.is_directory(error) && std::filesystem::is_regular_file(entry.path() / "profile.txt", error))
+      names.push_back(entry.path().filename().string());
+  std::sort(names.begin(), names.end());
+  Packs packs;
+  for (const std::string& name : names)
+  {
+    auto pack = std::make_shared<CLanguagePack>();
+    if (pack->Load(root + "/" + name, name))
+      packs.push_back(std::move(pack));
+  }
+  return packs;
+}
+
+std::shared_ptr<const CLanguagePack> PackFor(const std::string& code, const Packs& packs)
+{
+  for (const auto& pack : packs)
+    if (pack->HasCode(code))
+      return pack;
+  return nullptr;
+}
+
+Detection DetectLanguage(const std::string& utf8)
+{
+  Detection d;
+#ifdef HAS_CLD2
+  CLD2::Language languages[3];
+  int percents[3];
+  double scores[3];
+  int bytes = 0;
+  bool reliable = false;
+  CLD2::ExtDetectLanguageSummary(utf8.data(), static_cast<int>(utf8.size()), true, "",
+                                 CLD2::UNKNOWN_ENCODING, CLD2::UNKNOWN_LANGUAGE, languages,
+                                 percents, scores, &bytes, &reliable);
+  d.code = CLD2::LanguageCode(languages[0]);
+  d.percent = percents[0];
+  d.reliable = reliable;
+#else
+  (void)utf8;
+#endif
+  return d;
+}
