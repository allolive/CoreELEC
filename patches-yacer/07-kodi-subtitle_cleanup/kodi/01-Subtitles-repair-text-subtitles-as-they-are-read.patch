+const std::wregex& AdAtEdges()
+{
+  // only in the first or last few cues: a character may read out an address mid-film
+  static const std::wregex r = Pattern(
+      L"https?://|www\\.|[\\w.+-]+@[\\w-]+\\.[\\w.]+|^\\W*downloaded from\\b|find us on the web",
