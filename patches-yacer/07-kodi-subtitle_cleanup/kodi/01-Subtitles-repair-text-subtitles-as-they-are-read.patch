+      L"explosiveskull|advertise your (?:product|brand)|become (?:a )?vip member|remove all ads|"
+      L"please rate this subtitle|help other users to choose|danishbits|admit1\\.app|"
+      L"admitme\\.app|4kvod\\.tv|playships|iptv\\.cat|released on www\\.|kaboomskull|"
+      L"saveanilluminati|"
+      L"^\\W*subtitles?\\s*:|"
+      L"tv series and live sports|live tv, ?movies|la tv live|browser of future|"
+      L"(?:use|free) (?:the )?(?:free )?code\\b|code gratuit|\\buse code:|discount on your next|"
+      L"do you want subtitles for any video|watch any video online|watch more movies for free|"
+      L"aidez les autres utilisateurs|professional translation services|"
+      L"^\\W*(?:translation|translated|vertaling|vertaald door|[öÖ]versatt av|"
+      L"traducere realizata|improved by|ripped en bewerkt|"
+      L"sync(?:ed)?(?: ?& ?(?:corrections|edited))?|web[- ]?dl sync|"
+      L"(?:bluray |dvd )?resync)\\b\\s*(?::|by\\b|door\\b|de\\b)|"
+      L"^\\W*(?:subtitles?|subtitled|subs|subedit|captions?|captioning|transcript|"
+      L"dvd subtitles|a subtitle)\\b.*\\bby\\b|"
+      L"^\\W*(?:re-?sync(?:ed|hronized)?|sync(?:ed|hronized)?|ripped|encoded|corrected|fixed|"
+      L"corrections|edited|translated|translation|timing|web[- ]?dl sync)\\b.{0,30}\\bby\\b|"
+      L"^\\W*sous-titres? (?:par|by)\\b",
