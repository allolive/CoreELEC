+const std::vector<Confusion>& GeneralConfusions()
+{
+  static const std::vector<Confusion> c = {
+      {L"l", L"I"}, {L"I", L"l"}, {L"1", L"l"}, {L"1", L"I"}, {L"|", L"l"},  {L"|", L"I"},
