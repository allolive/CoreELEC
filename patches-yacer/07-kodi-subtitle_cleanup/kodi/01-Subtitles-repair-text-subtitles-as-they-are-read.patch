+// -- the engine --------------------------------------------------------------------------------
+
+COcrEngine::COcrEngine(std::shared_ptr<const CLanguagePack> language, const Packs& others)
+  : m_lang(std::move(language))
+{
+  for (const auto& other : others)
+    if (other->Name() != m_lang->Name())
+      m_others.push_back(other);
+}
+
+bool COcrEngine::Word(const CLanguagePack& pack, const std::wstring& w)
+{
+  auto& spelt = m_spelt[&pack];
+  const auto it = spelt.find(w);
+  if (it != spelt.end())
+    return it->second;
+  const bool known = pack.Word(w);
+  spelt.emplace(w, known);
+  return known;
+}
+
+void COcrEngine::NoteNames(const std::vector<std::wstring>& lines)
+{
+  // Not in a language that capitalises its nouns, and not a word starting with a letter an OCR
+  // confuses: "Ia" for "la" is capitalised by the misreading.
+  if (m_lang->CapitalisedNouns())
+    return;
+  for (const std::wstring& line : lines)
+  {
+    const std::wstring text = Visible(line);
+    for (const auto& [start, n] : Words(text))
+    {
+      const std::wstring w = text.substr(start, n);
+      size_t before = start;
+      while (before > 0 && IsSpace(text[before - 1]))
+        --before;
+      if (IsUpper(w[0]) && !Contains(L"Il|1", w[0]) && AllLower(w.substr(1)) && PlausibleWord(w) &&
+          before > 0 && !Contains(L".!?…:-\"'¿¡“«([*", text[before - 1]))
+        m_names.insert(w);
+    }
+  }
+}
+
+bool COcrEngine::ClaimedByOther(const std::vector<std::wstring>& words)
+{
+  int own = 0;
+  for (const std::wstring& w : words)
+    own += Word(*m_lang, w);
+  for (const auto& other : m_others)
+  {
+    int theirs = 0;
+    for (const std::wstring& w : words)
+      theirs += Word(*other, w);
+    if (theirs > own + OTHER_MARGIN * static_cast<double>(words.size()))
+      return true;
+  }
+  return false;
+}
+
+void COcrEngine::Learn(const std::vector<std::wstring>& lines)
+{
+  const std::vector<Confusion>& confusions = m_lang->Confusions();
+  for (const std::wstring& line : lines)
+  {
+    const std::wstring text = Visible(line);
+    const Spans spans = Words(text);
+    std::vector<std::wstring> words;
+    for (const auto& [a, n] : spans)
+      if (n >= 2 && !IsAsciiDigit(text[a]))
+        words.push_back(text.substr(a, n));
+    if (ClaimedByOther(words))
+      continue; // another language's line: not evidence of this file's misreadings
+    for (const auto& [start, n] : spans)
+    {
+      const std::wstring w = text.substr(start, n);
+      if (Word(*m_lang, w))
+      {
+        for (const Confusion& confusion : confusions)
+          if (w.find(confusion.second) != std::wstring::npos)
+            ++m_correct[confusion];
+        continue;
+      }
+      if (!m_lang->Readable(w) || !HasLetter(w))
+        continue; // another script, or a number ("Episode 1" is not "I")
+      if (n == 1 && !Alone(text, start, n))
+        continue;
+      std::map<std::wstring, Confusion> readings;
+      for (const Confusion& confusion : confusions)
+        for (const std::wstring& v : Variants(w, confusion))
+          if (Acceptable(w, v))
+            readings[v] = confusion;
+      if (readings.size() == 1)
+        ++m_evidence[readings.begin()->second][w];
+    }
+  }
+}
+
+std::vector<Confusion> COcrEngine::Active() const
+{
+  std::vector<Confusion> out;
+  for (const Confusion& c : m_lang->Confusions())
+  {
+    const auto it = m_evidence.find(c);
+    if (it == m_evidence.end() || it->second.empty())
+      continue;
+    int times = 0;
+    for (const auto& [word, count] : it->second)
+      times += count;
+    const auto correct = m_correct.find(c);
+    const int right = correct == m_correct.end() ? 0 : correct->second;
+    const double share = static_cast<double>(times) / (times + right);
+    const size_t words = it->second.size();
+    if (((words >= MIN_WORDS && times >= MIN_TIMES) || times >= MANY_TIMES) &&
+        (share >= MIN_SHARE || words >= MANY_WORDS))
+      out.push_back(c);
+  }
+  return out;
+}
+
+bool COcrEngine::Acceptable(const std::wstring& w, const std::wstring& reading)
+{
+  if (!PlausibleWord(reading) || !Word(*m_lang, reading) || m_names.count(w))
+    return false;
+  // an accent is not put on a word another language has ("THE" in a French subtitle's
+  // English sign is not "THÉ")
+  const bool accented = std::any_of(reading.begin(), reading.end(), [&](wchar_t c) {
+    return static_cast<uint32_t>(c) >= 0x80 && w.find(c) == std::wstring::npos;
+  });
+  if (accented &&
+      std::any_of(m_others.begin(), m_others.end(), [&](const auto& o) { return Word(*o, w); }))
+    return false;
+  // a capitalised word that shows no misreading may only become an ordinary word ("Ecoutez" is
+  // "Écoutez", "Moclan" is no "Modan"; "FeIipe" shows its misreading and is "Felipe")
+  if (!m_lang->CapitalisedNouns() && IsUpper(w[0]) && PlausibleWord(w) && !AllUpper(reading))
+    return Word(*m_lang, Lower(reading[0]) + reading.substr(1));
+  return true;
+}
+
+bool COcrEngine::FixWord(const std::wstring& w,
+                         const std::vector<Confusion>& active,
+                         std::wstring& fixed)
+{
+  if (Word(*m_lang, w) || !m_lang->Readable(w) ||
+      !std::any_of(w.begin(), w.end(), [](wchar_t c) { return IsLetter(c) || c == L'|'; }))
+    return false;
+  int found = 0;
+  for (const std::wstring& c : Candidates(w, active))
+  {
+    if (!Acceptable(w, c))
+      continue;
+    if (++found > 1)
+      return false;
+    fixed = c;
+  }
+  return found == 1;
+}
+
+bool COcrEngine::LoneOne(const std::wstring& text,
+                         size_t start,
+                         size_t length,
+                         const std::vector<Confusion>& active)
+{
+  // a lone "1" is "I" only in a file whose OCR writes "1" for "I", standing alone, before a
+  // word "I" goes with ("1 know"): "Episode 1", "1 day" stay numbers
+  if (text.compare(start, length, L"1") != 0 ||
+      std::find(active.begin(), active.end(), Confusion(L"1", L"I")) == active.end() ||
+      !Alone(text, start, length))
+    return false;
+  size_t from = start + length;
+  while (from < text.size() && IsSpace(text[from]))
+    ++from;
+  const std::wstring rest = text.substr(from);
+  const Spans following = Words(rest);
+  return !following.empty() && following[0].first == 0 &&
+         m_lang->LoneOne(rest.substr(0, following[0].second));
+}
+
+bool COcrEngine::ReadsAsLanguage(const std::wstring& text, const std::vector<bool>& skip)
+{
+  // Names are not weighed - a word starting with a capital A-Z - except in a line all in
+  // capitals ("NEMO, LIS THE NEWPORT NEWS")
+  const bool shouting = std::none_of(text.begin(), text.end(), IsLower);
+  const Spans spans = Words(text);
+  std::vector<std::wstring> words;
+  for (size_t k = 0; k < spans.size(); ++k)
+  {
+    const auto [a, n] = spans[k];
+    if (!skip[k] && n >= 2 && !IsAsciiDigit(text[a]))
+      words.push_back(text.substr(a, n));
+  }
+  int others = 0;
+  int known = 0;
+  for (const std::wstring& w : words)
+  {
+    if (!shouting && IsAsciiUpper(w[0]))
+      continue;
+    ++others;
+    known += Word(*m_lang, w);
+  }
+  if (known < LANGUAGE_SHARE * others)
+    return false;
+  return !ClaimedByOther(words);
+}
+
+bool COcrEngine::Fix(const std::wstring& text,
+                     size_t start,
+                     size_t length,
+                     const std::vector<Confusion>& active,
+                     std::wstring& fixed)
+{
+  if (LoneOne(text, start, length, active))
+  {
+    fixed = L"I";
+    return true;
+  }
+  return FixWord(text.substr(start, length), active, fixed) &&
+         (length > 1 || Alone(text, start, length));
+}
+
+std::wstring COcrEngine::FixLine(const std::wstring& line,
+                                 std::vector<std::pair<std::wstring, std::wstring>>* fixes)
+{
+  const std::vector<Confusion> active = Active();
+  if (active.empty())
+    return line;
+  const std::wstring text = Visible(line);
+  const Spans spans = Words(text);
+  std::vector<bool> pending(spans.size(), false);
+  bool any = false;
+  std::wstring fixed;
+  for (size_t k = 0; k < spans.size(); ++k)
+  {
+    pending[k] = Fix(text, spans[k].first, spans[k].second, active, fixed);
+    any = any || pending[k];
+  }
+  if (!any || !ReadsAsLanguage(text, pending))
+    return line;
+  return MapText(line, [&](const std::wstring& part) {
+    std::wstring out;
+    size_t last = 0;
+    for (const auto& [a, n] : Words(part))
+    {
+      out += part.substr(last, a - last);
+      if (Fix(part, a, n, active, fixed))
+      {
+        if (fixes)
+          fixes->emplace_back(part.substr(a, n), fixed);
+        out += fixed;
+      }
+      else
+        out += part.substr(a, n);
+      last = a + n;
+    }
+    return out + part.substr(last);
+  });
+}
+
+bool Report::Changed() const
+{
+  if (readAs == "unsure")
+    return false;
+  return readAs.compare(0, 4, "utf-") != 0 || repairedLines || notesFixed || adLines ||
+         ocrFixes || timingFixes;
+}
+
+std::string LanguageOfPath(const std::string& path)
+{
+  std::string name = path;
+  std::replace(name.begin(), name.end(), '\\', '/');
+  name = name.substr(name.rfind('/') == std::string::npos ? 0 : name.rfind('/') + 1);
+  const size_t dot = name.rfind('.');
+  const std::string stem = dot == std::string::npos ? name : name.substr(0, dot);
+  std::vector<std::string> words(1);
+  for (const char c : stem)
+  {
+    if (c == '.' || c == '_' || c == ' ')
+      words.emplace_back();
+    else
+      words.back().push_back(c);
+  }
+  // the code nearest the extension is the subtitle's: "…-bg.REMUX-Danishbits.da.srt" is Danish
+  const size_t from = words.size() > 3 ? words.size() - 3 : 0;
+  for (size_t i = words.size(); i-- > from;)
+    if (CodepageFor(words[i]))
+      return words[i];
+  return {};
+}
