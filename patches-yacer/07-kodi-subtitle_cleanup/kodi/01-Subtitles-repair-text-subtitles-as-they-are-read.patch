+//! Unicode white space: what Strip() takes off the ends of a line.
+bool IsSpace(wchar_t c)
+{
+  switch (c)
+  {
+    case 0x09: case 0x0A: case 0x0B: case 0x0C: case 0x0D: case 0x1C: case 0x1D: case 0x1E:
+    case 0x1F: case 0x20: case 0x85: case 0xA0: case 0x1680: case 0x2028: case 0x2029:
+    case 0x202F: case 0x205F: case 0x3000:
+      return true;
+    default:
+      return c >= 0x2000 && c <= 0x200A;
+  }
+}
+
+std::wstring Strip(const std::wstring& s)
+{
+  size_t a = 0;
+  size_t b = s.size();
+  while (a < b && IsSpace(s[a]))
+    ++a;
+  while (b > a && IsSpace(s[b - 1]))
+    --b;
+  return s.substr(a, b - a);
+}
+
+std::wstring LStrip(const std::wstring& s, const std::wstring& chars)
+{
+  size_t a = 0;
+  while (a < s.size() && chars.find(s[a]) != std::wstring::npos)
+    ++a;
+  return s.substr(a);
+}
+
+std::string AsciiLower(std::string s)
+{
+  for (char& c : s)
+    if (c >= 'A' && c <= 'Z')
+      c = static_cast<char>(c - 'A' + 'a');
+  return s;
+}
+
+std::wstring AsciiLower(std::wstring s)
+{
+  for (wchar_t& c : s)
+    if (c >= L'A' && c <= L'Z')
+      c = static_cast<wchar_t>(c - L'A' + L'a');
+  return s;
+}
+
+bool IsAsciiLetter(wchar_t c)
+{
+  return (c >= L'a' && c <= L'z') || (c >= L'A' && c <= L'Z');
+}
+
+bool IsAsciiUpper(wchar_t c)
+{
+  return c >= L'A' && c <= L'Z';
+}
+
+bool IsAsciiDigit(wchar_t c)
+{
+  return c >= L'0' && c <= L'9';
+}
+
+std::vector<std::wstring> Split(const std::wstring& s, wchar_t sep)
+{
+  std::vector<std::wstring> parts;
+  size_t start = 0;
+  for (size_t i = 0; i <= s.size(); ++i)
+  {
+    if (i == s.size() || s[i] == sep)
+    {
+      parts.push_back(s.substr(start, i - start));
+      start = i + 1;
+    }
+  }
+  return parts;
+}
+
+std::wstring Join(const std::vector<std::wstring>& parts, const std::wstring& sep)
+{
+  std::wstring out;
+  for (size_t i = 0; i < parts.size(); ++i)
+  {
+    if (i)
+      out += sep;
+    out += parts[i];
+  }
+  return out;
+}
+
+//! "\r\n" and a lone "\r" become "\n", in one pass.
+std::wstring UnixLines(const std::wstring& s)
+{
+  std::wstring out;
+  out.reserve(s.size());
+  for (size_t i = 0; i < s.size(); ++i)
+  {
+    if (s[i] != L'\r')
+      out.push_back(s[i]);
+    else
+    {
+      out.push_back(L'\n');
+      if (i + 1 < s.size() && s[i + 1] == L'\n')
+        ++i;
+    }
+  }
+  return out;
+}
+
+//! In the classic locale \w, \s, \d, \b and case folding stay ASCII, whatever the global
+//! locale is.
+std::wregex Pattern(const wchar_t* pattern, bool icase = false)
+{
+  std::wregex r;
+  r.imbue(std::locale::classic());
+  r.assign(pattern, icase ? std::regex::ECMAScript | std::regex::icase : std::regex::ECMAScript);
+  return r;
+}
