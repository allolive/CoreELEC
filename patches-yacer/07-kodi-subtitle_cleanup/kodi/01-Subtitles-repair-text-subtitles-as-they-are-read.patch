+// -- text ------------------------------------------------------------------------------------
+
+//! Decode UTF-8. Strict: fail on anything that is not UTF-8. Otherwise each invalid sequence
+//! becomes one U+FFFD, its maximal valid prefix consumed (Unicode's recommended practice).
+bool DecodeUtf8(const std::string& in, bool strict, std::wstring& out)
+{
+  out.clear();
+  out.reserve(in.size());
+  const size_t n = in.size();
+  size_t i = 0;
+  while (i < n)
+  {
+    const unsigned b = static_cast<unsigned char>(in[i]);
+    if (b < 0x80)
+    {
+      out.push_back(static_cast<wchar_t>(b));
+      ++i;
+      continue;
+    }
+    int need;
+    unsigned lo = 0x80;
+    unsigned hi = 0xBF;
+    uint32_t cp;
+    if (b >= 0xC2 && b <= 0xDF)
+    {
+      need = 1;
+      cp = b & 0x1F;
+    }
+    else if (b >= 0xE0 && b <= 0xEF)
+    {
+      need = 2;
+      cp = b & 0x0F;
+      if (b == 0xE0)
+        lo = 0xA0;
+      else if (b == 0xED)
+        hi = 0x9F;
+    }
+    else if (b >= 0xF0 && b <= 0xF4)
+    {
+      need = 3;
+      cp = b & 0x07;
+      if (b == 0xF0)
+        lo = 0x90;
+      else if (b == 0xF4)
+        hi = 0x8F;
+    }
+    else
+    {
+      if (strict)
+        return false;
+      out.push_back(REPLACEMENT);
+      ++i;
+      continue;
+    }
+    size_t j = i + 1;
+    bool bad = false;
+    for (int got = 0; got < need; ++got, ++j)
+    {
+      if (j >= n)
+      {
+        bad = true;
+        break;
+      }
+      const unsigned c = static_cast<unsigned char>(in[j]);
+      if (c < lo || c > hi)
+      {
+        bad = true;
+        break;
+      }
+      lo = 0x80;
+      hi = 0xBF;
+      cp = (cp << 6) | (c & 0x3F);
+    }
+    if (bad)
+    {
+      if (strict)
+        return false;
+      out.push_back(REPLACEMENT);
+      i = j;
+      continue;
+    }
+    out.push_back(static_cast<wchar_t>(cp));
+    i = j;
+  }
+  return true;
+}
+
+std::wstring DecodeUtf16(const std::string& in, size_t start, bool bigEndian)
+{
+  std::wstring out;
+  const size_t n = in.size();
+  auto unit = [&](size_t at) {
+    const unsigned a = static_cast<unsigned char>(in[at]);
+    const unsigned b = static_cast<unsigned char>(in[at + 1]);
+    return bigEndian ? (a << 8 | b) : (b << 8 | a);
+  };
+  size_t i = start;
+  while (i + 1 < n)
+  {
+    const unsigned u = unit(i);
+    i += 2;
+    if (u >= 0xD800 && u <= 0xDBFF)
+    {
+      if (i + 1 < n)
+      {
+        const unsigned low = unit(i);
+        if (low >= 0xDC00 && low <= 0xDFFF)
+        {
+          i += 2;
+          out.push_back(static_cast<wchar_t>(0x10000 + ((u - 0xD800) << 10) + (low - 0xDC00)));
+          continue;
+        }
+      }
+      out.push_back(REPLACEMENT);
+    }
+    else if (u >= 0xDC00 && u <= 0xDFFF)
+      out.push_back(REPLACEMENT);
+    else
+      out.push_back(static_cast<wchar_t>(u));
+  }
+  if (i < n)
+    out.push_back(REPLACEMENT);
+  return out;
+}
+
+std::string ToUtf8(const std::wstring& in)
+{
+  std::string out;
+  out.reserve(in.size() + in.size() / 4);
+  for (const wchar_t wc : in)
+  {
+    const uint32_t c = static_cast<uint32_t>(wc);
+    if (c < 0x80)
+      out.push_back(static_cast<char>(c));
+    else if (c < 0x800)
+    {
+      out.push_back(static_cast<char>(0xC0 | (c >> 6)));
+      out.push_back(static_cast<char>(0x80 | (c & 0x3F)));
+    }
+    else if (c < 0x10000)
+    {
+      out.push_back(static_cast<char>(0xE0 | (c >> 12)));
+      out.push_back(static_cast<char>(0x80 | ((c >> 6) & 0x3F)));
+      out.push_back(static_cast<char>(0x80 | (c & 0x3F)));
+    }
+    else
+    {
+      out.push_back(static_cast<char>(0xF0 | (c >> 18)));
+      out.push_back(static_cast<char>(0x80 | ((c >> 12) & 0x3F)));
+      out.push_back(static_cast<char>(0x80 | ((c >> 6) & 0x3F)));
+      out.push_back(static_cast<char>(0x80 | (c & 0x3F)));
+    }
+  }
+  return out;
+}
+
+std::wstring Widen(const std::string& utf8)
+{
+  std::wstring out;
+  DecodeUtf8(utf8, false, out);
+  return out;
+}
