+namespace KODI::SUBTITLES::CLEANUP
+{
+namespace
+{
+constexpr wchar_t NOTE = 0x266A; // ♪
+constexpr wchar_t REPLACEMENT = 0xFFFD;
+
+// -- text ------------------------------------------------------------------------------------
+
+//! Decode UTF-8. Strict: fail on anything that is not UTF-8. Otherwise each invalid sequence
+//! becomes one U+FFFD, its maximal valid prefix consumed (Unicode's recommended practice).
+bool DecodeUtf8(const std::string& in, bool strict, std::wstring& out)
+{
+  out.clear();
+  out.reserve(in.size());
+  const size_t n = in.size();
+  size_t i = 0;
+  while (i < n)
+  {
+    const unsigned b = static_cast<unsigned char>(in[i]);
+    if (b < 0x80)
+    {
+      out.push_back(static_cast<wchar_t>(b));
+      ++i;
+      continue;
+    }
+    int need;
+    unsigned lo = 0x80;
+    unsigned hi = 0xBF;
+    uint32_t cp;
+    if (b >= 0xC2 && b <= 0xDF)
+    {
+      need = 1;
+      cp = b & 0x1F;
+    }
+    else if (b >= 0xE0 && b <= 0xEF)
+    {
+      need = 2;
+      cp = b & 0x0F;
+      if (b == 0xE0)
+        lo = 0xA0;
+      else if (b == 0xED)
+        hi = 0x9F;
+    }
+    else if (b >= 0xF0 && b <= 0xF4)
+    {
+      need = 3;
+      cp = b & 0x07;
+      if (b == 0xF0)
+        lo = 0x90;
+      else if (b == 0xF4)
+        hi = 0x8F;
+    }
+    else
+    {
+      if (strict)
+        return false;
+      out.push_back(REPLACEMENT);
+      ++i;
+      continue;
+    }
+    size_t j = i + 1;
+    bool bad = false;
+    for (int got = 0; got < need; ++got, ++j)
+    {
+      if (j >= n)
+      {
+        bad = true;
+        break;
+      }
+      const unsigned c = static_cast<unsigned char>(in[j]);
+      if (c < lo || c > hi)
+      {
+        bad = true;
+        break;
+      }
+      lo = 0x80;
+      hi = 0xBF;
+      cp = (cp << 6) | (c & 0x3F);
+    }
+    if (bad)
+    {
+      if (strict)
+        return false;
+      out.push_back(REPLACEMENT);
+      i = j;
+      continue;
+    }
+    out.push_back(static_cast<wchar_t>(cp));
+    i = j;
+  }
+  return true;
+}
+
+std::wstring DecodeUtf16(const std::string& in, size_t start, bool bigEndian)
+{
+  std::wstring out;
+  const size_t n = in.size();
+  auto unit = [&](size_t at) {
+    const unsigned a = static_cast<unsigned char>(in[at]);
+    const unsigned b = static_cast<unsigned char>(in[at + 1]);
+    return bigEndian ? (a << 8 | b) : (b << 8 | a);
+  };
+  size_t i = start;
+  while (i + 1 < n)
+  {
+    const unsigned u = unit(i);
+    i += 2;
+    if (u >= 0xD800 && u <= 0xDBFF)
+    {
+      if (i + 1 < n)
+      {
+        const unsigned low = unit(i);
+        if (low >= 0xDC00 && low <= 0xDFFF)
+        {
+          i += 2;
+          out.push_back(static_cast<wchar_t>(0x10000 + ((u - 0xD800) << 10) + (low - 0xDC00)));
+          continue;
+        }
+      }
+      out.push_back(REPLACEMENT);
+    }
+    else if (u >= 0xDC00 && u <= 0xDFFF)
+      out.push_back(REPLACEMENT);
+    else
+      out.push_back(static_cast<wchar_t>(u));
+  }
+  if (i < n)
+    out.push_back(REPLACEMENT);
+  return out;
+}
+
+std::string ToUtf8(const std::wstring& in)
+{
+  std::string out;
+  out.reserve(in.size() + in.size() / 4);
+  for (const wchar_t wc : in)
+  {
+    const uint32_t c = static_cast<uint32_t>(wc);
+    if (c < 0x80)
+      out.push_back(static_cast<char>(c));
+    else if (c < 0x800)
+    {
+      out.push_back(static_cast<char>(0xC0 | (c >> 6)));
+      out.push_back(static_cast<char>(0x80 | (c & 0x3F)));
+    }
+    else if (c < 0x10000)
+    {
+      out.push_back(static_cast<char>(0xE0 | (c >> 12)));
+      out.push_back(static_cast<char>(0x80 | ((c >> 6) & 0x3F)));
+      out.push_back(static_cast<char>(0x80 | (c & 0x3F)));
+    }
+    else
+    {
+      out.push_back(static_cast<char>(0xF0 | (c >> 18)));
+      out.push_back(static_cast<char>(0x80 | ((c >> 12) & 0x3F)));
+      out.push_back(static_cast<char>(0x80 | ((c >> 6) & 0x3F)));
+      out.push_back(static_cast<char>(0x80 | (c & 0x3F)));
+    }
+  }
+  return out;
+}
+
+std::wstring Widen(const std::string& utf8)
+{
+  std::wstring out;
+  DecodeUtf8(utf8, false, out);
+  return out;
+}
+
+//! Unicode white space: what Strip() takes off the ends of a line.
+bool IsSpace(wchar_t c)
+{
+  switch (c)
+  {
+    case 0x09: case 0x0A: case 0x0B: case 0x0C: case 0x0D: case 0x1C: case 0x1D: case 0x1E:
+    case 0x1F: case 0x20: case 0x85: case 0xA0: case 0x1680: case 0x2028: case 0x2029:
+    case 0x202F: case 0x205F: case 0x3000:
+      return true;
+    default:
+      return c >= 0x2000 && c <= 0x200A;
+  }
+}
+
+std::wstring Strip(const std::wstring& s)
+{
+  size_t a = 0;
+  size_t b = s.size();
+  while (a < b && IsSpace(s[a]))
+    ++a;
+  while (b > a && IsSpace(s[b - 1]))
+    --b;
+  return s.substr(a, b - a);
+}
+
+std::wstring LStrip(const std::wstring& s, const std::wstring& chars)
+{
+  size_t a = 0;
+  while (a < s.size() && chars.find(s[a]) != std::wstring::npos)
+    ++a;
+  return s.substr(a);
+}
+
+std::string AsciiLower(std::string s)
+{
+  for (char& c : s)
+    if (c >= 'A' && c <= 'Z')
+      c = static_cast<char>(c - 'A' + 'a');
+  return s;
+}
+
+std::wstring AsciiLower(std::wstring s)
+{
+  for (wchar_t& c : s)
+    if (c >= L'A' && c <= L'Z')
+      c = static_cast<wchar_t>(c - L'A' + L'a');
+  return s;
+}
+
+bool IsAsciiLetter(wchar_t c)
+{
+  return (c >= L'a' && c <= L'z') || (c >= L'A' && c <= L'Z');
+}
+
+bool IsAsciiUpper(wchar_t c)
+{
+  return c >= L'A' && c <= L'Z';
+}
+
+bool IsAsciiDigit(wchar_t c)
+{
+  return c >= L'0' && c <= L'9';
+}
+
+std::vector<std::wstring> Split(const std::wstring& s, wchar_t sep)
+{
+  std::vector<std::wstring> parts;
+  size_t start = 0;
+  for (size_t i = 0; i <= s.size(); ++i)
+  {
+    if (i == s.size() || s[i] == sep)
+    {
+      parts.push_back(s.substr(start, i - start));
+      start = i + 1;
+    }
+  }
+  return parts;
+}
+
+std::wstring Join(const std::vector<std::wstring>& parts, const std::wstring& sep)
+{
+  std::wstring out;
+  for (size_t i = 0; i < parts.size(); ++i)
+  {
+    if (i)
+      out += sep;
+    out += parts[i];
+  }
+  return out;
+}
+
+//! "\r\n" and a lone "\r" become "\n", in one pass.
+std::wstring UnixLines(const std::wstring& s)
+{
+  std::wstring out;
+  out.reserve(s.size());
+  for (size_t i = 0; i < s.size(); ++i)
+  {
+    if (s[i] != L'\r')
+      out.push_back(s[i]);
+    else
+    {
+      out.push_back(L'\n');
+      if (i + 1 < s.size() && s[i + 1] == L'\n')
+        ++i;
+    }
+  }
+  return out;
+}
+
+//! In the classic locale \w, \s, \d, \b and case folding stay ASCII, whatever the global
+//! locale is.
+std::wregex Pattern(const wchar_t* pattern, bool icase = false)
+{
+  std::wregex r;
+  r.imbue(std::locale::classic());
+  r.assign(pattern, icase ? std::regex::ECMAScript | std::regex::icase : std::regex::ECMAScript);
+  return r;
+}
+
+// -- markup ----------------------------------------------------------------------------------
+
+//! A line as alternating text and markup (<tag> or {label}), text first.
+std::vector<std::wstring> SplitMarkup(const std::wstring& line)
+{
+  std::vector<std::wstring> parts;
+  size_t textStart = 0;
+  size_t i = 0;
+  while (i < line.size())
+  {
+    const wchar_t open = line[i];
+    const wchar_t close = open == L'<' ? L'>' : open == L'{' ? L'}' : 0;
+    if (close)
+    {
+      const size_t end = line.find(close, i + 1);
+      if (end != std::wstring::npos)
+      {
+        parts.push_back(line.substr(textStart, i - textStart));
+        parts.push_back(line.substr(i, end + 1 - i));
+        i = end + 1;
+        textStart = i;
+        continue;
+      }
+    }
+    ++i;
+  }
+  parts.push_back(line.substr(textStart));
+  return parts;
+}
+
+std::wstring Visible(const std::wstring& line)
+{
+  std::wstring out;
+  const std::vector<std::wstring> parts = SplitMarkup(line);
+  for (size_t i = 0; i < parts.size(); i += 2)
+    out += parts[i];
+  return out;
+}
+
+template<typename F>
+std::wstring MapText(const std::wstring& line, F f)
+{
+  std::vector<std::wstring> parts = SplitMarkup(line);
+  std::wstring out;
+  for (size_t i = 0; i < parts.size(); ++i)
+    out += (i % 2) ? parts[i] : f(parts[i]);
+  return out;
+}
