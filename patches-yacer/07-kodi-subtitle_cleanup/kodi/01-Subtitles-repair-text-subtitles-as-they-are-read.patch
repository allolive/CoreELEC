+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <functional>
+#include <map>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+/*!
+ * \brief Repairs of damage text subtitles arrive with. Each rule fixes one known kind of
+ * damage and nothing else: the words of the dialogue, the formatting tags and the start times
+ * are never changed.
+ *
+ * - encoding: a file that is not UTF-8 is read in the code page of the language its name
+ *   gives, and text that was UTF-8 once read as Windows-1252 ("â™ª", "Ã©") is put back;
+ * - music notes: a note that came out of OCR as "¶", as a pair of "J"s, as "#" in a file that
+ *   writes its notes that way, or as an emoji the subtitle font has no glyph for, becomes "♪";
+ * - OCR letters, in any language a pack is installed for: a subtitle made by OCR repeats the
+ *   same misreadings ("wouId", "lnspector", "N0"), so each file learns its own and only those
+ *   are undone, only into a word of the language, only in a line of the language;
+ * - advertising: lines that sell something or credit the uploader are removed, a line only
+ *   for what it says itself, and a cue left with nothing is dropped;
+ * - timing that is plainly broken: a line that cannot be seen, or that runs into the next one
+ *   at the same place so the dialogue jumps. Timing that works is left as it is.
+ */
+namespace KODI::SUBTITLES::CLEANUP
+{
+//! A line up for less than this (two frames at 23.976 fps) cannot be seen.
+constexpr int MIN_SHOWN_MS = 84;
+//! How long such a line is given, unless the next line starts sooner.
+constexpr int READABLE_MS = 1000;
+//! An overlap shorter than a frame rarely lands on one.
+constexpr int MIN_OVERLAP_MS = 42;
+//! Half a second of two lines at once cannot be read: a longer overlap is meant.
+constexpr int MAX_SLOP_MS = 500;
+
+//! A misreading: what the OCR wrote, and what was there.
+using Confusion = std::pair<std::wstring, std::wstring>;
+
+/*!
+ * \brief A language the OCR repair knows: its Hunspell dictionaries and a profile.txt beside
+ * them, one "key = value" a line - codes, dictionaries, one_letter_words, lone_one,
+ * capitalised_nouns, alphabet, accents (tests/subtitle-repair/make_pack.py writes them).
+ */
+class CLanguagePack
+{
+public:
+  CLanguagePack();
+  ~CLanguagePack();
+  CLanguagePack(const CLanguagePack&) = delete;
+  CLanguagePack& operator=(const CLanguagePack&) = delete;
+
+  //! Read dir/profile.txt and the dictionaries it names; false when any cannot be read, or
+  //! when Kodi is built without Hunspell.
+  bool Load(const std::string& dir, const std::string& name);
+
+  const std::string& Name() const { return m_name; }
+  //! Whether subtitles name this language so ("fre", "French", "pt-BR"), in any case.
+  bool HasCode(const std::string& code) const;
+  //! A word of the language: one of its one-letter words, or one a dictionary knows.
+  bool Word(const std::wstring& w) const;
+  //! Written in the language's letters, or in characters an OCR confuses them with.
+  bool Readable(const std::wstring& w) const;
+  bool CapitalisedNouns() const { return m_capitalisedNouns; }
+  bool LoneOne(const std::wstring& next) const { return m_lone.count(next) > 0; }
+  //! The general confusions, then the accents the language's OCR may drop.
+  const std::vector<Confusion>& Confusions() const { return m_confusions; }
+
+private:
+  class CDictionary;
+  std::string m_name;
+  std::unordered_set<std::string> m_codes;
+  std::vector<std::unique_ptr<CDictionary>> m_dictionaries;
+  std::unordered_set<std::wstring> m_one;
+  std::unordered_set<std::wstring> m_lone;
+  std::unordered_set<wchar_t> m_alphabet;
+  bool m_capitalisedNouns{false};
+  std::vector<Confusion> m_confusions;
+};
+
+//! The installed packs, by name.
+using Packs = std::vector<std::shared_ptr<const CLanguagePack>>;
+
+//! Every pack in a directory: each subdirectory holding a profile.txt, by name.
+Packs LoadPacks(const std::string& root);
+
+//! The pack a language code names, or nullptr.
+std::shared_ptr<const CLanguagePack> PackFor(const std::string& code, const Packs& packs);
+
+//! What a language detector makes of a text: the ISO 639-1 code it reads, the share of the text
+//! it gives that language, and whether it is sure.
+struct Detection
+{
+  std::string code;
+  int percent{0};
+  bool reliable{false};
+};
+using Detector = std::function<Detection(const std::string& utf8)>;
+
+//! CLD2's reading; an empty code when Kodi is built without it.
+Detection DetectLanguage(const std::string& utf8);
+
+//! How much of a text CLD2 must give one language to be believed.
+constexpr int DETECT_PERCENT = 80;
+//! A track that names no language is read by CLD2 every this many cues, until it is sure.
+constexpr int DETECT_CUES = 50;
+
+/*!
+ * \brief Undoes the misreadings of one subtitle's OCR, by the pattern the subtitle itself shows.
+ *
+ * A subtitle made by OCR from disc images repeats the same misreadings hundreds of times - one
+ * font, one engine - and a clean one has none. So the engine first learns from the lines which
+ * confusions the file makes: a non-word the confusion alone turns into exactly one word is
+ * evidence, and a confusion is the file's when it is frequent - a real share of how the file
+ * writes that letter, or across many words. A word is then corrected when the file's confusions
+ * turn it into exactly one word, in a line of the language. Names the file uses mid-sentence,
+ * lines another language explains better, an accent on a word another language has, numbers
+ * and Roman numerals are left as they are.
+ */
+class COcrEngine
+{
+public:
+  COcrEngine(std::shared_ptr<const CLanguagePack> language, const Packs& others);
+
+  //! Remember the words the lines capitalise mid-sentence: names keep their spelling.
+  void NoteNames(const std::vector<std::wstring>& lines);
+  //! Learn from the lines which misreadings the file makes.
+  void Learn(const std::vector<std::wstring>& lines);
+  //! The confusions the file has shown so far to be its own, in the language's order.
+  std::vector<Confusion> Active() const;
+  //! The line with the file's misreadings undone; each correction appended to fixes.
+  std::wstring FixLine(const std::wstring& line,
+                       std::vector<std::pair<std::wstring, std::wstring>>* fixes);
+
+  const CLanguagePack& Language() const { return *m_lang; }
+
+private:
+  bool Word(const CLanguagePack& pack, const std::wstring& w);
+  bool ClaimedByOther(const std::vector<std::wstring>& words);
+  bool Acceptable(const std::wstring& w, const std::wstring& reading);
+  bool FixWord(const std::wstring& w, const std::vector<Confusion>& active, std::wstring& fixed);
+  bool LoneOne(const std::wstring& text,
+               size_t start,
+               size_t length,
+               const std::vector<Confusion>& active);
+  bool ReadsAsLanguage(const std::wstring& text, const std::vector<bool>& skip);
+  bool Fix(const std::wstring& text,
+           size_t start,
+           size_t length,
+           const std::vector<Confusion>& active,
+           std::wstring& fixed);
+
+  std::shared_ptr<const CLanguagePack> m_lang;
+  Packs m_others;
+  std::unordered_set<std::wstring> m_names;
+  //! per confusion: the misread words it explains and how often; how often the right letter is
+  //! written correctly
+  std::map<Confusion, std::map<std::wstring, int>> m_evidence;
+  std::map<Confusion, int> m_correct;
+  std::unordered_map<const CLanguagePack*, std::unordered_map<std::wstring, bool>> m_spelt;
+};
+
+struct Options
+{
+  bool removeAds{true};
+  bool fixOcr{true};
+  bool fixTiming{true};
+};
+
+struct Report
+{
+  //! How the file was read: "utf-8", "cp1250", "mixed:cp1252"..., or "unsure" when it is not
+  //! UTF-8, its name gives no language and a Western reading makes no sense.
+  std::string readAs;
+  int repairedLines{0};
+  int notesFixed{0};
+  int adLines{0};
+  int cuesDropped{0};
+  int ocrFixes{0};
+  int timingFixes{0};
+  std::string ocrLanguage; //!< the pack the OCR letters were read in, or empty
+  std::string ocrPattern; //!< the file's misreadings, "l->I 0->O"
+  std::vector<std::string> removed; //!< the ad lines, for the log
+  std::vector<std::string> corrected; //!< "wouId -> would", "overlap: <old> -> <new>"
+
+  bool Changed() const;
+};
+
+//! The language one of the last three words of a subtitle file's name gives ("en", "fre",
+//! "Arabic"), the one nearest the extension first, or empty.
+std::string LanguageOfPath(const std::string& path);
+
+/*!
+ * \brief Repair a whole SubRip file.
+ * \param data the file as read, in whatever encoding it has
+ * \param language what LanguageOfPath gave for it, or empty
+ * \param packs the installed language packs, or nullptr to leave OCR letters alone
+ * \param detect reads the language of a file whose name gives none; empty to not guess
+ * \param out the repaired file, UTF-8
+ * \return false when the file is to be left as it is - it is "unsure" (see Report::readAs)
+ */
+bool CleanSubRip(const std::string& data,
+                 const std::string& language,
+                 const Options& options,
+                 const Packs* packs,
+                 const Detector& detect,
+                 std::string& out,
+                 Report& report);
+
+/*!
+ * \brief The same repairs for cues that arrive one at a time, from a track inside the video.
+ * What a whole file shows up front - whether it writes notes as "#", which misreadings its OCR
+ * makes, which language it is in when the track does not say - is learnt as the cues come, so
+ * those rules start late rather than guess. Timing is the caller's: it holds the cues.
+ */
+class CCueCleaner
+{
+public:
+  /*!
+   * \param packs the installed language packs, or nullptr to leave OCR letters alone
+   * \param language the track's language code, or empty to let detect read it
+   */
+  CCueCleaner(const Options& options,
+              const Packs* packs,
+              const std::string& language,
+              Detector detect);
+
+  /*!
+   * \param text the cue's lines, UTF-8, separated by "\n"; repaired in place
+   * \return false when nothing is left to show
+   */
+  bool Clean(std::string& text);
+
+  //! The {\anN} position a cue asks for, 2 (bottom centre) when it asks for none.
+  static int Position(const std::string& text);
+
+private:
+  Options m_options;
+  Packs m_packs;
+  Detector m_detect;
+  std::unique_ptr<COcrEngine> m_ocr;
+  std::vector<std::wstring> m_undetected; //!< the lines so far of a track in no language yet
+  int m_cuesSeen{0};
+  int m_wrapped{0};
+  int m_opened{0};
+};
+
+//! The options the settings ask for; false when subtitle repair is off.
+bool CurrentOptions(Options& options);
+
+//! The language packs of the pack add-ons installed, read again when they change.
+std::shared_ptr<const Packs> InstalledPacks();
+
+} // namespace KODI::SUBTITLES::CLEANUP
