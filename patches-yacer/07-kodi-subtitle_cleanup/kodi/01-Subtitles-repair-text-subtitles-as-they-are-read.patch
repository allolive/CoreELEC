+namespace
+{
+std::string JoinVisible(const std::vector<std::wstring>& lines)
+{
+  std::wstring text;
+  for (size_t i = 0; i < lines.size(); ++i)
+    text += (i ? L"\n" : L"") + Visible(lines[i]);
+  return ToUtf8(text);
+}
+
+//! The pack a detector surely reads the lines in, or nullptr.
+std::shared_ptr<const CLanguagePack> Detected(const std::vector<std::wstring>& lines,
+                                              const Packs& packs,
+                                              const Detector& detect,
+                                              bool& sure)
+{
+  const Detection d = detect(JoinVisible(lines));
+  sure = d.reliable && d.percent >= DETECT_PERCENT;
+  return sure ? PackFor(d.code, packs) : nullptr;
+}
+
+//! Undo the misreadings of the file's OCR, in the language its name gives or, when it gives
+//! none, the one the detector is sure of.
+void FixOcr(std::vector<Block>& blocks,
+            const std::string& language,
+            const Packs& packs,
+            const Detector& detect,
+            Report& report)
+{
+  std::vector<std::wstring*> lines;
+  std::vector<std::wstring> all;
+  for (Block& block : blocks)
+    if (block.cue)
+      for (std::wstring& line : block.cue->lines)
+      {
+        lines.push_back(&line);
+        all.push_back(line);
+      }
+  std::shared_ptr<const CLanguagePack> pack;
+  bool sure = false;
+  if (!language.empty())
+    pack = PackFor(language, packs);
+  else if (detect)
+    pack = Detected(all, packs, detect, sure);
+  if (!pack)
+    return;
+  COcrEngine engine(pack, packs);
+  engine.NoteNames(all);
+  engine.Learn(all);
+  std::vector<std::pair<std::wstring, std::wstring>> fixes;
+  for (std::wstring* line : lines)
+    *line = engine.FixLine(*line, &fixes);
+  report.ocrFixes = static_cast<int>(fixes.size());
+  for (const auto& [from, to] : fixes)
+    report.corrected.push_back(ToUtf8(from) + " -> " + ToUtf8(to));
+  report.ocrLanguage = pack->Name();
+  for (const Confusion& c : engine.Active())
+    report.ocrPattern += (report.ocrPattern.empty() ? "" : " ") + ToUtf8(c.first) + "->" +
+                         ToUtf8(c.second);
+}
+} // namespace
+
+bool CleanSubRip(const std::string& data,
+                 const std::string& language,
+                 const Options& options,
+                 const Packs* packs,
+                 const Detector& detect,
+                 std::string& out,
+                 Report& report)
+{
+  report = Report();
+  const std::wstring text = Decode(data, language, report.readAs);
+  if (report.readAs == "unsure")
+    return false;
+  // only text that was UTF-8 can carry UTF-8 mojibake; in a mixed file, its UTF-8 lines
+  const bool utf =
+      report.readAs.compare(0, 4, "utf-") == 0 || report.readAs.compare(0, 6, "mixed:") == 0;
+  std::vector<Block> blocks = Parse(text);
+
+  std::vector<size_t> cueIndexes;
+  std::vector<std::wstring> allLines;
+  for (size_t i = 0; i < blocks.size(); ++i)
+  {
+    if (!blocks[i].cue)
+      continue;
+    cueIndexes.push_back(i);
+    allLines.insert(allLines.end(), blocks[i].cue->lines.begin(), blocks[i].cue->lines.end());
+  }
+  const bool hashNotes = HashIsNote(allLines);
+  std::vector<bool> edge(blocks.size(), false);
+  for (size_t k = 0; k < cueIndexes.size(); ++k)
+    if (k < EDGE_CUES || k + EDGE_CUES >= cueIndexes.size())
+      edge[cueIndexes[k]] = true;
+
+  std::vector<Block> kept;
+  for (size_t i = 0; i < blocks.size(); ++i)
+  {
+    Block& block = blocks[i];
+    if (!block.cue)
+    {
+      kept.push_back(std::move(block));
+      continue;
+    }
+    Cue& cue = *block.cue;
+    std::vector<std::wstring> lines;
+    for (const std::wstring& original : cue.lines)
+    {
+      const std::wstring fixed = RepairChars(original, utf);
+      report.repairedLines += fixed != original;
+      if (options.removeAds && IsAd(fixed, edge[i]))
+      {
+        ++report.adLines;
+        report.removed.push_back(ToUtf8(Strip(Visible(fixed))));
+        continue;
+      }
+      std::wstring noted = FixNotes(fixed, hashNotes);
+      report.notesFixed += noted != fixed;
+      lines.push_back(std::move(noted));
+    }
+    if (!cue.lines.empty() && std::all_of(lines.begin(), lines.end(), OnlyMarkup))
+    {
+      ++report.cuesDropped;
+      continue;
+    }
+    cue.lines = std::move(lines);
+    kept.push_back(std::move(block));
+  }
+  if (options.fixOcr && packs)
+    FixOcr(kept, language, *packs, detect, report);
+  if (options.fixTiming)
+  {
+    std::vector<Cue*> cues;
+    for (Block& block : kept)
+      if (block.cue)
+        cues.push_back(&*block.cue);
+    FixTiming(cues, report);
+  }
+  out = ToUtf8(Serialize(kept, report.cuesDropped > 0));
+  return true;
+}
+
+CCueCleaner::CCueCleaner(const Options& options,
+                         const Packs* packs,
+                         const std::string& language,
+                         Detector detect)
+  : m_options(options)
+{
+  if (!options.fixOcr || !packs || packs->empty())
+    return;
+  m_packs = *packs; // the track outlives any one set of packs
+  if (!language.empty())
+  {
+    if (const auto pack = PackFor(language, m_packs))
+      m_ocr = std::make_unique<COcrEngine>(pack, m_packs);
+  }
+  else
+    m_detect = std::move(detect);
+}
+
+bool CCueCleaner::Clean(std::string& text)
+{
+  const std::wstring wide = UnixLines(Widen(text));
+  const std::vector<std::wstring> original = Split(wide, L'\n');
+  if (wide.empty())
+    return true;
+
+  // learn, from the cues seen so far, whether "#" is this track's note
+  for (const std::wstring& line : original)
+  {
+    const auto [w, o] = HashEvidence(line);
+    m_wrapped += w;
+    m_opened += o;
+  }
+  const bool hashNotes = m_wrapped >= 2 || m_opened >= 3;
+
+  std::vector<std::wstring> lines;
+  for (const std::wstring& line : original)
+  {
+    const std::wstring fixed = RepairChars(line, true);
+    if (m_options.removeAds && IsAd(fixed, false))
+      continue;
+    lines.push_back(FixNotes(fixed, hashNotes));
+  }
+  if (std::all_of(lines.begin(), lines.end(), OnlyMarkup))
+    return false;
+
+  if (!m_ocr && m_detect)
+  {
+    // a track that names no language: read it every DETECT_CUES cues until the detector is
+    // sure; a track surely in a language no pack is for is left as it is
+    m_undetected.insert(m_undetected.end(), lines.begin(), lines.end());
+    if (++m_cuesSeen % DETECT_CUES == 0)
+    {
+      bool sure = false;
+      if (const auto pack = Detected(m_undetected, m_packs, m_detect, sure))
+      {
+        m_ocr = std::make_unique<COcrEngine>(pack, m_packs);
+        m_ocr->NoteNames(m_undetected);
+        m_ocr->Learn(m_undetected);
+      }
+      if (sure)
+      {
+        m_detect = nullptr;
+        m_undetected = {};
+      }
+    }
+    if (!m_ocr)
+    {
+      text = ToUtf8(Join(lines, L"\n"));
+      return true;
+    }
+  }
+  else if (m_ocr)
+  {
+    m_ocr->NoteNames(lines);
+    m_ocr->Learn(lines);
+  }
+  if (m_ocr)
+    for (std::wstring& line : lines)
+      line = m_ocr->FixLine(line, nullptr);
+  text = ToUtf8(Join(lines, L"\n"));
+  return true;
+}
+
+int CCueCleaner::Position(const std::string& text)
+{
+  return PositionOf(Widen(text));
+}
+
+} // namespace KODI::SUBTITLES::CLEANUP
