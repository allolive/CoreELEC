+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "SubtitleCleanupSettings.h"
+
+#include "ServiceBroker.h"
+#include "SubtitleCleanup.h"
+#include "addons/AddonInstaller.h"
+#include "addons/AddonManager.h"
+#include "addons/AddonVersion.h"
+#include "addons/IAddon.h"
+#include "addons/addoninfo/AddonType.h"
+#include "filesystem/Directory.h"
+#include "filesystem/SpecialProtocol.h"
+#include "settings/Settings.h"
+#include "settings/SettingUtils.h"
+#include "settings/SettingsComponent.h"
+#include "settings/lib/Setting.h"
+#include "utils/LangCodeExpander.h"
+#include "utils/StringUtils.h"
+#include "utils/URIUtils.h"
+#include "utils/Variant.h"
+#include "utils/log.h"
+
+#include <algorithm>
+#include <map>
+#include <mutex>
+#include <set>
+
+namespace KODI::SUBTITLES::CLEANUP
+{
+bool CurrentOptions(Options& options)
+{
+  const std::shared_ptr<CSettings> settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  if (!settings->GetBool(CSettings::SETTING_SUBTITLES_REPAIR))
+    return false;
+  options.removeAds = settings->GetBool(CSettings::SETTING_SUBTITLES_REPAIRADS);
+  options.fixOcr = !settings->GetList(CSettings::SETTING_SUBTITLES_REPAIRLANGUAGES).empty();
+  options.fixTiming = settings->GetBool(CSettings::SETTING_SUBTITLES_REPAIRTIMING);
+  return true;
+}
+
+namespace
+{
+//! The code of the language a pack add-on is for: "fr" in "script.module.subtitlerepair.fr.allolive".
+std::string PackCode(const std::string& id)
+{
+  const std::string prefix = CRepairLanguages::PACK_PREFIX;
+  if (!StringUtils::StartsWith(id, prefix))
+    return {};
+  const std::string rest = id.substr(prefix.size());
+  return rest.substr(0, rest.find('.'));
+}
+
+//! The installed, enabled pack add-ons, by id.
+ADDON::VECADDONS PackAddons()
+{
+  ADDON::VECADDONS addons;
+  CServiceBroker::GetAddonMgr().GetAddons(addons, ADDON::AddonType::SCRIPT_MODULE);
+  std::erase_if(addons, [](const auto& addon) { return PackCode(addon->ID()).empty(); });
+  std::sort(addons.begin(), addons.end(),
+            [](const auto& a, const auto& b) { return a->ID() < b->ID(); });
+  return addons;
+}
+} // namespace
+
+std::shared_ptr<const Packs> InstalledPacks()
+{
+  static std::mutex lock;
+  static std::string loadedFrom;
+  static std::shared_ptr<const Packs> loaded;
+
+  // read again whenever the pack add-ons installed change
+  const ADDON::VECADDONS addons = PackAddons();
+  std::string key;
+  for (const auto& addon : addons)
+    key += addon->ID() + "@" + addon->Version().asString() + ";";
+  std::unique_lock guard(lock);
+  if (loaded && key == loadedFrom)
+    return loaded;
+
+  auto packs = std::make_shared<Packs>();
+  for (const auto& addon : addons)
+  {
+    const std::string dir = CSpecialProtocol::TranslatePath(
+        URIUtils::AddFileToFolder(addon->Path(), "resources", "subtitlerepair"));
+    if (!XFILE::CDirectory::Exists(dir))
+      continue;
+    for (auto& pack : LoadPacks(dir))
+      if (std::none_of(packs->begin(), packs->end(),
+                       [&](const auto& p) { return p->Name() == pack->Name(); }))
+        packs->push_back(std::move(pack));
+  }
+  std::sort(packs->begin(), packs->end(),
+            [](const auto& a, const auto& b) { return a->Name() < b->Name(); });
+  for (const auto& pack : *packs)
+    CLog::Log(LOGINFO, "Subtitle repair: language pack {}", pack->Name());
+  if (packs->empty())
+    CLog::Log(LOGINFO, "Subtitle repair: no language chosen, misread letters stay");
+  loadedFrom = key;
+  loaded = std::move(packs);
+  return loaded;
+}
+
+CRepairLanguages& CRepairLanguages::GetInstance()
+{
+  static CRepairLanguages instance;
+  return instance;
+}
+
+void CRepairLanguages::SettingOptionsFiller(const std::shared_ptr<const CSetting>& setting,
+                                            std::vector<StringSettingOption>& list,
+                                            std::string& current)
+{
+  // the packs the repositories offer, and any installed from elsewhere
+  ADDON::VECADDONS offered;
+  CServiceBroker::GetAddonMgr().GetInstallableAddons(offered, ADDON::AddonType::SCRIPT_MODULE);
+  const ADDON::VECADDONS installed = PackAddons();
+  offered.insert(offered.end(), installed.begin(), installed.end());
+  std::map<std::string, std::string> byLabel;
+  for (const auto& addon : offered)
+  {
+    const std::string code = PackCode(addon->ID());
+    if (code.empty())
+      continue;
+    std::string label;
+    if (!CLangCodeExpander::Lookup(code, label))
+      label = code;
+    byLabel.emplace(label, addon->ID());
+  }
+  for (const auto& [label, id] : byLabel)
+    list.emplace_back(label, id);
+}
+
+void CRepairLanguages::OnSettingChanged(const std::shared_ptr<const CSetting>& setting)
+{
+  if (!setting || setting->GetId() != CSettings::SETTING_SUBTITLES_REPAIRLANGUAGES)
+    return;
+  const std::vector<CVariant> values =
+      CSettingUtils::GetList(std::static_pointer_cast<const CSettingList>(setting));
+  std::set<std::string> chosen;
+  for (const CVariant& value : values)
+    chosen.insert(value.asString());
+
+  for (const std::string& id : chosen)
+    if (!CServiceBroker::GetAddonMgr().IsAddonInstalled(id))
+      ADDON::CAddonInstaller::GetInstance().InstallOrUpdate(
+          id, ADDON::BackgroundJob::CHOICE_YES, ADDON::ModalJob::CHOICE_NO);
+  for (const auto& addon : PackAddons())
+    if (!chosen.count(addon->ID()))
+      ADDON::CAddonInstaller::GetInstance().UnInstall(addon, true);
+}
+} // namespace KODI::SUBTITLES::CLEANUP
