+// -- markup ----------------------------------------------------------------------------------
+
+//! A line as alternating text and markup (<tag> or {label}), text first.
+std::vector<std::wstring> SplitMarkup(const std::wstring& line)
+{
+  std::vector<std::wstring> parts;
+  size_t textStart = 0;
+  size_t i = 0;
+  while (i < line.size())
+  {
+    const wchar_t open = line[i];
+    const wchar_t close = open == L'<' ? L'>' : open == L'{' ? L'}' : 0;
+    if (close)
+    {
+      const size_t end = line.find(close, i + 1);
+      if (end != std::wstring::npos)
+      {
+        parts.push_back(line.substr(textStart, i - textStart));
+        parts.push_back(line.substr(i, end + 1 - i));
+        i = end + 1;
+        textStart = i;
+        continue;
+      }
+    }
+    ++i;
+  }
+  parts.push_back(line.substr(textStart));
+  return parts;
+}
+
+std::wstring Visible(const std::wstring& line)
+{
+  std::wstring out;
+  const std::vector<std::wstring> parts = SplitMarkup(line);
+  for (size_t i = 0; i < parts.size(); i += 2)
+    out += parts[i];
+  return out;
+}
+
+template<typename F>
+std::wstring MapText(const std::wstring& line, F f)
+{
+  std::vector<std::wstring> parts = SplitMarkup(line);
+  std::wstring out;
+  for (size_t i = 0; i < parts.size(); ++i)
+    out += (i % 2) ? parts[i] : f(parts[i]);
+  return out;
+}
