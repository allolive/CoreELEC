+
+//! Whether a release is newer than another of its family: a higher version, then the alias of a
+//! version before its snapshots, then the later snapshot.
+bool Newer(const Release& a, const Release& b)
+{
+  if (a.version != b.version)
+    return a.version > b.version;
+  if (a.date.empty() != b.date.empty())
+    return a.date.empty();
+  return a.date > b.date;
+}
+
+//! The newest release of a family among the models listed, or empty.
+std::string Newest(const std::vector<std::string>& models, const std::string& family)
+{
+  std::string newest;
+  Release best;
+  for (const std::string& model : models)
+  {
+    const Release release = ReleaseOf(model);
+    if (release.stable && release.family == family && (newest.empty() || Newer(release, best)))
+    {
+      newest = model;
+      best = release;
+    }
+  }
+  return newest;
+}
