 namespace KODI::SUBTITLES::AI
 {
@@ -55,6 +61,12 @@ using namespace std::chrono_literals;
 
 constexpr auto OPENROUTER_URL = "https://openrouter.ai/api/v1";
 constexpr auto OPENAI_URL = "https://api.openai.com/v1";
+//! the providers' own APIs that speak OpenAI's
+constexpr auto GOOGLE_URL = "https://generativelanguage.googleapis.com/v1beta/openai";
+constexpr auto ANTHROPIC_URL = "https://api.anthropic.com/v1";
+constexpr auto NVIDIA_URL = "https://integrate.api.nvidia.com/v1";
+//! The model setting naming a family rather than a model: its newest release is used.
+constexpr std::string_view NEWEST = "newest:";
 //! Few names: they are for consistency, and a long cast list is mostly extras.
 constexpr size_t MAX_CAST = 40;
 //! How often the provider is asked again whether it answers: soon when it did not - a server
@@ -89,34 +101,245 @@ bool Exchange(XFILE::CCurlFile& http,
     http.SetRequestHeader("Authorization", "Bearer " + provider.key);
   if (provider.kind == OPENROUTER)
     http.SetRequestHeader("X-Title", "Kodi");
-  // the body of a refusal says why
-  const std::string url = provider.base + path + "|failonerror=false";
+  // Anthropic lists its models only to its own headers
+  if (provider.kind == ANTHROPIC && !provider.key.empty())
+  {
+    http.SetRequestHeader("x-api-key", provider.key);
+    http.SetRequestHeader("anthropic-version", "2023-06-01");
+  }
+  // the body of a refusal says why; and no range, which curl sends with a request's body as
+  // Content-Range - Google refuses it
+  const std::string url = provider.base + path + "|failonerror=false&seekable=0";
   if (!post)
     return http.Get(url, answer);
   http.SetMimeType("application/json");
   return http.Post(url, *post, answer);
 }
 
+//! The error a provider's answer carries - Google's comes in a list - or null.
+const CVariant& RefusalOf(const CVariant& json)
+{
+  static const CVariant none;
+  const CVariant& answer = json.isArray() && json.size() > 0 ? json[0] : json;
+  return answer.isObject() && answer.isMember("error") ? answer["error"] : none;
+}
+
 //! The error a provider's answer carries, or the start of an answer that is no JSON.
 std::string ErrorOf(const CVariant& json, const std::string& raw)
 {
   std::string error = raw.substr(0, 200);
-  if (json.isMember("error"))
-    error =
-        json["error"].isObject() ? json["error"]["message"].asString() : json["error"].asString();
+  const CVariant& refusal = RefusalOf(json);
+  if (!refusal.isNull())
+    error = refusal.isObject() ? refusal["message"].asString() : refusal.asString();
   return error.empty() ? "an answer with no reply in it" : error;
 }
 
+//! The HTTP status of the provider's last answer: 429 is its limit, requests a minute or a day,
+//! or credit, whoever the provider.
+int StatusOf(const XFILE::CCurlFile& http)
+{
+  const std::vector<std::string> parts =
+      StringUtils::Split(http.GetHttpHeader().GetProtoLine(), ' ');
+  return parts.size() > 1 ? std::atoi(parts[1].c_str()) : 0;
+}
+
+//! Whether the model reasoned before it answered: in the answer, or beside it.
+bool Reasoned(const CVariant& reply)
+{
+  const CVariant& message = reply["choices"][0]["message"];
+  const std::string content = message["content"].asString();
+  for (const char* tag : {"<think>", "</think>", "<thought>", "</thought>"})
+    if (content.find(tag) != std::string::npos)
+      return true;
+  return !message["reasoning"].asString().empty() ||
+         !message["reasoning_content"].asString().empty() ||
+         reply["usage"]["completion_tokens_details"]["reasoning_tokens"].asInteger() > 0;
+}
+
+//! A model a provider lists, by the name its chat takes: Google's list puts "models/" before it.
+std::string ModelOf(const CVariant& listed)
+{
+  std::string id = listed["id"].asString();
+  if (StringUtils::StartsWith(id, "models/"))
+    id.erase(0, 7);
+  return id;
+}
+
+//! Whether a model the provider lists can chat: OpenAI also lists the ones that speak, draw,
+//! hear or index.
+bool Chats(const std::string& model)
+{
+  for (const char* other : {"embed", "tts", "whisper", "dall-e", "moderation", "audio", "realtime",
+                            "transcribe", "image", "search", "live", "veo", "lyria", "imagen",
+                            "robotics", "computer-use", "research", "omni", "aqa", "banana",
+                            "antigravity", "guard", "safety", "reward", "parse", "clip",
+                            "detector", "retriever", "deplot", "kosmos", "calibration"})
+    if (model.find(other) != std::string::npos)
+      return false;
+  return true;
+}
+
+/*!
+ * \brief A model's name taken apart: its family - the name without the version, the size kept -
+ * the version, the date of the snapshot, and whether it is a release: not a preview, not an alias.
+ * "gemini-3.1-flash-lite" is the release 3.1 of gemini-flash-lite, "gpt-4o-mini-2024-07-18" a
+ * snapshot of 4 of gpt-mini, "qwen/qwen3.5-9b" the release 3.5 of qwen/qwen-9b.
+ */
+struct Release
+{
+  std::string family;
+  std::vector<int> version;
+  std::string date;
+  bool stable{true};
+};
+
+//! Whether a part of a name is a size, of the model or of its context: "31b", "8x7b", "500m", "32k".
+bool IsSize(std::string_view part)
+{
+  return part.size() > 1 && (part.back() == 'b' || part.back() == 'm' || part.back() == 'k') &&
+         std::all_of(part.begin(), part.end() - 1,
+                     [](char c) { return StringUtils::isasciidigit(c) || c == '.' || c == 'x'; });
+}
+
+void AppendNumbers(std::string_view part, std::vector<int>& version)
+{
+  int number = -1;
+  for (const char c : part)
+    if (StringUtils::isasciidigit(c))
+      number = (number < 0 ? 0 : number * 10) + (c - '0');
+    else if (number >= 0)
+    {
+      version.push_back(number);
+      number = -1;
+    }
+  if (number >= 0)
+    version.push_back(number);
+}
+
+Release ReleaseOf(std::string_view model)
+{
+  Release release;
+  // OpenRouter's variants, ":free", and the vendor before a slash stay in the family
+  std::string_view variant;
+  if (const size_t colon = model.find(':'); colon != std::string_view::npos)
+  {
+    variant = model.substr(colon);
+    model = model.substr(0, colon);
+  }
+  std::string_view vendor;
+  if (const size_t slash = model.rfind('/'); slash != std::string_view::npos)
+  {
+    vendor = model.substr(0, slash + 1);
+    model = model.substr(slash + 1);
+  }
+  std::vector<std::string> kept;
+  for (const std::string& part : StringUtils::Split(StringUtils::ToLower(std::string(model)), '-'))
+  {
+    if (part.empty())
+      continue;
+    const bool digits = std::all_of(part.begin(), part.end(), StringUtils::isasciidigit);
+    // a date, "20241022", "2506", or its year: it and what follows date the snapshot
+    if (!release.date.empty() || (digits && part.size() >= 4))
+      release.date += part;
+    else if (part == "latest" || part == "preview" || part == "beta" || part == "alpha" ||
+             StringUtils::StartsWith(part, "exp"))
+      release.stable = false;
+    // "4.1", "4o", "v2"
+    else if ((StringUtils::isasciidigit(part[0]) && !IsSize(part)) ||
+             (part.size() > 1 && part[0] == 'v' &&
+              part.find_first_not_of("0123456789.", 1) == std::string::npos))
+      AppendNumbers(part, release.version);
