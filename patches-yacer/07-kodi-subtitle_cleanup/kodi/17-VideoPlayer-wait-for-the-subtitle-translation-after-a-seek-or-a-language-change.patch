+/*!
+ * \brief Playback waiting for the translation (CLead::Check) as it leaves its buffering: when the
+ * wait starts, ends, or gives up - CAP after the last lead waited for moved.
+ */
+class CTranslationWait
+{
+public:
+  using Clock = CLead::Clock;
+  static constexpr Clock::duration CAP = std::chrono::seconds(30);
+  //! A wait not asked about this long no longer counts as waiting (Waiting()); one not asked
+  //! about for CAP ended some other way.
+  static constexpr Clock::duration GONE = std::chrono::seconds(5);
+
+  enum class Turn
+  {
+    GO,
+    STARTS,
+    WAITS,
+    ENDS,
+    GIVES_UP,
+  };
+  struct Answer
+  {
+    Turn turn;
+    double lead; //!< how far ahead the translation is
+    double waited; //!< seconds since the wait started
+  };
+  //! Whether playback waits, asked as it is about to go on: where it is, as CLead::Check takes it.
+  static Answer Ask(double stream, double file, Clock::time_point now = Clock::now());
+  static bool Waiting(Clock::time_point now = Clock::now());
+};
+
 /*!
  * \brief Hands cues to a model's work on a thread of its own, a few at a time, and each result to
  * deliver with the cue's times, on that thread, in the order of the cues.
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 50f1d08..598a0f7 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -2825,6 +2825,12 @@ void CVideoPlayer::HandlePlaySpeed()
       }
 
       m_syncStartPtsWait.reset();
+      // A film's start is already out of its buffering (the speed request Prepare queues): one
+      // whose subtitle translation is waited for goes back into it, the stream players paused,
+      // for SetCaching to hold.
+      if (!m_State.streamsReady && m_caching == CACHESTATE_DONE &&
+          HoldForSubtitleTranslation(clock))
+        SetCaching(CACHESTATE_INIT);
       m_clock.Discontinuity(clock);
       m_CurrentAudio.syncState = IDVDStreamPlayer::SYNC_INSYNC;
       m_CurrentAudio.avsync = CCurrentStream::AV_SYNC_NONE;
@@ -4750,6 +4756,11 @@ bool CVideoPlayer::PollResumePreroll()
 
 void CVideoPlayer::SetCaching(ECacheState state)
 {
+  if ((state == CACHESTATE_PLAY || state == CACHESTATE_DONE) &&
+      (m_caching == CACHESTATE_INIT || m_caching == CACHESTATE_FULL) &&
+      HoldForSubtitleTranslation())
+    return;
+
   // Any move off CACHESTATE_FULL ends a source-underrun hold, a seek included.
   const bool wasSourceUnderrunHold = m_srcUnderrunHold;
   if (state != CACHESTATE_FULL)
@@ -7229,6 +7240,9 @@ void CVideoPlayer::UpdatePlayState(double timeout)
   else
     state.cache_bytes = 0;
 
+  if (state.caching && SUBTITLES::AI::HoldingForTranslation())
+    state.cache_level = std::max(state.cache_level, 0.01);
+
   state.timestamp = m_clock.GetAbsoluteClock();
 
   if (state.timeMax <= 0)
@@ -7532,6 +7546,26 @@ void CVideoPlayer::UpdateContent()
   m_content.m_programs = m_programs;
 }
 
+bool CVideoPlayer::HoldForSubtitleTranslation(std::optional<double> at)
+{
+  // after a seek or a subtitle opening, the translation gets ahead first; not at the end of the
+  // input, when the streams are no longer inited
+  if (m_bAbortRequest || !(m_CurrentVideo.inited || m_CurrentAudio.inited) ||
+      m_nextStream.Pending() || !m_pInputStream || m_pInputStream->IsRealtime() ||
+      IsInMenuInternal() || (m_CurrentVideo.hint.flags & StreamFlags::FLAG_STILL_IMAGES) ||
+      !m_VideoPlayerVideo->IsSubtitleEnabled())
+    return false;
+  // the clock is put where playback goes only as the streams are put on it: until then, whether
+  // the translation may be waited for
+  if (!at &&
+      ((m_CurrentVideo.id >= 0 && m_CurrentVideo.syncState != IDVDStreamPlayer::SYNC_INSYNC) ||
+       (m_CurrentAudio.id >= 0 && m_CurrentAudio.syncState != IDVDStreamPlayer::SYNC_INSYNC)))
+    return SUBTITLES::AI::TranslationAwaited();
+  // the times the player shows a stream's cues and a file's at (see Process)
+  const double stream = at.value_or(m_clock.GetClock()) - m_VideoPlayerVideo->GetSubtitleDelay();
+  return SUBTITLES::AI::HoldForTranslation(stream, stream + m_State.time_offset);
+}
