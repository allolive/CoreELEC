 #include <condition_variable>
 #include <cstdlib>
 #include <iterator>
@@ -1052,6 +1053,57 @@ double ShowingTime()
                 : 0.0;
 }
 
+namespace
+{
+std::string Ahead(double lead)
+{
+  return std::isinf(lead) ? "all" : StringUtils::Format("{:.1f} s", lead / DVD_TIME_BASE);
+}
+} // namespace
+
+bool HoldForTranslation(double stream, double file)
+{
+  using Wait = MODEL::CTranslationWait;
+  const Wait::Answer answer = Wait::Ask(stream, file);
+  switch (answer.turn)
+  {
+    case Wait::Turn::STARTS:
+      CLog::Log(LOGINFO, "Subtitle translation: playback waits at {:.1f} s, the translation {} ahead",
+                stream / DVD_TIME_BASE, Ahead(answer.lead));
+      CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Info, Localized(287),
+                                            Localized(60103), TOAST_DISPLAY_TIME, false);
+      return true;
+    case Wait::Turn::WAITS:
+      return true;
+    case Wait::Turn::ENDS:
+      CLog::Log(LOGINFO,
+                "Subtitle translation: playback goes on after waiting {:.1f} s, the translation "
+                "{} ahead",
+                answer.waited, Ahead(answer.lead));
+      return false;
+    case Wait::Turn::GIVES_UP:
+      CLog::Log(LOGINFO,
+                "Subtitle translation: playback goes on after waiting {:.1f} s, {} s after the "
+                "seek, the translation {} ahead: lines may come late",
+                answer.waited, std::chrono::duration_cast<std::chrono::seconds>(Wait::CAP).count(),
+                Ahead(answer.lead));
+      return false;
+    case Wait::Turn::GO:
+      break;
+  }
+  return false;
+}
+
+bool HoldingForTranslation()
+{
+  return MODEL::CTranslationWait::Waiting();
+}
+
+bool TranslationAwaited()
+{
+  return MODEL::CLead::Awaited();
+}
