@@ -374,6 +381,47 @@ void CLead::GiveUp()
     lead->m_settled = true;
 }
 
+namespace
+{
+std::mutex g_waitLock;
+std::optional<CLead::Clock::time_point> g_waitSince;
+CLead::Clock::time_point g_waitAsked;
+} // namespace
+
+CTranslationWait::Answer CTranslationWait::Ask(double stream, double file, Clock::time_point now)
+{
+  std::unique_lock lock(g_waitLock);
+  // one wait, told once: asked about seldom (before the start sync) it goes on
+  if (g_waitSince && now - g_waitAsked > CAP)
+    g_waitSince.reset();
+  g_waitAsked = now;
+  const CLead::State state = CLead::Check(stream, file, now);
+  const double waited =
+      g_waitSince ? std::chrono::duration<double>(now - *g_waitSince).count() : 0.0;
+  if (state.ready)
+  {
+    const Turn turn = g_waitSince ? Turn::ENDS : Turn::GO;
+    g_waitSince.reset();
+    return {turn, state.lead, waited};
+  }
+  if (now - state.moved >= CAP)
+  {
+    CLead::GiveUp();
+    g_waitSince.reset();
+    return {Turn::GIVES_UP, state.lead, waited};
+  }
+  if (g_waitSince)
+    return {Turn::WAITS, state.lead, waited};
+  g_waitSince = now;
+  return {Turn::STARTS, state.lead, 0.0};
+}
+
+bool CTranslationWait::Waiting(Clock::time_point now)
+{
+  std::unique_lock lock(g_waitLock);
+  return g_waitSince && now - g_waitAsked <= GONE;
+}
