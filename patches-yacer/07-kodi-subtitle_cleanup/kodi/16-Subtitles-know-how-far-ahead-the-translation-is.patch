+// -- the lead ------------------------------------------------------------------------------------
+
+namespace
+{
+std::mutex& LeadLock()
+{
+  static std::mutex lock;
+  return lock;
+}
+
+//! the leads open, under LeadLock
+std::vector<CLead*>& Leads()
+{
+  static std::vector<CLead*> leads;
+  return leads;
+}
+
+uint64_t g_ticket{0}; //!< the last ticket given, under LeadLock
+
+constexpr double NONE = std::numeric_limits<double>::infinity();
+} // namespace
+
+CLead::CLead(Known known, Clock::time_point at)
+  : m_known(known),
+    m_horizon(known == Known::WHOLE ? NONE : -NONE),
+    m_moved(at),
+    m_until(at + FRESH)
+{
+  std::unique_lock lock(LeadLock());
+  Leads().push_back(this);
+}
+
+CLead::~CLead()
+{
+  Close();
+}
+
+void CLead::Close()
+{
+  std::unique_lock lock(LeadLock());
+  m_closed = true;
+  m_pending.clear();
+  std::vector<CLead*>& leads = Leads();
+  leads.erase(std::remove(leads.begin(), leads.end(), this), leads.end());
+}
+
+uint64_t CLead::Add(double start, double stop)
+{
+  std::unique_lock lock(LeadLock());
+  if (m_closed)
+    return 0;
+  m_pending[++g_ticket] = {start, stop > start ? stop : start};
+  if (m_known == Known::AS_READ)
+    m_horizon = std::max(m_horizon, start);
+  return g_ticket;
+}
+
+void CLead::Done(uint64_t ticket)
+{
+  if (!ticket)
+    return;
+  std::unique_lock lock(LeadLock());
+  m_pending.erase(ticket);
+}
+
+void CLead::Seek(Clock::time_point at)
+{
+  std::unique_lock lock(LeadLock());
+  ++m_generation;
+  m_settled = false;
+  m_moved = at;
+  m_until = at + FRESH;
+  // a file's cues stay: they are worked on from wherever playback is
+  if (m_known == Known::WHOLE)
+    return;
+  m_pending.clear();
+  m_horizon = -NONE;
+  m_ended = false;
+}
+
+unsigned int CLead::Generation() const
+{
+  std::unique_lock lock(LeadLock());
+  return m_generation;
+}
+
+void CLead::ReadAhead()
+{
+  std::unique_lock lock(LeadLock());
+  m_known = Known::AHEAD;
+  m_horizon = -NONE;
+  m_ended = false;
+}
+
+void CLead::Reached(double time, unsigned int generation)
+{
+  std::unique_lock lock(LeadLock());
+  if (m_known != Known::AHEAD || generation != m_generation)
+    return;
+  m_horizon = std::max(m_horizon, time);
+  // read on: a failed read was taken for the end
+  m_ended = false;
+}
+
+void CLead::Ended(unsigned int generation)
+{
+  std::unique_lock lock(LeadLock());
+  if (m_known == Known::AHEAD && generation == m_generation)
+    m_ended = true;
+}
+
+void CLead::Unread()
+{
+  std::unique_lock lock(LeadLock());
+  if (m_known != Known::AHEAD)
+    return;
+  m_known = Known::AS_READ;
+  m_horizon = -NONE;
+  for (const auto& [ticket, cue] : m_pending)
+    m_horizon = std::max(m_horizon, cue.first);
+}
+
+double CLead::Ahead(double now, bool& ready) const
+{
+  // a cue over already is not waited for: a file's are worked on from where playback is
+  double first = NONE;
+  for (const auto& [ticket, cue] : m_pending)
+    if (cue.second >= now)
+      first = std::min(first, cue.first);
+  const bool whole = m_known != Known::AHEAD || m_ended;
+  const double lead = std::min(first, whole ? NONE : m_horizon) - now;
+  ready = lead >= READY || (first == NONE && whole);
+  // a stream read as it plays: as far as its cues are known
+  return m_known == Known::AS_READ ? std::min(first, m_horizon) - now : lead;
+}
+
+CLead::State CLead::Check(double stream, double file, Clock::time_point at)
+{
+  std::unique_lock lock(LeadLock());
+  State state{true, NONE, {}};
+  for (CLead* lead : Leads())
+  {
+    if (lead->m_settled || at > lead->m_until)
+    {
+      lead->m_settled = true;
+      continue;
+    }
+    bool ready;
+    state.lead =
+        std::min(state.lead, lead->Ahead(lead->m_known == Known::WHOLE ? file : stream, ready));
+    if (ready)
+    {
+      lead->m_settled = true;
+      continue;
+    }
+    state.ready = false;
+    state.moved = std::max(state.moved, lead->m_moved);
+    lead->m_until = std::max(lead->m_until, at + KEEP);
+  }
+  return state;
+}
+
+void CLead::GiveUp()
+{
+  std::unique_lock lock(LeadLock());
+  for (CLead* lead : Leads())
+    lead->m_settled = true;
+}
