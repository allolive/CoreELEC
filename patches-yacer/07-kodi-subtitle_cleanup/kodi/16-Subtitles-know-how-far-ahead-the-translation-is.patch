+/*!
+ * \brief How far ahead of playback the translation of an open subtitle stream is: the cues handed
+ * in and not yet shown, and how far ahead its cues are known. Times are the cues' (microseconds).
+ * Check() sees every one open; the player asks it before it goes on after a seek or a stream
+ * opening. Its lock is taken for nothing else.
+ */
+class CLead
+{
+public:
+  using Clock = std::chrono::steady_clock;
+
+  //! How far ahead its cues are known.
+  enum class Known
+  {
+    WHOLE, //!< a file's: all of them
+    AHEAD, //!< as far as a read-ahead has read
+    AS_READ, //!< as the player reads them
+  };
+
+  //! How far ahead of playback the translation is for playback to go on.
+  static constexpr double READY = 15.0 * 1000000.0;
+  //! A lead is waited for only this soon after it opens or a seek moves it, and the wait goes on
+  //! only while it is asked about.
+  static constexpr Clock::duration FRESH = std::chrono::seconds(20);
+  static constexpr Clock::duration KEEP = std::chrono::seconds(2);
+
+  explicit CLead(Known known, Clock::time_point at = Clock::now());
+  ~CLead();
+  CLead(const CLead&) = delete;
+  CLead& operator=(const CLead&) = delete;
+
+  //! A cue handed in to be translated; the ticket Done() takes.
+  uint64_t Add(double start, double stop);
+  //! The cue is shown, or dropped.
+  void Done(uint64_t ticket);
+  //! Playback moved: waited for again; a stream's cues are dropped, and how far they are known
+  //! is not known again until the read-ahead says.
+  void Seek(Clock::time_point at = Clock::now());
+  //! Which seek: what a read-ahead says before seeing the last one is not taken.
+  unsigned int Generation() const;
+  //! A read-ahead reads the track.
+  void ReadAhead();
+  //! It has read up to there, after the seek generation.
+  void Reached(double time, unsigned int generation);
+  //! It has read to the end, after the seek generation.
+  void Ended(unsigned int generation);
+  //! It stopped: the cues are known as the player reads them.
+  void Unread();
+  //! The stream closes: Check() no longer sees it.
+  void Close();
+
+  struct State
+  {
