+//! What the playing video's subtitles are translated into: shared by the player, which opens the
+//! subtitle, and the subtitle dialog, which shows and turns it.
+struct Translation
+{
+  std::mutex lock;
+  std::string video; //!< the video it is for
+  bool chosen{false}; //!< the viewer chose the target, which then holds
+  std::string target; //!< what the subtitles are translated into, a language's code, or empty
+  bool available{false}; //!< whether a translation can be chosen
+  struct Open
+  {
+    int64_t demuxerId{-1};
+    int id{-1};
+    int source{-1};
+  };
+  std::optional<Open> open; //!< the track open translated
+  std::string track; //!< the language of the subtitle open, translated or not
+  uint64_t kept{0}; //!< how many choices were kept: a file write never undoes a later one
+};
+
+Translation& GetTranslation()
+{
+  static Translation translation;
+  return translation;
+}
+
+//! The playing film, as the library knows its file, whichever path played it - a disc's
+//! playlist included.
+std::string PlayingVideo()
+{
+  const std::shared_ptr<CFileItem> item = g_application.CurrentFileItemPtr();
+  if (!item)
+    return {};
+  if (item->HasVideoInfoTag() && !item->GetVideoInfoTag()->m_strFileNameAndPath.empty())
+    return item->GetVideoInfoTag()->m_strFileNameAndPath;
+  return item->GetPath();
+}
+
+//! The language each film's subtitles were last turned to, off included, kept for when it plays
+//! again: in a file of its own, read once.
+constexpr const char* CHOICES = "special://profile/subtitletranslation.json";
+constexpr const char* CHOICES_NEW = "special://profile/subtitletranslation.json.new";
+
+CVariant& Choices()
+{
+  static std::optional<CVariant> choices;
+  if (choices)
+    return *choices;
+  choices.emplace(CVariant::VariantTypeObject);
+  std::vector<uint8_t> buffer;
+  XFILE::CFile file;
+  CVariant read;
+  if (file.LoadFile(CHOICES, buffer) > 0 &&
+      CJSONVariantParser::Parse(std::string(buffer.begin(), buffer.end()), read) && read.isObject())
+    *choices = read;
+  return *choices;
+}
+
+struct Kept
+{
+  std::string json;
+  uint64_t number;
+};
+
+//! Keep a film's choice, under the translation's lock: what the file is then to hold.
+std::optional<Kept> Keep(Translation& translation)
+{
+  CVariant& choices = Choices();
+  if (choices.isMember(translation.video) &&
+      choices[translation.video].asString() == translation.target)
+    return {};
+  choices[translation.video] = translation.target;
+  std::string json;
+  if (!CJSONVariantWriter::Write(choices, json, false))
+    return {};
+  return Kept{std::move(json), ++translation.kept};
+}
+
+//! Write the choices kept, without the translation's lock: the player takes it.
+void Save(const Kept& kept)
+{
+  static std::mutex lock;
+  static uint64_t written{0};
+  std::unique_lock guard(lock);
+  if (kept.number <= written)
+    return;
+  // written aside and renamed over: a power cut leaves the old file or the new one
+  XFILE::CFile file;
+  if (!file.OpenForWrite(CHOICES_NEW, true) ||
+      file.Write(kept.json.data(), kept.json.size()) !=
+          static_cast<ssize_t>(kept.json.size()))
   {
-    m_selected = false;
+    CLog::LogF(LOGERROR, "cannot write {}", CHOICES_NEW);
     return;
   }
-  std::vector<TR::Track> tracks;
-  for (const SelectionStream& st : ordered)
+  file.Close();
+  if (!XFILE::CFile::Rename(CHOICES_NEW, CHOICES))
   {
-    // text inside the video, cue by cue, or a SubRip file beside it, read whole
-    const bool text =
-        (STREAM_SOURCE_MASK(st.source) == STREAM_SOURCE_DEMUX &&
-         (st.codecId == AV_CODEC_ID_SUBRIP || st.codecId == AV_CODEC_ID_TEXT)) ||
-        (STREAM_SOURCE_MASK(st.source) == STREAM_SOURCE_TEXT &&
-         URIUtils::HasExtension(st.filename, ".srt"));
-    tracks.push_back({TR::CodeOf(st.language), reads(st.language),
-                      (st.flags & StreamFlags::FLAG_FORCED) != 0, text});
+    CLog::LogF(LOGERROR, "cannot replace {}", CHOICES);
+    return;
   }
-  // a provider that does not answer offers nothing - but a translation being shown stays
-  const auto chosen = TR::ChooseSource(tracks);
-  if (chosen && (m_selected || Available()))
-    m_offer = Offer{ordered[*chosen].type_index, tracks[*chosen].code, target};
-  else
-    m_selected = false;
+  written = kept.number;
 }
 
-int CTranslatedEntry::Index(const CSelectionStreams& streams)
+//! The languages to translate into, in turn: the subtitle language, then those subtitles are
+//! downloaded in.
+std::vector<std::string> TranslationLanguages()
 {
-  return streams.CountType(StreamType::SUBTITLE);
+  std::vector<std::string> codes;
+  const auto add = [&codes](const std::string& code)
+  {
+    if (!code.empty() && std::find(codes.begin(), codes.end(), code) == codes.end())
+      codes.push_back(code);
+  };
+  add(TargetLanguage());
+  for (const CVariant& language :
+       CServiceBroker::GetSettingsComponent()->GetSettings()->GetList(
+           CSettings::SETTING_SUBTITLES_LANGUAGES))
+    if (std::string code; CLangCodeExpander::ConvertToISO6391(language.asString(), code))
+      add(code);
+  return codes;
+}
+
+//! Whether a track is text the translation reads: inside the video, cue by cue, or a SubRip file
+//! beside it, read whole.
+bool IsText(const SelectionStream& st)
+{
+  return (STREAM_SOURCE_MASK(st.source) == STREAM_SOURCE_DEMUX &&
+          (st.codecId == AV_CODEC_ID_SUBRIP || st.codecId == AV_CODEC_ID_TEXT)) ||
+         (STREAM_SOURCE_MASK(st.source) == STREAM_SOURCE_TEXT &&
+          URIUtils::HasExtension(st.filename, ".srt"));
+}
+
+//! What a track is read in for a target: the target, or empty when it is shown as it is.
+std::string ReadFor(const SelectionStream& st, const std::string& target)
+{
+  const std::string from = TRANSLATION::CodeOf(st.language);
+  if (target.empty() || !IsText(st) || from.empty() || from == target)
+    return {};
+  return target;
+}
+} // namespace
+
+std::string TranslationLabel()
+{
+  Translation& translation = GetTranslation();
+  std::unique_lock guard(translation.lock);
+  if (!translation.available || translation.video != PlayingVideo())
+    return {};
+  // a subtitle already in the language is not translated: off
+  if (translation.target.empty() || translation.target == translation.track)
+    return Localized(16039);
+  return LanguageName(translation.target);
+}
+
+void NextTranslation()
+{
+  const std::vector<std::string> languages = TranslationLanguages();
+  std::optional<Kept> kept;
+  {
+    Translation& translation = GetTranslation();
+    std::unique_lock guard(translation.lock);
+    if (!translation.available || translation.video != PlayingVideo())
+      return;
+    // off, then each language in turn - but the open subtitle's own
+    std::vector<std::string> offered;
+    std::copy_if(languages.begin(), languages.end(), std::back_inserter(offered),
+                 [&translation](const std::string& code) { return code != translation.track; });
+    const auto now = std::find(offered.begin(), offered.end(), translation.target);
+    const auto next = now == offered.end() ? offered.begin() : now + 1;
+    translation.target = next == offered.end() ? std::string() : *next;
+    translation.chosen = true;
+    kept = Keep(translation);
+  }
+  if (kept)
+    Save(*kept);
+  // the subtitle open is opened again, to be read in the language chosen
+  const auto& player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  if (player && player->IsPlayingVideo())
+    if (const int subtitle = player->GetSubtitle(); subtitle >= 0)
+      player->SetSubtitle(subtitle);
+}
+
+void CTranslatedEntry::Update(const std::vector<SelectionStream>& ordered, const Reads& reads)
+{
+  namespace TR = TRANSLATION;
+  m_source.reset();
+  const std::string preferred = TranslateEnabled() ? TargetLanguage() : std::string();
+  const std::string video = PlayingVideo();
+  Translation& translation = GetTranslation();
+  bool translating = false;
+  {
+    std::unique_lock guard(translation.lock);
+    if (translation.video != video)
+    {
+      translation.video = video;
+      translation.chosen = false;
+      translation.open.reset();
+      translation.track.clear();
+      // the language the viewer last turned this film's subtitles to
+      if (const CVariant& choices = Choices(); choices.isMember(video))
+      {
+        translation.chosen = true;
+        translation.target = choices[video].asString();
+      }
+    }
+    translation.available = !preferred.empty();
+    if (!translation.available)
+      translation.target.clear();
+    else if (translation.chosen && Choices().isMember(video))
+      translation.target = Choices()[video].asString();
+    if (!translation.available || translation.chosen)
+      return;
+    translating = translation.open.has_value();
+  }
+  // how the video starts: translated when it has no subtitle in the language the viewer reads
+  std::vector<TR::Track> tracks;
+  for (const SelectionStream& st : ordered)
+    tracks.push_back({TR::CodeOf(st.language), reads(st.language),
+                      (st.flags & StreamFlags::FLAG_FORCED) != 0, IsText(st)});
+  // a provider that does not answer starts nothing - but a translation being shown stays
+  const auto source = TR::ChooseSource(tracks);
+  const bool starts = source && (translating || Available());
+  if (starts)
+    m_source = ordered[*source].type_index;
+  std::unique_lock guard(translation.lock);
+  if (translation.video == video && !translation.chosen)
+    translation.target = starts ? preferred : std::string();
 }
 
