+void WantPack(const std::string& code)
+{
+  if (code.empty())
+    return;
+  static std::mutex lock;
+  static std::set<std::string> asked;
+  {
+    std::unique_lock guard(lock);
+    if (!asked.insert(code).second)
+      return;
+  }
+  // the repositories are asked off the player's thread
+  CServiceBroker::GetJobManager()->Submit(
+      [code]
+      {
+        for (const auto& addon : PackAddons())
+          if (PackCode(addon->ID()) == code)
+            return;
+        ADDON::VECADDONS offered;
+        CServiceBroker::GetAddonMgr().GetInstallableAddons(offered,
+                                                           ADDON::AddonType::SCRIPT_MODULE);
+        for (const auto& addon : offered)
+          if (PackCode(addon->ID()) == code)
+          {
+            CLog::Log(LOGINFO, "Subtitle repair: installing the language pack {}", addon->ID());
+            ADDON::CAddonInstaller::GetInstance().InstallOrUpdate(
+                addon->ID(), ADDON::BackgroundJob::CHOICE_YES, ADDON::ModalJob::CHOICE_NO);
+            return;
+          }
+      });
+}
