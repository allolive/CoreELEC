+
+bool IsCapital(wchar_t c)
+{
+  return IsUpper(c);
+}
+
+bool IsSmall(wchar_t c)
+{
+  return IsLower(c);
+}
+
+wchar_t Small(wchar_t c)
+{
+  return Lower(c);
+}
+
+wchar_t Capital(wchar_t c)
+{
+  static const std::unordered_map<wchar_t, wchar_t> table = []
+  {
+    std::unordered_map<wchar_t, wchar_t> t;
+    for (const auto& [upper, lower] : UpperToLower())
+      t.emplace(lower, upper);
+    return t;
+  }();
+  const auto it = table.find(c);
+  return it == table.end() ? c : it->second;
+}
