+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "SubtitleTranslation.h"
+
+#include "SubtitleCleanup.h"
+
+#include <algorithm>
+
+namespace KODI::SUBTITLES::TRANSLATION
+{
+std::optional<size_t> ChooseSource(const std::vector<Track>& tracks)
+{
+  if (std::any_of(tracks.begin(), tracks.end(),
+                  [](const Track& t) { return t.isTarget && !t.forced; }))
+    return std::nullopt;
+  for (size_t i = 0; i < tracks.size(); ++i)
+  {
+    const Track& t = tracks[i];
+    if (t.text && !t.forced && !t.isTarget && !t.code.empty())
+      return i;
+  }
+  return std::nullopt;
+}
+
+std::string Wrap(const std::string& text, size_t width)
+{
+  if (text.size() <= width)
+    return text;
+  const size_t middle = text.size() / 2;
+  size_t best = std::string::npos;
+  for (size_t i = 0; i < text.size(); ++i)
+  {
+    const auto distance = [&](size_t at) { return at > middle ? at - middle : middle - at; };
+    if (text[i] == ' ' && (best == std::string::npos || distance(i) < distance(best)))
+      best = i;
+  }
+  return best == std::string::npos ? text : text.substr(0, best) + "\n" + text.substr(best + 1);
+}
+
+namespace
+{
+//! Text written all in capitals - a song, a sign: the models read capitals as names and keep
+//! them in their own language, so it is translated in ordinary case and set back in capitals.
+//! A script with no case ("これはNASAのデータだ") is not shouting.
+bool Shouted(const std::wstring& text)
+{
+  int capitals = 0;
+  for (const wchar_t c : text)
+  {
+    if (CLEANUP::IsCapital(c))
+      ++capitals;
+    else if (CLEANUP::IsWordLetter(c) && !(c >= L'0' && c <= L'9'))
+      return false;
+  }
+  return capitals >= 4;
+}
+
+std::wstring SentenceCase(const std::wstring& text)
+{
+  std::wstring out;
+  bool start = true;
+  for (const wchar_t c : text)
+  {
+    out.push_back(start ? c : CLEANUP::Small(c));
+    if (CLEANUP::IsCapital(c) || CLEANUP::IsSmall(c))
+      start = false;
+    else if (c == L'.' || c == L'!' || c == L'?')
+      start = true;
+  }
+  return out;
+}
+} // namespace
+
+// -- the request --------------------------------------------------------------------------------
+
+std::string SystemPrompt(const Context& context)
+{
+  return "You translate the subtitles of a film or a television episode from " + context.from +
+         " into " + context.to + ". Translate each numbered line on its own, into natural spoken " +
+         context.to +
+         " that reads well as a subtitle, keeping its meaning, its tone and its register. Keep "
+         "names as they are. Answer with the same numbered lines, translated, and nothing else.";
+}
+
+std::string UserPrompt(const Context& context,
+                       const std::deque<std::string>& before,
+                       const std::vector<std::string>& lines)
+{
+  std::string out = MODEL::Preamble(context.title, context.cast, before);
+  out += "\nThe lines to translate:\n";
+  for (size_t i = 0; i < lines.size(); ++i)
+    out += std::to_string(i + 1) + ". " + lines[i] + "\n";
+  return out;
+}
+
+std::vector<std::string> ReadTranslation(const std::string& answer,
+                                         const std::vector<std::string>& sources)
+{
+  std::vector<std::string> out = MODEL::ReadNumbered(answer, sources.size());
+  for (size_t i = 0; i < out.size(); ++i)
+    if (out[i].size() > 3 * sources[i].size() + 30)
+      return {};
+  return out;
+}
+
+std::optional<std::vector<std::string>> TranslateLines(MODEL::IChat& chat,
+                                                       const Context& context,
+                                                       const std::deque<std::string>& before,
+                                                       const std::vector<std::string>& lines)
+{
+  const std::string system = SystemPrompt(context);
+  const std::optional<std::string> answer =
+      chat.Complete(system, UserPrompt(context, before, lines));
+  if (!answer)
+    return std::nullopt;
+  std::vector<std::string> out = ReadTranslation(*answer, lines);
+  if (!out.empty())
+    return out;
+  // the answer lost the numbering: a line at a time, each with the lines before it
+  out.assign(lines.size(), {});
+  if (lines.size() == 1)
+    return out;
+  std::deque<std::string> earlier = before;
+  for (size_t i = 0; i < lines.size(); ++i)
+  {
+    const std::optional<std::string> one =
+        chat.Complete(system, UserPrompt(context, earlier, {lines[i]}));
+    if (!one)
+      return std::nullopt;
+    const std::vector<std::string> read = ReadTranslation(*one, {lines[i]});
+    if (!read.empty())
+      out[i] = read[0];
+    earlier.push_back(lines[i]);
+  }
+  return out;
+}
+
+// -- the work ----------------------------------------------------------------------------------
+
+namespace
+{
+//! A cue as lines to translate: one sentence, whatever its breaks, or a dialogue, which keeps
+//! one speaker a line.
+struct Layout
+{
+  std::vector<std::string> lines;
+  bool dialogue{false};
+};
+
+Layout LayOut(const std::string& text)
+{
+  std::vector<std::string> lines;
+  size_t start = 0;
+  while (start <= text.size())
+  {
+    const size_t end = text.find('\n', start);
+    lines.push_back(text.substr(start, end == std::string::npos ? std::string::npos : end - start));
+    if (end == std::string::npos)
+      break;
+    start = end + 1;
+  }
+  // every line a speaker's, with something said
+  const bool dialogue =
+      lines.size() > 1 && std::all_of(lines.begin(), lines.end(),
+                                      [](const std::string& line)
+                                      {
+                                        const std::string plain = MODEL::Plain(line);
+                                        return plain.size() > 1 && plain[0] == '-' &&
+                                               plain.find_first_not_of("- ") != std::string::npos;
+                                      });
+  if (!dialogue)
+    return {{MODEL::Plain(text)}, false};
+  for (std::string& line : lines)
+  {
+    line = MODEL::Plain(line).substr(1);
+    line.erase(0, line.find_first_not_of(' '));
+  }
+  return {lines, true};
+}
+} // namespace
+
+MODEL::Work Translation(Context context)
+{
+  return [context = std::move(context), before = std::deque<std::string>()](
+             MODEL::IChat& chat, const std::vector<MODEL::Item>& cues) mutable
+  {
+    std::vector<Layout> layouts;
+    std::vector<std::string> sources;
+    std::vector<bool> shouted;
+    for (const MODEL::Item& cue : cues)
+    {
+      layouts.push_back(LayOut(cue.text));
+      // nothing to translate in it ("{\\an8}", "<i></i>"): it is not asked about
+      if (layouts.back().lines.front().empty())
+        layouts.back().lines.clear();
+      for (const std::string& line : layouts.back().lines)
+      {
+        const std::wstring wide = CLEANUP::ToWide(line);
+        shouted.push_back(Shouted(wide));
+        sources.push_back(shouted.back() ? CLEANUP::FromWide(SentenceCase(wide)) : line);
+      }
+    }
+
+    const std::optional<std::vector<std::string>> translated =
+        sources.empty() ? std::make_optional(std::vector<std::string>())
+                        : TranslateLines(chat, context, before, sources);
+    // the lines before a seek are no context for those after it
+    for (const std::string& source : chat.Aborted() ? std::vector<std::string>() : sources)
+    {
+      before.push_back(source);
+      if (before.size() > BEFORE)
+        before.pop_front();
+    }
+    // the provider is down or refuses: these cues show nothing, but still end the cue before
+    MODEL::Outcome outcome;
+    outcome.cues.resize(cues.size());
+    outcome.failed = !translated;
+    if (!translated || sources.empty())
+      return outcome;
+
+    size_t at = 0;
+    for (size_t c = 0; c < cues.size(); ++c)
+    {
+      std::string out;
+      bool complete = true;
+      for (size_t i = 0; i < layouts[c].lines.size(); ++i, ++at)
+      {
+        std::string line = (*translated)[at];
+        complete = complete && !line.empty();
+        if (shouted[at])
+        {
+          std::wstring upper = CLEANUP::ToWide(line);
+          for (wchar_t& ch : upper)
+            ch = CLEANUP::Capital(ch);
+          line = CLEANUP::FromWide(upper);
+        }
+        out += layouts[c].dialogue ? (out.empty() ? "- " : "\n- ") + line : line;
+      }
+      if (complete && !layouts[c].lines.empty())
+        outcome.cues[c] = layouts[c].dialogue ? out : Wrap(out);
+    }
+    return outcome;
+  };
+}
+} // namespace KODI::SUBTITLES::TRANSLATION
