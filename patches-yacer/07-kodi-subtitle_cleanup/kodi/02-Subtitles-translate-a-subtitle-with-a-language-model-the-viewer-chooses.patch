+/*!
+ * \brief The language model the subtitles are translated with: a provider of the OpenAI chat
+ * API (OpenRouter, OpenAI, or any server that speaks it - llama.cpp, vLLM, Ollama), the key and
+ * the model the settings name.
+ */
+namespace KODI::SUBTITLES::AI
+{
+struct Provider
+{
+  std::string base; //!< the API's root, ".../v1"
+  std::string key; //!< empty when the server asks for none
+  std::string model;
+  int kind{0}; //!< the provider setting: OPENROUTER, OPENAI or CUSTOM
+};
+
+constexpr int OPENROUTER = 0;
+constexpr int OPENAI = 1;
+constexpr int CUSTOM = 2;
+
+//! The provider the settings name.
+Provider CurrentProvider();
+
+//! Whether subtitles are to be translated: the setting is on and a provider and model are named.
+bool TranslateEnabled();
+
+/*!
+ * \brief Whether the provider answered, and listed the model, the last time it was asked. It is
+ * asked in the background - when its settings change, and again when the answer is ten minutes
+ * old, or half a minute when it did not answer. A provider that does not answer offers no
+ * translation.
+ * \param wait whether to wait for the first answer for its settings, a second and a half at
+ * most: the video opening would offer the translation, and a server on the network answers in
+ * milliseconds
+ */
+bool Available(bool wait = true);
+
+//! The language subtitles are to be read in, as ISO 639-1 (or 639-2) code: the subtitle language
+//! setting when it names one, else empty.
+std::string TargetLanguage();
+
+//! A language by name in English ("French"), or the code itself when it names none.
+std::string LanguageName(const std::string& code);
+
+/*!
+ * \brief The language model's work on a subtitle stream being opened: translating it when the
+ * player opens it to be read in another language (hints.translateTo); nullptr otherwise.
+ * \param silence how long a request may go without a word: as long as its cues can wait
+ * \param deliver where each cue goes, translated or corrected, with its times; "" when there is
+ * nothing to show for it, which still ends a cue left open before it
+ * \param now where playback is, for a file known whole; empty for a track read as it plays
+ */
+std::unique_ptr<MODEL::CCueWorker> MakeWorker(const CDVDStreamInfo& hints,
+                                              std::chrono::seconds silence,
+                                              MODEL::CCueWorker::Deliver deliver,
+                                              MODEL::CCueWorker::Now now);
+
+//! Where playback is, in the time base of the cues of a subtitle file.
+double PlaybackTime();
+
+/*!
+ * \brief The player's translated subtitle: one more entry in its subtitle list, after the video's
+ * own, standing for one of its tracks translated into the language the viewer reads - for a
+ * video that has no subtitle in that language. It is copied as the player publishes its streams.
+ */
+class CTranslatedEntry
+{
+public:
+  using Reads = std::function<bool(const KODI::UTILS::CLanguageTag&)>;
+
+  /*!
+   * \brief Decide again what is offered.
+   * \param ordered the video's subtitle tracks, in the order the player would choose them
+   * \param reads whether the viewer reads a language
+   */
+  void Update(const std::vector<SelectionStream>& ordered, const Reads& reads);
+  //! Whether the entry is offered.
+  bool Offered() const { return m_offer.has_value(); }
+  //! Whether the entry is the subtitle selected.
+  bool Selected() const { return m_selected; }
+  //! The entry's place in the subtitle list.
+  static int Index(const CSelectionStreams& streams);
+  /*!
+   * \brief The player chooses its subtitle: with no subtitle in the language the viewer reads,
+   * the translation comes first - unless the viewer chose another for this video; once playing,
+   * the viewer's choice stands.
+   * \param saved the subtitle the video's settings name
+   * \return the track to open translated, or nullptr
+   */
+  const SelectionStream* Default(const CSelectionStreams& streams,
+                                 bool reset,
+                                 bool defaultSettings,
+                                 int saved);
+  //! The viewer chooses an entry: the track to open for it.
+  int Select(int entry, const CSelectionStreams& streams);
+  //! Whether the track chosen opened.
+  void Opened(bool ok);
+  //! The language a subtitle stream being opened is to be read in, or empty.
+  std::string TranslateTo(int64_t demuxerId, int id, int source, const CSelectionStreams& streams) const;
+  //! The entry's details, when index names it.
+  bool Info(int index, const CSelectionStreams& streams, SubtitleStreamInfo& info) const;
+
+private:
+  struct Offer
+  {
+    int sourceIndex{-1}; //!< the track translated, among the subtitle streams
+    std::string from;
+    std::string target;
+  };
+  std::optional<Offer> m_offer;
+  bool m_selected{false};
+};
+
+/*!
+ * \brief The settings' buttons - pick a model from those the provider lists, test the
+ * connection - and a question to the provider when its settings change.
+ */
+class CAiSettings : public ISettingCallback
+{
+public:
+  static CAiSettings& GetInstance();
+
+  void OnSettingChanged(const std::shared_ptr<const CSetting>& setting) override;
+  void OnSettingAction(const std::shared_ptr<const CSetting>& setting) override;
+};
+} // namespace KODI::SUBTITLES::AI
