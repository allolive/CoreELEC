diff --git a/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitleModel.cpp b/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitleModel.cpp
new file mode 100644
index 0000000..c7a3b8a
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitleModel.cpp
@@ -0,0 +1,267 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "SubtitleModel.h"
+
+#include <algorithm>
+#include <chrono>
+#include <regex>
+
+namespace KODI::SUBTITLES::MODEL
+{
+std::string Plain(const std::string& text)
+{
+  // what the screen hides is dropped: a "<...>" or "{...}" closed on its line (Kodi erases the
+  // one, libass the other); a "<" or "{" never closed shows, and stays. White space collapsed.
+  std::string out;
+  bool space = false;
+  size_t ends[2] = {0, 0}; // where the next ">" or "}" or line end is, from some point on
+  for (size_t i = 0; i < text.size(); ++i)
+  {
+    const char c = text[i];
+    if (c == '<' || c == '{')
+    {
+      size_t& end = ends[c == '{'];
+      if (end <= i)
+        end = text.find_first_of(c == '<' ? ">\n" : "}\n", i + 1);
+      if (end == std::string::npos)
+        end = text.size();
+      if (end < text.size() && text[end] != '\n')
+      {
+        i = end;
+        continue;
+      }
+    }
+    if (c == '\n' || c == '\r' || c == ' ' || c == '\t')
+    {
+      space = !out.empty();
+      continue;
+    }
+    if (space)
+      out += ' ';
+    space = false;
+    out += c;
+  }
+  return out;
+}
+
+std::string Preamble(const std::string& title,
+                     const std::vector<std::string>& cast,
+                     const std::deque<std::string>& before)
+{
+  std::string out;
+  if (!title.empty())
+    out += "Video: " + title + "\n";
+  if (!cast.empty())
+  {
+    out += "Characters:";
+    for (size_t i = 0; i < cast.size(); ++i)
+      out += (i ? ", " : " ") + cast[i];
+    out += "\n";
+  }
+  if (!before.empty())
+  {
+    out += "\nThe lines before, for context only:\n";
+    for (const std::string& line : before)
+      out += line + "\n";
+  }
+  return out;
+}
+
+std::vector<std::string> AnswerLines(const std::string& answer)
+{
+  // a few cues are a few hundred bytes; a model that runs on is no answer
+  constexpr size_t MAX_ANSWER = 16384;
+  const size_t thought = answer.rfind("</think>");
+  const std::string text = thought == std::string::npos ? answer : answer.substr(thought + 8);
+  std::vector<std::string> lines;
+  if (text.size() > MAX_ANSWER)
+    return lines;
+  size_t start = 0;
+  while (start < text.size())
+  {
+    size_t end = text.find('\n', start);
+    if (end == std::string::npos)
+      end = text.size();
+    std::string line = text.substr(start, end - start);
+    start = end + 1;
+    const size_t first = line.find_first_not_of(" \t");
+    if (first == std::string::npos || line.compare(first, 3, "```") != 0)
+      lines.push_back(std::move(line));
+  }
+  return lines;
+}
+
+std::vector<std::string> ReadNumbered(const std::string& answer, size_t count)
+{
+  static const std::regex numbered(R"(^\s*(\d+)\s*[.):]\s*(.*?)\s*$)");
+  std::vector<std::string> out(count);
+  std::vector<bool> seen(count, false);
+  int current = -1;
+  bool trailing = false; // a line after the last numbered one, with no blank line between
+  for (const std::string& line : AnswerLines(answer))
+  {
+    std::smatch m;
+    if (line.find_first_not_of(" \t\r") == std::string::npos)
+    {
+      current = -1;
+      trailing = false;
+    }
+    else if (std::regex_match(line, m, numbered))
+    {
+      const size_t n = std::stoul(m[1].str().substr(0, 6));
+      if (n < 1 || n > count || seen[n - 1])
+        return {};
+      current = static_cast<int>(n - 1);
+      seen[current] = true;
+      out[current] = m[2].str();
+      trailing = false;
+    }
+    else if (current >= 0)
+    {
+      // a line the model broke in two - unless no numbered line follows: then it may be a
+      // remark ("Note: the names are kept."), and the answer is not to be trusted. Its words are
+      // the model's, kept as the numbered part is: "<" and "{" in them are text.
+      const size_t first = line.find_first_not_of(" \t\r");
+      if (first != std::string::npos)
+        out[current] += (out[current].empty() ? "" : " ") +
+                        line.substr(first, line.find_last_not_of(" \t\r") + 1 - first);
+      trailing = true;
+    }
+  }
+  if (trailing)
+    return {};
+  for (size_t i = 0; i < count; ++i)
+    if (!seen[i] || out[i].empty())
+      return {};
+  return out;
+}
+
+// -- the thread ----------------------------------------------------------------------------------
+
+CCueWorker::CCueWorker(std::unique_ptr<IChat> chat, Work work, Deliver deliver, Now now)
+  : m_chat(std::move(chat)),
+    m_work(std::move(work)),
+    m_deliver(std::move(deliver)),
+    m_now(std::move(now)),
+    m_thread([this] { Run(); })
+{
+}
+
+CCueWorker::~CCueWorker()
+{
+  {
+    std::unique_lock lock(m_queueLock);
+    m_stop = true;
+  }
+  m_wake.notify_all();
+  m_chat->Cancel();
+  m_thread.join();
+}
+
+void CCueWorker::Submit(const std::string& text,
+                        double start,
+                        double stop,
+                        std::vector<std::string> notes)
+{
+  unsigned generation;
+  {
+    std::unique_lock lock(m_deliverLock);
+    generation = m_generation;
+  }
+  {
+    std::unique_lock lock(m_queueLock);
+    m_queue.push_back({{text, std::move(notes)}, start, stop, generation});
+  }
+  m_wake.notify_one();
+}
+
+void CCueWorker::Flush()
+{
+  {
+    std::unique_lock lock(m_queueLock);
+    m_queue.clear();
+  }
+  {
+    std::unique_lock lock(m_deliverLock);
+    ++m_generation;
+  }
+  m_chat->Abort();
+}
+
+std::vector<CCueWorker::Cue> CCueWorker::NextBatch()
+{
+  std::unique_lock lock(m_queueLock);
+  m_wake.wait(lock, [this] { return m_stop || !m_queue.empty(); });
+  if (m_stop)
+    return {};
+  // a file known whole goes from where playback is; what is behind it comes last
+  size_t first = 0;
+  if (m_now)
+  {
+    const double now = m_now();
+    const auto ahead = std::find_if(m_queue.begin(), m_queue.end(),
+                                    [now](const Cue& cue) { return cue.stop >= now; });
+    if (ahead != m_queue.end())
+      first = ahead - m_queue.begin();
+  }
+  const size_t last = std::min(m_queue.size(), first + BATCH);
+  std::vector<Cue> batch(std::make_move_iterator(m_queue.begin() + first),
+                         std::make_move_iterator(m_queue.begin() + last));
+  m_queue.erase(m_queue.begin() + first, m_queue.begin() + last);
+  return batch;
+}
+
+void CCueWorker::Run()
+{
+  using namespace std::chrono_literals;
+  while (true)
+  {
+    const std::vector<Cue> batch = NextBatch();
+    if (batch.empty())
+      return;
+
+    std::vector<Item> items;
+    for (const Cue& cue : batch)
+      items.push_back(cue.item);
+    // a seek between taking the batch and beginning it already dropped it
+    m_chat->Begin();
+    {
+      std::unique_lock lock(m_deliverLock);
+      if (batch.front().generation != m_generation)
+        continue;
+    }
+    const Outcome outcome = m_work(*m_chat, items);
+    {
+      // closing: nothing more is delivered
+      std::unique_lock lock(m_queueLock);
+      if (m_stop)
+        return;
+    }
+
+    for (size_t c = 0; c < batch.size() && c < outcome.cues.size(); ++c)
+    {
+      std::unique_lock lock(m_deliverLock);
+      if (batch[c].generation == m_generation)
+        m_deliver(outcome.cues[c], batch[c].start, batch[c].stop);
+    }
+    bool dropped;
+    {
+      std::unique_lock lock(m_deliverLock);
+      dropped = batch.front().generation != m_generation;
+    }
+    if (outcome.failed && !dropped)
+    {
+      // the provider is down or refuses: the next request waits a little rather than hammer it
+      std::unique_lock lock(m_queueLock);
+      if (m_wake.wait_for(lock, 10s, [this] { return m_stop; }))
+        return;
+    }
+  }
+}
+} // namespace KODI::SUBTITLES::MODEL
