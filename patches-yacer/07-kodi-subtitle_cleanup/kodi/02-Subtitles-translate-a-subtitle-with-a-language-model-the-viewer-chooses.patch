+
+#pragma once
+
+#include "SubtitleModel.h"
+
+#include <deque>
+#include <optional>
+#include <string>
+#include <vector>
+
+/*!
+ * \brief Subtitles translated into the language the viewer reads, for a video that has none in
+ * it: a text subtitle in another language is translated by a language model behind an
+ * OpenAI-style chat API, a few cues a request, on a thread of its own.
+ */
+namespace KODI::SUBTITLES::TRANSLATION
+{
+//! A subtitle track as the choice of what to translate sees it.
+struct Track
+{
+  std::string code; //!< ISO 639-1 where the language has one, else 639-2; empty when undeclared
+  bool isTarget{false}; //!< in the language subtitles are to be read in
+  bool forced{false};
+  bool text{false}; //!< text the translation reads, not images
+};
+
+/*!
+ * \brief The track to translate, or none.
+ * \param tracks the subtitle tracks, in the order Kodi would choose them
+ * \return an index into tracks; none when a full track in the target language exists - a forced
+ * one does not count, it only covers what is said in another language - or when no track is text,
+ * not forced, in a declared language
+ */
+std::optional<size_t> ChooseSource(const std::vector<Track>& tracks);
+
+//! The code a language tag is known by here: ISO 639-1 where it has one, else 639-2/B; empty
+//! when the tag declares no language.
+template<class Tag>
+std::string CodeOf(const Tag& tag)
+{
+  if (tag.IsEmpty() || tag.IsUndetermined())
+    return {};
+  const std::string code = tag.AsIso6391();
+  return code.empty() ? tag.AsIso6392B() : code;
+}
+
+//! A translation laid out on at most two lines, broken at the space nearest the middle.
+std::string Wrap(const std::string& text, size_t width = 42);
+
+//! What a model is told about the video, besides the lines.
+struct Context
+{
+  std::string from; //!< the source language's name in English ("French")
+  std::string to; //!< the target language's name in English
+  std::string title; //!< "Title (1999)", or empty
+  std::vector<std::string> cast; //!< the characters' names, to be kept as they are
+};
+
+//! The instructions for translating numbered lines.
+std::string SystemPrompt(const Context& context);
+
+//! The request: what the video is, the lines before (context only) and the numbered lines.
+std::string UserPrompt(const Context& context,
+                       const std::deque<std::string>& before,
+                       const std::vector<std::string>& lines);
+
+//! The translated lines of an answer (see MODEL::ReadNumbered); empty too when a line is
+//! implausibly longer than its source: models that run on invent.
+std::vector<std::string> ReadTranslation(const std::string& answer,
+                                         const std::vector<std::string>& sources);
+
+/*!
+ * \brief The lines translated: all in one request, and line by line when the answer does not
+ * keep to the numbering. A line no answer gives is empty. Nothing when the provider fails.
+ */
+std::optional<std::vector<std::string>> TranslateLines(MODEL::IChat& chat,
+                                                       const Context& context,
+                                                       const std::deque<std::string>& before,
+                                                       const std::vector<std::string>& lines);
+
+//! How many lines before a request it carries for context.
+constexpr size_t BEFORE = 6;
+
+/*!
+ * \brief Translation as a model's work on cues, with the lines before them for context. A cue of
+ * a dialogue ("- Hi." "- Hello.") is translated line by line and keeps its lines; any other is one
+ * sentence, laid out on two lines. A line in capitals goes in ordinary case: models read capitals
+ * as names. A cue with nothing to translate, or that the provider did not answer for, comes
+ * back "".
+ */
+MODEL::Work Translation(Context context);
+} // namespace KODI::SUBTITLES::TRANSLATION
