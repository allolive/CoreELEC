index 0000000..1edfce5
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitleModel.h
@@ -0,0 +1,138 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <condition_variable>
+#include <deque>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <thread>
+#include <vector>
+
+/*!
+ * \brief Work a language model does on subtitle cues, behind an OpenAI-style chat API: the cues
+ * go a few to a request, on a thread of their own, so the player never waits for the model.
+ */
+namespace KODI::SUBTITLES::MODEL
+{
+/*!
+ * \brief A language model to talk to. Complete() sends one exchange and returns the model's
+ * answer, or nothing when the provider could not be reached or refused the request. Cancel()
+ * may come from another thread.
+ */
+class IChat
+{
+public:
+  virtual ~IChat() = default;
+  virtual std::optional<std::string> Complete(const std::string& system,
+                                              const std::string& user) = 0;
+  //! End the exchange in progress, and refuse any after it: the cues' track is closing.
+  virtual void Cancel() {}
+  //! A batch of cues starts: Abort() ends its exchanges, the one in progress and those after.
+  virtual void Begin() {}
+  //! The batch's cues were dropped: its exchanges answer nothing.
+  virtual void Abort() {}
+  //! Whether the batch begun last was aborted: a missing answer then says nothing of the
+  //! provider.
+  virtual bool Aborted() const { return false; }
+};
+
+//! What became of a batch of cues: each one's text, "" when there is nothing to show for it;
+//! failed when the provider did not answer.
+struct Outcome
+{
+  std::vector<std::string> cues;
+  bool failed{false};
+};
+
+//! A cue as the model's work gets it: its text as it would be shown, and notes about it - the
+//! words the repair doubts, for one.
+struct Item
+{
+  std::string text;
+  std::vector<std::string> notes;
+};
+
+//! What the model does to a batch of cues.
+using Work = std::function<Outcome(IChat& chat, const std::vector<Item>& cues)>;
+
+//! A cue's text as a model reads it: formatting tags dropped, lines joined by a space.
+std::string Plain(const std::string& text);
+
+//! What a model is told of the video before the lines: its title, its characters' names, and
+//! the lines before them, for context only.
+std::string Preamble(const std::string& title,
+                     const std::vector<std::string>& cast,
+                     const std::deque<std::string>& before);
+
+//! The lines of a model's answer: what a reasoning model thought first and code fences left
+//! out; none for an answer far too long to be one.
+std::vector<std::string> AnswerLines(const std::string& answer);
+
+//! The numbered lines of a model's answer: "1. ...", "2) ...", in order, a line the model broke
+//! in two joined again. Empty unless the answer holds exactly lines 1 to count, each once and
+//! none empty, and nothing but a blank line and remarks after the last.
+std::vector<std::string> ReadNumbered(const std::string& answer, size_t count);
+
+/*!
+ * \brief Hands cues to a model's work on a thread of its own, a few at a time, and each result to
+ * deliver with the cue's times, on that thread, in the order of the cues.
+ */
+class CCueWorker
+{
+public:
+  using Deliver = std::function<void(const std::string& text, double start, double stop)>;
+  //! Where playback is, in the cues' time base: a file known whole is worked from there.
+  using Now = std::function<double()>;
+
+  //! How many cues a request carries at most.
+  static constexpr size_t BATCH = 8;
+
+  CCueWorker(std::unique_ptr<IChat> chat, Work work, Deliver deliver, Now now = {});
+  ~CCueWorker();
+  CCueWorker(const CCueWorker&) = delete;
+  CCueWorker& operator=(const CCueWorker&) = delete;
+
+  //! A cue: its text as it would be shown, its times, and notes for the work.
+  void Submit(const std::string& text,
+              double start,
+              double stop,
+              std::vector<std::string> notes = {});
+  //! Drop every cue not yet delivered, ending the request for them: none is delivered once this
+  //! returns (after a seek).
+  void Flush();
+
+private:
+  struct Cue
+  {
+    Item item;
+    double start;
+    double stop;
+    unsigned generation;
+  };
+
+  void Run();
+  std::vector<Cue> NextBatch();
+
+  std::unique_ptr<IChat> m_chat;
+  Work m_work;
+  Deliver m_deliver;
+  Now m_now;
+  std::mutex m_queueLock;
+  std::condition_variable m_wake;
+  std::deque<Cue> m_queue;
+  bool m_stop{false};
+  std::mutex m_deliverLock; //!< held while delivering, and to change the generation
+  unsigned m_generation{0};
+  std::thread m_thread;
+};
+} // namespace KODI::SUBTITLES::MODEL
