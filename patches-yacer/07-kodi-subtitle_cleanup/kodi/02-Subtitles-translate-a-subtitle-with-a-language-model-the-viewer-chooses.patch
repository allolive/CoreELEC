+namespace KODI::SUBTITLES::AI
+{
+namespace
+{
+using namespace std::chrono_literals;
+
+constexpr auto OPENROUTER_URL = "https://openrouter.ai/api/v1";
+constexpr auto OPENAI_URL = "https://api.openai.com/v1";
+//! Few names: they are for consistency, and a long cast list is mostly extras.
+constexpr size_t MAX_CAST = 40;
+//! How often the provider is asked again whether it answers: soon when it did not - a server
+//! starting, the network coming up after Kodi - and rarely when it did.
+constexpr auto REASK = std::chrono::minutes(10);
+constexpr auto RETRY = std::chrono::seconds(30);
+//! How long the first answer is waited for.
+constexpr auto FIRST_ANSWER = std::chrono::milliseconds(1500);
+//! A question unanswered this long is lost.
+constexpr auto LOST = std::chrono::seconds(30);
+
+const std::string& Localized(uint32_t id)
+{
+  return CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(id);
+}
+
+/*!
+ * \brief One HTTP exchange with the provider: the body of its answer, whatever its status, or
+ * false when no answer came. A model being loaded answers late, so only silence ends it.
+ */
+bool Exchange(XFILE::CCurlFile& http,
+              const Provider& provider,
+              const std::string& path,
+              const std::string* post,
+              std::chrono::seconds connect,
+              std::chrono::seconds silence,
+              std::string& answer)
+{
+  http.SetTimeout(static_cast<int>(connect.count()));
+  http.SetLowSpeedTime(static_cast<int>(silence.count()));
+  if (!provider.key.empty())
+    http.SetRequestHeader("Authorization", "Bearer " + provider.key);
+  if (provider.kind == OPENROUTER)
+    http.SetRequestHeader("X-Title", "Kodi");
+  // the body of a refusal says why
+  const std::string url = provider.base + path + "|failonerror=false";
+  if (!post)
+    return http.Get(url, answer);
+  http.SetMimeType("application/json");
+  return http.Post(url, *post, answer);
+}
+
+//! The error a provider's answer carries, or the start of an answer that is no JSON.
+std::string ErrorOf(const CVariant& json, const std::string& raw)
+{
+  std::string error = raw.substr(0, 200);
+  if (json.isMember("error"))
+    error =
+        json["error"].isObject() ? json["error"]["message"].asString() : json["error"].asString();
+  return error.empty() ? "an answer with no reply in it" : error;
+}
+
+struct Status
+{
+  std::mutex lock;
+  std::condition_variable answered;
+  std::string asked; //!< the provider the answer is for: its address, key and model
+  bool ok{false};
+  bool known{false}; //!< it has answered, or failed to, since the settings named it
+  std::chrono::steady_clock::time_point when{};
+  bool asking{false};
+  std::chrono::steady_clock::time_point askedAt{};
+};
+
+Status& GetStatus()
+{
+  static Status status;
+  return status;
+}
+
+std::string Signature(const Provider& provider)
+{
+  return provider.base + "\n" + provider.key + "\n" + provider.model;
+}
+
+//! Whether the provider lists the model: it is up, lets the key in, and has the model. Asked
+//! while a video opens, so briefly.
+bool Ask(const Provider& provider)
+{
+  XFILE::CCurlFile http;
+  std::string answer;
+  CVariant json;
+  bool listed = false;
+  if (Exchange(http, provider, "/models", nullptr, 2s, 3s, answer) &&
+      CJSONVariantParser::Parse(answer, json) && json["data"].isArray())
+    for (unsigned int i = 0; i < json["data"].size() && !listed; ++i)
+      listed = json["data"][i]["id"].asString() == provider.model;
+  CLog::Log(listed ? LOGINFO : LOGWARNING, "Subtitle translation: {} {}",
+            CURL::GetRedacted(provider.base),
+            listed                   ? "answers"
+            : json["data"].isArray() ? "does not list " + provider.model
+                                     : "does not answer: " + ErrorOf(json, answer));
+  return listed;
+}
+
+void Record(const std::string& signature, bool ok)
+{
+  Status& status = GetStatus();
+  std::unique_lock guard(status.lock);
+  if (status.asked != signature)
+    return;
+  status.ok = ok;
+  status.known = true;
+  status.when = std::chrono::steady_clock::now();
+  status.answered.notify_all();
+}
+
+class CChat : public MODEL::IChat
+{
+public:
+  /*!
+   * \param silence how long the provider may say nothing before the request is given up: as
+   * long as the cues it is for can wait
+   */
+  CChat(Provider provider, std::chrono::seconds silence)
+    : m_provider(std::move(provider)),
+      m_silence(silence)
+  {
+  }
+
+  std::optional<std::string> Complete(const std::string& system, const std::string& user) override
+  {
+    // one request failing says nothing of the next: only the question Available() asks offers
+    // or withdraws the translation
+    std::string error;
+    std::optional<std::string> answer = Send(system, user, error);
+    if (!answer && !error.empty())
+      CLog::Log(LOGWARNING, "Subtitle translation: {} refused or did not answer: {}",
+                CURL::GetRedacted(m_provider.base), error);
+    return answer;
+  }
+
+  void Cancel() override
+  {
+    // the exchange ends once its transfer notices, which Cancel() waits for
+    std::unique_lock guard(m_lock);
+    m_cancelled = true;
+    if (m_active)
+      m_active->Cancel();
+  }
+
+  void Begin() override
+  {
+    std::unique_lock guard(m_lock);
+    m_batch = m_aborts;
+  }
+
+  void Abort() override
+  {
+    std::unique_lock guard(m_lock);
+    ++m_aborts;
+    if (m_active)
+      m_active->Cancel();
+  }
+
+  bool Aborted() const override
+  {
+    std::unique_lock guard(m_lock);
+    return m_aborts != m_batch;
+  }
+
+  std::optional<std::string> Send(const std::string& system,
+                                  const std::string& user,
+                                  std::string& error)
+  {
+    CVariant request(CVariant::VariantTypeObject);
+    request["model"] = m_provider.model;
+    request["temperature"] = 0;
+    // a few subtitle lines; a model that runs on is stopped early
+    request["max_tokens"] = 2048;
+    CVariant messages(CVariant::VariantTypeArray);
+    CVariant message(CVariant::VariantTypeObject);
+    message["role"] = "system";
+    message["content"] = system;
+    messages.push_back(message);
+    message["role"] = "user";
+    message["content"] = user;
+    messages.push_back(message);
+    request["messages"] = messages;
+    // a model that reasons first takes ten times as long for nothing a subtitle needs
+    if (m_provider.kind == OPENROUTER)
+      request["reasoning"]["enabled"] = false;
+    else if (m_provider.kind == CUSTOM)
+      request["chat_template_kwargs"]["enable_thinking"] = false;
+
+    std::string body;
+    std::string answer;
+    CVariant json;
+    if (!CJSONVariantWriter::Write(request, body, true))
+    {
+      error = "cannot write the request";
+      return std::nullopt;
+    }
+    XFILE::CCurlFile http;
+    {
+      std::unique_lock guard(m_lock);
+      if (m_cancelled || m_aborts != m_batch)
+        return std::nullopt;
+      m_active = &http;
+    }
+    const bool answered =
+        Exchange(http, m_provider, "/chat/completions", &body, 5s, m_silence, answer);
+    {
+      std::unique_lock guard(m_lock);
+      m_active = nullptr;
+      if (m_cancelled || m_aborts != m_batch)
+        return std::nullopt;
+    }
+    if (!answered)
+    {
+      error = "no answer";
+      return std::nullopt;
+    }
+    if (!CJSONVariantParser::Parse(answer, json) || !json["choices"].isArray() ||
+        json["choices"].size() == 0)
+    {
+      error = ErrorOf(json, answer);
+      return std::nullopt;
+    }
+    return json["choices"][0]["message"]["content"].asString();
+  }
+
+private:
+  const Provider m_provider;
+  const std::chrono::seconds m_silence;
+  mutable std::mutex m_lock;
+  XFILE::CCurlFile* m_active{nullptr};
+  bool m_cancelled{false};
+  unsigned int m_aborts{0}; //!< how many batches were aborted
+  unsigned int m_batch{0}; //!< and how many when the batch in progress began
+};
+
+class CCall : public IRunnable
+{
+public:
+  CCall(std::function<void()> call, std::function<void()> cancel)
+    : m_call(std::move(call)),
+      m_cancel(std::move(cancel))
+  {
+  }
+  void Run() override { m_call(); }
+  void Cancel() override { m_cancel(); }
+
+private:
+  std::function<void()> m_call;
+  std::function<void()> m_cancel;
+};
+
+void ChooseModel()
+{
+  const Provider provider = CurrentProvider();
+  std::vector<std::string> models;
+  std::string error;
+  XFILE::CCurlFile http;
+  CCall list(
+      [&]
+      {
+        std::string answer;
+        CVariant json;
+        if (!Exchange(http, provider, "/models", nullptr, 5s, 10s, answer) ||
+            !CJSONVariantParser::Parse(answer, json) || !json["data"].isArray())
+        {
+          error = answer.empty() ? "no answer" : ErrorOf(json, answer);
+          return;
+        }
+        for (unsigned int i = 0; i < json["data"].size(); ++i)
+          models.push_back(json["data"][i]["id"].asString());
+      },
+      [&] { http.Cancel(); });
+  if (!CGUIDialogBusy::Wait(&list, 100, true))
+    return;
+  std::erase_if(models, [](const std::string& model) { return model.empty(); });
+  std::sort(models.begin(), models.end());
+  if (models.empty())
+  {
+    KODI::MESSAGING::HELPERS::ShowOKDialogText(
+        CVariant{60074},
+        CVariant{error.empty() ? Localized(60080) : StringUtils::Format(Localized(60079), error)});
+    return;
+  }
+
+  auto* dialog = CServiceBroker::GetGUI()->GetWindowManager().GetWindow<CGUIDialogSelect>(
+      WINDOW_DIALOG_SELECT);
+  if (!dialog)
+    return;
+  dialog->Reset();
+  dialog->SetHeading(CVariant{60074});
+  for (const std::string& model : models)
+    dialog->Add(model);
+  dialog->SetSelected(provider.model);
+  dialog->Open();
+  const int chosen = dialog->GetSelectedItem();
+  if (dialog->IsConfirmed() && chosen >= 0 && chosen < static_cast<int>(models.size()))
+    CServiceBroker::GetSettingsComponent()->GetSettings()->SetString(
+        CSettings::SETTING_SUBTITLES_AIMODEL, models[chosen]);
+}
+
+void Test()
+{
+  const Provider provider = CurrentProvider();
+  std::string to = TargetLanguage();
+  if (to.empty())
+    to = "en";
+  const std::string from = to == "fr" ? "en" : "fr";
+  const std::string line = from == "fr" ? "Je vais pas y aller par quatre chemins."
+                                        : "I'm not going to beat around the bush.";
+  std::string result;
+  // a model being loaded first answers late
+  CChat chat(provider, 120s);
+  CCall ask(
+      [&]
+      {
+        TRANSLATION::Context context{LanguageName(from), LanguageName(to), {}, {}};
+        std::string error;
+        const std::optional<std::string> answer =
+            chat.Send(TRANSLATION::SystemPrompt(context),
+                      TRANSLATION::UserPrompt(context, {}, {line}), error);
+        const std::vector<std::string> read =
+            answer ? TRANSLATION::ReadTranslation(*answer, {line}) : std::vector<std::string>{};
+        if (answer || !error.empty())
+          Record(Signature(provider), answer.has_value());
+        if (!answer)
+          result = StringUtils::Format(Localized(60079), error);
+        else
+          result = StringUtils::Format(Localized(60078), provider.model,
+                                       line + " -> " + (read.empty() ? *answer : read[0]));
+      },
+      [&] { chat.Cancel(); });
+  if (!CGUIDialogBusy::Wait(&ask, 100, true))
+    return;
+  KODI::MESSAGING::HELPERS::ShowOKDialogText(CVariant{60076}, CVariant{result});
+}
+} // namespace
+
+Provider CurrentProvider()
+{
+  const std::shared_ptr<CSettings> settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  Provider provider;
+  provider.kind = settings->GetInt(CSettings::SETTING_SUBTITLES_AIPROVIDER);
+  provider.base = provider.kind == OPENROUTER ? OPENROUTER_URL
+                  : provider.kind == OPENAI
+                      ? OPENAI_URL
+                      : settings->GetString(CSettings::SETTING_SUBTITLES_AIURL);
+  StringUtils::Trim(provider.base);
+  StringUtils::TrimRight(provider.base, "/");
+  provider.key = settings->GetString(CSettings::SETTING_SUBTITLES_AIKEY);
+  provider.model = settings->GetString(CSettings::SETTING_SUBTITLES_AIMODEL);
+  StringUtils::Trim(provider.key);
+  StringUtils::Trim(provider.model);
+  return provider;
+}
+
+bool TranslateEnabled()
+{
+  const Provider provider = CurrentProvider();
+  return CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
+             CSettings::SETTING_SUBTITLES_TRANSLATE) &&
+         !provider.base.empty() && !provider.model.empty();
+}
+
+bool Available(bool wait)
+{
+  const Provider provider = CurrentProvider();
+  const std::string signature = Signature(provider);
+  Status& status = GetStatus();
+  std::unique_lock guard(status.lock);
+  if (status.asked != signature)
+  {
+    status.asked = signature;
+    status.ok = false;
+    status.known = false;
+    status.when = {};
+    status.asking = false;
+  }
+  // never on the caller's thread - the player's: in the background, and again now and then; a
+  // question whose job never ran is asked again
+  const auto now = std::chrono::steady_clock::now();
+  if (status.asking && now - status.askedAt > LOST)
+    status.asking = false;
+  if (!status.asking && (!status.known || now - status.when > (status.ok ? REASK : RETRY)))
+  {
+    status.asking = true;
+    status.askedAt = now;
+    CServiceBroker::GetJobManager()->Submit(
+        [provider, signature]
+        {
+          const bool ok = Ask(provider);
+          Record(signature, ok);
+          Status& status = GetStatus();
+          std::unique_lock guard(status.lock);
+          status.asking = false;
+        },
+        // a short question the player may be waiting on: never behind the library's work
+        CJob::PRIORITY_DEDICATED);
+  }
+  if (wait && !status.known)
+    status.answered.wait_for(guard, FIRST_ANSWER,
+                             [&] { return status.known || status.asked != signature; });
+  return status.asked == signature && status.ok;
+}
+
+std::string TargetLanguage()
+{
+  return TRANSLATION::CodeOf(g_langInfo.GetSubtitleLanguage(false));
+}
+
+std::string LanguageName(const std::string& code)
+{
+  std::string name;
+  return CLangCodeExpander::Lookup(code, name) ? name : code;
+}
+
+namespace
+{
+//! The title of what plays, and its characters' names.
+void TitleAndCast(std::string& title, std::vector<std::string>& cast)
+{
+  const std::shared_ptr<CFileItem> item = g_application.CurrentFileItemPtr();
+  if (item && item->HasVideoInfoTag())
+  {
+    const CVideoInfoTag& tag = *item->GetVideoInfoTag();
+    if (!tag.m_strShowTitle.empty())
+      title = StringUtils::Format("{}, season {} episode {}: {}", tag.m_strShowTitle, tag.m_iSeason,
+                                  tag.m_iEpisode, tag.m_strTitle);
+    else if (!tag.m_strTitle.empty())
+      title = tag.GetYear() > 0 ? StringUtils::Format("{} ({})", tag.m_strTitle, tag.GetYear())
+                                : tag.m_strTitle;
+  }
+  for (const std::string& role : CLEANUP::CastOfPlaying())
+    if (cast.size() < MAX_CAST && std::find(cast.begin(), cast.end(), role) == cast.end())
+      cast.push_back(role);
+}
+
+TRANSLATION::Context ContextFor(const std::string& from, const std::string& to)
+{
+  TRANSLATION::Context context{LanguageName(from), LanguageName(to), {}, {}};
+  TitleAndCast(context.title, context.cast);
+  return context;
+}
+
+} // namespace
+
+std::unique_ptr<MODEL::CCueWorker> MakeWorker(const CDVDStreamInfo& hints,
+                                              std::chrono::seconds silence,
+                                              MODEL::CCueWorker::Deliver deliver,
+                                              MODEL::CCueWorker::Now now)
+{
+  if (hints.translateTo.empty())
+    return nullptr;
+  return std::make_unique<MODEL::CCueWorker>(
+      std::make_unique<CChat>(CurrentProvider(), silence),
+      TRANSLATION::Translation(ContextFor(TRANSLATION::CodeOf(hints.language), hints.translateTo)),
+      std::move(deliver), std::move(now));
+}
+
+double PlaybackTime()
+{
+  const auto& player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  // milliseconds, and the cues count in microseconds
+  return player ? static_cast<double>(player->GetTime()) * 1000.0 : 0.0;
+}
+
+CAiSettings& CAiSettings::GetInstance()
+{
+  static CAiSettings instance;
+  return instance;
+}
+
+void CAiSettings::OnSettingChanged(const std::shared_ptr<const CSetting>& setting)
+{
+  if (setting && TranslateEnabled())
+    Available(false);
+}
+
+void CAiSettings::OnSettingAction(const std::shared_ptr<const CSetting>& setting)
+{
+  if (!setting)
+    return;
+  if (setting->GetId() == CSettings::SETTING_SUBTITLES_AIMODELS)
+    ChooseModel();
+  else if (setting->GetId() == CSettings::SETTING_SUBTITLES_AITEST)
+    Test();
+}
+void CTranslatedEntry::Update(const std::vector<SelectionStream>& ordered, const Reads& reads)
+{
+  namespace TR = TRANSLATION;
+  m_offer.reset();
+  const std::string target = TranslateEnabled() ? TargetLanguage() : std::string();
+  if (target.empty())
+  {
+    m_selected = false;
+    return;
+  }
+  std::vector<TR::Track> tracks;
+  for (const SelectionStream& st : ordered)
+  {
+    // text inside the video, cue by cue, or a SubRip file beside it, read whole
+    const bool text =
+        (STREAM_SOURCE_MASK(st.source) == STREAM_SOURCE_DEMUX &&
+         (st.codecId == AV_CODEC_ID_SUBRIP || st.codecId == AV_CODEC_ID_TEXT)) ||
+        (STREAM_SOURCE_MASK(st.source) == STREAM_SOURCE_TEXT &&
+         URIUtils::HasExtension(st.filename, ".srt"));
+    tracks.push_back({TR::CodeOf(st.language), reads(st.language),
+                      (st.flags & StreamFlags::FLAG_FORCED) != 0, text});
+  }
+  // a provider that does not answer offers nothing - but a translation being shown stays
+  const auto chosen = TR::ChooseSource(tracks);
+  if (chosen && (m_selected || Available()))
+    m_offer = Offer{ordered[*chosen].type_index, tracks[*chosen].code, target};
+  else
+    m_selected = false;
+}
+
+int CTranslatedEntry::Index(const CSelectionStreams& streams)
+{
+  return streams.CountType(StreamType::SUBTITLE);
+}
+
+const SelectionStream* CTranslatedEntry::Default(const CSelectionStreams& streams,
+                                                 bool reset,
+                                                 bool defaultSettings,
+                                                 int saved)
+{
+  m_selected = m_offer && (reset ? defaultSettings || saved == Index(streams) : m_selected);
+  return m_selected ? &streams.Get(StreamType::SUBTITLE, m_offer->sourceIndex) : nullptr;
+}
+
+int CTranslatedEntry::Select(int entry, const CSelectionStreams& streams)
+{
+  m_selected = m_offer && entry == Index(streams);
+  return m_selected ? m_offer->sourceIndex : entry;
+}
+
+void CTranslatedEntry::Opened(bool ok)
+{
+  m_selected = m_selected && ok;
+}
+
+std::string CTranslatedEntry::TranslateTo(int64_t demuxerId,
+                                          int id,
+                                          int source,
+                                          const CSelectionStreams& streams) const
+{
+  if (!m_selected)
+    return {};
+  const SelectionStream& st = streams.Get(StreamType::SUBTITLE, m_offer->sourceIndex);
+  return st.demuxerId == demuxerId && st.id == id && st.source == source ? m_offer->target
+                                                                         : std::string();
+}
+
+bool CTranslatedEntry::Info(int index,
+                            const CSelectionStreams& streams,
+                            SubtitleStreamInfo& info) const
+{
+  if (!m_offer || index != Index(streams))
+    return false;
+  info = SubtitleStreamInfo{};
+  info.valid = true;
+  info.name =
+      StringUtils::Format(CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(60062),
+                          LanguageName(m_offer->target), LanguageName(m_offer->from));
+  info.language = KODI::UTILS::CLanguageTag::Parse(m_offer->target);
+  info.codecName = "subrip";
+  return true;
+}
+} // namespace KODI::SUBTITLES::AI
