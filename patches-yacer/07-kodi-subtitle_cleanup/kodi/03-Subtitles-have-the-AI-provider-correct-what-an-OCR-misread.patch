+
+#pragma once
+
+#include "SubtitleModel.h"
+
+#include <deque>
+#include <functional>
+#include <string>
+#include <vector>
+
+/*!
+ * \brief OCR damage a language model corrects: the words the repair's rules doubt, or every line.
+ * The model answers with a list of changes, and only a change the rules here allow is made - a
+ * subtitle that is right must never come out wrong.
+ */
+namespace KODI::SUBTITLES::REVISION
+{
+enum class Mode
+{
+  DOUBTS, //!< only the words the repair doubts, which the model confirms or corrects
+  EVERY_LINE, //!< every line, read by the model
+};
+
+//! What the model is told, and what a change is judged by.
+struct Context
+{
+  std::string language; //!< the subtitle's language, by name in English
+  std::string title; //!< "Title (1999)", or empty
+  std::vector<std::string> cast; //!< the characters' names
+  //! whether a word is one of the language's, or nothing when no dictionary is installed
+  std::function<bool(const std::wstring& word)> isWord;
+};
+
+//! One change the model asks for: in a line, what is written, and what it should be.
+struct Change
+{
+  size_t line; //!< from 0
+  std::string wrong;
+  std::string right;
+};
+
+//! The instructions.
+std::string SystemPrompt(const Context& context, Mode mode);
+
+/*!
+ * \brief The request: the lines before for context, then the numbered lines, each with the words
+ * the repair doubts when it has any.
+ */
+std::string UserPrompt(const Context& context,
+                       const std::deque<std::string>& before,
+                       const std::vector<std::string>& lines,
+                       const std::vector<std::vector<std::string>>& doubts);
+
+//! The changes an answer asks for: "2: wouId -> would" a line; "none", or anything else, none.
+std::vector<Change> ReadChanges(const std::string& answer, size_t lines);
+
+/*!
+ * \brief Whether a change may be made to its line. What is written must stand in the line as
+ * whole words and be no word of the language; what it becomes must be close to it, and a reading
+ * the OCR's usual confusions explain ("l" for "I", "rn" for "m", "0" for "O"), or the word that
+ * pieces which are none were broken from ("fi re"), rejoined. Only when no such reading is a word
+ * may it restore an accent the OCR lost or misread, into words of the dictionary or the cast's
+ * names; with no dictionary, never, and nothing is rejoined. In DOUBTS mode, only a word the
+ * repair doubted may change.
+ */
+bool Allowed(const Change& change,
+             const std::string& line,
+             const std::vector<std::string>& doubts,
+             const Context& context,
+             Mode mode);
+
+//! The line with an allowed change made, wherever what is written stands.
+std::string Apply(const Change& change, const std::string& line);
+
+/*!
+ * \brief The model's corrections as work on cues. Each cue comes with the words the repair
+ * doubts in it; in DOUBTS mode a batch with none is not sent. A cue the model is not asked
+ * about, or whose answer is refused, stays as it was - and so does every cue of a batch the
+ * provider did not answer, and of those after it for a minute, which go by without waiting.
+ */
+MODEL::Work Revision(Context context, Mode mode);
+} // namespace KODI::SUBTITLES::REVISION
