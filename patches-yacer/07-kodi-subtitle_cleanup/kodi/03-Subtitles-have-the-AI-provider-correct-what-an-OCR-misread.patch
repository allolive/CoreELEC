@@ -2532,17 +2557,17 @@ bool CCueCleaner::Clean(std::string& text)
     for (const std::wstring& line : original)
       m_ocr->NoteLigatures(ReadLigatures(line));
     for (std::wstring& line : lines)
+    {
       line = m_ocr->FixLine(line, nullptr);
+      if (doubts)
+        for (const std::wstring& w : m_ocr->Doubtful(line))
+          doubts->push_back(ToUtf8(w));
+    }
   }
   text = ToUtf8(Join(lines, L"\n"));
   return true;
 }
 
