+std::optional<REVISION::Mode> RepairMode()
+{
+  const std::shared_ptr<CSettings> settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  const int mode = settings->GetInt(CSettings::SETTING_SUBTITLES_AIREPAIR);
+  const Provider provider = CurrentProvider();
+  // a provider that does not answer is let be by the repair itself, request by request
+  if (mode == 0 || !settings->GetBool(CSettings::SETTING_SUBTITLES_REPAIR) ||
+      provider.base.empty() || provider.model.empty())
+    return std::nullopt;
+  return mode == 1 ? REVISION::Mode::DOUBTS : REVISION::Mode::EVERY_LINE;
+}
+
+REVISION::Context RevisionContext(const std::string& language)
+{
+  REVISION::Context context;
+  if (!language.empty())
+    context.language = LanguageName(language);
+  TitleAndCast(context.title, context.cast);
+  const std::shared_ptr<const CLEANUP::Packs> packs = CLEANUP::InstalledPacks();
+  if (const auto pack = language.empty() ? nullptr : CLEANUP::PackFor(language, *packs))
+    context.isWord = [pack](const std::wstring& word) { return pack->Word(word); };
+  return context;
+}
 } // namespace
 
 std::unique_ptr<MODEL::CCueWorker> MakeWorker(const CDVDStreamInfo& hints,
+                                              const std::string& language,
                                               std::chrono::seconds silence,
                                               MODEL::CCueWorker::Deliver deliver,
-                                              MODEL::CCueWorker::Now now)
-{
-  if (hints.translateTo.empty())
+                                              MODEL::CCueWorker::Now now,
+                                              bool& doubts)
+{
+  doubts = false;
+  if (!hints.translateTo.empty())
+    return std::make_unique<MODEL::CCueWorker>(
+        std::make_unique<CChat>(CurrentProvider(), silence),
+        TRANSLATION::Translation(
+            ContextFor(TRANSLATION::CodeOf(hints.language), hints.translateTo)),
+        std::move(deliver), std::move(now));
+  const std::optional<REVISION::Mode> mode = RepairMode();
+  if (!mode)
     return nullptr;
-  return std::make_unique<MODEL::CCueWorker>(
-      std::make_unique<CChat>(CurrentProvider(), silence),
-      TRANSLATION::Translation(ContextFor(TRANSLATION::CodeOf(hints.language), hints.translateTo)),
-      std::move(deliver), std::move(now));
+  doubts = *mode == REVISION::Mode::DOUBTS;
+  return std::make_unique<MODEL::CCueWorker>(std::make_unique<CChat>(CurrentProvider(), silence),
+                                             REVISION::Revision(RevisionContext(language), *mode),
+                                             std::move(deliver), std::move(now));
 }
 
