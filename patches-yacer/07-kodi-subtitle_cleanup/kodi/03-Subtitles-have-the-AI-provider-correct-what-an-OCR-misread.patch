+
+#include "SubtitleRevision.h"
+
+#include "SubtitleCleanup.h"
+
+#include <algorithm>
+#include <chrono>
+#include <regex>
+#include <unordered_set>
+
+namespace KODI::SUBTITLES::REVISION
+{
+namespace
+{
+//! How many lines before a request it carries for context.
+constexpr size_t BEFORE = 4;
+//! How long the cues go by unasked after the provider failed: a cue waiting on a provider that
+//! does not answer would miss its time on screen.
+constexpr std::chrono::seconds QUIET{60};
+
+std::vector<std::wstring> SplitWords(const std::wstring& text)
+{
+  std::vector<std::wstring> words;
+  for (const auto& [start, length] : CLEANUP::WordSpans(text))
+    words.push_back(text.substr(start, length));
+  return words;
+}
+
+size_t Distance(const std::wstring& a, const std::wstring& b)
+{
+  std::vector<size_t> row(b.size() + 1);
+  for (size_t j = 0; j <= b.size(); ++j)
+    row[j] = j;
+  for (size_t i = 1; i <= a.size(); ++i)
+  {
+    size_t diagonal = row[0];
+    row[0] = i;
+    for (size_t j = 1; j <= b.size(); ++j)
+    {
+      const size_t up = row[j];
+      row[j] = std::min({row[j] + 1, row[j - 1] + 1, diagonal + (a[i - 1] != b[j - 1])});
+      diagonal = up;
+    }
+  }
+  return row[b.size()];
+}
+
+//! Where what is written stands in the line as whole words ("HeIp! HeIp!" twice), outside the
+//! formatting tags ("<font color=...>", "{\c&H00FFFF&}"): what MODEL::Plain leaves out, a
+//! "<...>" or "{...}" closed on its line.
+std::vector<size_t> Find(const std::wstring& line, const std::wstring& wrong)
+{
+  std::vector<bool> tag(line.size(), false);
+  size_t closes[2] = {0, 0}; // where the next ">" or "}" or line end is, from some point on
+  for (size_t i = 0; i < line.size(); ++i)
+  {
+    if (line[i] != L'<' && line[i] != L'{')
+      continue;
+    size_t& end = closes[line[i] == L'{'];
+    if (end <= i)
+      end = std::min(line.find_first_of(line[i] == L'<' ? L">\n" : L"}\n", i + 1), line.size());
+    if (end == line.size() || line[end] == L'\n')
+      continue;
+    std::fill(tag.begin() + i, tag.begin() + end + 1, true);
+    i = end;
+  }
+  std::vector<size_t> starts;
+  std::vector<size_t> ends;
+  for (const auto& [start, length] : CLEANUP::WordSpans(line))
+  {
+    if (tag[start])
+      continue;
+    starts.push_back(start);
+    ends.push_back(start + length);
+  }
+  const auto in = [](const std::vector<size_t>& v, size_t at)
+  { return std::find(v.begin(), v.end(), at) != v.end(); };
+  std::vector<size_t> found;
+  for (size_t at = line.find(wrong); at != std::wstring::npos;
+       at = line.find(wrong, at + wrong.size()))
+    if (in(starts, at) && in(ends, at + wrong.size()))
+      found.push_back(at);
+  return found;
+}
+
+//! Whether two words differ only by accents: the same length, and every letter that differs
+//! one beyond ASCII ("Ecoutez", "Écoutez").
+bool AccentOnly(const std::wstring& a, const std::wstring& b)
+{
+  if (a.size() != b.size() || a == b)
+    return false;
+  for (size_t i = 0; i < a.size(); ++i)
+    if (a[i] != b[i] && (!CLEANUP::IsWordLetter(a[i]) || !CLEANUP::IsWordLetter(b[i]) ||
+                         (a[i] < 0x80 && b[i] < 0x80)))
+      return false;
+  return true;
+}
+
+std::string Trimmed(std::string text)
+{
+  const auto quote = [](char c) { return c == '"' || c == '\'' || c == '`' || c == ' '; };
+  while (!text.empty() && quote(text.front()))
+    text.erase(0, 1);
+  while (!text.empty() && quote(text.back()))
+    text.pop_back();
+  return text;
+}
+} // namespace
+
+std::string SystemPrompt(const Context& context, Mode mode)
+{
+  std::string out =
+      "You check subtitles in " + context.language +
+      " that an OCR read from the images of a disc, for the errors the OCR made: letters "
+      "misread (\"wouId\" for \"would\", \"rn\" for \"m\", \"0\" for \"O\"), a word broken "
+      "into letters, an accent lost. Correct only such errors. Never change the wording, the "
+      "grammar, slang, a spelling the author chose, a name or the punctuation. ";
+  if (mode == Mode::DOUBTS)
+    out += "After each line come the words a spelling check doubts: decide for each whether it "
+           "is an OCR error, and correct it only if it is - names, slang and words of another "
+           "language are not. ";
+  return out + "Answer with one line per correction: the line's number, a colon, the words as "
+               "written, \" -> \" and the words corrected, as in \"3: wouId -> would\". When "
+               "there is nothing to correct, answer \"none\".";
+}
+
+std::string UserPrompt(const Context& context,
+                       const std::deque<std::string>& before,
+                       const std::vector<std::string>& lines,
+                       const std::vector<std::vector<std::string>>& doubts)
+{
+  std::string out = MODEL::Preamble(context.title, context.cast, before);
+  out += "\nThe lines to check:\n";
+  for (size_t i = 0; i < lines.size(); ++i)
+  {
+    out += std::to_string(i + 1) + ". " + lines[i] + "\n";
+    if (i < doubts.size() && !doubts[i].empty())
+    {
+      out += "   doubted:";
+      for (size_t k = 0; k < doubts[i].size(); ++k)
+        out += (k ? ", " : " ") + doubts[i][k];
+      out += "\n";
+    }
+  }
+  return out;
+}
+
+std::vector<Change> ReadChanges(const std::string& answer, size_t lines)
+{
+  static const std::regex change(R"(^\s*(\d+)\s*[.):]\s*(.+?)\s*(?:->|→|=>)\s*(.+?)\s*$)");
+  std::vector<Change> changes;
+  for (const std::string& line : MODEL::AnswerLines(answer))
+  {
+    std::smatch m;
+    if (!std::regex_match(line, m, change))
+      continue;
+    const size_t n = std::stoul(m[1].str().substr(0, 6));
+    Change c{n - 1, Trimmed(m[2].str()), Trimmed(m[3].str())};
+    if (n >= 1 && n <= lines && !c.wrong.empty() && !c.right.empty())
+      changes.push_back(std::move(c));
+  }
+  return changes;
+}
+
+bool Allowed(const Change& change,
+             const std::string& line,
+             const std::vector<std::string>& doubts,
+             const Context& context,
+             Mode mode)
+{
+  const std::wstring text = CLEANUP::ToWide(line);
+  const std::wstring wrong = CLEANUP::ToWide(change.wrong);
+  const std::wstring right = CLEANUP::ToWide(change.right);
+  if (wrong == right || Find(text, wrong).empty() ||
+      right.find_first_of(L"<>{}\n") != std::wstring::npos)
+    return false;
+
+  // a word broken into pieces ("fi re") becomes one; anything else keeps its words apart
+  const std::vector<std::wstring> was = SplitWords(wrong);
+  const std::vector<std::wstring> becomes = SplitWords(right);
+  const bool rejoined = was.size() > 1 && becomes.size() == 1;
+  if (was.empty() || (!rejoined && was.size() != becomes.size()))
+    return false;
+  std::wstring joined;
+  for (const std::wstring& piece : was)
+    joined += piece;
+  const std::wstring& from = rejoined ? joined : wrong;
+  if (Distance(from, right) > std::max<size_t>(2, from.size() / 3))
+    return false;
+
+  if (mode == Mode::DOUBTS && std::none_of(was.begin(), was.end(),
+                                           [&](const std::wstring& w)
+                                           {
+                                             return std::find(doubts.begin(), doubts.end(),
+                                                              CLEANUP::FromWide(w)) != doubts.end();
+                                           }))
+    return false;
+
+  std::unordered_set<std::wstring> names;
+  for (const std::string& role : context.cast)
+    for (std::wstring& word : SplitWords(CLEANUP::ToWide(role)))
+      names.insert(std::move(word));
+  const auto known = [&](const std::wstring& w)
+  { return names.count(w) > 0 || (context.isWord && context.isWord(w)); };
+  // a name or a word of the language is never "corrected" - with no dictionary, only what can be
+  // no word's spelling ("wouId"): "modern" is "modem" for all the OCR's confusions say
+  if (!rejoined &&
+      std::any_of(was.begin(), was.end(), [&](const std::wstring& w)
+                  { return known(w) || (!context.isWord && CLEANUP::CouldBeSpelt(w)); }))
+    return false;
+  // a word is rejoined only from a piece that is none ("fi re"), into a word: "may be" is no
+  // "maybe", and with no dictionary nothing says
+  if (rejoined && (!context.isWord || std::all_of(was.begin(), was.end(), known) || !known(right)))
+    return false;
+  // what the OCR's usual confusions explain ("couIda" is "coulda", slang or not)
+  const std::vector<std::wstring> readings = CLEANUP::OcrReadings(from);
+  if ((rejoined && from == right) ||
+      std::find(readings.begin(), readings.end(), right) != readings.end())
+    return true;
+  // anything else only where no such reading is a word - "HeIp" is "Help", whatever a model
+  // would rather read ("Hip") - and then only an accent the OCR lost or misread, into words or
+  // names: a letter more or less is another word ("Berck" is no "Berk"); with no dictionary, or
+  // pieces rejoined into what they do not spell, nothing else
+  if (!context.isWord || rejoined || !AccentOnly(from, right) ||
+      std::any_of(readings.begin(), readings.end(),
+                  [&](const std::wstring& reading)
+                  {
+                    const std::vector<std::wstring> words = SplitWords(reading);
+                    return !words.empty() && std::all_of(words.begin(), words.end(), known);
+                  }))
+    return false;
+  return std::all_of(becomes.begin(), becomes.end(), known);
+}
+
+std::string Apply(const Change& change, const std::string& line)
+{
+  std::wstring text = CLEANUP::ToWide(line);
+  const std::wstring wrong = CLEANUP::ToWide(change.wrong);
+  const std::wstring right = CLEANUP::ToWide(change.right);
+  const std::vector<size_t> found = Find(text, wrong);
+  for (auto at = found.rbegin(); at != found.rend(); ++at)
+    text.replace(*at, wrong.size(), right);
+  return CLEANUP::FromWide(text);
+}
+
+MODEL::Work Revision(Context context, Mode mode)
+{
+  return [context = std::move(context), mode, before = std::deque<std::string>(),
+          quietUntil = std::chrono::steady_clock::time_point()](
+             MODEL::IChat& chat, const std::vector<MODEL::Item>& cues) mutable
+  {
+    const auto now = std::chrono::steady_clock::now();
+    MODEL::Outcome outcome;
+    std::vector<size_t> asked;
+    std::vector<std::string> lines;
+    std::vector<std::vector<std::string>> doubts;
+    for (size_t c = 0; c < cues.size(); ++c)
+    {
+      outcome.cues.emplace_back(cues[c].text);
+      const std::string plain = MODEL::Plain(cues[c].text);
+      if (plain.empty() || (mode == Mode::DOUBTS && cues[c].notes.empty()))
+        continue;
+      asked.push_back(c);
+      lines.push_back(plain);
+      doubts.push_back(cues[c].notes);
+    }
+    std::optional<std::string> answer;
+    if (now < quietUntil)
+      asked.clear();
+    if (!asked.empty())
+      answer =
+          chat.Complete(SystemPrompt(context, mode), UserPrompt(context, before, lines, doubts));
+    // the lines before a seek are no context for those after it
+    for (const MODEL::Item& cue : chat.Aborted() ? std::vector<MODEL::Item>() : cues)
+    {
+      const std::string plain = MODEL::Plain(cue.text);
+      if (plain.empty())
+        continue;
+      before.push_back(plain);
+      if (before.size() > BEFORE)
+        before.pop_front();
+    }
+    if (asked.empty())
+      return outcome;
+    // the provider is down or refuses: the cues are shown as the rules left them, and the next
+    // ones too for a while, without waiting on it - unless a seek dropped them
+    if (!answer)
+    {
+      if (!chat.Aborted())
+        quietUntil = std::chrono::steady_clock::now() + QUIET;
+      return outcome;
+    }
+    for (const Change& change : ReadChanges(*answer, asked.size()))
+    {
+      const size_t c = asked[change.line];
+      if (Allowed(change, outcome.cues[c], cues[c].notes, context, mode))
+        outcome.cues[c] = Apply(change, outcome.cues[c]);
+    }
+    return outcome;
+  };
+}
+} // namespace KODI::SUBTITLES::REVISION
