+std::vector<std::wstring> COcrEngine::Doubtful(const std::wstring& line)
+{
+  const std::wstring text = Visible(line);
+  const Spans spans = Words(text);
+  std::vector<std::wstring> doubts;
+  if (!ReadsAsLanguage(text, std::vector<bool>(spans.size(), false)))
+    return doubts;
+  // the general confusions, then the language's own
+  const std::vector<Confusion>& confusions = m_lang->Confusions();
+  for (const auto& [a, n] : spans)
+  {
+    const std::wstring w = text.substr(a, n);
+    if (n < 2 || !HasLetter(w) || m_names.count(w) || m_cast.count(w) || Word(*m_lang, w) ||
+        !m_lang->Readable(w) || std::find(doubts.begin(), doubts.end(), w) != doubts.end())
+      continue;
+    const std::vector<std::wstring> readings = Candidates(w, confusions);
+    if (!PlausibleWord(w) || std::any_of(readings.begin(), readings.end(),
+                                         [&](const std::wstring& r) { return Acceptable(w, r); }))
+      doubts.push_back(w);
+  }
+  return doubts;
+}
+
