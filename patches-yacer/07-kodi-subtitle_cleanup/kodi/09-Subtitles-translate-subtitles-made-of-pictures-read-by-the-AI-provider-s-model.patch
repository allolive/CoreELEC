+
+#pragma once
+
+#include "DVDSubtitles/SubtitleCueStage.h"
+#include "DVDSubtitles/SubtitlePictures.h"
+#include "DVDSubtitles/SubtitlesAdapter.h"
+#include "cores/VideoPlayer/DVDCodecs/Overlay/DVDOverlayCodec.h"
+
+#include <atomic>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <set>
+#include <string>
+
+class CDVDOverlayCodecFFmpeg;
+
+/*!
+ * \brief A subtitle made of pictures - PGS, DVD, DVB - opened to be read in another language: its
+ * pictures, decoded as the player decodes them, are read as text by the AI provider's model and
+ * then shown as a text subtitle is, translated. The track is read a minute ahead of playback in a
+ * demuxer of its own, so each line is ready long before it is due; the player's own packets fill
+ * what that misses. Should the model read no pictures, they are shown as they are.
+ */
+class CSubtitlePictureCodec : public CDVDOverlayCodec, private CSubtitlesAdapter
+{
+public:
+  CSubtitlePictureCodec();
+  ~CSubtitlePictureCodec() override;
+  bool Open(CDVDStreamInfo& hints, CDVDCodecOptions& options) override;
+  OverlayMessage Decode(DemuxPacket* pPacket) override;
+  void Reset() override;
+  void Flush() override;
+  std::shared_ptr<CDVDOverlay> GetOverlay() override;
+
+private:
+  struct Ahead;
+
+  void Show(std::string text, double start, double stop);
+  /*!
+   * \brief A subtitle to read, from either path, once.
+   * \param generation the seek the read-ahead read it after; 0 for the player's own packets
+   */
+  void Hand(KODI::SUBTITLES::PICTURES::CReader::Item item, unsigned int generation);
+
+  std::unique_ptr<CDVDOverlayCodecFFmpeg> m_pictures;
+  std::unique_ptr<KODI::SUBTITLES::PICTURES::CReader> m_reader;
+  std::unique_ptr<Ahead> m_ahead;
+  std::mutex m_seenLock;
+  std::set<int64_t> m_seen; //!< the subtitles handed to the reader since the last seek
+  std::map<int64_t, int> m_places; //!< where each of them is shown on the video, by its start
+  double m_aheadUpTo{0}; //!< the latest start the read-ahead handed in
+  //! how many seeks: what the read-ahead read before the last is dropped
+  std::atomic<unsigned int> m_generation{1};
+  std::atomic<bool> m_aheadWrong{false}; //!< the read-ahead missed what the player read
+  bool m_asPictures{false}; //!< the model reads no pictures: they are shown as they are
+  std::shared_ptr<CDVDOverlay> m_overlay;
+  int m_prevSubId{-1}; //!< the line shown last, which the next one ends
+  double m_prevStart{0};
+  double m_prevStop{0};
+  //! last, so whatever delivers its cues stops before anything it delivers to goes
+  KODI::SUBTITLES::CCueStage m_cues;
+};
diff --git a/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitlePictures.cpp b/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitlePictures.cpp
