index 0000000..1b97aff
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitlePictures.cpp
@@ -0,0 +1,441 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "SubtitlePictures.h"
+
+#include "PlatformDefs.h"
+#include "SubtitleAI.h"
+#include "ServiceBroker.h"
+#include "SubtitleModel.h"
+#include "cores/DataCacheCore.h"
+#include "cores/VideoPlayer/DVDCodecs/Overlay/DVDOverlayCodecFFmpegUtils.h"
+#include "cores/VideoPlayer/DVDCodecs/Overlay/DVDOverlayImage.h"
+#include "guilib/FFmpegImage.h"
+#include "guilib/TextureFormats.h"
+#include "utils/StringUtils.h"
+#include "utils/log.h"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+
+namespace KODI::SUBTITLES::PICTURES
+{
+namespace
+{
+//! How high a text line is when the model reads it: smaller costs it less, and a line this high
+//! it reads as well as a full-size one.
+constexpr int LINE_HEIGHT = 32;
+//! Pictures read in one request: the model writes their text at the same pace however many.
+constexpr size_t BATCH = 8;
+//! How long the first picture waits for the others of its batch: a moment - the player reads a
+//! disc's subtitles only a little ahead of the picture.
+constexpr auto GATHER = std::chrono::milliseconds(300);
+//! Batches refused, or answered unread, in a row before the model is taken to read no pictures.
+constexpr int REFUSALS = 3;
+//! Ink darker than this is text.
+constexpr uint8_t INK = 128;
+constexpr int MARGIN = 6;
+
+//! Which pixels are text: a crop's rows and columns.
+struct Box
+{
+  int x0, y0, x1, y1;
+};
+
+std::optional<Box> InkBox(const Picture& picture)
+{
+  Box box{picture.width, picture.height, -1, -1};
+  for (int y = 0; y < picture.height; ++y)
+    for (int x = 0; x < picture.width; ++x)
+      if (picture.grey[y * picture.width + x] < INK)
+      {
+        box.x0 = std::min(box.x0, x);
+        box.y0 = std::min(box.y0, y);
+        box.x1 = std::max(box.x1, x);
+        box.y1 = std::max(box.y1, y);
+      }
+  if (box.x1 < 0)
+    return std::nullopt;
+  return box;
+}
+
+//! A box of the picture, with a white margin around it.
+Picture Crop(const Picture& picture, const Box& box)
+{
+  Picture out;
+  out.width = box.x1 - box.x0 + 1 + 2 * MARGIN;
+  out.height = box.y1 - box.y0 + 1 + 2 * MARGIN;
+  out.grey.assign(static_cast<size_t>(out.width) * out.height, 255);
+  for (int y = box.y0; y <= box.y1; ++y)
+    std::copy_n(picture.grey.begin() + y * picture.width + box.x0, box.x1 - box.x0 + 1,
+                out.grey.begin() + (y - box.y0 + MARGIN) * out.width + MARGIN);
+  return out;
+}
+
+//! How many lines of text a picture holds: bands of rows with ink, the small ones - accents,
+//! dots - not counted.
+int Lines(const Picture& picture)
+{
+  std::vector<std::pair<int, int>> bands;
+  for (int y = 0; y < picture.height; ++y)
+  {
+    const auto row = picture.grey.begin() + y * picture.width;
+    const bool ink = std::any_of(row, row + picture.width, [](uint8_t p) { return p < INK; });
+    if (ink && (bands.empty() || bands.back().second < y - 1))
+      bands.emplace_back(y, y);
+    else if (ink)
+      bands.back().second = y;
+  }
+  int tallest = 0;
+  for (const auto& [top, bottom] : bands)
+    tallest = std::max(tallest, bottom - top + 1);
+  return std::max<int>(1, static_cast<int>(std::count_if(
+                              bands.begin(), bands.end(), [tallest](const auto& band)
+                              { return (band.second - band.first + 1) * 5 >= tallest * 2; })));
+}
+
+//! A picture with the space between its lines no taller than a line: the two lines of a
+//! subtitle at the top and the bottom of the picture are read as one.
+Picture CloseGaps(const Picture& picture)
+{
+  std::vector<bool> ink(picture.height);
+  for (int y = 0; y < picture.height; ++y)
+  {
+    const auto row = picture.grey.begin() + y * picture.width;
+    ink[y] = std::any_of(row, row + picture.width, [](uint8_t p) { return p < INK; });
+  }
+  int tallest = 0;
+  for (int y = 0, run = 0; y < picture.height; ++y)
+    tallest = std::max(tallest, run = ink[y] ? run + 1 : 0);
+  Picture out{picture.width, 0, {}};
+  for (int y = 0, blank = 0; y < picture.height; ++y)
+  {
+    blank = ink[y] ? 0 : blank + 1;
+    if (blank > tallest / 2)
+      continue;
+    out.grey.insert(out.grey.end(), picture.grey.begin() + y * picture.width,
+                    picture.grey.begin() + (y + 1) * picture.width);
+    ++out.height;
+  }
+  return out;
+}
+
+//! A 3x5 digit, or ")", a row in each three bits.
+const std::array<uint8_t, 5>& Glyph(char c)
+{
+  static const std::array<std::array<uint8_t, 5>, 11> glyphs{{
+      {7, 5, 5, 5, 7}, {2, 6, 2, 2, 7}, {7, 1, 7, 4, 7}, {7, 1, 7, 1, 7}, {5, 5, 7, 1, 1},
+      {7, 4, 7, 1, 7}, {7, 4, 7, 5, 7}, {7, 1, 1, 1, 1}, {7, 5, 7, 5, 7}, {7, 5, 7, 1, 7},
+      {2, 1, 1, 1, 2},
+  }};
+  return glyphs[c == ')' ? 10 : c - '0'];
+}
+
+void Draw(Picture& picture, int left, int top, const std::string& text)
+{
+  constexpr int SCALE = 3;
+  for (const char c : text)
+  {
+    const auto& glyph = Glyph(c);
+    for (int row = 0; row < 5; ++row)
+      for (int column = 0; column < 3; ++column)
+        if (glyph[row] & (4 >> column))
+          for (int dy = 0; dy < SCALE; ++dy)
+            for (int dx = 0; dx < SCALE; ++dx)
+            {
+              const int x = left + column * SCALE + dx;
+              const int y = top + row * SCALE + dy;
+              if (x < picture.width && y >= 0 && y < picture.height)
+                picture.grey[y * picture.width + x] = 0;
+            }
+    left += 4 * SCALE;
+  }
+}
+
+std::string Prompt(size_t count, const std::string& language)
+{
+  return StringUtils::Format(
+      "This image holds {} {}film subtitles, one per numbered row. Transcribe each exactly as "
+      "written, keeping punctuation, accents and capitals; join a row's lines with a single "
+      "space. Answer with one line per row, numbered 1) to {}), and nothing else.",
+      count, language.empty() ? "" : language + " ", count);
+}
+} // namespace
+
+std::optional<Picture> FromOverlays(const std::vector<std::shared_ptr<CDVDOverlay>>& overlays)
+{
+  namespace VS = KODI::VIDEO::SUBTITLES;
+  const VS::BitmapStereoLayout layout =
+      VS::GetBitmapStereoLayout(CServiceBroker::GetDataCacheCore().GetVideoStereoMode());
+  std::vector<std::shared_ptr<CDVDOverlayImage>> eyes; //!< one eye cut from a picture of both
+  std::vector<const CDVDOverlayImage*> images;
+  int videoWidth = 0; //!< the video the subtitle is placed on, one eye's of a 3D one
+  int videoHeight = 0;
+  for (const auto& overlay : overlays)
+  {
+    // a 3D subtitle is read by one eye: the player has split it for a 3D screen, or it is cut
+    if (!overlay || !overlay->IsOverlayType(DVDOVERLAY_TYPE_IMAGE) ||
+        overlay->m_stereoView == DVDOverlayStereoView::RIGHT)
+      continue;
+    const auto* image = static_cast<const CDVDOverlayImage*>(overlay.get());
+    if (image->palette.empty() || image->width <= 0 || image->height <= 0)
+      continue;
+    int width = image->source_width;
+    int height = image->source_height;
+    if (layout != VS::BitmapStereoLayout::MONO && overlay->m_stereoView == DVDOverlayStereoView::BOTH)
+    {
+      VS::BitmapSubtitle bitmap;
+      bitmap.pixels = image->pixels.data();
+      bitmap.stride = image->linesize;
+      bitmap.x = image->x;
+      bitmap.y = image->y;
+      bitmap.width = image->width;
+      bitmap.height = image->height;
+      bitmap.sourceWidth = image->source_width;
+      bitmap.sourceHeight = image->source_height;
+      for (size_t i = 0; i < image->palette.size() && i < bitmap.palette.size(); ++i)
+        if (((image->palette[i] >> PIXEL_ASHIFT) & 0xff) != 0)
+          bitmap.palette[i] = image->palette[i];
+      if (VS::IsStereoBitmap(bitmap, layout))
+      {
+        const VS::BitmapStereoCrop crop = VS::GetStereoCrop(bitmap, layout, false);
+        if (crop.IsEmpty())
+          continue;
+        image = eyes.emplace_back(std::make_shared<CDVDOverlayImage>(
+                                      *image, crop.packedX, crop.packedY, crop.width, crop.height))
+                    .get();
+        width = crop.sourceWidth;
+        height = crop.sourceHeight;
+      }
+    }
+    if (images.empty())
+    {
+      videoWidth = width;
+      videoHeight = height;
+    }
+    images.push_back(image);
+  }
+  if (images.empty())
+    return std::nullopt;
+
+  int x0 = images.front()->x, y0 = images.front()->y, x1 = x0, y1 = y0;
+  for (const CDVDOverlayImage* image : images)
+  {
+    x0 = std::min(x0, image->x);
+    y0 = std::min(y0, image->y);
+    x1 = std::max(x1, image->x + image->width);
+    y1 = std::max(y1, image->y + image->height);
+  }
+  Picture canvas;
+  canvas.width = x1 - x0;
+  canvas.height = y1 - y0;
+  canvas.grey.assign(static_cast<size_t>(canvas.width) * canvas.height, 255);
+  for (const CDVDOverlayImage* image : images)
+  {
+    // the text's light, as opaque as it is: bright text is ink, its dark outline is not
+    std::array<uint8_t, 256> ink;
+    ink.fill(255);
+    for (size_t i = 0; i < image->palette.size() && i < ink.size(); ++i)
+    {
+      const uint32_t color = image->palette[i];
+      const unsigned int alpha = (color >> PIXEL_ASHIFT) & 0xff;
+      const unsigned int light = (299 * ((color >> PIXEL_RSHIFT) & 0xff) +
+                                  587 * ((color >> PIXEL_GSHIFT) & 0xff) +
+                                  114 * ((color >> PIXEL_BSHIFT) & 0xff)) /
+                                 1000;
+      ink[i] = static_cast<uint8_t>(255 - light * alpha / 255);
+    }
+    for (int y = 0; y < image->height; ++y)
+      for (int x = 0; x < image->width; ++x)
+      {
+        uint8_t& out = canvas.grey[(image->y - y0 + y) * canvas.width + image->x - x0 + x];
+        out = std::min(out, ink[image->pixels[y * image->linesize + x]]);
+      }
+  }
+  const std::optional<Box> box = InkBox(canvas);
+  if (!box)
+    return std::nullopt;
+  Picture picture = CloseGaps(Crop(canvas, *box));
+  picture.place = MODEL::Place(x0 + box->x0, y0 + box->y0, x0 + box->x1 + 1, y0 + box->y1 + 1,
+                               videoWidth, videoHeight);
+  return picture;
+}
+
+Picture Scaled(const Picture& picture, int lineHeight)
+{
+  const double factor = static_cast<double>(lineHeight) * Lines(picture) / picture.height;
+  if (factor >= 1.0)
+    return picture;
+  Picture out;
+  out.width = std::max(1, static_cast<int>(picture.width * factor));
+  out.height = std::max(1, static_cast<int>(picture.height * factor));
+  out.grey.resize(static_cast<size_t>(out.width) * out.height);
+  // each pixel the average of the ones it covers
+  for (int y = 0; y < out.height; ++y)
+  {
+    const int top = y * picture.height / out.height;
+    const int bottom = std::max(top + 1, (y + 1) * picture.height / out.height);
+    for (int x = 0; x < out.width; ++x)
+    {
+      const int left = x * picture.width / out.width;
+      const int right = std::max(left + 1, (x + 1) * picture.width / out.width);
+      unsigned int sum = 0;
+      for (int sy = top; sy < bottom; ++sy)
+        for (int sx = left; sx < right; ++sx)
+          sum += picture.grey[sy * picture.width + sx];
+      out.grey[y * out.width + x] =
+          static_cast<uint8_t>(sum / static_cast<unsigned int>((bottom - top) * (right - left)));
+    }
+  }
+  return out;
+}
+
+Picture Stack(const std::vector<Picture>& pictures)
+{
+  constexpr int NUMBERS = 48; //!< the column of the numbers
+  constexpr int GAP = 6;
+  Picture out;
+  for (const Picture& picture : pictures)
+  {
+    out.width = std::max(out.width, NUMBERS + picture.width);
+    out.height += std::max(picture.height, 15) + 2 * GAP + 1;
+  }
+  out.grey.assign(static_cast<size_t>(out.width) * out.height, 255);
+  int top = 0;
+  for (size_t i = 0; i < pictures.size(); ++i)
+  {
+    const Picture& picture = pictures[i];
+    const int row = std::max(picture.height, 15);
+    Draw(out, 4, top + (row - 15) / 2, std::to_string(i + 1) + ")");
+    for (int y = 0; y < picture.height; ++y)
+      std::copy_n(picture.grey.begin() + y * picture.width, picture.width,
+                  out.grey.begin() + (top + y) * out.width + NUMBERS);
+    top += row + GAP;
+    std::fill_n(out.grey.begin() + top * out.width, out.width, 128);
+    top += 1 + GAP;
+  }
+  return out;
+}
+
+std::string Png(const Picture& picture)
+{
+  std::vector<uint8_t> argb(static_cast<size_t>(picture.width) * picture.height * 4);
+  for (size_t i = 0; i < picture.grey.size(); ++i)
+  {
+    // the byte order of XB_FMT_A8R8G8B8: blue, green, red, alpha
+    argb[4 * i] = argb[4 * i + 1] = argb[4 * i + 2] = picture.grey[i];
+    argb[4 * i + 3] = 255;
+  }
+  CFFmpegImage encoder("image/png");
+  unsigned char* out = nullptr;
+  unsigned int size = 0;
+  if (!encoder.CreateThumbnailFromSurface(argb.data(), picture.width, picture.height,
+                                          XB_FMT_A8R8G8B8, picture.width * 4, "subtitle.png",
+                                          out, size))
+    return {};
+  std::string png(reinterpret_cast<const char*>(out), size);
+  encoder.ReleaseThumbnailBuffer();
+  return png;
+}
+
+CReader::CReader(std::string language, Deliver deliver)
+  : m_language(std::move(language)),
+    m_deliver(std::move(deliver)),
+    m_ask(std::make_unique<AI::CPictureAsk>()),
+    m_thread([this] { Run(); })
+{
+}
+
+CReader::~CReader()
+{
+  {
+    std::unique_lock guard(m_lock);
+    m_stop = true;
+  }
+  m_wake.notify_all();
+  m_ask->Cancel();
+  m_thread.join();
+}
+
+void CReader::Add(Item item)
+{
+  {
+    std::unique_lock guard(m_lock);
+    m_queue.push_back(std::move(item));
+  }
+  m_wake.notify_all();
+}
+
+void CReader::Flush()
+{
+  {
+    std::unique_lock guard(m_lock);
+    ++m_generation;
+    m_queue.clear();
+  }
+  m_ask->Abort();
+}
+
+void CReader::Run()
+{
+  int refused = 0;
+  m_ask->Wake();
+  std::unique_lock lock(m_lock);
+  while (true)
+  {
+    m_wake.wait(lock, [this] { return m_stop || !m_queue.empty(); });
+    // the next ones come with the packets that follow: a batch, if they come soon
+    m_wake.wait_for(lock, GATHER, [this] { return m_stop || m_queue.size() >= BATCH; });
+    if (m_stop)
+      return;
+    // in order, the clears among them, up to a batch of pictures
+    std::vector<Item> batch;
+    size_t count = 0;
+    while (!m_queue.empty() && (count < BATCH || m_queue.front().picture.grey.empty()))
+    {
+      count += m_queue.front().picture.grey.empty() ? 0 : 1;
+      batch.push_back(std::move(m_queue.front()));
+      m_queue.pop_front();
+    }
+    const unsigned int generation = m_generation;
+    lock.unlock();
+
+    std::vector<Picture> pictures;
+    for (const Item& item : batch)
+      if (!item.picture.grey.empty())
+        pictures.push_back(Scaled(item.picture, LINE_HEIGHT));
+    const std::string png = pictures.empty() ? std::string() : Png(Stack(pictures));
+    std::string error;
+    const std::optional<std::string> answer =
+        png.empty() ? std::nullopt : m_ask->Ask(Prompt(pictures.size(), m_language), png, error);
+    const std::vector<std::string> texts =
+        answer ? MODEL::ReadNumbered(*answer, pictures.size()) : std::vector<std::string>{};
+    // a provider that does not answer says nothing of whether its model reads pictures
+    if (!texts.empty())
+      refused = 0;
+    else if (!pictures.empty() && (answer || (!error.empty() && error != "no answer")) &&
+             ++refused >= REFUSALS)
+      m_failed = true;
+    if (!error.empty() || (answer && texts.empty()))
+      CLog::Log(LOGWARNING, "Subtitle pictures: {} not read: {}", pictures.size(),
+                answer ? "an answer not numbered" : error);
+
+    // delivered at once, not when the next packet comes - that can be minutes later - and under
+    // the lock, so a flush waits for it
+    lock.lock();
+    if (generation != m_generation)
+      continue;
+    for (size_t i = 0, picture = 0; i < batch.size(); ++i)
+      if (batch[i].picture.grey.empty())
+        m_deliver({}, batch[i].start, batch[i].start);
+      else if (const size_t read = picture++; read < texts.size() && !texts[read].empty())
+        m_deliver(texts[read], batch[i].start, batch[i].stop);
+  }
+}
+} // namespace KODI::SUBTITLES::PICTURES
