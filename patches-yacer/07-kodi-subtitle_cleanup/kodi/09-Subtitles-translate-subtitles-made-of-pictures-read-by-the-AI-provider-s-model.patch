+//! How long a line with no end of its own lasts unless the next one ends it first.
+constexpr double UNENDED = 20.0 * DVD_TIME_BASE;
+//! How far ahead of playback the track is read: long before reading and translating a line is
+//! done, whatever the model's pace.
+constexpr double AHEAD = 60.0 * DVD_TIME_BASE;
+//! How far behind its latest the read-ahead may be missing a subtitle the player read, timing
+//! aside, before it is taken not to see the track as the player does.
+constexpr double MISSED = 2.0 * DVD_TIME_BASE;
+//! The same subtitle from both paths starts within this.
+constexpr double SAME = 0.01 * DVD_TIME_BASE;
+//! How much faster than playback the read-ahead reads: past that it would take the network and
+//! the disc from playback, more so as a video opens or after a seek.
+constexpr double PACE = 4.0;
+
+//! A subtitle's start, to the nearest SAME: the subtitles the two paths read are one if it is.
+int64_t Slot(double start)
+{
+  return std::llround(start / SAME);
+}
+
+//! The subtitle a decode left in the codec: its picture, or the clear that ends the one before.
+std::optional<PICTURES::CReader::Item> Collect(CDVDOverlayCodecFFmpeg& codec)
+{
+  std::vector<std::shared_ptr<CDVDOverlay>> shown;
+  double start = 0;
+  double stop = 0;
+  bool cleared = false;
+  while (std::shared_ptr<CDVDOverlay> overlay = codec.GetOverlay())
+  {
+    start = overlay->iPTSStartTime;
+    stop = overlay->iPTSStopTime;
+    if (overlay->IsOverlayType(DVDOVERLAY_TYPE_IMAGE))
+      shown.push_back(std::move(overlay));
+    else
+      cleared = true;
+  }
+  if (std::optional<PICTURES::Picture> picture = PICTURES::FromOverlays(shown))
+    return PICTURES::CReader::Item{std::move(*picture), start, stop > start ? stop : 0};
+  if (cleared)
+    return PICTURES::CReader::Item{{}, start, 0};
+  return std::nullopt;
+}
+} // namespace
