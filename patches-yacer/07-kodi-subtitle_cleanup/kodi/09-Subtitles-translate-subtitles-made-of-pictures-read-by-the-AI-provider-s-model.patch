+/*!
+ * \brief The AI provider's model asked about a picture: how subtitles made of pictures are read.
+ * The provider and model are the settings' when it is made.
+ */
+class CPictureAsk
+{
+public:
+  CPictureAsk();
+  ~CPictureAsk();
+  //! The model's answer about a PNG picture, or none, with why when the provider said.
+  std::optional<std::string> Ask(const std::string& prompt, const std::string& png, std::string& error);
+  //! Have the model loaded before the first picture comes: a server that unloads it when idle
+  //! takes seconds to load it again.
+  void Wake();
+  //! Drop the request in progress: the pictures it is for are no longer wanted.
+  void Abort();
+  //! End the request in progress, and any to come: the stream closes.
+  void Cancel();
+
+private:
+  struct Chat;
+  std::mutex m_lock;
+  std::unique_ptr<Chat> m_chat; //!< made once the model is known
+  bool m_cancelled{false};
+};
