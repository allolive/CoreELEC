+}
+
+/*!
+ * \brief Subtitles made of pictures - Blu-ray PGS, DVD, DVB - read as text, so they can be
+ * translated: by the AI provider's model, when it reads images.
+ */
+namespace KODI::SUBTITLES::PICTURES
+{
+//! A subtitle picture in grey: its text dark on white.
+struct Picture
+{
+  int width{0};
+  int height{0};
+  std::vector<uint8_t> grey; //!< width * height, row by row
+  int place{MODEL::BOTTOM_CENTRE}; //!< where on the video it is shown, as MODEL::Place gives it
+};
+
+/*!
+ * \brief The picture the overlays of one subtitle make: its text dark on white, cropped to it,
+ * with where its text is shown on the video. The other eye's copy of a 3D subtitle is left out.
+ * None when nothing shows.
+ */
+std::optional<Picture> FromOverlays(const std::vector<std::shared_ptr<CDVDOverlay>>& overlays);
+
+/*!
+ * \brief A picture with its text lines about lineHeight high - the text's own height, not the
+ * video's, decides: a DVD subtitle keeps its size, a 4K one shrinks a lot. Never enlarged.
+ */
+Picture Scaled(const Picture& picture, int lineHeight);
+
+/*!
+ * \brief Pictures one above the other, each with its number on its left and a rule under it:
+ * one picture for the model to read them all.
+ */
+Picture Stack(const std::vector<Picture>& pictures);
+
+//! A picture as PNG, empty when it cannot be made.
+std::string Png(const Picture& picture);
+
+/*!
+ * \brief Reads the text of a stream's subtitle pictures in the background, a few at a time, with
+ * the AI provider's model.
+ */
+class CReader
+{
+public:
+  //! A subtitle's picture, with its times; one with no picture clears the one before.
+  struct Item
+  {
+    Picture picture;
+    double start;
+    double stop; //!< its own end, or 0 for none
+  };
+  //! A picture's text, with its times, as soon as it is read, and "" for a clear, in the order
+  //! they came: from the reader's thread, never after Flush returns.
+  using Deliver = std::function<void(std::string text, double start, double stop)>;
+
+  /*!
+   * \param language the pictures' language, by name in English ("Spanish"), or empty
+   * \param deliver where what is read goes; a picture not read goes nowhere
+   */
+  CReader(std::string language, Deliver deliver);
+  ~CReader();
+
+  void Add(Item item);
+  //! Forget every picture not yet read: a seek.
+  void Flush();
+  //! Whether the model reads no pictures: it refused them, or answered unread, several in a row.
+  bool Failed() const { return m_failed; }
+
+private:
+  void Run();
+
+  const std::string m_language;
+  const Deliver m_deliver;
+  std::unique_ptr<AI::CPictureAsk> m_ask;
+  std::mutex m_lock;
+  std::condition_variable m_wake;
+  std::deque<Item> m_queue;
+  unsigned int m_generation{0}; //!< how many flushes: what is read for an earlier one is dropped
+  bool m_stop{false};
+  std::atomic<bool> m_failed{false};
+  std::thread m_thread;
+};
+} // namespace KODI::SUBTITLES::PICTURES
