+ * subtitle packets decoded as the player decodes them.
+ */
+struct CSubtitlePictureCodec::Ahead
+{
+  Ahead(CSubtitlePictureCodec& codec, const CDVDStreamInfo& hints)
+    : m_codec(codec),
+      m_hints(hints),
+      m_thread([this] { Run(); })
+  {
+  }
+
+  ~Ahead()
+  {
+    {
+      std::unique_lock guard(m_lock);
+      m_stop = true;
+      if (m_input)
+        m_input->Abort();
+    }
+    m_wake.notify_all();
+    m_thread.join();
+  }
+
+  //! Playback moved: read from where it is now.
+  void Seek()
+  {
+    {
+      std::unique_lock guard(m_lock);
+      m_seek = true;
+    }
+    m_wake.notify_all();
+  }
+
+private:
+  void Run()
+  {
+    CFileItem item(m_hints.video, false);
+    std::shared_ptr<CDVDInputStream> input = CDVDFactoryInputStream::CreateInputStream(nullptr, item);
+    // a file without the player's cache, which would only hold a second copy of what it reads; a
+    // disc through its own navigation
+    if (input && input->IsStreamType(DVDSTREAM_TYPE_FILE))
+      input = std::make_shared<CDVDInputStreamFile>(
+          item, XFILE::READ_TRUNCATED | XFILE::READ_BITRATE | XFILE::READ_NO_CACHE);
+    if (!input || !input->Open())
+    {
+      CLog::Log(LOGINFO, "Subtitle pictures: {} cannot be read ahead", CURL::GetRedacted(m_hints.video));
+      return;
+    }
+    {
+      std::unique_lock guard(m_lock);
+      if (m_stop)
+        return;
+      m_input = input;
+    }
+    std::unique_ptr<CDVDDemux> demux(CDVDFactoryDemuxer::CreateDemuxer(input, false));
+    const CDemuxStream* track = nullptr;
+    for (const CDemuxStream* stream : demux ? demux->GetStreams() : std::vector<CDemuxStream*>{})
+      if (stream && stream->type == StreamType::SUBTITLE && stream->uniqueId == m_hints.uniqueId &&
+          stream->codec == m_hints.codec)
+        track = stream;
+    CDVDOverlayCodecFFmpeg pictures;
+    CDVDStreamInfo hints(m_hints);
+    CDVDCodecOptions options;
+    if (!track || !pictures.Open(hints, options))
+    {
+      CLog::Log(LOGINFO, "Subtitle pictures: the track is not found again to read it ahead");
+      Release();
+      return;
+    }
+    CLog::Log(LOGDEBUG, "Subtitle pictures: reading the track ahead of playback");
+
+    double reached = 0; //!< where the reading is, in the stream's time
+    double from = 0; //!< and where it was after the last seek
+    auto since = std::chrono::steady_clock::now();
+    unsigned int generation = 0;
+    while (true)
+    {
+      {
+        std::unique_lock guard(m_lock);
+        if (m_stop)
+          break;
+        if (m_seek)
+        {
+          m_seek = false;
+          generation = m_codec.m_generation;
+          guard.unlock();
+          // from a little before where playback is, the subtitle shown then included
+          const double now = KODI::SUBTITLES::AI::PlaybackTime() / 1000.0;
+          demux->SeekTime(std::max(0.0, now - 5000.0), true);
+          pictures.Flush();
+          reached = 0;
+          from = 0;
+          since = std::chrono::steady_clock::now();
+          continue;
+        }
+        // a minute ahead, or read faster than its pace: wait
+        const double read = reached - from;
+        const double allowed =
+            PACE * DVD_TIME_BASE *
+            std::chrono::duration<double>(std::chrono::steady_clock::now() - since).count();
+        if (reached > 0 &&
+            (reached > KODI::SUBTITLES::AI::PlaybackTime() + AHEAD || read > allowed + AHEAD / 6))
+        {
+          m_wake.wait_for(guard, 500ms, [this] { return m_stop || m_seek; });
+          continue;
+        }
+      }
+      DemuxPacket* packet = demux->Read();
+      if (!packet)
+      {
+        // the end, or nothing yet: until a seek
+        std::unique_lock guard(m_lock);
+        m_wake.wait_for(guard, 1s, [this] { return m_stop || m_seek; });
+        continue;
+      }
+      if (packet->pts != DVD_NOPTS_VALUE)
+      {
+        if (from == 0)
+          from = packet->pts;
+        reached = std::max(reached, packet->pts);
+      }
+      if (packet->iStreamId == track->uniqueId &&
+          pictures.Decode(packet) == OverlayMessage::OC_OVERLAY)
+        if (std::optional<PICTURES::CReader::Item> subtitle = Collect(pictures))
+          m_codec.Hand(std::move(*subtitle), generation);
+      CDVDDemuxUtils::FreeDemuxPacket(packet);
+      if (m_codec.m_aheadWrong)
+        break;
+    }
+    demux.reset();
+    Release();
+  }
+
+  void Release()
+  {
+    std::unique_lock guard(m_lock);
+    m_input.reset();
+  }
+
+  CSubtitlePictureCodec& m_codec;
+  const CDVDStreamInfo m_hints;
+  std::mutex m_lock;
+  std::condition_variable m_wake;
+  std::shared_ptr<CDVDInputStream> m_input; //!< the video read, to abort
+  bool m_stop{false};
+  bool m_seek{true};
+  std::thread m_thread;
+};
+
+CSubtitlePictureCodec::CSubtitlePictureCodec() : CDVDOverlayCodec("Subtitle Picture Reader")
+{
+}
+
+CSubtitlePictureCodec::~CSubtitlePictureCodec()
+{
+  // their threads hand lines on, to the reader and to the cue stage: they go first
+  m_ahead.reset();
+  m_reader.reset();
+}
+
+bool CSubtitlePictureCodec::Open(CDVDStreamInfo& hints, CDVDCodecOptions& options)
+{
+  m_pictures = std::make_unique<CDVDOverlayCodecFFmpeg>();
+  if (!m_pictures->Open(hints, options))
+    return false;
+  m_reader = std::make_unique<PICTURES::CReader>(
+      KODI::SUBTITLES::AI::LanguageName(KODI::SUBTITLES::TRANSLATION::CodeOf(hints.language)),
+      [this](std::string text, double start, double stop)
+      { m_cues.Submit(std::move(text), start, stop); });
+  m_cues.Open(
+      hints, true, [this](const std::string& text, double start, double stop)
+      { Show(text, start, stop); }, false);
+  if (!hints.video.empty())
+    m_ahead = std::make_unique<Ahead>(*this, hints);
+  return Initialize();
+}
+
+void CSubtitlePictureCodec::Hand(PICTURES::CReader::Item item, unsigned int generation)
+{
+  {
+    std::unique_lock guard(m_seenLock);
+    if (generation && generation != m_generation)
+      return;
+    // each once, whichever path reads it first; a clear apart from a picture at the same time
+    const int64_t key = Slot(item.start) * 2 + (item.picture.grey.empty() ? 1 : 0);
+    if (!m_seen.insert(key).second)
+      return;
+    if (!item.picture.grey.empty())
+      m_places[Slot(item.start)] = item.picture.place;
+    if (generation)
+      m_aheadUpTo = std::max(m_aheadUpTo, item.start);
+    else if (m_ahead && !m_aheadWrong && m_aheadUpTo > item.start + MISSED)
+    {
+      // read ahead past it, yet never seen: the read-ahead does not see the track as the player
+      m_aheadWrong = true;
+      CLog::Log(LOGWARNING, "Subtitle pictures: the read-ahead missed one at {:.1f} s: stopped",
+                item.start / DVD_TIME_BASE);
+    }
+  }
+  if (!item.picture.grey.empty())
+    CLog::Log(LOGDEBUG, "Subtitle pictures: one at {:.1f} s, {:.1f} s ahead of playback, {}",
+              item.start / DVD_TIME_BASE,
+              (item.start - KODI::SUBTITLES::AI::PlaybackTime()) / DVD_TIME_BASE,
+              generation ? "read ahead" : "from the player");
+  m_reader->Add(std::move(item));
+}
+
+OverlayMessage CSubtitlePictureCodec::Decode(DemuxPacket* pPacket)
+{
+  if (m_asPictures)
+    return m_pictures->Decode(pPacket);
+  if (m_aheadWrong && m_ahead)
+    m_ahead.reset();
+  if (m_pictures->Decode(pPacket) == OverlayMessage::OC_OVERLAY)
+    if (std::optional<PICTURES::CReader::Item> subtitle = Collect(*m_pictures))
+      Hand(std::move(*subtitle), 0);
+  if (m_reader->Failed())
+  {
+    CLog::Log(LOGWARNING, "{} - the AI provider's model reads no pictures: shown as they are",
+              __FUNCTION__);
+    m_asPictures = true;
+    m_ahead.reset();
+  }
+  return m_overlay ? OverlayMessage::OC_DONE : OverlayMessage::OC_OVERLAY;
+}
+
+void CSubtitlePictureCodec::Show(std::string text, double start, double stop)
+{
+  // as the player ends a picture: where the next starts or clears, or at its own end before -
+  // PGS gives none, only the farthest time there is
+  if (m_prevSubId != NO_SUBTITLE_ID && m_prevStop > start && start > m_prevStart)
+    ChangeSubtitleStopTime(m_prevSubId, start);
+  m_prevSubId = NO_SUBTITLE_ID;
+  if (text.empty())
+    return;
+  CLog::Log(LOGDEBUG, "Subtitle pictures: line at {:.1f} s ready {:.1f} s ahead of it",
+            start / DVD_TIME_BASE, (start - KODI::SUBTITLES::AI::PlaybackTime()) / DVD_TIME_BASE);
+  if (stop <= start)
+    stop = start + UNENDED;
+  // read off a picture, it carries no tags: every character of it shows as itself, where the
+  // picture was - bottom centre, as any text subtitle, needs no tag
+  int place = KODI::SUBTITLES::MODEL::BOTTOM_CENTRE;
+  {
+    std::unique_lock guard(m_seenLock);
+    if (const auto it = m_places.find(Slot(start)); it != m_places.end())
+    {
+      place = it->second;
+      m_places.erase(it); // each line is shown once
+    }
+  }
+  text = (place != KODI::SUBTITLES::MODEL::BOTTOM_CENTRE ? "{\\an" + std::to_string(place) + "}"
+                                                         : "") +
+         KODI::SUBTITLES::MODEL::AssText(text);
+  m_prevSubId = AddSubtitle(text, start, stop);
+  m_prevStart = start;
+  m_prevStop = stop;
+}
+
+void CSubtitlePictureCodec::Reset()
+{
+  Flush();
+}
+
+void CSubtitlePictureCodec::Flush()
+{
+  {
+    std::unique_lock guard(m_seenLock);
+    ++m_generation;
+    m_seen.clear();
+    m_places.clear();
+    m_aheadUpTo = 0;
+  }
+  if (m_ahead)
+    m_ahead->Seek();
+  m_pictures->Flush();
+  m_reader->Flush();
+  m_cues.Flush();
+  m_prevSubId = NO_SUBTITLE_ID;
+  m_overlay.reset();
+  FlushSubtitles();
+}
+
+std::shared_ptr<CDVDOverlay> CSubtitlePictureCodec::GetOverlay()
+{
+  if (m_asPictures)
+    return m_pictures->GetOverlay();
+  if (m_overlay)
+    return nullptr;
+  m_overlay = CreateOverlay();
+  return m_overlay;
+}
