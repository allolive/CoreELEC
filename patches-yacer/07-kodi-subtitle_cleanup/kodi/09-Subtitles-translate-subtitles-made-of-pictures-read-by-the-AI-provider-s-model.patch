+/*!
+ * \brief The provider the settings name, with the model it is asked for: the newest of a family
+ * once the provider has said which - not waited for - or none until then.
+ */
+std::optional<Provider> ModelProvider()
+{
+  Provider provider = CurrentProvider();
+  if (!FamilyNamed(provider.model).empty())
+    Available(false);
+  provider.model = ModelInUse(provider);
+  if (provider.model.empty())
+    return std::nullopt;
+  return provider;
+}
+} // namespace
+
+struct CPictureAsk::Chat : CChat
+{
+  explicit Chat(Provider provider) : CChat(std::move(provider), 60s) {}
+};
+
+CPictureAsk::CPictureAsk() = default;
+
+CPictureAsk::~CPictureAsk() = default;
+
+std::optional<std::string> CPictureAsk::Ask(const std::string& prompt,
+                                            const std::string& png,
+                                            std::string& error)
+{
+  {
+    std::unique_lock guard(m_lock);
+    if (m_cancelled)
+      return std::nullopt;
+    // the model is known once the provider has been asked: until then nothing is sent
+    if (!m_chat)
+      if (std::optional<Provider> provider = ModelProvider())
+        m_chat = std::make_unique<Chat>(std::move(*provider));
+    if (!m_chat)
+      return std::nullopt;
+  }
+  m_chat->Begin();
+  return m_chat->Send({}, prompt, error, &png).text;
+}
+
+void CPictureAsk::Wake()
+{
+  std::string error;
+  {
+    std::unique_lock guard(m_lock);
+    if (m_cancelled)
+      return;
+    if (!m_chat)
+      if (std::optional<Provider> provider = ModelProvider())
+        m_chat = std::make_unique<Chat>(std::move(*provider));
+    if (!m_chat)
+      return;
+  }
+  m_chat->Begin();
+  m_chat->Send({}, "Answer with the word OK.", error);
+}
+
+void CPictureAsk::Abort()
+{
+  std::unique_lock guard(m_lock);
+  if (m_chat)
+    m_chat->Abort();
+}
+
+void CPictureAsk::Cancel()
+{
+  std::unique_lock guard(m_lock);
+  m_cancelled = true;
+  if (m_chat)
+    m_chat->Cancel();
+}
