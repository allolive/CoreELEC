+void CCueStage::Parsed()
+{
+  // read in the background: the cues are shown as they are meanwhile
+  if (m_realigning)
+    m_realign = std::thread(&CCueStage::Realign, this);
+}
+
+void CCueStage::Realign()
+{
+  const auto key = std::make_pair(m_video, m_file);
+  std::optional<std::optional<TIMING::Fit>> known;
+  {
+    std::unique_lock lock(g_fitsLock);
+    if (const auto it = g_fits.find(key); it != g_fits.end())
+      known = it->second;
+  }
+  std::optional<TIMING::Fit> fit;
+  if (known)
+    fit = *known;
+  else
+  {
+    const auto reference = ReadReference();
+    if (m_abort)
+      return;
+    if (reference)
+    {
+      fit = TIMING::FitToReference(m_starts, reference->cues, reference->windows);
+      CLog::Log(LOGDEBUG, "Subtitle timing: {} lines of the video's own read in {} windows",
+                reference->cues.size(), reference->windows.size());
+    }
+    std::unique_lock lock(g_fitsLock);
+    g_fits[key] = fit;
+  }
+
+  std::unique_lock lock(m_outLock);
+  m_realigning = false;
+  if (fit)
+  {
+    CLog::Log(LOGINFO,
+              "Subtitle timing: {} realigned on the video's own subtitles, x{:.5f} {:+.2f} s ({} "
+              "of {} lines lined up)",
+              CURL::GetRedacted(m_file), fit->scale, fit->offset, fit->matched, fit->reference);
+    // what reached the screen goes, and comes again moved; what is still to come moves in Out
+    m_fit = fit;
+    m_clear();
+    for (const Shown& cue : m_delivered)
+      m_deliver(cue.text, Moved(cue.start), Moved(cue.stop));
+  }
+  m_delivered.clear();
+  m_delivered.shrink_to_fit();
+}
+
+std::optional<CCueStage::Reference> CCueStage::ReadReference()
+{
+  // a file of streams: a disc's titles are read through its navigation, not by seeking
+  CFileItem item(m_video, false);
+  if (const auto probe = CDVDFactoryInputStream::CreateInputStream(nullptr, item);
+      !probe || !probe->IsStreamType(DVDSTREAM_TYPE_FILE))
+    return {};
+  // read in short bursts far apart: a cache would only fill with what is skipped
+  const auto input = std::make_shared<CDVDInputStreamFile>(
+      item, XFILE::READ_TRUNCATED | XFILE::READ_BITRATE | XFILE::READ_NO_CACHE);
+  {
+    std::unique_lock lock(m_inputLock);
+    if (m_abort)
+      return {};
+    m_input = input;
+  }
+  const auto done = [this]
+  {
+    std::unique_lock lock(m_inputLock);
+    m_input.reset();
+  };
+  // opened as playback opens it, so that both count time from the same start
+  std::unique_ptr<CDVDDemux> demux;
+  if (input->Open())
+    demux.reset(CDVDFactoryDemuxer::CreateDemuxer(input, false));
+  if (!demux || m_abort)
+  {
+    done();
+    return {};
+  }
+
+  // a text track, else a picture one; never a forced one, which covers too little
+  const CDemuxStream* track = nullptr;
+  int rank = 0;
+  for (const CDemuxStream* stream : demux->GetStreams())
+  {
+    if (!stream || stream->type != StreamType::SUBTITLE ||
+        (stream->flags & StreamFlags::FLAG_FORCED))
+      continue;
+    const AVCodecID codec = stream->codec;
+    const int r = codec == AV_CODEC_ID_SUBRIP || codec == AV_CODEC_ID_TEXT ||
+                          codec == AV_CODEC_ID_ASS || codec == AV_CODEC_ID_SSA
+                      ? 2
+                      : codec == AV_CODEC_ID_HDMV_PGS_SUBTITLE ? 1 : 0;
+    if (r > rank)
+    {
+      rank = r;
+      track = stream;
+    }
+  }
+  const double length = demux->GetStreamLength() / 1000.0;
+  if (!track || length < 20 * WINDOW)
+  {
+    done();
+    return {};
+  }
+  const int64_t demuxerId = track->demuxerId;
+  const int id = track->uniqueId;
+  const bool picture = track->codec == AV_CODEC_ID_HDMV_PGS_SUBTITLE;
+
+  Reference reference;
+  for (const double at : WINDOWS_AT)
+  {
+    const double start = at * length;
+    const double stop = start + WINDOW;
+    if (m_abort || !demux->SeekTime(start * 1000, true))
+      continue;
+    double first = -1;
+    double last = -1;
+    std::optional<double> shown;
+    // half a minute of every stream: a few hundred megabytes of a remux at most
+    for (int packets = 0; packets < 100000 && !m_abort; ++packets)
+    {
+      DemuxPacket* packet = demux->Read();
+      if (!packet)
+        break;
+      const double pts = packet->pts == DVD_NOPTS_VALUE ? -1 : Seconds(packet->pts);
+      if (pts >= 0)
+      {
+        if (first < 0)
+          first = pts;
+        last = std::max(last, pts);
+        if (packet->demuxerId == demuxerId && packet->iStreamId == id)
+        {
+          if (!picture)
+            reference.cues.push_back(
+                {pts, pts + (packet->duration > 0 ? Seconds(packet->duration) : 2)});
+          else if (const auto shows = TIMING::PgsShows(packet->pData, packet->iSize))
+          {
+            if (shown && pts > *shown)
+              reference.cues.push_back({*shown, pts});
+            shown = *shows ? std::optional<double>(pts) : std::nullopt;
+          }
+        }
+      }
+      CDVDDemuxUtils::FreeDemuxPacket(packet);
+      // a video picture can come a little out of order: a line just before the end is still read
+      if (pts > stop + 2)
+        break;
+    }
+    if (first >= 0 && last > first)
+      reference.windows.push_back({std::max(first, start), std::min(last, stop)});
+  }
+  done();
+  if (m_abort)
+    return {};
+  return reference;
+}
+
+double CCueStage::Moved(double time) const
+{
+  return DVD_SEC_TO_TIME(TIMING::Apply(*m_fit, Seconds(time)));
+}
+
+void CCueStage::Out(const std::string& text, double start, double stop)
+{
+  // nothing to show: in a file, a cue that is empty ends no other
+  if (text.empty())
+    return;
+  std::unique_lock lock(m_outLock);
+  if (m_realigning)
+    m_delivered.push_back({text, start, stop});
+  if (m_fit)
+    m_deliver(text, Moved(start), Moved(stop));
+  else
+    m_deliver(text, start, stop);
+}
+
 void CCueStage::Submit(std::string text, double start, double stop)
 {
   std::vector<std::string> doubts;
   if (m_cleaner && !m_cleaner->Clean(text, m_doubts ? &doubts : nullptr))
     text.clear();
+  if (m_realigning)
+    m_starts.push_back({Seconds(start), Seconds(stop)});
   if (m_doubter)
   {
     std::string read = text;
@@ -82,7 +330,7 @@ void CCueStage::Submit(std::string text, double start, double stop)
     // ones too, to keep their order
     m_worker->Submit(text, start, stop, std::move(doubts));
   else
-    m_deliver(text, start, stop);
+    m_out(text, start, stop);
 }
 
