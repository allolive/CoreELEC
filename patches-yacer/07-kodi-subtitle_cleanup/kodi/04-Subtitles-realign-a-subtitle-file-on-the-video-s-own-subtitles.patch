+//! where the video's own subtitles are read: six stretches of half a minute, across the film
+constexpr double WINDOW = 30;
+constexpr double WINDOWS_AT[] = {0.1, 0.25, 0.4, 0.55, 0.7, 0.85};
+
+double Seconds(double time)
+{
+  return time / DVD_TIME_BASE;
+}
+
+//! What a video and a subtitle file were found to need, kept for the session: the subtitle is
+//! opened again each time the viewer picks it after another, or seeks back past a title.
+std::mutex g_fitsLock;
