+
+void CCueStage::Stop()
+{
+  m_abort = true;
+  {
+    // a read stalled on the network gives up when its stream is aborted
+    std::unique_lock lock(m_inputLock);
+    if (m_input)
+      m_input->Abort();
+  }
+  if (m_realign.joinable())
+    m_realign.join();
+  m_abort = false;
+  m_starts.clear();
+  // the worker of the stream before may still be delivering
+  std::unique_lock lock(m_outLock);
+  m_realigning = false;
+  m_delivered.clear();
+  m_fit.reset();
+}
 
