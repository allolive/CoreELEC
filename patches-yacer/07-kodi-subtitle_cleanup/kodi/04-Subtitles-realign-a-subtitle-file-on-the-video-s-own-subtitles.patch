diff --git a/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitleTiming.cpp b/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitleTiming.cpp
new file mode 100644
index 0000000..b2c941a
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitleTiming.cpp
@@ -0,0 +1,208 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "SubtitleTiming.h"
+
+#include <algorithm>
+#include <cmath>
+#include <unordered_map>
+
+namespace KODI::SUBTITLES::TIMING
+{
+namespace
+{
+constexpr double FILM = 24000.0 / 1001;
+//! how far two starts may be apart and still be the same line's: two lines in other languages
+//! start with the same words, give or take a few frames
+constexpr double TOLERANCE = 0.3;
+//! the bins starts vote for an offset in
+constexpr double BIN = 0.1;
+//! a release with another intro is late or early by a minute or two; more is another film
+constexpr double MAX_OFFSET = 600;
+//! a change is made only when it lines up this many of the reference's lines...
+constexpr size_t MIN_MATCHED = 8;
+//! ...and this share of them, since the reference's lines are not the subtitle's
+constexpr double MIN_SHARE = 0.4;
+//! and when no other change comes close
+constexpr double MAX_RIVAL = 0.6;
+//! a ratio a thousandth from the best one (24 against 23.976) is the same change drifting, and
+//! lines up much of what it does: it need only clearly lose
+constexpr double MAX_TWIN = 0.85;
+constexpr double TWIN = 0.002;
+//! and in every stretch read, it must line up this share of the reference's lines there - a
+//! file for another cut fits one part of the film and not the rest
+constexpr double MIN_WINDOW_SHARE = 0.25;
+constexpr size_t WINDOW_LINES = 3;
+
+std::vector<double> Starts(const std::vector<Cue>& cues)
+{
+  std::vector<double> starts;
+  starts.reserve(cues.size());
+  for (const Cue& cue : cues)
+    starts.push_back(cue.start);
+  std::sort(starts.begin(), starts.end());
+  return starts;
+}
+
+//! The reference's starts each matched by a start of the subtitle, moved: (reference, subtitle).
+std::vector<std::pair<double, double>> Matches(const std::vector<double>& starts,
+                                               const std::vector<double>& reference,
+                                               double scale,
+                                               double offset)
+{
+  std::vector<std::pair<double, double>> matches;
+  for (const double r : reference)
+  {
+    // the subtitle's starts are sorted, and so are they moved
+    const double s = (r - offset) / scale;
+    const auto it = std::lower_bound(starts.begin(), starts.end(), s - TOLERANCE / scale);
+    if (it != starts.end() && std::abs(scale * *it + offset - r) <= TOLERANCE)
+      matches.emplace_back(r, *it);
+  }
+  return matches;
+}
+
+Fit Refine(const std::vector<double>& starts,
+           const std::vector<double>& reference,
+           double scale,
+           double offset)
+{
+  // the median of the matched lines' offsets, then counted again from there
+  auto matches = Matches(starts, reference, scale, offset);
+  if (!matches.empty())
+  {
+    std::vector<double> offsets;
+    for (const auto& [r, s] : matches)
+      offsets.push_back(r - scale * s);
+    std::nth_element(offsets.begin(), offsets.begin() + offsets.size() / 2, offsets.end());
+    offset = offsets[offsets.size() / 2];
+    matches = Matches(starts, reference, scale, offset);
+  }
+  return {scale, offset, matches.size(), reference.size()};
+}
+} // namespace
+
+const std::vector<double>& Scales()
+{
+  static const std::vector<double> scales{1.0,         25.0 / FILM, FILM / 25.0, 24.0 / FILM,
+                                          FILM / 24.0, 25.0 / 24.0, 24.0 / 25.0};
+  return scales;
+}
+
+std::optional<Fit> FitToReference(const std::vector<Cue>& cues,
+                                  const std::vector<Cue>& reference,
+                                  const std::vector<Window>& windows)
+{
+  std::vector<Cue> read;
+  for (const Cue& cue : reference)
+    if (std::any_of(windows.begin(), windows.end(), [&cue](const Window& w)
+                    { return cue.start >= w.start && cue.start <= w.stop; }))
+      read.push_back(cue);
+  const std::vector<double> starts = Starts(cues);
+  const std::vector<double> refs = Starts(read);
+  if (starts.empty() || refs.size() < MIN_MATCHED)
+    return {};
+
+  // every pair of starts votes for the offset that would make them one line's; the few offsets
+  // with most votes, under each frame-rate ratio, are tried
+  std::vector<Fit> fits;
+  for (const double scale : Scales())
+  {
+    std::unordered_map<long, size_t> votes;
+    for (const double r : refs)
+    {
+      // only the starts an offset in range can bring to this line vote for it
+      const auto from = std::lower_bound(starts.begin(), starts.end(), (r - MAX_OFFSET) / scale);
+      const auto to = std::upper_bound(from, starts.end(), (r + MAX_OFFSET) / scale);
+      for (auto s = from; s != to; ++s)
+        ++votes[std::lround((r - scale * *s) / BIN)];
+    }
+    std::vector<std::pair<size_t, long>> ranked;
+    const auto at = [&votes](long b)
+    {
+      const auto it = votes.find(b);
+      return it == votes.end() ? size_t{0} : it->second;
+    };
+    // a bin and its neighbours, since a line's start is off by a frame or two
+    for (const auto& [bin, count] : votes)
+      ranked.emplace_back(count + at(bin - 1) + at(bin + 1), bin);
+    const size_t tried = std::min<size_t>(ranked.size(), 5);
+    std::partial_sort(ranked.begin(), ranked.begin() + tried, ranked.end(), std::greater<>());
+    for (size_t i = 0; i < tried; ++i)
+      fits.push_back(Refine(starts, refs, scale, ranked[i].second * BIN));
+  }
+  if (fits.empty())
+    return {};
+
+  // the most lines lined up; on a tie, the nearer to leaving the times alone
+  const auto better = [](const Fit& a, const Fit& b)
+  {
+    if (a.matched != b.matched)
+      return a.matched > b.matched;
+    if ((a.scale == 1) != (b.scale == 1))
+      return a.scale == 1;
+    return std::abs(a.offset) < std::abs(b.offset);
+  };
+  std::sort(fits.begin(), fits.end(), better);
+  const Fit& best = fits.front();
+  const auto same = [&best](const Fit& f)
+  { return f.scale == best.scale && std::abs(f.offset - best.offset) <= 2 * TOLERANCE; };
+  const size_t asIs = Matches(starts, refs, 1, 0).size();
+
+  if (best.matched < MIN_MATCHED || best.matched < MIN_SHARE * refs.size())
+    return {};
+  for (const Fit& rival : fits)
+  {
+    if (same(rival))
+      continue;
+    const bool twin = std::abs(rival.scale / best.scale - 1) < TWIN;
+    if (rival.matched > (twin ? MAX_TWIN : MAX_RIVAL) * best.matched)
+      return {};
+  }
+  // times that line up as they are stay as they are
+  if ((best.scale == 1 && std::abs(best.offset) <= TOLERANCE) ||
+      asIs > MAX_RIVAL * best.matched)
+    return {};
+  for (const Window& window : windows)
+  {
+    std::vector<double> there;
+    for (const double r : refs)
+      if (r >= window.start && r <= window.stop)
+        there.push_back(r);
+    const size_t matched = Matches(starts, there, best.scale, best.offset).size();
+    const size_t matchedAsIs = Matches(starts, there, 1, 0).size();
+    // a stretch the times fit as they are, better than the change: the change breaks it
+    if (matchedAsIs >= 2 && matchedAsIs > matched)
+      return {};
+    if (there.size() >= WINDOW_LINES && matched < MIN_WINDOW_SHARE * there.size())
+      return {};
+  }
+  return best;
+}
+
+std::optional<bool> PgsShows(const uint8_t* data, size_t size)
+{
+  // segments: a type, a big-endian length, the data; a presentation composition segment (0x16)
+  // gives, at its eleventh byte, how many objects it shows
+  std::optional<bool> shows;
+  size_t at = 0;
+  while (at + 3 <= size)
+  {
+    const uint8_t type = data[at];
+    const size_t length = (size_t{data[at + 1]} << 8) | data[at + 2];
+    at += 3;
+    if (at + length > size)
+      break;
+    // a palette update only recolours what is shown (a fade): no line starts or ends
+    if (type == 0x16 && length >= 11 && !(data[at + 8] & 0x80))
+      shows = data[at + 10] > 0;
+    at += length;
+  }
+  return shows;
+}
+} // namespace KODI::SUBTITLES::TIMING
