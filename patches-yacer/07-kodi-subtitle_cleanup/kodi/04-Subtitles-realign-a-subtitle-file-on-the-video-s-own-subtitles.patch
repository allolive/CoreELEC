--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitleTiming.h
@@ -0,0 +1,81 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+/*!
+ * \brief Realigning a subtitle whose times do not match the video: made for another release (a
+ * different intro, so every line is late or early by the same amount) or another frame rate (a
+ * PAL release runs 4% fast, so the lines drift further out as the film goes on).
+ *
+ * The subtitle is laid against another subtitle track of the same video, in any language: lines
+ * start where speech or a sign starts, whatever the language, so the pattern of starts is the
+ * video's own. One change applies to every line alike - an offset, and a known frame-rate ratio -
+ * so a line that translates something written on screen, which no speech marks, moves with the
+ * rest. Nothing changes unless that one change lines most of the reference's lines up, and many
+ * more than any other would.
+ */
+namespace KODI::SUBTITLES::TIMING
+{
+//! A line's times, in seconds.
+struct Cue
+{
+  double start{0};
+  double stop{0};
+};
+
+//! A stretch of the video whose reference lines were all read.
+struct Window
+{
+  double start{0};
+  double stop{0};
+};
+
+//! The change to a subtitle's times: video time = scale * subtitle time + offset.
+struct Fit
+{
+  double scale{1};
+  double offset{0};
+  size_t matched{0}; //!< the reference's lines that a line of the subtitle then starts with
+  size_t reference{0}; //!< the reference's lines read
+};
+
+//! The frame-rate ratios a subtitle made for another release can be off by.
+const std::vector<double>& Scales();
+
+/*!
+ * \brief The change that lays the subtitle on the reference, when there is one, and it is not
+ * to leave the times as they are.
+ * \param cues every line of the subtitle
+ * \param reference the reference's lines within windows
+ * \param windows the stretches the reference was read in
+ */
+std::optional<Fit> FitToReference(const std::vector<Cue>& cues,
+                                  const std::vector<Cue>& reference,
+                                  const std::vector<Window>& windows);
+
+//! A time of the subtitle, moved by a fit.
+inline double Apply(const Fit& fit, double time)
+{
+  return fit.scale * time + fit.offset;
+}
+
+/*!
+ * \brief What a packet of a picture subtitle (PGS, a Blu-ray's) does: a presentation segment
+ * that shows something starts a line, one that shows nothing ends the line before it.
+ * \return true when it shows something, false when it clears the screen, nothing when it has
+ * no presentation segment
+ */
+std::optional<bool> PgsShows(const uint8_t* data, size_t size);
+} // namespace KODI::SUBTITLES::TIMING
