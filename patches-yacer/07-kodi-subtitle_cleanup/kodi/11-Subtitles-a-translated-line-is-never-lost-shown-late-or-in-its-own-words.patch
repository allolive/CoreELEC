+
+std::optional<double> CCueStage::Late(double& start, double& stop)
+{
+  const std::optional<double> before = m_lateStart;
+  m_lateStart.reset();
+  if (!m_late)
+    return {};
+  const double now = AI::ShowingTime();
+  if (start >= now)
+    return {};
+  // an end before the start is one the next line gives
+  const bool ended = stop >= start;
+  if (ended && now > stop + LATE_GONE)
+  {
+    CLog::Log(LOGDEBUG,
+              "Subtitle translation: line at {:.1f} s came {:.1f} s after its end: not shown",
+              Seconds(start), Seconds(now - stop));
+    return {};
+  }
+  CLog::Log(LOGDEBUG, "Subtitle translation: line at {:.1f} s shown {:.1f} s late", Seconds(start),
+            Seconds(now - start));
+  // from the next picture: on a paused one, a line that comes stays hidden until it plays
+  start = now + LATE_FROM;
+  if (ended)
+    stop = std::max(stop, start + LATE_SHOWN);
+  m_lateStart = start;
+  if (!before)
+    return {};
+  return std::max(start, *before + LATE_SHOWN);
+}
+
+double CCueStage::Ending(double end) const
+{
+  return m_lateStart ? std::max(end, *m_lateStart + LATE_SHOWN) : end;
 }
 
