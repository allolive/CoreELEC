+std::string PicturePrompt(const Context& context,
+                          const std::deque<std::string>& before,
+                          size_t count)
+{
+  const std::string n = std::to_string(count);
+  return MODEL::Preamble(context.title, context.cast, before) + "\nThis image holds " + n + " " +
+         (context.from.empty() ? "" : context.from + " ") +
+         "film subtitles, one per numbered row. Transcribe each exactly as written, keeping "
+         "punctuation, accents and capitals, joining a row's lines with a single space; then "
+         "translate it into natural spoken " +
+         context.to +
+         " that reads well as a subtitle, keeping its meaning, its tone and its register, and "
+         "names as they are. Answer with one line per row, numbered 1) to " +
+         n + "), each the row as written, then \" => \", then its " + context.to +
+         " translation, and nothing else.";
+}
+
+namespace
+{
+std::string Trimmed(const std::string& text)
+{
+  const size_t first = text.find_first_not_of(" \t");
+  return first == std::string::npos ? std::string()
+                                    : text.substr(first, text.find_last_not_of(" \t") + 1 - first);
+}
+
+//! The same words, whatever their case and spacing: a line the model did not translate.
+bool Same(const std::string& a, const std::string& b)
+{
+  const auto folded = [](const std::string& text)
+  {
+    std::wstring out;
+    for (const wchar_t c : CLEANUP::ToWide(text))
+      if (c != L' ' && c != L'\t')
+        out.push_back(CLEANUP::Small(c));
+    return out;
+  };
+  return folded(a) == folded(b);
+}
+} // namespace
+
+std::optional<std::vector<PictureRow>> ReadPictureAnswer(const std::string& answer, size_t count)
+{
+  const std::vector<std::string> lines = MODEL::ReadNumbered(answer, count);
+  if (lines.empty())
+    return std::nullopt;
+  std::vector<PictureRow> rows;
+  for (const std::string& line : lines)
+  {
+    const size_t arrow = line.find("=>");
+    if (arrow == std::string::npos)
+      return std::nullopt;
+    PictureRow row{Trimmed(line.substr(0, arrow)), Trimmed(line.substr(arrow + 2))};
+    if (row.source.empty())
+      return std::nullopt;
+    // left in its own language, or run on: a model that runs on invents
+    if (Same(row.source, row.translation) ||
+        ReadTranslation("1. " + row.translation, {row.source}).empty())
+      row.translation.clear();
+    rows.push_back(std::move(row));
+  }
+  return rows;
+}
