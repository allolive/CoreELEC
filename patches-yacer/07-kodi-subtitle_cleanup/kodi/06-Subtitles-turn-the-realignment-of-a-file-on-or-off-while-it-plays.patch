diff --git a/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitleCueStage.cpp b/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitleCueStage.cpp
index df45e30..06d561f 100644
--- a/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitleCueStage.cpp
+++ b/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitleCueStage.cpp
@@ -111,6 +111,19 @@ bool LoadDetector(TIMING::CSpeechDetector& detector)
 //! opened again each time the viewer picks it after another, or seeks back past a title.
 std::mutex g_fitsLock;
 std::map<std::pair<std::string, std::string>, std::optional<TIMING::Fit>> g_fits;
+
+//! The subtitle files open, and the viewer's choice for the video they play with: none, the
+//! setting decides. A choice made with no file open is the next video's.
+std::mutex g_filesLock;
+std::vector<CCueStage*> g_files;
+std::string g_choiceVideo;
+std::optional<bool> g_choice;
+
+bool OnLocked()
+{
+  return g_files.empty() && !g_choiceVideo.empty() ? CLEANUP::RealignWanted()
+                                                    : g_choice.value_or(CLEANUP::RealignWanted());
+}
 } // namespace
 
 CCueStage::CCueStage() = default;
@@ -120,8 +133,64 @@ CCueStage::~CCueStage()
   Stop();
 }
 
+bool CCueStage::RealignOn()
+{
+  std::unique_lock lock(g_filesLock);
+  return OnLocked();
+}
+
+void CCueStage::ToggleRealign()
+{
+  std::unique_lock lock(g_filesLock);
+  const bool on = !OnLocked();
+  if (g_files.empty())
+    g_choiceVideo.clear();
+  g_choice = on;
+  CLog::Log(LOGINFO, "Subtitle timing: realignment turned {}", on ? "on" : "off");
+  for (CCueStage* file : g_files)
+    file->Turn(on);
+}
+
+void CCueStage::Turn(bool on)
+{
+  std::unique_lock lock(m_turnLock);
+  // the cues not all in yet: realigned or not once they are
+  if (!m_parsed)
+    return;
+  if (on)
+  {
+    {
+      std::unique_lock out(m_outLock);
+      if (m_realigning)
+        return;
+    }
+    if (m_realign.joinable())
+      m_realign.join();
+    std::unique_lock out(m_outLock);
+    m_realigning = true;
+    m_realign = std::thread(&CCueStage::Realign, this);
+    return;
+  }
+  m_abort = true;
+  {
+    std::unique_lock input(m_inputLock);
+    if (m_input)
+      m_input->Abort();
+  }
+  if (m_realign.joinable())
+    m_realign.join();
+  m_abort = false;
+  Show({}, "realignment turned off");
+}
+
 void CCueStage::Stop()
 {
+  {
+    std::unique_lock lock(g_filesLock);
+    std::erase(g_files, this);
+  }
+  std::unique_lock turn(m_turnLock);
+  m_parsed = false;
   m_abort = true;
   {
     // a read stalled on the network gives up when its stream is aborted
@@ -138,6 +207,7 @@ void CCueStage::Stop()
   m_realigning = false;
   m_delivered.clear();
   m_fit.reset();
+  m_file.clear();
 }
 
 void CCueStage::Open(const CDVDStreamInfo& hints, bool text, Deliver deliver)
@@ -185,8 +255,7 @@ void CCueStage::OpenFile(const CDVDStreamInfo& hints,
   m_doubts = false;
   m_timing = false;
   m_file = file;
-  m_video = CLEANUP::RealignWanted() ? hints.video : std::string();
-  m_realigning = !m_video.empty();
+  m_video = hints.video;
   // the whole file is known: it is worked on from where playback is, ahead of it
   const std::string language = CLEANUP::LanguageOfPath(file);
   m_worker = AI::MakeWorker(hints, language, std::chrono::seconds(60), m_out, AI::PlaybackTime,
@@ -203,9 +272,24 @@ void CCueStage::OpenFile(const CDVDStreamInfo& hints,
 
 void CCueStage::Parsed()
 {
+  std::unique_lock lock(g_filesLock);
+  // another video: the setting decides again, unless the choice was made before a file opened
+  if (g_choiceVideo != m_video)
+  {
+    if (!g_choiceVideo.empty() || !g_files.empty())
+      g_choice.reset();
+    g_choiceVideo = m_video;
+  }
+  g_files.push_back(this);
+  std::unique_lock turn(m_turnLock);
+  m_parsed = true;
   // read in the background: the cues are shown as they are meanwhile
-  if (m_realigning)
+  if (!m_video.empty() && g_choice.value_or(CLEANUP::RealignWanted()))
+  {
+    std::unique_lock out(m_outLock);
+    m_realigning = true;
     m_realign = std::thread(&CCueStage::Realign, this);
+  }
 }
 
 void CCueStage::Realign()
@@ -240,8 +324,6 @@ void CCueStage::Realign()
   }
   std::unique_lock lock(m_outLock);
   m_realigning = false;
-  m_delivered.clear();
-  m_delivered.shrink_to_fit();
 }
 
 void CCueStage::Keep(const std::optional<TIMING::Fit>& fit)
@@ -556,8 +638,8 @@ void CCueStage::Out(const std::string& text, double start, double stop)
   if (text.empty())
     return;
   std::unique_lock lock(m_outLock);
-  if (m_realigning)
-    m_delivered.push_back({text, start, stop});
+  // kept to be shown again when the file is realigned, or turned back
+  m_delivered.push_back({text, start, stop});
   if (m_fit)
     m_deliver(text, Moved(start, start), Moved(stop, start));
   else
@@ -569,7 +651,7 @@ void CCueStage::Submit(std::string text, double start, double stop)
   std::vector<std::string> doubts;
   if (m_cleaner && !m_cleaner->Clean(text, m_doubts ? &doubts : nullptr))
     text.clear();
-  if (m_realigning)
+  if (!m_file.empty())
     m_starts.push_back({Seconds(start), Seconds(stop)});
   if (m_doubter)
   {
