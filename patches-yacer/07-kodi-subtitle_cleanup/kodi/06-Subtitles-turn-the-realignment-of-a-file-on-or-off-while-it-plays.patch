   //! Lay the file's cues on the playing video's own subtitles, or its speech.
   void Realign();
   //! The playing video, opened as playback opens it, and abortable by Stop until it is let go.
@@ -117,11 +126,14 @@ private:
   Deliver m_out;
   Clear m_clear;
   std::string m_file;
-  std::string m_video; //!< the video a file's times are checked against, or empty
+  std::string m_video; //!< the video a file's times are checked against
   //! a file's times as handed in, and what reached the screen while they were checked
   std::vector<TIMING::Cue> m_starts;
   std::vector<Shown> m_delivered;
-  bool m_realigning{false};
+  bool m_realigning{false}; //!< the file's times are being checked
+  bool m_parsed{false}; //!< the file's cues are all handed in
