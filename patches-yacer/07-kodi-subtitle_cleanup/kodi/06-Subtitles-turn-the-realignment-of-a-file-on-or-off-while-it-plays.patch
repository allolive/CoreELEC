 ///   \table_row3{   <b>`VideoPlayer.HasEpg`</b>,
 ///                  \anchor VideoPlayer_HasEpg
 ///                  _boolean_,
@@ -4342,7 +4349,7 @@ constexpr std::array<InfoMap, 46> musicplayer = {{
