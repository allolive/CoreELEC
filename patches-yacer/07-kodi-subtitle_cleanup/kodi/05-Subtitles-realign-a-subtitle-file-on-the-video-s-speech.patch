index 0000000..b4e68b2
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitleSpeech.cpp
@@ -0,0 +1,974 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "SubtitleSpeech.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+#include <limits>
+
+namespace KODI::SUBTITLES::TIMING
+{
+namespace
+{
+//! offsets are tried this far apart, then the best one this finely around it
+constexpr double COARSE = 0.1;
+constexpr double FINE = 0.01;
+//! another change within this of the best one is the same change
+constexpr double SAME = 2;
+//! the best change must agree this much better than any other...
+constexpr double MIN_RATIO = 1.2;
+//! ...and stand this far above the agreements of all offsets, in their spread
+constexpr double MIN_Z = 5;
+//! a change smaller than this is no change: lines are shown a little before their speech
+constexpr double LEAVE = 0.5;
+constexpr size_t MIN_LINES = 20;
+
+//! The speech heard, less its mean, as running totals: how much more speech than usual lies
+//! between two times is two lookups.
+class CRunning
+{
+public:
+  CRunning(const Heard& heard, double mean) : m_start(heard.start)
+  {
+    m_excess.reserve(heard.speech.size());
+    m_total.reserve(heard.speech.size() + 1);
+    m_total.push_back(0);
+    for (const float p : heard.speech)
+    {
+      m_excess.push_back(static_cast<double>(p) - mean);
+      m_total.push_back(m_total.back() + m_excess.back());
+    }
+  }
+  double Start() const { return m_start; }
+  double Stop() const { return m_start + m_excess.size() * SPEECH_FRAME; }
+  //! The total up to a time, in frames, between frames by the frame it falls in.
+  double At(double time) const
+  {
+    const double f =
+        std::clamp((time - m_start) / SPEECH_FRAME, 0.0, static_cast<double>(m_excess.size()));
+    const size_t i = std::min(static_cast<size_t>(f), m_excess.size() - 1);
+    return m_total[i] + (f - i) * m_excess[i];
+  }
+
+private:
+  double m_start;
+  std::vector<double> m_excess;
+  std::vector<double> m_total;
+};
+
+//! How much more speech than usual the lines, moved, cover.
+double Agreement(const std::vector<Cue>& cues,
+                 double longest,
+                 const std::vector<CRunning>& heard,
+                 double scale,
+                 double offset)
+{
+  double sum = 0;
+  for (const CRunning& h : heard)
+  {
+    // the lines whose moved times reach into the stretch; cues are sorted by start
+    const double from = (h.Start() - offset) / scale - longest;
+    const double to = (h.Stop() - offset) / scale;
+    auto it = std::lower_bound(cues.begin(), cues.end(), from,
+                               [](const Cue& c, double t) { return c.start < t; });
+    for (; it != cues.end() && it->start < to; ++it)
+      sum += h.At(scale * it->stop + offset) - h.At(scale * it->start + offset);
+  }
+  return sum;
+}
+
+//! A subtitle made for another cut of the film - a scene more or less, a shot trimmed - is right,
+//! or off by one offset, until the first difference, then off by another. It is laid on the
+//! speech in parts: in blocks of this many lines, two at a time, ...
+constexpr size_t BLOCK = 30;
+//! ...each line against the speech heard this far around it, which says what any line there would
+//! cover by chance: a scene of talk agrees with any line laid in it
+constexpr double AROUND = 30;
+//! offsets of blocks this close are one: nearer than SAME, no run of lines tells them apart
+constexpr double CLOSE = SAME;
+//! changing offset between two lines must gain this much speech, in seconds
+constexpr double SWITCH = 4;
+//! a part of fewer lines than this takes a neighbour's offset
+constexpr size_t MIN_PART = 8;
+constexpr int STEPS = static_cast<int>(MAX_OFFSET / COARSE + 0.5);
+
+double OffsetOf(size_t i)
+{
+  return (static_cast<int>(i) - STEPS) * COARSE;
+}
+
+//! Everything heard laid on the film's time, less the speech heard within AROUND of each moment:
+//! what a line covers more than any line there would by chance, and how much of it was heard at
+//! all, are two lookups each.
+class CTimeline
+{
+public:
+  explicit CTimeline(const std::vector<Heard>& heard)
+  {
+    size_t frames = 0;
+    for (const Heard& h : heard)
+      frames = std::max(frames, First(h) + h.speech.size());
+    std::vector<double> speech(frames, 0);
+    m_heard.assign(frames, 0);
+    for (const Heard& h : heard)
+      for (size_t i = 0; i < h.speech.size(); ++i)
+      {
+        speech[First(h) + i] = h.speech[i];
+        m_heard[First(h) + i] = 1;
+      }
+    const std::vector<double> speechTotal = Totals(speech);
+    m_heardTotal = Totals(m_heard);
+    const size_t around = static_cast<size_t>(AROUND / SPEECH_FRAME);
+    m_excess.assign(frames, 0);
+    for (size_t i = 0; i < frames; ++i)
+    {
+      const size_t from = i > around ? i - around : 0;
+      const size_t to = std::min(frames, i + around + 1);
+      const double heardAround = m_heardTotal[to] - m_heardTotal[from];
+      if (m_heard[i] > 0 && heardAround > 0)
+        m_excess[i] = speech[i] - (speechTotal[to] - speechTotal[from]) / heardAround;
+    }
+    m_excessTotal = Totals(m_excess);
+  }
+
+  //! The speech under a line beyond what is usual around it, in seconds.
+  double Excess(double start, double stop) const
+  {
+    return (At(m_excessTotal, m_excess, stop) - At(m_excessTotal, m_excess, start)) * SPEECH_FRAME;
+  }
+  //! How much of a line was heard, in seconds.
+  double Listened(double start, double stop) const
+  {
+    return (Both(stop).second - Both(start).second) * SPEECH_FRAME;
+  }
+  //! A line at every offset: adds the speech it covers beyond the usual, and how much of it is
+  //! heard, both in seconds.
+  void Sweep(double start,
+             double stop,
+             std::vector<double>& excess,
+             std::vector<double>& heard) const
+  {
+    for (size_t i = 0; i < excess.size(); ++i)
+    {
+      const auto [excessFrom, heardFrom] = Both(start + OffsetOf(i));
+      const auto [excessTo, heardTo] = Both(stop + OffsetOf(i));
+      excess[i] += (excessTo - excessFrom) * SPEECH_FRAME;
+      heard[i] += (heardTo - heardFrom) * SPEECH_FRAME;
+    }
+  }
+
+private:
+  static size_t First(const Heard& h)
+  {
+    return static_cast<size_t>(std::lround(std::max(h.start, 0.0) / SPEECH_FRAME));
+  }
+  static std::vector<double> Totals(const std::vector<double>& frames)
+  {
+    std::vector<double> totals(frames.size() + 1, 0);
+    for (size_t i = 0; i < frames.size(); ++i)
+      totals[i + 1] = totals[i] + frames[i];
+    return totals;
+  }
+  std::pair<double, double> Both(double t) const
+  {
+    if (m_excess.empty())
+      return {0, 0};
+    const double f = std::clamp(t / SPEECH_FRAME, 0.0, static_cast<double>(m_excess.size()));
+    const size_t i = std::min(static_cast<size_t>(f), m_excess.size() - 1);
+    return {m_excessTotal[i] + (f - i) * m_excess[i], m_heardTotal[i] + (f - i) * m_heard[i]};
+  }
+  //! The total up to a time, between frames by the frame it falls in.
+  static double At(const std::vector<double>& totals, const std::vector<double>& frames, double t)
+  {
+    if (frames.empty())
+      return 0;
+    const double f = std::clamp(t / SPEECH_FRAME, 0.0, static_cast<double>(frames.size()));
+    const size_t i = std::min(static_cast<size_t>(f), frames.size() - 1);
+    return totals[i] + (f - i) * frames[i];
+  }
+
+  std::vector<double> m_excess;
+  std::vector<double> m_heard;
+  std::vector<double> m_excessTotal;
+  std::vector<double> m_heardTotal;
+};
+
+//! How clearly some lines ask for an offset: their agreement there against every offset's, and
+//! against the best agreement away from it.
+struct Support
+{
+  bool clear{false};
+  double z{-1};
+};
+
+//! A run of lines [first, last) laid at the candidate offset `at`.
+struct Run
+{
+  size_t first;
+  size_t last;
+  size_t at;
+};
+
+//! Some lines at every offset: how much more speech than usual they cover, and how much of them
+//! is heard at all. Offsets are compared only where the lines are heard about as well as anywhere,
+//! at least half as much as at best: lines nothing was heard of at their own offset would agree
+//! by chance wherever some speech was.
+struct Curve
+{
+  std::vector<double> agreement = std::vector<double>(2 * STEPS + 1, 0);
+  std::vector<double> heard = std::vector<double>(2 * STEPS + 1, 0);
+  double length{0};
+
+  void Add(const Curve& other)
+  {
+    for (size_t i = 0; i < agreement.size(); ++i)
+    {
+      agreement[i] += other.agreement[i];
+      heard[i] += other.heard[i];
+    }
+    length += other.length;
+  }
+  //! The least of the lines heard at an offset that is compared.
+  double Enough() const
+  {
+    const double most = *std::max_element(heard.begin(), heard.end());
+    return most > 0 ? most / 2 : std::numeric_limits<double>::infinity();
+  }
+
+  //! The offset the lines agree with most where they are heard, if anywhere.
+  std::optional<double> Best() const
+  {
+    const double enough = Enough();
+    std::optional<size_t> best;
+    for (size_t i = 0; i < agreement.size(); ++i)
+      if (heard[i] >= enough && (!best || agreement[i] > agreement[*best]))
+        best = i;
+    if (!best)
+      return {};
+    return OffsetOf(*best);
+  }
+
+  Support Supports(double offset) const
+  {
+    const double enough = Enough();
+    const int k = static_cast<int>(std::lround(offset / COARSE)) + STEPS;
+    if (k < 0 || k > 2 * STEPS || heard[k] < enough)
+      return {};
+    double peak = -std::numeric_limits<double>::infinity();
+    for (int i = std::max(k - 3, 0); i <= std::min(k + 3, 2 * STEPS); ++i)
+      if (heard[i] >= enough)
+        peak = std::max(peak, agreement[i]);
+    double sum = 0;
+    double squares = 0;
+    size_t count = 0;
+    double highest = -std::numeric_limits<double>::infinity();
+    double rival = -std::numeric_limits<double>::infinity();
+    for (size_t i = 0; i < agreement.size(); ++i)
+    {
+      if (heard[i] < enough)
+        continue;
+      sum += agreement[i];
+      squares += agreement[i] * agreement[i];
+      ++count;
+      highest = std::max(highest, agreement[i]);
+      if (std::abs(OffsetOf(i) - offset) > SAME)
+        rival = std::max(rival, agreement[i]);
+    }
+    const double mean = sum / count;
+    const double spread = std::sqrt(std::max(squares / count - mean * mean, 0.0));
+    Support support;
+    support.z = spread > 0 ? (peak - mean) / spread : 0;
+    support.clear = peak > 0 && peak >= highest && support.z >= MIN_Z &&
+                    (rival <= 0 || peak / rival >= MIN_RATIO);
+    return support;
+  }
+};
+
+//! The lines of the subtitle under one frame-rate ratio, laid on the speech heard.
+class CLayout
+{
+public:
+  //! Gives up laying the lines when stop is set.
+  CLayout(const CTimeline& timeline,
+          const std::vector<Cue>& cues,
+          double scale,
+          const std::atomic<bool>* stop)
+    : m_timeline(timeline), m_cues(cues), m_scale(scale)
+  {
+    const size_t blocks = (cues.size() + BLOCK - 1) / BLOCK;
+    m_blocks.resize(blocks);
+    for (size_t k = 0; k < blocks && !(stop && *stop); ++k)
+      Add(k * BLOCK, std::min(cues.size(), (k + 1) * BLOCK), m_blocks[k]);
+  }
+
+  //! The most the lines agree with the speech at one offset.
+  double Single() const
+  {
+    Curve all;
+    for (const Curve& block : m_blocks)
+      all.Add(block);
+    return *std::max_element(all.agreement.begin(), all.agreement.end());
+  }
+
+  //! The offsets each two blocks clearly ask for, and `also`, those close together taken as one.
+  std::vector<double> Candidates(std::optional<double> also) const
+  {
+    std::vector<double> asked;
+    if (also)
+      asked.push_back(*also);
+    Pairs([&](const Curve&, double offset) { asked.push_back(offset); });
+    std::sort(asked.begin(), asked.end());
+    std::vector<double> candidates;
+    for (size_t a = 0; a < asked.size();)
+    {
+      size_t b = a + 1;
+      while (b < asked.size() && asked[b] - asked[a] <= CLOSE)
+        ++b;
+      candidates.push_back(asked[a + (b - a) / 2]);
+      a = b;
+    }
+    return candidates;
+  }
+
+  //! Whether two blocks, heard where this offset puts them, clearly ask for another.
+  bool Elsewhere(double offset) const
+  {
+    bool elsewhere = false;
+    Pairs([&](const Curve& curve, double asked)
+          { elsewhere |= std::abs(asked - offset) > SAME && curve.heard[At(offset)] >= curve.Enough(); });
+    return elsewhere;
+  }
+
+  //! Each line at one of the candidates, a change between two lines costing SWITCH.
+  std::vector<Run> Lay(const std::vector<double>& candidates) const
+  {
+    const size_t k = candidates.size();
+    const size_t n = m_cues.size();
+    std::vector<double> score(k);
+    std::vector<double> next(k);
+    std::vector<uint8_t> switched(n * k, 0);
+    std::vector<size_t> from(n, 0);
+    for (size_t c = 0; c < k; ++c)
+      score[c] = Agreement(0, candidates[c]);
+    for (size_t i = 1; i < n; ++i)
+    {
+      const size_t best = std::max_element(score.begin(), score.end()) - score.begin();
+      from[i] = best;
+      for (size_t c = 0; c < k; ++c)
+      {
+        const double change = score[best] - SWITCH;
+        switched[i * k + c] = change > score[c];
+        next[c] = std::max(score[c], change) + Agreement(i, candidates[c]);
+      }
+      std::swap(score, next);
+    }
+    std::vector<size_t> choice(n);
+    size_t c = std::max_element(score.begin(), score.end()) - score.begin();
+    for (size_t i = n; i-- > 0;)
+    {
+      choice[i] = c;
+      if (i > 0 && switched[i * k + c])
+        c = from[i];
+    }
+    std::vector<Run> runs;
+    for (size_t i = 0; i < n; ++i)
+      if (!runs.empty() && runs.back().at == choice[i])
+        runs.back().last = i + 1;
+      else
+        runs.push_back({i, i + 1, choice[i]});
+    return runs;
+  }
+
+  //! How clearly lines [first, last) alone ask for an offset.
+  Support Supports(size_t first, size_t last, double offset) const
+  {
+    return CurveOf(first, last).Supports(offset);
+  }
+
+  //! Lines [first, last) at every offset, from whole blocks where it can.
+  Curve CurveOf(size_t first, size_t last) const
+  {
+    Curve curve;
+    for (size_t i = first; i < last;)
+    {
+      const size_t end = std::min(m_cues.size(), i + BLOCK);
+      if (i % BLOCK == 0 && end <= last)
+      {
+        curve.Add(m_blocks[i / BLOCK]);
+        i = end;
+      }
+      else
+      {
+        Add(i, i + 1, curve);
+        ++i;
+      }
+    }
+    return curve;
+  }
+
+  //! How much more speech lines [first, last) cover at an offset than lines there would by chance.
+  double Agreement(size_t first, size_t last, double offset) const
+  {
+    double sum = 0;
+    for (size_t i = first; i < last; ++i)
+      sum += Agreement(i, offset);
+    return sum;
+  }
+
+  //! How much of lines [first, last) is heard at an offset, in seconds.
+  double Heard(size_t first, size_t last, double offset) const
+  {
+    double heard = 0;
+    for (size_t i = first; i < last; ++i)
+      heard += m_timeline.Listened(m_scale * m_cues[i].start + offset,
+                                   m_scale * m_cues[i].stop + offset);
+    return heard;
+  }
+
+  //! Whether lines [first, last), heard at this offset, agree with another at least twice as much:
+  //! a part that takes them is laid over lines it does not fit.
+  bool Contradicts(size_t first, size_t last, double offset) const
+  {
+    const Curve curve = CurveOf(first, last);
+    const auto best = curve.Best();
+    if (!best || std::abs(*best - offset) <= SAME || curve.heard[At(offset)] < curve.Enough())
+      return false;
+    return curve.agreement[At(offset)] < curve.agreement[At(*best)] / 2;
+  }
+
+  size_t Lines() const { return m_cues.size(); }
+  double Start(size_t line) const { return m_cues[line].start; }
+  double Scale() const { return m_scale; }
+
+private:
+  static size_t At(double offset)
+  {
+    return static_cast<size_t>(std::clamp(std::lround(offset / COARSE) + STEPS, 0L, 2L * STEPS));
+  }
+
+  //! Each two blocks in turn, with the offset they clearly ask for when they do.
+  template<typename F>
+  void Pairs(F asks) const
+  {
+    for (size_t k = 0; k < m_blocks.size(); ++k)
+    {
+      if (k + 1 == m_blocks.size() && k > 0)
+        break;
+      if (std::min(m_cues.size(), (k + 2) * BLOCK) - k * BLOCK < BLOCK)
+        continue;
+      Curve curve = m_blocks[k];
+      if (k + 1 < m_blocks.size())
+        curve.Add(m_blocks[k + 1]);
+      if (const auto offset = curve.Best(); offset && curve.Supports(*offset).clear)
+        asks(curve, *offset);
+    }
+  }
+
+  double Agreement(size_t line, double offset) const
+  {
+    return m_timeline.Excess(m_scale * m_cues[line].start + offset,
+                             m_scale * m_cues[line].stop + offset);
+  }
+
+  void Add(size_t first, size_t last, Curve& curve) const
+  {
+    for (size_t line = first; line < last; ++line)
+    {
+      const double start = m_scale * m_cues[line].start;
+      const double stop = m_scale * m_cues[line].stop;
+      curve.length += stop - start;
+      m_timeline.Sweep(start, stop, curve.agreement, curve.heard);
+    }
+  }
+
+  const CTimeline& m_timeline;
+  const std::vector<Cue>& m_cues;
+  double m_scale;
+  std::vector<Curve> m_blocks;
+};
+
+//! Neighbouring runs at one offset made one.
+std::vector<Run> Merged(const std::vector<Run>& runs)
+{
+  std::vector<Run> merged;
+  for (const Run& run : runs)
+    if (!merged.empty() && merged.back().at == run.at)
+      merged.back().last = run.last;
+    else
+      merged.push_back(run);
+  return merged;
+}
+
+//! Runs of fewer than MIN_PART lines take a neighbour's offset, whichever they agree with more.
+std::vector<Run> MergeShort(const CLayout& layout,
+                            const std::vector<double>& candidates,
+                            std::vector<Run> runs)
+{
+  for (size_t i = 0; i < runs.size() && runs.size() > 1;)
+  {
+    if (runs[i].last - runs[i].first >= MIN_PART)
+    {
+      ++i;
+      continue;
+    }
+    double best = -std::numeric_limits<double>::infinity();
+    for (const size_t side : {i - 1, i + 1})
+      if (side < runs.size())
+        if (const double a =
+                layout.Agreement(runs[i].first, runs[i].last, candidates[runs[side].at]);
+            a > best)
+        {
+          best = a;
+          runs[i].at = runs[side].at;
+        }
+    runs = Merged(runs);
+    i = 0;
+  }
+  return runs;
+}
+
+//! A run differs from a neighbour only where its lines are heard at the neighbour's offset too:
+//! nothing says they are not there. And a run unsure on its own goes with the neighbour it agrees
+//! with more.
+std::vector<Run> Settle(const CLayout& layout,
+                        const std::vector<double>& candidates,
+                        std::vector<Run> runs)
+{
+  for (size_t i = 0; i < runs.size() && runs.size() > 1;)
+  {
+    const bool first = i == 0;
+    const bool last = i + 1 == runs.size();
+    const double own = layout.Heard(runs[i].first, runs[i].last, candidates[runs[i].at]);
+    std::optional<size_t> unheard;
+    for (const size_t side : {i - 1, i + 1})
+      if (side < runs.size() && !unheard &&
+          layout.Heard(runs[i].first, runs[i].last, candidates[runs[side].at]) < own / 2)
+        unheard = runs[side].at;
+    if (unheard)
+    {
+      runs[i].at = *unheard;
+      runs = Merged(runs);
+      i = 0;
+      continue;
+    }
+    if (layout.Supports(runs[i].first, runs[i].last, candidates[runs[i].at]).clear)
+    {
+      ++i;
+      continue;
+    }
+    // to the neighbour it agrees with more
+    if (first || last)
+      runs[i].at = first ? runs[i + 1].at : runs[i - 1].at;
+    else
+      runs[i].at =
+          layout.Agreement(runs[i].first, runs[i].last, candidates[runs[i - 1].at]) >=
+                  layout.Agreement(runs[i].first, runs[i].last, candidates[runs[i + 1].at])
+              ? runs[i - 1].at
+              : runs[i + 1].at;
+    runs = Merged(runs);
+    i = 0;
+  }
+  return runs;
+}
+
+//! The subtitle laid on the speech in parts, each clearly asked for by some run of its lines.
+struct Parts
+{
+  double scale{1};
+  std::vector<std::pair<double, double>> parts;
+  double agreement{0};
+};
+
+//! `also`: the offset the whole subtitle clearly asks for under this ratio, if any; gives up when
+//! stop is set.
+std::optional<Parts> LayInParts(const CLayout& layout,
+                                std::optional<double> also,
+                                const std::atomic<bool>* stop)
+{
+  std::vector<double> candidates = layout.Candidates(also);
+  while (candidates.size() > 1 && !(stop && *stop))
+  {
+    std::vector<Run> runs = MergeShort(layout, candidates, layout.Lay(candidates));
+    std::vector<Support> support(candidates.size());
+    for (const Run& run : runs)
+    {
+      const Support s = layout.Supports(run.first, run.last, candidates[run.at]);
+      if (s.clear > support[run.at].clear ||
+          (s.clear == support[run.at].clear && s.z > support[run.at].z))
+        support[run.at] = s;
+    }
+    // the least supported candidate goes, and the lines are laid again
+    size_t worst = candidates.size();
+    for (size_t c = 0; c < candidates.size(); ++c)
+      if (!support[c].clear && (worst == candidates.size() || support[c].z < support[worst].z))
+        worst = c;
+    if (worst < candidates.size())
+    {
+      candidates.erase(candidates.begin() + worst);
+      continue;
+    }
+    runs = Settle(layout, candidates, std::move(runs));
+    if (runs.size() < 2)
+      return {};
+    Parts parts;
+    parts.scale = layout.Scale();
+    std::vector<double> offsets(layout.Lines());
+    std::vector<double> coarse(layout.Lines());
+    for (const Run& run : runs)
+    {
+      const double candidate = candidates[run.at];
+      // finely around the candidate
+      double offset = candidate;
+      double peak = -std::numeric_limits<double>::infinity();
+      for (double o = candidate - 3 * COARSE; o <= candidate + 3 * COARSE + FINE / 2; o += FINE)
+        if (const double a = layout.Agreement(run.first, run.last, o); a > peak)
+        {
+          peak = a;
+          offset = o;
+        }
+      if (parts.scale == 1 && std::abs(offset) < LEAVE)
+        offset = 0;
+      std::fill(offsets.begin() + run.first, offsets.begin() + run.last, offset);
+      std::fill(coarse.begin() + run.first, coarse.begin() + run.last, candidate);
+      // its lines a block at a time, the last short one with the one before: those that do not fit
+      // it stay as they are - a cut re-edited in more places than its parts tell; under another
+      // frame rate, as they are is no part at all
+      for (size_t first = run.first; first < run.last;)
+      {
+        size_t last = std::min(run.last, first + BLOCK);
+        if (run.last - last < BLOCK / 2)
+          last = run.last;
+        if (offset != 0 && layout.Contradicts(first, last, offset))
+        {
+          if (parts.scale != 1)
+            return {};
+          std::fill(offsets.begin() + first, offsets.begin() + last, 0.0);
+          std::fill(coarse.begin() + first, coarse.begin() + last, 0.0);
+        }
+        first = last;
+      }
+    }
+    if (stop && *stop)
+      return {};
+    for (size_t i = 0; i < offsets.size(); ++i)
+    {
+      parts.agreement += layout.Agreement(i, i + 1, coarse[i]);
+      if (parts.parts.empty() || offsets[i] != parts.parts.back().second)
+        parts.parts.emplace_back(layout.Start(i), offsets[i]);
+    }
+    if (parts.parts.size() < 2)
+      return {};
+    parts.agreement -= SWITCH * (parts.parts.size() - 1);
+    return parts;
+  }
+  return {};
+}
+} // namespace
+
+std::optional<SpeechFit> FitToSpeech(const std::vector<Cue>& unsorted,
+                                     const std::vector<Heard>& heard,
+                                     const std::atomic<bool>* stop)
+{
+  const auto stopped = [stop] { return stop && *stop; };
+  std::vector<Cue> cues;
+  double longest = 0;
+  for (const Cue& cue : unsorted)
+    if (cue.stop > cue.start)
+    {
+      cues.push_back(cue);
+      longest = std::max(longest, cue.stop - cue.start);
+    }
+  std::sort(cues.begin(), cues.end(), [](const Cue& a, const Cue& b) { return a.start < b.start; });
+  double sum = 0;
+  size_t frames = 0;
+  for (const Heard& h : heard)
+  {
+    for (const float p : h.speech)
+      sum += static_cast<double>(p);
+    frames += h.speech.size();
+  }
+  if (cues.size() < MIN_LINES || frames == 0)
+    return {};
+  std::vector<CRunning> running;
+  for (const Heard& h : heard)
+    if (!h.speech.empty())
+      running.emplace_back(h, sum / frames);
+
+  // every offset under every frame-rate ratio, coarsely
+  struct Curve
+  {
+    double scale;
+    std::vector<double> agreement;
+  };
+  std::vector<Curve> curves;
+  for (const double scale : Scales())
+  {
+    if (stopped())
+      return {};
+    Curve curve{scale, {}};
+    curve.agreement.reserve(2 * STEPS + 1);
+    for (int i = -STEPS; i <= STEPS; ++i)
+      curve.agreement.push_back(Agreement(cues, longest, running, scale, i * COARSE));
+    curves.push_back(std::move(curve));
+  }
+  const Curve* best = nullptr;
+  size_t at = 0;
+  for (const Curve& curve : curves)
+  {
+    const size_t i =
+        std::max_element(curve.agreement.begin(), curve.agreement.end()) - curve.agreement.begin();
+    if (!best || curve.agreement[i] > best->agreement[at])
+    {
+      best = &curve;
+      at = i;
+    }
+  }
+  const double coarse = (static_cast<int>(at) - STEPS) * COARSE;
+
+  // then finely around it
+  double offset = coarse;
+  double peak = best->agreement[at];
+  for (double o = coarse - COARSE; o <= coarse + COARSE + FINE / 2; o += FINE)
+    if (const double a = Agreement(cues, longest, running, best->scale, o); a > peak)
+    {
+      peak = a;
+      offset = o;
+    }
+
+  // the best of every other change: a twin ratio is the same change only where it puts the lines
+  // where the best one does, which over a few scenes of lines it may not
+  const double first = cues.front().start;
+  double last = first;
+  for (const Cue& cue : cues)
+    last = std::max(last, cue.stop);
+  double rival = -std::numeric_limits<double>::infinity();
+  for (const Curve& curve : curves)
+  {
+    const double drift = best->scale - curve.scale;
+    const bool twin = std::abs(curve.scale / best->scale - 1) < TWIN;
+    for (size_t i = 0; i < curve.agreement.size(); ++i)
+    {
+      const double o = (static_cast<int>(i) - STEPS) * COARSE;
+      const bool same = twin && std::abs(drift * first + offset - o) <= SAME &&
+                        std::abs(drift * last + offset - o) <= SAME;
+      if (!same)
+        rival = std::max(rival, curve.agreement[i]);
+    }
+  }
+  double mean = 0;
+  for (const double a : best->agreement)
+    mean += a;
+  mean /= best->agreement.size();
+  double spread = 0;
+  for (const double a : best->agreement)
+    spread += (a - mean) * (a - mean);
+  spread = std::sqrt(spread / best->agreement.size());
+
+  SpeechFit result;
+  // nothing else agrees at all: as clear as can be
+  result.ratio = rival > 0 ? peak / rival : std::numeric_limits<double>::infinity();
+  result.z = spread > 0 ? (peak - mean) / spread : 0;
+
+  // a subtitle for another cut: under the best ratio, or under none when that is a near twin of
+  // it, since a few steps a few seconds apart look like a slow drift; taken only when it agrees
+  // better than any one offset
+  const CTimeline timeline(heard);
+  std::optional<Parts> parts;
+  double single = -std::numeric_limits<double>::infinity();
+  bool elsewhere = false;
+  const bool sure = peak > 0 && result.ratio >= MIN_RATIO && result.z >= MIN_Z;
+  for (const double scale : Scales())
+  {
+    if (scale != best->scale && (scale != 1 || std::abs(scale / best->scale - 1) >= TWIN))
+      continue;
+    const CLayout layout(timeline, cues, scale, stop);
+    if (stopped())
+      return {};
+    single = std::max(single, layout.Single());
+    const auto also = sure && scale == best->scale ? std::optional<double>(offset) : std::nullopt;
+    auto laid = LayInParts(layout, also, stop);
+    // steps under no change at all can follow a sure drift: each costs a change more there
+    if (laid && sure && scale != best->scale)
+      laid->agreement -= SWITCH * laid->parts.size();
+    if (laid && (!parts || laid->agreement > parts->agreement))
+      parts = std::move(laid);
+    // lines somewhere, heard where the one change puts them, clearly asking for another offset
+    if (scale == best->scale)
+      elsewhere = layout.Elsewhere(offset);
+  }
+  if (parts && parts->agreement > single)
+  {
+    result.fit.scale = parts->scale;
+    result.fit.offset = parts->parts.front().second;
+    result.fit.parts = std::move(parts->parts);
+    return result;
+  }
+
+  // nor one change that some run of lines clearly says is wrong for it: a cut not yet heard enough
+  // to be laid in parts
+  if (!sure || elsewhere)
+    return {};
+  result.fit.scale = best->scale;
+  // lines are shown a little before their speech: a smaller change is none
+  result.fit.offset = best->scale == 1 && std::abs(offset) < LEAVE ? 0 : offset;
+  return result;
+}
+
+namespace
+{
+constexpr int BINS = 129;
+constexpr int WINDOW = 256;
+constexpr int HOP = 128;
+//! the encoder: input channels, output channels, stride; every kernel is three wide
+constexpr int LAYERS[4][3] = {{BINS, 128, 1}, {128, 64, 2}, {64, 64, 2}, {64, 128, 1}};
+
+//! y (out, frames) = ReLU(conv1d(x (in, frames), padding 1, stride))
+int Convolve(const float* x,
+             int in,
+             int frames,
+             const float* w,
+             const float* b,
+             int out,
+             int stride,
+             float* y)
+{
+  const int produced = (frames - 1) / stride + 1;
+  for (int o = 0; o < out; ++o)
+    for (int t = 0; t < produced; ++t)
+    {
+      float sum = b[o];
+      for (int k = 0; k < 3; ++k)
+      {
+        const int at = t * stride + k - 1;
+        if (at < 0 || at >= frames)
+          continue;
+        const float* wk = w + o * in * 3 + k;
+        for (int c = 0; c < in; ++c)
+          sum += wk[c * 3] * x[c * frames + at];
+      }
+      y[o * produced + t] = std::max(sum, 0.0f);
+    }
+  return produced;
+}
+
+float Sigmoid(float v)
+{
+  return 1.0f / (1.0f + std::exp(-v));
+}
+} // namespace
+
+size_t CSpeechDetector::WeightCount()
+{
+  size_t count = 2 * BINS * WINDOW;
+  for (const auto& layer : LAYERS)
+    count += layer[0] * layer[1] * 3 + layer[1];
+  return count + 2 * 4 * HIDDEN * HIDDEN + 2 * 4 * HIDDEN + HIDDEN + 1;
+}
+
+bool CSpeechDetector::Load(std::vector<float> weights)
+{
+  if (weights.size() != WeightCount())
+    return false;
+  m_weights = std::move(weights);
+  const float* p = m_weights.data();
+  const auto take = [&p](size_t count)
+  {
+    const float* at = p;
+    p += count;
+    return at;
+  };
+  m_basis = take(2 * BINS * WINDOW);
+  for (int i = 0; i < 4; ++i)
+  {
+    m_conv[i][0] = take(LAYERS[i][0] * LAYERS[i][1] * 3);
+    m_conv[i][1] = take(LAYERS[i][1]);
+  }
+  m_inputWeights = take(4 * HIDDEN * HIDDEN);
+  m_hiddenWeights = take(4 * HIDDEN * HIDDEN);
+  m_inputBias = take(4 * HIDDEN);
+  m_hiddenBias = take(4 * HIDDEN);
+  m_outWeights = take(HIDDEN);
+  m_outBias = *take(1);
+  Reset();
+  return true;
+}
+
+void CSpeechDetector::Reset()
+{
+  m_context.fill(0);
+  m_h.fill(0);
+  m_c.fill(0);
+}
+
+float CSpeechDetector::Process(const float* chunk)
+{
+  // the end of the chunk before, the chunk, and the chunk's end mirrored
+  constexpr int LENGTH = CONTEXT + SPEECH_CHUNK + CONTEXT;
+  float x[LENGTH];
+  std::copy(m_context.begin(), m_context.end(), x);
+  std::copy(chunk, chunk + SPEECH_CHUNK, x + CONTEXT);
+  for (int i = 0; i < CONTEXT; ++i)
+    x[CONTEXT + SPEECH_CHUNK + i] = x[CONTEXT + SPEECH_CHUNK - 2 - i];
+  std::copy(chunk + SPEECH_CHUNK - CONTEXT, chunk + SPEECH_CHUNK, m_context.begin());
+
+  // the spectrum's magnitude, by the basis' cosine and sine rows
+  constexpr int FRAMES = (LENGTH - WINDOW) / HOP + 1;
+  float magnitude[BINS * FRAMES];
+  for (int bin = 0; bin < BINS; ++bin)
+    for (int f = 0; f < FRAMES; ++f)
+    {
+      const float* frame = x + f * HOP;
+      const float* re = m_basis + bin * WINDOW;
+      const float* im = m_basis + (BINS + bin) * WINDOW;
+      float r = 0;
+      float i = 0;
+      for (int n = 0; n < WINDOW; ++n)
+      {
+        r += re[n] * frame[n];
+        i += im[n] * frame[n];
+      }
+      magnitude[bin * FRAMES + f] = std::sqrt(r * r + i * i);
+    }
+  float a[128 * FRAMES];
+  float b[128 * FRAMES];
+  const float* in = magnitude;
+  float* out = a;
+  int frames = FRAMES;
+  for (int i = 0; i < 4; ++i)
+  {
+    frames = Convolve(in, LAYERS[i][0], frames, m_conv[i][0], m_conv[i][1], LAYERS[i][1],
+                      LAYERS[i][2], out);
+    in = out;
+    out = out == a ? b : a;
+  }
+
+  // one step of the recurrent cell on the encoder's one frame: gates input, forget, cell, output
+  float gates[4 * HIDDEN];
+  for (int g = 0; g < 4 * HIDDEN; ++g)
+  {
+    float sum = m_inputBias[g] + m_hiddenBias[g];
+    const float* wi = m_inputWeights + g * HIDDEN;
+    const float* wh = m_hiddenWeights + g * HIDDEN;
+    for (int k = 0; k < HIDDEN; ++k)
+      sum += wi[k] * in[k] + wh[k] * m_h[k];
+    gates[g] = sum;
+  }
+  float speech = m_outBias;
+  for (int k = 0; k < HIDDEN; ++k)
+  {
+    m_c[k] =
+        Sigmoid(gates[HIDDEN + k]) * m_c[k] + Sigmoid(gates[k]) * std::tanh(gates[2 * HIDDEN + k]);
+    m_h[k] = Sigmoid(gates[3 * HIDDEN + k]) * std::tanh(m_c[k]);
+    speech += m_outWeights[k] * std::max(m_h[k], 0.0f);
+  }
+  return Sigmoid(speech);
+}
+} // namespace KODI::SUBTITLES::TIMING
