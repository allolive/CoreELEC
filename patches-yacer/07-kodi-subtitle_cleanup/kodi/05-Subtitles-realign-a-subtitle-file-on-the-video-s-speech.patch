+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "SubtitleListener.h"
+
+#include "cores/VideoPlayer/DVDDemuxers/DVDDemux.h"
+#include "cores/VideoPlayer/DVDStreamInfo.h"
+#include "cores/VideoPlayer/Interface/DemuxPacket.h"
+#include "cores/VideoPlayer/Interface/TimingConstants.h"
+
+#include <cstring>
+#include <utility>
+
+extern "C"
+{
+#include <libavcodec/avcodec.h>
+#include <libavutil/channel_layout.h>
+#include <libavutil/dict.h>
+#include <libswresample/swresample.h>
+}
+
+namespace KODI::SUBTITLES::TIMING
+{
+CListener::CListener(CSpeechDetector& detector) : m_detector(detector)
+{
+}
+
+CListener::~CListener()
+{
+  swr_free(&m_resample);
+  av_frame_free(&m_frame);
+  avcodec_free_context(&m_codec);
+  av_packet_free(&m_packet);
+}
+
+bool CListener::Open(const CDemuxStreamAudio& stream)
+{
+  const CDVDStreamInfo hints(stream);
+  const AVCodec* codec = avcodec_find_decoder(hints.codec);
+  if (!codec)
+    return false;
+  m_codec = avcodec_alloc_context3(codec);
+  m_frame = av_frame_alloc();
+  m_packet = av_packet_alloc();
+  if (!m_codec || !m_frame || !m_packet)
+    return false;
+  if (hints.channels > 0 && hints.channellayout > 0)
+    av_channel_layout_from_mask(&m_codec->ch_layout, hints.channellayout);
+  else if (hints.channels > 0)
+    av_channel_layout_default(&m_codec->ch_layout, hints.channels);
+  m_codec->sample_rate = hints.samplerate;
+  m_codec->block_align = hints.blockalign;
+  m_codec->bit_rate = hints.bitrate;
+  m_codec->bits_per_coded_sample = hints.bitspersample ? hints.bitspersample : 16;
+  m_codec->pkt_timebase = AVRational{1, static_cast<int>(DVD_TIME_BASE)};
+  if (hints.extradata)
+  {
+    m_codec->extradata =
+        static_cast<uint8_t*>(av_mallocz(hints.extradata.GetSize() + AV_INPUT_BUFFER_PADDING_SIZE));
+    if (m_codec->extradata)
+    {
+      m_codec->extradata_size = hints.extradata.GetSize();
+      std::memcpy(m_codec->extradata, hints.extradata.GetData(), hints.extradata.GetSize());
+    }
+  }
+  // a DTS-HD stream's lossless extension adds nothing a voice detector hears
+  AVDictionary* options = nullptr;
+  if (hints.codec == AV_CODEC_ID_DTS)
+    av_dict_set(&options, "core_only", "1", 0);
+  const bool opened = avcodec_open2(m_codec, codec, &options) >= 0;
+  av_dict_free(&options);
+  return opened;
+}
+
+void CListener::Begin()
+{
+  avcodec_flush_buffers(m_codec);
+  swr_free(&m_resample);
+  m_detector.Reset();
+  m_heard = {};
+  m_started = false;
+  m_pending.clear();
+}
+
+void CListener::Hear(const DemuxPacket& packet)
+{
+  m_packet->data = packet.pData;
+  m_packet->size = packet.iSize;
+  m_packet->pts = packet.pts == DVD_NOPTS_VALUE ? AV_NOPTS_VALUE : static_cast<int64_t>(packet.pts);
+  if (avcodec_send_packet(m_codec, m_packet) >= 0)
+    while (avcodec_receive_frame(m_codec, m_frame) >= 0)
+    {
+      Take(*m_frame);
+      av_frame_unref(m_frame);
+    }
+  m_packet->data = nullptr;
+  m_packet->size = 0;
+}
+
+void CListener::Take(const AVFrame& frame)
+{
+  if (!m_started)
+  {
+    if (frame.best_effort_timestamp == AV_NOPTS_VALUE)
+      return;
+    m_heard.start = static_cast<double>(frame.best_effort_timestamp) / DVD_TIME_BASE;
+    m_started = true;
+  }
+  if (!m_resample)
+  {
+    // the dialogue's channel when the mix has one, else every channel alike
+    const int channels = frame.ch_layout.nb_channels;
+    const int centre = av_channel_layout_index_from_channel(&frame.ch_layout, AV_CHAN_FRONT_CENTER);
+    std::vector<double> matrix(channels, centre >= 0 ? 0.0 : 1.0 / channels);
+    if (centre >= 0)
+      matrix[centre] = 1;
+    AVChannelLayout mono = AV_CHANNEL_LAYOUT_MONO;
+    if (swr_alloc_set_opts2(&m_resample, &mono, AV_SAMPLE_FMT_FLT, SPEECH_RATE, &frame.ch_layout,
+                            static_cast<AVSampleFormat>(frame.format), frame.sample_rate, 0,
+                            nullptr) < 0 ||
+        swr_set_matrix(m_resample, matrix.data(), channels) < 0 || swr_init(m_resample) < 0)
+    {
+      swr_free(&m_resample);
+      return;
+    }
+  }
+  const int room = swr_get_out_samples(m_resample, frame.nb_samples);
+  if (room <= 0)
+    return;
+  const size_t had = m_pending.size();
+  m_pending.resize(had + room);
+  uint8_t* out = reinterpret_cast<uint8_t*>(m_pending.data() + had);
+  const int got = swr_convert(m_resample, &out, room,
+                              const_cast<const uint8_t**>(frame.extended_data), frame.nb_samples);
+  m_pending.resize(had + std::max(got, 0));
+  size_t used = 0;
+  for (; used + SPEECH_CHUNK <= m_pending.size(); used += SPEECH_CHUNK)
+    m_heard.speech.push_back(m_detector.Process(m_pending.data() + used));
+  m_pending.erase(m_pending.begin(), m_pending.begin() + used);
+}
+
+Heard CListener::End()
+{
+  return std::exchange(m_heard, {});
+}
+} // namespace KODI::SUBTITLES::TIMING
