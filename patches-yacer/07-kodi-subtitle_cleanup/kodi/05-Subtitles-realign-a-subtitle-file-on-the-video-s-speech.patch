-double CCueStage::Moved(double time) const
+void CCueStage::Listen()
+{
+  TIMING::CSpeechDetector detector;
+  if (!LoadDetector(detector))
+    return;
+  const auto demux = OpenVideo();
+  if (!demux)
+    return;
+
+  // the stream playback starts with
+  const CDemuxStreamAudio* audio = nullptr;
+  for (const CDemuxStream* stream : demux->GetStreams())
+    if (stream && stream->type == StreamType::AUDIO &&
+        (!audio || ((stream->flags & StreamFlags::FLAG_DEFAULT) &&
+                    !(audio->flags & StreamFlags::FLAG_DEFAULT))))
+      audio = static_cast<const CDemuxStreamAudio*>(stream);
+  TIMING::CListener listener(detector);
+  const double length = demux->GetStreamLength() / 1000.0;
+  if (!audio || length < 10 * STRETCH || !listener.Open(*audio))
+    return;
+  const int64_t demuxerId = audio->demuxerId;
+  const int id = audio->uniqueId;
+
+  const size_t stretches = static_cast<size_t>(length / STRETCH);
+  std::vector<bool> read(stretches, false);
+  std::vector<TIMING::Heard> heard;
+  double bytes = 0;
+  const auto hear = [&](size_t stretch)
+  {
+    // a stretch that cannot be reached is not tried again
+    read[stretch] = true;
+    const double start = stretch * STRETCH;
+    if (!demux->SeekTime(start * 1000, true))
+      return;
+    listener.Begin();
+    double taken = 0;
+    const auto began = std::chrono::steady_clock::now();
+    const auto elapsed = [began]
+    { return std::chrono::duration<double>(std::chrono::steady_clock::now() - began).count(); };
+    while (!m_abort)
+    {
+      DemuxPacket* packet = demux->Read();
+      if (!packet)
+        break;
+      bytes += packet->iSize;
+      taken += packet->iSize;
+      const double pts = packet->pts == DVD_NOPTS_VALUE ? -1 : Seconds(packet->pts);
+      if (packet->demuxerId == demuxerId && packet->iStreamId == id)
+        listener.Hear(*packet);
+      CDVDDemuxUtils::FreeDemuxPacket(packet);
+      if (pts > start + STRETCH)
+        break;
+      // playback reads the same file: leave it the room
+      while (!m_abort && taken > MAX_RATE * elapsed())
+        std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    }
+    if (TIMING::Heard h = listener.End(); !h.speech.empty())
+      heard.push_back(std::move(h));
+  };
+  // what the speech asks for, shown when it changes a line still to come; a change it no longer
+  // asks for is taken back
+  std::optional<TIMING::Fit> found;
+  std::optional<TIMING::Fit> shown;
+  size_t unsure = 0;
+  const auto judge = [&]
+  {
+    const auto fit = TIMING::FitToSpeech(m_starts, heard, &m_abort);
+    if (m_abort)
+      return;
+    // a change shown is taken back only when the speech twice running no longer tells
+    if (!fit && shown && ++unsure < 2)
+      return;
+    unsure = 0;
+    found = fit ? std::optional<TIMING::Fit>(fit->fit) : std::nullopt;
+    if (!Changes(shown, found.value_or(TIMING::Fit{})))
+      return;
+    shown = found;
+    std::string how = StringUtils::Format("the video's speech, {} minutes of it", heard.size());
+    if (!fit)
+      how += ", which no longer tells";
+    else if (fit->fit.parts.empty())
+      how += StringUtils::Format(", {:.2f} times the agreement of any other change", fit->ratio);
+    else
+      how += StringUtils::Format(", in {} parts for another cut", fit->fit.parts.size());
+    Show(shown, how);
+  };
+
+  // across the film until the speech is clear; a subtitle for another cut is heard further
+  const std::vector<size_t> order = SpreadOrder(stretches);
+  size_t verdict = FIRST_STRETCHES;
+  for (size_t i = 0; i < order.size() && !m_abort && bytes < MAX_BYTES; ++i)
+  {
+    hear(order[i]);
+    if (heard.size() >= verdict || i + 1 == order.size() || bytes >= MAX_BYTES)
+    {
+      verdict *= 2;
+      judge();
+      if (found && found->parts.empty())
+        break;
+    }
+  }
+  // then, for a subtitle for another cut or one the speech is not yet clear about, just ahead of
+  // playback until the film is heard whole: where the cuts differ, the lines after it are laid on
+  // what is heard there before they show
+  size_t fresh = 0;
+  bool kept = false;
+  while (!m_abort && (!found || !found->parts.empty()) &&
+         std::find(read.begin(), read.end(), false) != read.end())
+  {
+    const double now = std::max(AI::PlaybackTime() / DVD_TIME_BASE, 0.0);
+    const size_t first = std::min(stretches, static_cast<size_t>(now / STRETCH));
+    const size_t last = std::min(stretches, static_cast<size_t>((now + AHEAD) / STRETCH) + 1);
+    // all the rest of the film heard: what it asks for is kept, and what was skipped heard if
+    // playback goes back to it
+    if (!kept && std::find(read.begin() + first, read.end(), false) == read.end())
+    {
+      Keep(found);
+      kept = true;
+    }
+    if (const auto next = std::find(read.begin() + first, read.begin() + last, false);
+        next != read.begin() + last)
+    {
+      hear(next - read.begin());
+      if (++fresh >= REFIT || std::find(read.begin(), read.end(), false) == read.end())
+      {
+        fresh = 0;
+        judge();
+      }
+    }
+    else
+      std::this_thread::sleep_for(std::chrono::milliseconds(200));
+  }
+  CLog::Log(LOGDEBUG, "Subtitle timing: {} minutes of the video's speech heard", heard.size());
+  // what the whole film asks for is kept; a film left before the end is heard again next time
+  if (!m_abort)
+    Keep(found);
+}
+
+bool CCueStage::Changes(const std::optional<TIMING::Fit>& shown, const TIMING::Fit& fit) const
+{
+  if (!shown && !fit.Moves())
+    return false;
+  // a line still to come moves by more than the refinement of a change heard further
+  const double now = AI::PlaybackTime() / DVD_TIME_BASE;
+  for (const TIMING::Cue& cue : m_starts)
+  {
+    const double moved = TIMING::Apply(fit, cue.start);
+    const double before = shown ? TIMING::Apply(*shown, cue.start) : cue.start;
+    if (std::max(moved, before) >= now && std::abs(moved - before) > CHANGE)
+      return true;
+  }
+  return false;
+}
+
+double CCueStage::Moved(double time, double start) const
 {
-  return DVD_SEC_TO_TIME(TIMING::Apply(*m_fit, Seconds(time)));
+  return DVD_SEC_TO_TIME(TIMING::Apply(*m_fit, Seconds(time), Seconds(start)));
 }
 
