+ * parts: the offset changes where the cuts differ, when runs of lines on each side clearly ask
+ * for their own.
+ */
+namespace KODI::SUBTITLES::TIMING
+{
+//! What the detector reads at a time, in samples at its rate, and so how long a reading lasts.
+constexpr int SPEECH_RATE = 16000;
+constexpr int SPEECH_CHUNK = 512;
+constexpr double SPEECH_FRAME = static_cast<double>(SPEECH_CHUNK) / SPEECH_RATE;
+
+//! A stretch of the video listened to: where it starts, and the chance of speech in each frame.
+struct Heard
+{
+  double start{0};
+  std::vector<float> speech;
+};
+
+//! The change the speech clearly asks for - none, when it finds the times right - and how sure:
+//! the best one offset's agreement against the best other change's, and how far it stands above
+//! every offset's.
+struct SpeechFit
+{
+  Fit fit;
+  double ratio{0};
+  double z{0};
+};
+
+/*!
+ * \brief The change that lays the subtitle's lines on the speech heard, when the speech is clear
+ * about it; nothing when it is not. A subtitle made for another cut of the film is laid in parts,
+ * each at its own offset, when runs of its lines clearly ask for each.
+ */
+std::optional<SpeechFit> FitToSpeech(const std::vector<Cue>& cues,
+                                     const std::vector<Heard>& heard,
+                                     const std::atomic<bool>* stop = nullptr);
+
+/*!
+ * \brief Silero VAD v5 at 16 kHz, without a runtime: a short-time spectrum, four convolutions and
+ * a recurrent cell. Fed SPEECH_CHUNK samples at a time, in order.
+ */
+class CSpeechDetector
+{
+public:
+  //! The weights as the add-on ships them: float32, little endian, in the network's order.
+  bool Load(std::vector<float> weights);
+  bool Loaded() const { return !m_weights.empty(); }
+  //! Forgets what it heard: the next chunk does not follow the last.
+  void Reset();
+  //! The chance that someone speaks in the chunk.
+  float Process(const float* chunk);
+
+  //! How many floats the weights are.
+  static size_t WeightCount();
+
+private:
+  static constexpr int CONTEXT = 64;
+  static constexpr int HIDDEN = 128;
+
+  std::vector<float> m_weights;
+  const float* m_basis{nullptr};
+  std::array<std::array<const float*, 2>, 4> m_conv{};
+  const float* m_inputWeights{nullptr};
+  const float* m_hiddenWeights{nullptr};
+  const float* m_inputBias{nullptr};
+  const float* m_hiddenBias{nullptr};
+  const float* m_outWeights{nullptr};
+  float m_outBias{0};
+
+  std::array<float, CONTEXT> m_context{};
+  std::array<float, HIDDEN> m_h{};
+  std::array<float, HIDDEN> m_c{};
+};
+} // namespace KODI::SUBTITLES::TIMING
