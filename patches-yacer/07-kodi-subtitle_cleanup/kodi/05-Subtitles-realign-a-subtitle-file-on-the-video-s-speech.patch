@@ -308,7 +559,7 @@ void CCueStage::Out(const std::string& text, double start, double stop)
   if (m_realigning)
     m_delivered.push_back({text, start, stop});
   if (m_fit)
-    m_deliver(text, Moved(start), Moved(stop));
+    m_deliver(text, Moved(start, start), Moved(stop, start));
   else
