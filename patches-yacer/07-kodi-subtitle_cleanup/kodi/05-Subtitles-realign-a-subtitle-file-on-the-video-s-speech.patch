+//! the speech: a minute at a time, spread across the film; the first verdict after this many,
+//! then after twice as many each time, until it is clear or the film is heard whole
+constexpr double STRETCH = 60;
+constexpr size_t FIRST_STRETCHES = 8;
+//! read no faster than this, and no more than this: playback reads the same file meanwhile
+constexpr double MAX_RATE = 25e6;
+constexpr double MAX_BYTES = 12e9;
+//! then the speech is heard this far ahead of playback, to the end of the film...
+constexpr double AHEAD = 300;
+//! ...and the lines still to come shown again when that moves one by more than this
+constexpr double CHANGE = 0.5;
+//! refitted after this many more minutes heard there
+constexpr size_t REFIT = 2;
+//! the voice activity model, from its add-on
+constexpr const char* SPEECH_ADDON = "script.module.subtitlespeech.allolive";
+constexpr const char* SPEECH_WEIGHTS = "silero_vad_16k.bin";
+
 double Seconds(double time)
 {
   return time / DVD_TIME_BASE;
 }
 
+//! The stretches of a film of so many, in the order they are read: each pass halfway between
+//! the ones before.
+std::vector<size_t> SpreadOrder(size_t stretches)
+{
+  std::vector<size_t> order;
+  std::vector<bool> taken(stretches, false);
+  for (size_t count = 1; order.size() < stretches; count *= 2)
+    for (size_t i = 0; i < count; ++i)
+    {
+      const size_t at = static_cast<size_t>((i + 0.5) / count * stretches);
+      if (at < stretches && !taken[at])
+      {
+        taken[at] = true;
+        order.push_back(at);
+      }
+    }
+  return order;
+}
+
+//! The model's weights, when its add-on is there; asks for the add-on once when it is not.
+bool LoadDetector(TIMING::CSpeechDetector& detector)
+{
+  static std::atomic<bool> asked{false};
+  ADDON::AddonPtr addon;
+  if (!CServiceBroker::GetAddonMgr().GetAddon(SPEECH_ADDON, addon, ADDON::OnlyEnabled::CHOICE_YES))
+  {
+    if (!asked.exchange(true))
+      ADDON::CAddonInstaller::GetInstance().InstallOrUpdate(
+          SPEECH_ADDON, ADDON::BackgroundJob::CHOICE_YES, ADDON::ModalJob::CHOICE_NO);
+    return false;
+  }
+  std::vector<uint8_t> data;
+  if (XFILE::CFile().LoadFile(
+          URIUtils::AddFileToFolder(addon->Path(), "resources", "subtitlespeech", SPEECH_WEIGHTS),
+          data) <= 0)
+    return false;
+  std::vector<float> weights(data.size() / sizeof(float));
+  std::memcpy(weights.data(), data.data(), weights.size() * sizeof(float));
+  return detector.Load(std::move(weights));
+}
