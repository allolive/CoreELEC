+}
+
+class CDemuxStreamAudio;
+struct DemuxPacket;
+
+namespace KODI::SUBTITLES::TIMING
+{
+/*!
+ * \brief Hears where someone speaks in an audio stream of the video, stretch by stretch: decodes
+ * its packets, keeps the centre channel where dialogue sits (or all of them evenly when there is
+ * none) at the detector's rate, and has the detector read it.
+ */
+class CListener
+{
+public:
+  explicit CListener(CSpeechDetector& detector);
+  ~CListener();
+  CListener(const CListener&) = delete;
+  CListener& operator=(const CListener&) = delete;
+
+  bool Open(const CDemuxStreamAudio& stream);
+  //! A new stretch: nothing heard before it carries over.
+  void Begin();
+  void Hear(const DemuxPacket& packet);
+  //! The stretch heard since Begin.
+  Heard End();
+
+private:
+  void Take(const AVFrame& frame);
+
+  CSpeechDetector& m_detector;
+  AVCodecContext* m_codec{nullptr};
+  AVFrame* m_frame{nullptr};
+  AVPacket* m_packet{nullptr};
+  SwrContext* m_resample{nullptr};
+  Heard m_heard;
+  bool m_started{false};
+  std::vector<float> m_pending;
+};
+} // namespace KODI::SUBTITLES::TIMING
