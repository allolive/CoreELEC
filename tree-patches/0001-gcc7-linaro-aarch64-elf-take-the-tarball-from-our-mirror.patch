Upstream releases.linaro.org is decommissioned. Take the byte-identical
tarball from our own mirror instead; PKG_SHA256 still verifies it.

The context deliberately includes PKG_VERSION: the mirror is keyed on the
exact filename, so a version bump must break this patch rather than leave
the URL pointing at a tarball that was never mirrored.

diff --git a/projects/Amlogic-ce/packages/lang/gcc7-linaro-aarch64-elf/package.mk b/projects/Amlogic-ce/packages/lang/gcc7-linaro-aarch64-elf/package.mk
--- a/projects/Amlogic-ce/packages/lang/gcc7-linaro-aarch64-elf/package.mk
+++ b/projects/Amlogic-ce/packages/lang/gcc7-linaro-aarch64-elf/package.mk
@@ -3,13 +3,19 @@
 
 PKG_NAME="gcc7-linaro-aarch64-elf"
 PKG_VERSION="7.5.0-2019.12"
 PKG_SHA256="73689fb3e71beeecebd6434d60efad4cb926153d48399e4d16fb45395d9c81a0"
 PKG_LICENSE="GPL"
 PKG_SITE="https://www.linaro.org/"
-PKG_URL="https://releases.linaro.org/components/toolchain/binaries/7.5-2019.12/aarch64-elf/gcc-linaro-${PKG_VERSION}-x86_64_aarch64-elf.tar.xz"
+# Upstream releases.linaro.org is offline (host decommissioned). Self-hosted mirror of the
+# byte-identical tarball; sha256 still verified against PKG_SHA256 above.
+# Original: https://releases.linaro.org/components/toolchain/binaries/7.5-2019.12/aarch64-elf/gcc-linaro-${PKG_VERSION}-x86_64_aarch64-elf.tar.xz
+PKG_URL="https://github.com/allolive/CoreELEC/releases/download/packages-mirror/${PKG_NAME}__${PKG_NAME}-${PKG_VERSION}.tar.xz"
+# The mirror names its assets <package>__<filename>; the build still wants the
+# plain filename, so do not let it be derived from the URL.
+PKG_SOURCE_NAME="${PKG_NAME}-${PKG_VERSION}.tar.xz"
 PKG_DEPENDS_HOST="ccache:host"
 PKG_LONGDESC="Linaro Aarch64 GNU Linux Binary Toolchain"
 PKG_TOOLCHAIN="manual"
 
 unpack() {
   mkdir -p ${PKG_BUILD}
